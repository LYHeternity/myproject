     <el-option label=\"创业经验\" value=\"创业经验\"></el-option>\r\n              <el-option label=\"融资技巧\" value=\"融资技巧\"></el-option>\r\n              <el-option label=\"技术分享\" value=\"技术分享\"></el-option>\r\n              <el-option label=\"行业动态\" value=\"行业动态\"></el-option>\r\n            </el-select>\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"标签\" prop=\"tags\">\r\n            <el-input \r\n              v-model=\"postForm.tags\" \r\n              placeholder=\"请输入标签，用逗号分隔\"\r\n              size=\"large\"\r\n            ></el-input>\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"内容\" prop=\"content\">\r\n            <el-input\r\n              type=\"textarea\"\r\n              v-model=\"postForm.content\"\r\n              placeholder=\"请输入内容\"\r\n              :rows=\"12\"\r\n              size=\"large\"\r\n              maxlength=\"5000\"\r\n              show-word-limit\r\n            ></el-input>\r\n          </el-form-item>\r\n          \r\n          <el-form-item>\r\n            <el-button \r\n              type=\"primary\" \r\n              size=\"large\" \r\n              @click=\"submitForm\"\r\n              :loading=\"loading\"\r\n              :disabled=\"loading\"\r\n            >\r\n              {{ isEdit ? '更新' : '发布' }}\r\n            </el-button>\r\n            <el-button \r\n              size=\"large\" \r\n              @click=\"resetForm\"\r\n              :disabled=\"loading\"\r\n            >\r\n              重置\r\n            </el-button>\r\n            <el-button \r\n              size=\"large\" \r\n              @click=\"navigateBack\"\r\n              :disabled=\"loading\"\r\n            >\r\n              取消\r\n            </el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { postAPI } from '@/api/community'\r\n\r\nexport default {\r\n  name: 'PostCreate',\r\n  data() {\r\n    r