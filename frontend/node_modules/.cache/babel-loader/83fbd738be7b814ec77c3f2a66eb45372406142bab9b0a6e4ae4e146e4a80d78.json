length],\n      stage: MOCK_STAGES[i % 3],\n      fundingNeeded: [50, 100, 200, 500, 1000][i % 5],\n      likeCount: 10 + i % 20,\n      viewCount: 50 + i % 100\n    };\n  });\n}\nexport default {\n  name: 'ProjectList',\n  data: function data() {\n    return {\n      loading: false,\n      list: [],\n      query: {\n        industry: '',\n        stage: ''\n      },\n      page: {\n        current: 1,\n        size: 10,\n        total: 0\n      },\n      viewMode: 'card',\n      mockList: getMockProjects(20)\n    };\n  },\n  computed: {\n    displayCards: function displayCards() {\n      // 优先使用实际API数据，即使为空也不使用模拟数据，这样分页功能才能正常工作\n      return this.list;\n    },\n    sortedDisplayCards: function sortedDisplayCards() {\n      return _toConsumableArray(this.displayCards).sort(function (a, b) {\n        var likeA = a.likeCount || 0;\n        var likeB = b.likeCount || 0;\n        return likeB - likeA;\n      });\n    }\n  },\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    goProject: function goProject(item) {\n      if (item.id && String(item.id).indexOf('mock') === -1) this.$router.push('/project/' + item.id);\n    },\n    cardPlaceholder: function cardPlaceholder(i) {\n      return PLACEHOLDERS[i % PLACEHOLDERS.length];\n    },\n    load: function load() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var res;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              _context.n = 2;\n              return listPublic(_objectSpread({\n                current: _this.page.current,\n                size: _this.page.size\n              }, _this.query));\n            case 2:\n              res = _context.v;\n              _this.list = res.records || [];\n              _this.page.total = res.total || 0;\n            case 3:\n              _context.p = 3;\n              _this.loading = false;\n              return _context.f(3);\n            case 4:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1,, 3, 4]]);\n      }))();\n    },\n    onPage: function onPage(p) {\n      this.page.current = p;\n      this.load();\n    },\n    onSizeChange: function onSizeChange(size) {\n      this.page.size = size;\n      this.page.current = 1;\n      this.load();\n    },\n    toggleLike: function toggleLike(item) {\n      item.liked = !item.liked;\n      item.likeCount = (item.likeCount || 0) + (item.liked ? 1 : -1);\n      // 这里可以添加实际的点赞API调用\n      this.$message.success(item.liked ? '点赞成功' : '取消点赞');\n    }\n  }\n};","map":{"version":3,"names":["listPublic","PLACEHOLDERS","MOCK_TITLES","MOCK_INDUSTRIES","MOCK_STAGES","getMockProjects","n","Array","from","length","_","i","id","title","industry","stage","fundingNeeded","likeCount","viewCount","name","data","loading","list","query","page","current","size","total","viewMode","mockList","computed","displayCards","sortedDisplayCards","_toConsumableArray","sort","a","b","likeA","likeB","created","load","methods","goProject","item","String","indexOf","$router","push","cardPlaceholder","_this","_asyncToGenerator","_regenerator","m","_callee","res","w","_context","p","_objectSpread","v","records","f","onPage","onSizeChange","toggleLike","liked","$message","success"],"sources":["src/views/project/List.vue"],"sourcesContent":["<template>\n  <div class=\"page-card project-list-page\">\n    <div class=\"list-header\">\n      <h3>项目列表</h3>\n      <div class=\"view-toggle\">\n        <el-radio-group v-model=\"viewMode\" size=\"small\">\n          <el-radio-button label=\"table\">表格</el-radio-button>\n          <el-radio-button label=\"card\">卡片</el-radio-button>\n        </el-radio-group>\n      </div>\n    </div>\n    <div class=\"filter-bar hw-filter-bar\">\n      <el-form inline class=\"query-form\">\n        <el-form-item label=\"行业\">\n          <el-input v-model=\"query.industry\" placeholder=\"请输入行业\" clearable class=\"hw-input\" />\n        </el-form-item>\n        <el-form-item label=\"阶段\">\n          <el-select v-model=\"query.stage\" placeholder=\"全部阶段\" clearable class=\"hw-select\">\n            <el-option label=\"想法\" value=\"idea\" />\n            <el-option label=\"开发中\" value=\"开发中\" />\n            <el-option label=\"已上线\" value=\"已上线\" />\n          </el-select>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" class=\"hw-btn-primary\" @click=\"load\">查询</el-button>\n          <el-button @click=\"query = { industry: '', stage: '' }; load()\">重置</el-button>\n        </el-form-item>\n      </el-form>\n    </div>\n    <template v-if=\"viewMode === 'table'\">\n      <el-table v-loading=\"loading\" :data=\"list\" border stripe class=\"hw-table\">\n        <el-table-column prop=\"title\" label=\"项目名称\" min-width=\"200\" />\n        <el-table-column prop=\"industry\" label=\"行业\" width=\"100\" />\n        <el-table-column prop=\"stage\" label=\"阶段\" width=\"100\" />\n        <el-table-column prop=\"fundingNeeded\" label=\"融资需求(万)\" width=\"120\" />\n        <el-table-column prop=\"likeCount\" label=\"点赞\" width=\"80\" />\n        <el-table-column prop=\"viewCount\" label=\"浏览\" width=\"80\" />\n        <el-table-column label=\"操作\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"$router.push('/project/' + scope.row.id)\">详情</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </template>\n    <template v-else>\n      <div v-loading=\"loading\" class=\"project-waterfall\">\n        <div\n          v-for=\"(item, idx) in sortedDisplayCards\"\n          :key=\"'card-' + (item.id || idx)\"\n          class=\"project-card hw-clickable\"\n          @click=\"goProject(item)\"\n        >\n          <div class=\"project-card-img\">\n            <img :src=\"item.projectImage ? '/images/' + item.projectImage : (item.coverImage || cardPlaceholder(idx))\" :alt=\"item.title\" loading=\"lazy\" />\n            <div class=\"project-card-badges\">\n              <span class=\"badge industry\">{{ item.industry }}</span>\n              <span class=\"badge stage\">{{ item.stage }}</span>\n            </div>\n            <button \n              class=\"like-button\" \n              @click.stop=\"toggleLike(item)\"\n              :class=\"{ 'liked': item.liked }\"\n            >\n              <i :class=\"item.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n              <span class=\"like-count\">{{ item.likeCount || 0 }}</span>\n            </button>\n          </div>\n          <div class=\"project-card-body\">\n            <h4 class=\"project-title\">{{ item.title }}</h4>\n            <div class=\"project-meta\">\n              <div class=\"meta-item\">\n                <i class=\"el-icon-money\"></i>\n                <span>融资需求: {{ item.fundingNeeded != null ? item.fundingNeeded + ' 万' : '-' }}</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-view\"></i>\n                <span>{{ item.viewCount || 0 }} 浏览</span>\n              </div>\n            </div>\n            <div class=\"project-actions\">\n              <el-button type=\"primary\" size=\"small\" class=\"btn-detail\">查看详情</el-button>\n              <button \n                class=\"quick-like-button\" \n                @click.stop=\"toggleLike(item)\"\n                :class=\"{ 'liked': item.liked }\"\n              >\n                <i :class=\"item.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n                点赞\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </template>\n    <div v-if=\"!loading && !displayCards.length\" class=\"data-empty hw-empty\">\n      <div class=\"empty-icon\"><i class=\"el-icon-document\"></i></div>\n      <p>暂无项目数据</p>\n      <p class=\"empty-tip\">请尝试调整筛选条件或稍后再试</p>\n    </div>\n    <el-pagination\n      v-if=\"page.total > 0\"\n      style=\"margin-top:16px\"\n      :current-page=\"page.current\"\n      :page-size=\"page.size\"\n      :page-sizes=\"[5, 10, 20, 50]\"\n      :total=\"page.total\"\n      layout=\"total, sizes, prev, pager, next, jumper\"\n      @current-change=\"onPage\"\n      @size-change=\"onSizeChange\"\n    />\n  </div>\n</template>\n\n<script>\nimport { listPublic } from '@/api/project'\nconst PLACEHOLDERS = [\n  '/images/1.png',\n  '/images/2.png',\n  '/images/3.png'\n]\nconst MOCK_TITLES = ['智能硬件孵化', '企业SaaS平台', '新能源出行', '医疗健康数字化', '教育科技产品', '跨境电商', '本地生活O2O', '金融科技', 'AI内容工具', '供应链协同', '智慧园区', '环保科技', '农业物联网', '文创IP', '企业培训SaaS', '智能客服', '数据安全', '区块链存证', '短视频营销', '工业互联网']\nconst MOCK_INDUSTRIES = ['科技', '消费', '医疗', '教育', '金融', '制造', '企业服务', '文娱']\nconst MOCK_STAGES = ['想法', '开发中', '已上线']\nfunction getMockProjects(n) {\n  return Array.from({ length: n }, (_, i) => ({\n    id: 'mock-' + (i + 1),\n    title: MOCK_TITLES[i % MOCK_TITLES.length] + (i >= MOCK_TITLES.length ? ' ' + (i + 1) : ''),\n    industry: MOCK_INDUSTRIES[i % MOCK_INDUSTRIES.length],\n    stage: MOCK_STAGES[i % 3],\n    fundingNeeded: [50, 100, 200, 500, 1000][i % 5],\n    likeCount: 10 + (i % 20),\n    viewCount: 50 + (i % 100)\n  }))\n}\nexport default {\n  name: 'ProjectList',\n  data() {\n    return {\n      loading: false,\n      list: [],\n      query: { industry: '', stage: '' },\n      page: { current: 1, size: 10, total: 0 },\n      viewMode: 'card',\n      mockList: getMockProjects(20)\n    }\n  },\n  computed: {\n    displayCards() {\n      // 优先使用实际API数据，即使为空也不使用模拟数据，这样分页功能才能正常工作\n      return this.list\n    },\n    sortedDisplayCards() {\n      return [...this.displayCards].sort((a, b) => {\n        const likeA = a.likeCount || 0\n        const likeB = b.likeCount || 0\n        return likeB - likeA\n      })\n    }\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    goProject(item) {\n      if (item.id && String(item.id).indexOf('mock') === -1)\n        this.$router.push('/project/' + item.id)\n    },\n    cardPlaceholder(i) {\n      return PLACEHOLDERS[i % PLACEHOLDERS.length]\n    },\n    async load() {\n      this.loading = true\n      try {\n        const res = await listPublic({ current: this.page.current, size: this.page.size, ...this.query })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally {\n        this.loading = false\n      }\n    },\n    onPage(p) {\n      this.page.current = p\n      this.load()\n    },\n    onSizeChange(size) {\n      this.page.size = size\n      this.page.current = 1\n      this.load()\n    },\n    toggleLike(item) {\n      item.liked = !item.liked\n      item.likeCount = (item.likeCount || 0) + (item.liked ? 1 : -1)\n      // 这里可以添加实际的点赞API调用\n      this.$message.success(item.liked ? '点赞成功' : '取消点赞')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\n.list-header h3 { margin-bottom: 0; }\n.view-toggle { flex-shrink: 0; }\n.query-form { margin-bottom: 16px; }\n.project-waterfall {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 24px;\n}\n.project-card {\n  background: var(--hw-bg-card);\n  border-radius: var(--hw-radius-xl);\n  overflow: hidden;\n  border: 1px solid var(--hw-border);\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n  transition: all 0.3s ease;\n  position: relative;\n}\n.project-card:hover {\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);\n  transform: translateY(-8px);\n  border-color: var(--hw-primary-light);\n}\n.project-card-img {\n  height: 180px;\n  overflow: hidden;\n  background: #f1f5f9;\n  position: relative;\n}\n.project-card-img img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.5s ease;\n}\n.project-card:hover .project-card-img img {\n  transform: scale(1.08);\n}\n.project-card-badges {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  display: flex;\n  gap: 8px;\n  z-index: 2;\n}\n.badge {\n  padding: 6px 12px;\n  border-radius: 16px;\n  font-size: 12px;\n  font-weight: 500;\n  backdrop-filter: blur(10px);\n}\n.badge.industry {\n  background: rgba(0, 125, 255, 0.2);\n  color: #007dff;\n}\n.badge.stage {\n  background: rgba(16, 185, 129, 0.2);\n  color: #10b981;\n}\n.like-button {\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 12px;\n  background: rgba(255, 255, 255, 0.9);\n  border: 1px solid rgba(255, 255, 255, 0.3);\n  border-radius: 20px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  backdrop-filter: blur(10px);\n  z-index: 2;\n  font-size: 12px;\n  font-weight: 500;\n}\n.like-button:hover {\n  background: rgba(255, 255, 255, 1);\n  transform: scale(1.05);\n}\n.like-button.liked {\n  background: rgba(251, 191, 36, 0.9);\n  color: white;\n  border-color: rgba(251, 191, 36, 0.3);\n}\n.like-button.liked:hover {\n  background: rgba(251, 191, 36, 1);\n}\n.like-button i {\n  font-size: 14px;\n}\n.like-count {\n  font-size: 12px;\n  font-weight: 600;\n}\n.project-card-body {\n  padding: 20px;\n}\n.project-title {\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--hw-text);\n  margin-bottom: 12px;\n  line-height: 1.3;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.project-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n.meta-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 14px;\n  color: var(--hw-text-secondary);\n}\n.meta-item i {\n  font-size: 14px;\n  color: var(--hw-primary);\n}\n.project-actions {\n  display: flex;\n  gap: 10px;\n}\n.btn-detail {\n  flex: 1;\n  border-radius: 8px;\n  font-weight: 500;\n}\n.quick-like-button {\n  padding: 8px 16px;\n  border: 1px solid var(--hw-primary);\n  border-radius: 8px;\n  background: white;\n  color: var(--hw-primary);\n  cursor: pointer;\n  transition: all 0.3s ease;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 12px;\n  font-weight: 500;\n}\n.quick-like-button:hover {\n  background: var(--hw-primary-light);\n  transform: translateY(-2px);\n}\n.quick-like-button.liked {\n  background: var(--hw-primary);\n  color: white;\n}\n.quick-like-button.liked:hover {\n  background: var(--hw-primary-hover);\n}\n.quick-like-button i {\n  font-size: 12px;\n}\n.hw-filter-bar {\n  background: #fff;\n  border-radius: 12px;\n  padding: 20px;\n  margin-bottom: 24px;\n  border: 1px solid var(--hw-border);\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n}\n.hw-empty .empty-tip {\n  font-size: 12px;\n  color: #94a3b8;\n  margin-top: 8px;\n}\n\n/* 响应式设计 */\n@media (max-width: 1024px) {\n  .project-waterfall {\n    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  }\n  .project-card-img {\n    height: 160px;\n  }\n}\n\n@media (max-width: 768px) {\n  .project-waterfall {\n    grid-template-columns: repeat(auto-fill, minmax(100%, 1fr));\n  }\n  .project-card-img {\n    height: 200px;\n  }\n  .project-actions {\n    flex-direction: column;\n  }\n  .quick-like-button {\n    justify-content: center;\n  }\n}\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAkHA,SAAAA,UAAA;AACA,IAAAC,YAAA,IACA,iBACA,iBACA,gBACA;AACA,IAAAC,WAAA;AACA,IAAAC,eAAA;AACA,IAAAC,WAAA;AACA,SAAAC,gBAAAC,CAAA;EACA,OAAAC,KAAA,CAAAC,IAAA;IAAAC,MAAA,EAAAH;EAAA,aAAAI,CAAA,EAAAC,CAAA;IAAA;MACAC,EAAA,aAAAD,CAAA;MACAE,KAAA,EAAAX,WAAA,CAAAS,CAAA,GAAAT,WAAA,CAAAO,MAAA,KAAAE,CAAA,IAAAT,WAAA,CAAAO,MAAA,UAAAE,CAAA;MACAG,QAAA,EAAAX,eAAA,CAAAQ,CAAA,GAAAR,eAAA,CAAAM,MAAA;MACAM,KAAA,EAAAX,WAAA,CAAAO,CAAA;MACAK,aAAA,4BAAAL,CAAA;MACAM,SAAA,OAAAN,CAAA;MACAO,SAAA,OAAAP,CAAA;IACA;EAAA;AACA;AACA;EACAQ,IAAA;EACAC,IAAA,WA