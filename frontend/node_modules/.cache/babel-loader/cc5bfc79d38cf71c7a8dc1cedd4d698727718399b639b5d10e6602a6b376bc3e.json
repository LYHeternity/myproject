{"ast":null,"code":"import \"core-js/modules/web.timers.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'App',\n  data: function data() {\n    return {\n      appReady: false,\n      isDarkTheme: true\n    };\n  },\n  mounted: function mounted() {\n    var _this = this;\n    // 从localStorage读取主题设置\n    var savedTheme = localStorage.getItem('theme');\n    if (savedTheme) {\n      this.isDarkTheme = savedTheme === 'dark';\n    }\n    this.$router.afterEach(function () {\n      if (!_this.appReady) _this.appReady = true;\n    });\n    setTimeout(function () {\n      _this.appReady = true;\n    }, 320);\n  },\n  methods: {\n    toggleTheme: function toggleTheme() {\n      this.isDarkTheme = !this.isDarkTheme;\n      // 保存主题设置到localStorage\n      localStorage.setItem('theme', this.isDarkTheme ? 'dark' : 'light');\n    }\n  }\n};","map":{"version":3,"names":["name","data","appReady","isDarkTheme","mounted","_this","savedTheme","localStorage","getItem","$router","afterEach","setTimeout","methods","toggleTheme","setItem"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\" :class=\"{ 'dark-theme': isDarkTheme }\">\n    <!-- 骨架屏：首屏加载时展示，内容就绪后渐隐 -->\n    <div v-show=\"!appReady\" class=\"app-skeleton\">\n      <div class=\"skeleton-header\"></div>\n      <div class=\"skeleton-body\">\n        <div class=\"skeleton-block skeleton-hero\"></div>\n        <div class=\"skeleton-block skeleton-line\" style=\"width:60%; margin:24px 0\"></div>\n        <div class=\"skeleton-block skeleton-line\" style=\"width:40%\"></div>\n        <div class=\"skeleton-cards\">\n          <div class=\"skeleton-block skeleton-card\" v-for=\"i in 4\" :key=\"i\"></div>\n        </div>\n      </div>\n    </div>\n    \n    <!-- 主题切换按钮 -->\n    <div class=\"theme-toggle-container\">\n      <button \n        class=\"theme-toggle-button\" \n        :class=\"{ active: !isDarkTheme }\" \n        @click=\"toggleTheme\"\n        aria-label=\"切换主题\"\n      >\n        <div class=\"toggle-track\">\n          <div class=\"toggle-thumb\"></div>\n        </div>\n        <span class=\"toggle-label\">{{ isDarkTheme ? '浅色' : '深色' }}</span>\n      </button>\n    </div>\n    \n    <transition name=\"page-fade\">\n      <router-view v-show=\"appReady\" />\n    </transition>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  data() {\n    return {\n      appReady: false,\n      isDarkTheme: true\n    }\n  },\n  mounted() {\n    // 从localStorage读取主题设置\n    const savedTheme = localStorage.getItem('theme')\n    if (savedTheme) {\n      this.isDarkTheme = savedTheme === 'dark'\n    }\n    \n    this.$router.afterEach(() => {\n      if (!this.appReady) this.appReady = true\n    })\n    setTimeout(() => { this.appReady = true }, 320)\n  },\n  methods: {\n    toggleTheme() {\n      this.isDarkTheme = !this.isDarkTheme\n      // 保存主题设置到localStorage\n      localStorage.setItem('theme', this.isDarkTheme ? 'dark' : 'light')\n    }\n  }\n}\n</script>\n\n<style>\n.app-skeleton {\n  position: fixed;\n  inset: 0;\n  z-index: 9999;\n  background: var(--hw-bg, #f8fafc);\n  transition: opacity 0.35s ease;\n}\n.app-skeleton[style*='display: none'] { pointer-events: none; }\n.skeleton-header {\n  height: 64px;\n  background: linear-gradient(90deg, #e2e8f0 0%, #f1f5f9 50%, #e2e8f0 100%);\n  background-size: 200% 100%;\n  animation: skeleton-shine 1.2s ease-in-out infinite;\n}\n.skeleton-body { max-width: 1200px; margin: 0 auto; padding: 24px; }\n.skeleton-hero { height: 280px; border-radius: 16px; margin-bottom: 32px; }\n.skeleton-cards { display: flex; gap: 20px; margin-top: 24px; }\n.skeleton-card { flex: 1; height: 120px; border-radius: 12px; }\n.page-fade-enter-active { transition: opacity 0.3s ease; }\n.page-fade-enter { opacity: 0; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqCA;EACAA,IAAA;EACAC,IAAA,WAAA