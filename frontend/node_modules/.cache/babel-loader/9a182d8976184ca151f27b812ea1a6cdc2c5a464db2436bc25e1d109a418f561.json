"操作\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"$router.push('/service/' + scope.row.id)\">详情</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </template>\n    <template v-else>\n      <div v-loading=\"loading\" class=\"service-waterfall\">\n        <div\n          v-for=\"(item, idx) in displayCards\"\n          :key=\"'card-' + (item.id || idx)\"\n          class=\"service-card hw-clickable\"\n          @click=\"goService(item)\"\n        >\n          <div class=\"service-card-img\">\n            <img :src=\"cardPlaceholder(idx)\" :alt=\"item.title\" loading=\"lazy\" />\n          </div>\n          <div class=\"service-card-body\">\n            <h4>{{ item.title }}</h4>\n            <div class=\"meta\">{{ item.category }}</div>\n            <div class=\"price-wrap\">\n              <span class=\"price\">¥{{ item.price != null ? item.price : '0' }}</span>\n              <span class=\"rating\" v-if=\"item.rating\">评分 {{ item.rating }}</span>\n            </div>\n            <el-button type=\"primary\" size=\"small\" class=\"btn-detail\">查看详情</el-button>\n          </div>\n        </div>\n      </div>\n    </template>\n    <div v-if=\"!loading && !displayCards.length\" class=\"data-empty hw-empty\">\n      <div class=\"empty-icon\"><i class=\"el-icon-goods\"></i></div>\n      <p>暂无服务数据</p>\n      <p class=\"empty-tip\">请尝试调整筛选条件或稍后再试</p>\n    </div>\n    <el-pagination\n      v-if=\"page.total > 0\"\n      style=\"margin-top:16px\"\n      :current-page=\"page.current\"\n      :page-size=\"page.size\"\n      :total=\"page.total\"\n      layout=\"total, prev, pager, next\"\n      @current-change=\"onPage\"\n    />\n  </div>\n</template>\n\n<script>\nimport { listPublic } from '@/api/resource'\nconst PLACEHOLDERS = [\n  'https://images.unsplash.com/photo-1552664730-d307ca884978?w=400',\n  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=400',\n  'https://images.unsplash.com/photo-1556761175-b413da4baf72?w=400',\n  'https://images.unsplash.com/photo-1551434678-e076c223a692?w=400',\n  'https://images.unsplash.com/photo-1557804506-669a67965ba0?w=400'\n]\nconst MOCK_TITLES = ['市场推广', '法律咨询', '财务顾问', '技术开发', '品牌设计', '人力资源', '知识产权', '融资辅导', '战略规划', '数字化咨询', '供应链管理', '营销策划', '公关传播', '数据分析', 'UI/UX设计', '运维支持', '安全审计', '培训服务', '会务策划', '翻译服务']\nconst MOCK_CATEGORIES = ['市场', '法律', '财务', '技术', '设计', '咨询', '培训', '其他']\nfunction getMockServices(n) {\n  return Array.from({ length: n }, (_, i) => ({\n    id: 'mock-' + (i + 1),\n    title: MOCK_TITLES[i % MOCK_TITLES.length] + (i >= MOCK_TITLES.length ? ' ' + (i + 1) : ''),\n    category: MOCK_CATEGORIES[i % MOCK_CATEGORIES.length],\n    price: [999, 1999, 2999, 4999, 9999][i % 5],\n    rating: (4 + (i % 10) / 10).toFixed(1),\n    providerName: '服务商' + (i % 5 + 1)\n  }))\n}\nexport default {\n  name: 'ServiceList',\n  data() {\n    return {\n      loading: false,\n      list: [],\n      query: { category: '' },\n      page: { current: 1, size: 10, total: 0 },\n      viewMode: 'card',\n      mockList: getMockServices(20)\n    }\n  },\n  computed: {\n    displayCards() {\n      if (this.list.length) return this.list\n      return this.mockList\n    }\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    goService(item) {\n      if (item.id && String(item.id).indexOf('mock') === -1)\n        this.$router.push('/service/' + item.id)\n    },\n    cardPlaceholder(i) {\n      return PLACEHOLDERS[i % PLACEHOLDERS.length]\n    },\n    async load() {\n      this.loading = true\n      try {\n        const res = await listPublic({ current: this.page.current, size: this.page.size, ...this.query })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally {\n        this.loading = false\n      }\n    },\n    onPage(p) {\n      this.page.current = p\n      this.load()\n    }\n  }\n}\n</script>\n\n<style scoped>\n.list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\n.list-header h3 { margin-bottom: 0; }\n.filter-bar { margin-bottom: 20px; }\n.hw-filter-bar { background: #fff; border-radius: 8px; padding: 16px; border: 1px solid var(--hw-border); box-shadow: 0 2px 12px rgba(0,0,0,.06); }\n.service-waterfall {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  gap: 20px;\n}\n.service-card {\n  background: #fff;\n  border-radius: var(--hw-radius-lg);\n  overflow: hidden;\n  border: 1px solid var(--hw-border);\n  box-shadow: var(--hw-shadow);\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\n}\n.service-card:hover { box-shadow: var(--hw-shadow-hover); transform: scale(1.02); }\n.service-card-img { height: 140px; overflow: hidden; background: #f1f5f9; }\n.service-card-img img { width: 100%; height: 100%; object-fit: cover; }\n.service-card-body { padding: 16px; }\n.service-card-body h4 { font-size: 15px; font-weight: 600; color: #1e293b; margin-bottom: 8px; }\n.service-card-body .meta { font-size: 12px; color: var(--hw-text-secondary); margin-bottom: 8px; }\n.service-card-body .price-wrap { margin-bottom: 12px; }\n.service-card-body .price { font-size: 18px; font-weight: 700; color: #007dff; margin-right: 12px; }\n.service-card-body .rating { font-size: 12px; color: #64748b; }\n.service-card-body .btn-detail { width: 100%; border-radius: 8px; }\n.hw-empty .empty-tip { font-size: 12px; color: #94a3b8; margin-top: 8px; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA6EA,SAAAA,UAAA;AACA,IAAAC,YAAA,IACA,mEACA,sEACA,mEACA,mEACA,kEACA;AACA,IAAAC,WAAA;AACA,IAAAC,eAAA;AACA,SAAAC,gBAAAC,CAAA;EACA,OAAAC,KAAA,CAAAC,IAAA;IAAAC,MAAA,EAAAH;EAAA,aAAAI,CAAA,EAAAC,CAAA;IAAA;MACAC,EAAA,aAAAD,CAAA;MACAE,KAAA,EAAAV,WAAA,CAAAQ,CAAA,GAAAR,WAAA,CAAAM,MAAA,KAAAE,CAAA,IAAAR,WAAA,CAAAM,MAAA,UAAAE,CAAA;MACAG,QAAA,EAAAV,eAAA,CAAAO,CAAA,GAAAP,eAAA,CAAAK,MAAA;MACAM,KAAA,gCAAAJ,CAAA;