          message: '请选择项目阶段',\n          trigger: 'change'\n        }],\n        summary: [{\n          required: true,\n          message: '请输入项目简介',\n          trigger: 'blur'\n        }],\n        description: [{\n          required: true,\n          message: '请输入项目描述',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  created: function created() {\n    this.token = localStorage.getItem('token');\n  },\n  methods: {\n    showGuidelines: function showGuidelines() {\n      this.showGuidelinesDialog = true;\n    },\n    addTag: function addTag() {\n      if (this.inputTag && !this.form.tags.includes(this.inputTag)) {\n        this.form.tags.push(this.inputTag);\n        this.inputTag = '';\n      }\n    },\n    removeTag: function removeTag(tag) {\n      this.form.tags = this.form.tags.filter(function (t) {\n        return t !== tag;\n      });\n    },\n    prevStep: function prevStep() {\n      if (this.currentStep > 0) {\n        this.currentStep--;\n      }\n    },\n    nextStep: function nextStep() {\n      var _this = this;\n      if (this.currentStep === 0) {\n        this.$refs.form.validateField(['title', 'industry', 'stage'], function (err) {\n          if (!err) _this.currentStep = 1;\n        });\n      } else if (this.currentStep === 1) {\n        this.currentStep = 2;\n      }\n    },\n    beforeImageUpload: function beforeImageUpload(file) {\n      var isJPG = file.type === 'image/jpeg' || file.type === 'image/png';\n      var isLt5M = file.size / 1024 / 1024 < 5;\n      if (!isJPG) {\n        this.$message.error('只支持jpg、png格式的图片');\n        return false;\n      }\n      if (!isLt5M) {\n        this.$message.error('图片大小不能超过5MB');\n        return false;\n      }\n\n      // 手动上传\n      this.uploadImage(file);\n      return false;\n    },\n    uploadImage: function uploadImage(file) {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var response, _t;\n        return _rege