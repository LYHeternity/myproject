 4999, 9999][i % 5],\n      rating: (4 + i % 10 / 10).toFixed(1),\n      providerName: '服务商' + (i % 5 + 1)\n    };\n  });\n}\nexport default {\n  name: 'ServiceList',\n  data: function data() {\n    return {\n      loading: false,\n      list: [],\n      query: {\n        category: ''\n      },\n      page: {\n        current: 1,\n        size: 10,\n        total: 0\n      },\n      viewMode: 'card',\n      mockList: getMockServices(20)\n    };\n  },\n  computed: {\n    displayCards: function displayCards() {\n      if (this.list.length) return this.list;\n      return this.mockList;\n    },\n    sortedDisplayCards: function sortedDisplayCards() {\n      return _toConsumableArray(this.displayCards).sort(function (a, b) {\n        var likeA = a.likeCount || 0;\n        var likeB = b.likeCount || 0;\n        return likeB - likeA;\n      });\n    }\n  },\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    goService: function goService(item) {\n      if (item.id && String(item.id).indexOf('mock') === -1) this.$router.push('/service/' + item.id);\n    },\n    cardPlaceholder: function cardPlaceholder(i) {\n      return PLACEHOLDERS[i % PLACEHOLDERS.length];\n    },\n    load: function load() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var res;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              _context.n = 2;\n              return listPublic(_objectSpread({\n                current: _this.page.current,\n                size: _this.page.size\n              }, _this.query));\n            case 2:\n              res = _context.v;\n              _this.list = res.records || [];\n              _this.page.total = res.total || 0;\n            case 3:\n              _context.p = 3;\n              _this.loading = false;\n              return _context.f(3);\n            case 4:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1,, 3, 4]]);\n      }))();\n    },\n    onPage: function onPage(p) {\n      this.page.current = p;\n      this.load();\n    },\n    onSizeChange: function onSizeChange(size) {\n      this.page.size = size;\n      this.page.current = 1;\n      this.load();\n    },\n    toggleLike: function toggleLike(item) {\n      item.liked = !item.liked;\n      item.likeCount = (item.likeCount || 0) + (item.liked ? 1 : -1);\n      // 这里可以添加实际的点赞API调用\n      this.$message.success(item.liked ? '点赞成功' : '取消点赞');\n    }\n  }\n};","map":{"version":3,"names":["listPublic","PLACEHOLDERS","MOCK_TITLES","MOCK_CATEGORIES","getMockServices","n","Array","from","length","_","i","id","title","category","price","rating","toFixed","providerName","name","data","loading","list","query","page","current","size","total","viewMode","mockList","computed","displayCards","sortedDisplayCards","_toConsumableArray","sort","a","b","likeA","likeCount","likeB","created","load","methods","goService","item","String","indexOf","$router","push","cardPlaceholder","_this","_asyncToGenerator","_regenerator","m","_callee","res","w","_context","p","_objectSpread","v","records","f","onPage","onSizeChange","toggleLike","liked","$message","success"],"sources":["src/views/resource/List.vue"],"sourcesContent":["<template>\n  <div class=\"page-card service-list-page\">\n    <div class=\"list-header\">\n      <h3>服务市场</h3>\n      <div class=\"view-toggle\">\n        <el-radio-group v-model=\"viewMode\" size=\"small\">\n          <el-radio-button label=\"table\">表格</el-radio-button>\n          <el-radio-button label=\"card\">卡片</el-radio-button>\n        </el-radio-group>\n      </div>\n    </div>\n    <div class=\"filter-bar hw-filter-bar\">\n      <el-form inline class=\"query-form\">\n        <el-form-item label=\"分类\">\n          <el-input v-model=\"query.category\" placeholder=\"请输入分类\" clearable />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" @click=\"load\">查询</el-button>\n          <el-button @click=\"query = { category: '' }; load()\">重置</el-button>\n        </el-form-item>\n      </el-form>\n    </div>\n    <template v-if=\"viewMode === 'table'\">\n      <el-table v-loading=\"loading\" :data=\"list\" border stripe class=\"hw-table\">\n        <el-table-column prop=\"title\" label=\"服务名称\" min-width=\"200\" />\n        <el-table-column prop=\"category\" label=\"分类\" width=\"120\" />\n        <el-table-column prop=\"price\" label=\"价格\" width=\"100\" />\n        <el-table-column prop=\"rating\" label=\"评分\" width=\"80\" />\n        <el-table-column prop=\"providerName\" label=\"服务商\" width=\"120\" />\n        <el-table-column label=\"操作\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"$router.push('/service/' + scope.row.id)\">详情</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </template>\n    <template v-else>\n      <div v-loading=\"loading\" class=\"service-waterfall\">\n        <div\n          v-for=\"(item, idx) in sortedDisplayCards\"\n          :key=\"'card-' + (item.id || idx)\"\n          class=\"service-card hw-clickable\"\n          @click=\"goService(item)\"\n        >\n          <div class=\"service-card-img\">\n            <img :src=\"cardPlaceholder(idx)\" :alt=\"item.title\" loading=\"lazy\" />\n            <div class=\"service-card-badges\">\n              <span class=\"badge category\">{{ item.category }}</span>\n              <span class=\"badge rating\" v-if=\"item.rating\">{{ item.rating }}</span>\n            </div>\n            <button \n              class=\"like-button\" \n              @click.stop=\"toggleLike(item)\"\n              :class=\"{ 'liked': item.liked }\"\n            >\n              <i :class=\"item.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n              <span class=\"like-count\">{{ item.likeCount || 0 }}</span>\n            </button>\n          </div>\n          <div class=\"service-card-body\">\n            <h4 class=\"service-title\">{{ item.title }}</h4>\n            <div class=\"service-meta\">\n              <div class=\"meta-item\">\n                <i class=\"el-icon-user\"></i>\n                <span>{{ item.providerName || '专业服务商' }}</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-view\"></i>\n                <span>{{ item.viewCount || 0 }} 浏览</span>\n              </div>\n            </div>\n            <div class=\"service-price\">¥{{ item.price != null ? item.price : '0' }}</div>\n            <div class=\"service-actions\">\n              <el-button type=\"primary\" size=\"small\" class=\"btn-detail\">查看详情</el-button>\n              <button \n                class=\"quick-like-button\" \n                @click.stop=\"toggleLike(item)\"\n                :class=\"{ 'liked': item.liked }\"\n              >\n                <i :class=\"item.liked ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n                点赞\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </template>\n    <div v-if=\"!loading && !displayCards.length\" class=\"data-empty hw-empty\">\n      <div class=\"empty-icon\"><i class=\"el-icon-goods\"></i></div>\n      <p>暂无服务数据</p>\n      <p class=\"empty-tip\">请尝试调整筛选条件或稍后再试</p>\n    </div>\n    <el-pagination\n      v-if=\"page.total > 0\"\n      style=\"margin-top:16px\"\n      :current-page=\"page.current\"\n      :page-size=\"page.size\"\n      :page-sizes=\"[5, 10, 20, 50]\"\n      :total=\"page.total\"\n      layout=\"total, sizes, prev, pager, next, jumper\"\n      @current-change=\"onPage\"\n      @size-change=\"onSizeChange\"\n    />\n  </div>\n</template>\n\n<script>\nimport { listPublic } from '@/api/resource'\nconst PLACEHOLDERS = [\n  '/images/1.png',\n  '/images/2.png',\n  '/images/3.png'\n]\nconst MOCK_TITLES = ['市场推广', '法律咨询', '财务顾问', '技术开发', '品牌设计', '人力资源', '知识产权', '融资辅导', '战略规划', '数字化咨询', '供应链管理', '营销策划', '公关传播', '数据分析', 'UI/UX设计', '运维支持', '安全审计', '培训服务', '会务策划', '翻译服务']\nconst MOCK_CATEGORIES = ['市场', '法律', '财务', '技术', '设计', '咨询', '培训', '其他']\nfunction getMockServices(n) {\n  return Array.from({ length: n }, (_, i) => ({\n    id: 'mock-' + (i + 1),\n    title: MOCK_TITLES[i % MOCK_TITLES.length] + (i >= MOCK_TITLES.length ? ' ' + (i + 1) : ''),\n    category: MOCK_CATEGORIES[i % MOCK_CATEGORIES.length],\n    price: [999, 1999, 2999, 4999, 9999][i % 5],\n    rating: (4 + (i % 10) / 10).toFixed(1),\n    providerName: '服务商' + (i % 5 + 1)\n  }))\n}\nexport default {\n  name: 'ServiceList',\n  data() {\n    return {\n      loading: false,\n      list: [],\n      query: { category: '' },\n      page: { current: 1, size: 10, total: 0 },\n      viewMode: 'card',\n      mockList: getMockServices(20)\n    }\n  },\n  computed: {\n    displayCards() {\n      if (this.list.length) return this.list\n      return this.mockList\n    },\n    sortedDisplayCards() {\n      return [...this.displayCards].sort((a, b) => {\n        const likeA = a.likeCount || 0\n        const likeB = b.likeCount || 0\n        return likeB - likeA\n      })\n    }\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    goService(item) {\n      if (item.id && String(item.id).indexOf('mock') === -1)\n        this.$router.push('/service/' + item.id)\n    },\n    cardPlaceholder(i) {\n      return PLACEHOLDERS[i % PLACEHOLDERS.length]\n    },\n    async load() {\n      this.loading = true\n      try {\n        const res = await listPublic({ current: this.page.current, size: this.page.size, ...this.query })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally {\n        this.loading = false\n      }\n    },\n    onPage(p) {\n      this.page.current = p\n      this.load()\n    },\n    onSizeChange(size) {\n      this.page.size = size\n      this.page.current = 1\n      this.load()\n    },\n    toggleLike(item) {\n      item.liked = !item.liked\n      item.likeCount = (item.likeCount || 0) + (item.liked ? 1 : -1)\n      // 这里可以添加实际的点赞API调用\n      this.$message.success(item.liked ? '点赞成功' : '取消点赞')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\n.list-header h3 { margin-bottom: 0; }\n.filter-bar { margin-bottom: 20px; }\n.hw-filter-bar { background: #fff; border-radius: 12px; padding: 20px; border: 1px solid var(--hw-border); box-shadow: 0 4px 20px rgba(0,0,0,.08); }\n.service-waterfall {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 24px;\n}\n.service-card {\n  background: var(--hw-bg-card);\n  border-radius: var(--hw-radius-xl);\n  overflow: hidden;\n  border: 1px solid var(--hw-border);\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n  transition: all 0.3s ease;\n  position: relative;\n}\n.service-card:hover {\n  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);\n  transform: translateY(-8px);\n  border-color: var(--hw-primary-light);\n}\n.service-card-img {\n  height: 180px;\n  overflow: hidden;\n  background: #f1f5f9;\n  position: relative;\n}\n.service-card-img img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.5s ease;\n}\n.service-card:hover .service-card-img img {\n  transform: scale(1.08);\n}\n.service-card-badges {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  display: flex;\n  gap: 8px;\n  z-index: 2;\n}\n.badge {\n  padding: 6px 12px;\n  border-radius: 16px;\n  font-size: 12px;\n  font-weight: 500;\n  backdrop-filter: blur(10px);\n}\n.badge.category {\n  background: rgba(0, 125, 255, 0.2);\n  color: #007dff;\n}\n.badge.rating {\n  background: rgba(251, 191, 36, 0.2);\n  color: #f59e0b;\n}\n.like-button {\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 12px;\n  background: rgba(255, 255, 255, 0.9);\n  border: 1px solid rgba(255, 255, 255, 0.3);\n  border-radius: 20px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n  backdrop-filter: blur(10px);\n  z-index: 2;\n  font-size: 12px;\n  font-weight: 500;\n}\n.like-button:hover {\n  background: rgba(255, 255, 255, 1);\n  transform: scale(1.05);\n}\n.like-button.liked {\n  background: rgba(251, 191, 36, 0.9);\n  color: white;\n  border-color: rgba(251, 191, 36, 0.3);\n}\n.like-button.liked:hover {\n  background: rgba(251, 191, 36, 1);\n}\n.like-button i {\n  font-size: 14px;\n}\n.like-count {\n  font-size: 12px;\n  font-weight: 600;\n}\n.service-card-body {\n  padding: 20px;\n}\n.service-title {\n  font-size: 18px;\n  font-weight: 600;\n  color: var(--hw-text);\n  margin-bottom: 12px;\n  line-height: 1.3;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.service-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n.meta-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 14px;\n  color: var(--hw-text-secondary);\n}\n.meta-item i {\n  font-size: 14px;\n  color: var(--hw-primary);\n}\n.service-price {\n  font-size: 24px;\n  font-weight: 700;\n  color: var(--hw-primary);\n  margin-bottom: 16px;\n  line-height: 1;\n}\n.service-actions {\n  display: flex;\n  gap: 10px;\n}\n.btn-detail {\n  flex: 1;\n  border-radius: 8px;\n  font-weight: 500;\n}\n.quick-like-button {\n  padding: 8px 16px;\n  border: 1px solid var(--hw-primary);\n  border-radius: 8px;\n  background: white;\n  color: var(--hw-primary);\n  cursor: pointer;\n  transition: all 0.3s ease;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 12px;\n  font-weight: 500;\n}\n.quick-like-button:hover {\n  background: var(--hw-primary-light);\n  transform: translateY(-2px);\n}\n.quick-like-button.liked {\n  background: var(--hw-primary);\n  color: white;\n}\n.quick-like-button.liked:hover {\n  background: var(--hw-primary-hover);\n}\n.quick-like-button i {\n  font-size: 12px;\n}\n.hw-empty .empty-tip { font-size: 12px; color: #94a3b8; margin-top: 8px; }\n\n/* 响应式设计 */\n@media (max-width: 1024px) {\n  .service-waterfall {\n    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  }\n  .service-card-img {\n    height: 160px;\n  }\n}\n\n@media (max-width: 768px) {\n  .service-waterfall {\n    grid-template-columns: repeat(auto-fill, minmax(100%, 1fr));\n  }\n  .service-card-img {\n    height: 200px;\n  }\n  .service-actions {\n    flex-direction: column;\n  }\n  .quick-like-button {\n    justify-content: center;\n  }\n}\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA2GA,SAAAA,UAAA;AACA,IAAAC,YAAA,IACA,iBACA,iBACA,gBACA;AACA,IAAAC,WAAA;AACA,IAAAC,eAAA;AACA,SAAAC,gBAAAC,CAAA;EACA,OAAAC,KAAA,CAAAC,IAAA;IAAAC,MAAA,EAAAH;EAAA,aAAAI,CAAA,EAAAC,CAAA;IAAA;MACAC,EAAA,aAAAD,CAAA;MACAE,KAAA,EAAAV,WAAA,CAAAQ,CAAA,GAAAR,WAAA,CAAAM,MAAA,KAAAE,CAAA,IAAAR,WAAA,CAAAM,MAAA,UAAAE,CAAA;MACAG,QAAA,EAAAV,eAAA,CAAAO,CAAA,GAAAP,eAAA,CAAAK,MAAA;MACAM,KAAA,gCAAAJ,CAAA;MACAK,MAAA,OAAAL,CAAA,YAAAM,OAAA;MACAC,YAAA,WAAAP,CAAA;IACA;EAAA;AACA;AACA;EACAQ,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,IAAA;MACAC,KAAA;QAAAT,QAAA;MAAA;MACAU,IAAA;QAAAC,OAAA;QAAAC,IAAA;QAAAC,KAAA;MAAA;MACAC,QAAA;MACAC,QAAA,EAAAxB,eAAA;IACA;EACA;EACAyB,QAAA;IACAC,YAAA,WAAAA,aAAA;MACA,SAAAT,IAAA,CAAAb,MAAA,cAAAa,IAAA;MACA,YAAAO,QAAA;IACA;IACAG,kBAAA,WAAAA,mBAAA;MACA,OAAAC,kBAAA,MAAAF,YAAA,EAAAG,IAAA,WAAAC,CAAA,EAAAC,CAAA;QACA,IAAAC,KAAA,GAAAF,CAAA,CAAAG,SAAA;QACA,IAAAC,KAAA,GAAAH,CAAA,CAAAE,SAAA;QACA,OAAAC,KAAA,GAAAF,KAAA;MACA;IACA;EACA;EACAG,OAAA,WAAAA,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAC,SAAA,WAAAA,UAAAC,IAAA;MACA,IAAAA,IAAA,CAAAhC,EAAA,IAAAiC,MAAA,CAAAD,IAAA,CAAAhC,EAAA,EAAAkC,OAAA,iBACA,KAAAC,OAAA,CAAAC,IAAA,eAAAJ,IAAA,