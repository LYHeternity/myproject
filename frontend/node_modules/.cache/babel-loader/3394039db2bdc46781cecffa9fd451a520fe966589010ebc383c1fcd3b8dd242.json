{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { postAPI } from '@/api/community';\nexport default {\n  name: 'PostCreate',\n  data: function data() {\n    return {\n      isEdit: false,\n      postId: null,\n      postForm: {\n        type: 'article',\n        title: '',\n        category: '',\n        tags: '',\n        content: ''\n      },\n      rules: {\n        title: [{\n          required: true,\n          message: '请输入标题',\n          trigger: 'blur'\n        }, {\n          min: 2,\n          max: 100,\n          message: '标题长度在 2 到 100 个字符',\n          trigger: 'blur'\n        }],\n        category: [{\n          required: true,\n          message: '请选择分类',\n          trigger: 'change'\n        }],\n        content: [{\n          required: true,\n          message: '请输入内容',\n          trigger: 'blur'\n        }, {\n          min: 10,\n          message: '内容长度至少 10 个字符',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  mounted: function mounted() {\n    // 检查是否是编辑模式\n    var id = this.$route.params.id;\n    if (id) {\n      this.isEdit = true;\n      this.postId = id;\n      this.loadPostDetail();\n    }\n  },\n  methods: {\n    loadPostDetail: function loadPostDetail() {\n      var _this = this;\n      postAPI.getPostDetail(this.postId).then(function (res) {\n        _this.postForm = res;\n      });\n    },\n    submitForm: function submitForm() {\n      var _this2 = this;\n      this.$refs.postForm.validate(function (valid) {\n        if (valid) {\n          if (_this2.isEdit) {\n            // 编辑帖子\n            postAPI.updatePost(_this2.postId, _this2.postForm).then(function (res) {\n              _this2.$message.success('更新成功');\n              _this2.$router.push(\"/community/post/\".concat(_this2.postId));\n            });\n          } else {\n            // 发布帖子\n            postAPI.createPost(_this2.postForm).then(function (res) {\n              _this2.$message.success('发布成功');\n              _this2.$router.push('/community');\n            });\n          }\n        } else {\n          return false;\n        }\n      });\n    },\n    resetForm: function resetForm() {\n      this.$refs.postForm.resetFields();\n    },\n    navigateBack: function navigateBack() {\n      this.$router.back();\n    }\n  }\n};","map":{"version":3,"names":["postAPI","name","data","isEdit","postId","postForm","type","title","category","tags","content","rules","required","message","trigger","min","max","mounted","id","$route","params","loadPostDetail","methods","_this","getPostDetail","then","res","submitForm","_this2","$refs","validate","valid","updatePost","$message","success","$router","push","concat","createPost","resetForm","resetFields","navigateBack","back"],"sources":["src/views/community/PostCreate.vue"],"sourcesContent":["<template>\r\n  <div class=\"post-create\">\r\n    <div class=\"container\">\r\n      <el-card>\r\n        <div slot=\"header\" class=\"card-header\">\r\n          <h2>{{ isEdit ? '编辑帖子' : '发布帖子' }}</h2>\r\n        </div>\r\n        \r\n        <el-form :model=\"postForm\" :rules=\"rules\" ref=\"postForm\" label-width=\"80px\">\r\n          <el-form-item label=\"帖子类型\" prop=\"type\">\r\n            <el-radio-group v-model=\"postForm.type\">\r\n              <el-radio label=\"article\">文章</el-radio>\r\n              <el-radio label=\"question\">问题</el-radio>\r\n            </el-radio-group>\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"标题\" prop=\"title\">\r\n            <el-input v-model=\"postForm.title\" placeholder=\"请输入标题\"></el-input>\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"分类\" prop=\"category\">\r\n            <el-select v-model=\"postForm.category\" placeholder=\"选择分类\">\r\n              <el-option label=\"创业经验\" value=\"创业经验\"></el-option>\r\n              <el-option label=\"融资技巧\" value=\"融资技巧\"></el-option>\r\n              <el-option label=\"技术分享\" value=\"技术分享\"></el-option>\r\n              <el-option label=\"行业动态\" value=\"行业动态\"></el-option>\r\n            </el-select>\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"标签\" prop=\"tags\">\r\n            <el-input v-model=\"postForm.tags\" placeholder=\"请输入标签，用逗号分隔\"></el-input>\r\n          </el-form-item>\r\n          \r\n          <el-form-item label=\"内容\" prop=\"content\">\r\n            <el-input\r\n              type=\"textarea\"\r\n              v-model=\"postForm.content\"\r\n              placeholder=\"请输入内容\"\r\n              :rows=\"10\"\r\n            ></el-input>\r\n          </el-form-item>\r\n          \r\n          <el-form-item>\r\n            <el-button type=\"primary\" @click=\"submitForm\">提交</el-button>\r\n            <el-button @click=\"resetForm\">重置</el-button>\r\n            <el-button @click=\"navigateBack\">取消</el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </el-card>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { postAPI } from '@/api/community'\r\n\r\nexport default {\r\n  name: 'PostCreate',\r\n  data() {\r\n    return {\r\n      isEdit: false,\r\n      postId: null,\r\n      postForm: {\r\n        type: 'article',\r\n        title: '',\r\n        category: '',\r\n        tags: '',\r\n        content: ''\r\n      },\r\n      rules: {\r\n        title: [\r\n          { required: true, message: '请输入标题', trigger: 'blur' },\r\n          { min: 2, max: 100, message: '标题长度在 2 到 100 个字符', trigger: 'blur' }\r\n        ],\r\n        category: [\r\n          { required: true, message: '请选择分类', trigger: 'change' }\r\n        ],\r\n        content: [\r\n          { required: true, message: '请输入内容', trigger: 'blur' },\r\n          { min: 10, message: '内容长度至少 10 个字符', trigger: 'blur' }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  mounted() {\r\n    // 检查是否是编辑模式\r\n    const id = this.$route.params.id\r\n    if (id) {\r\n      this.isEdit = true\r\n      this.postId = id\r\n      this.loadPostDetail()\r\n    }\r\n  },\r\n  methods: {\r\n    loadPostDetail() {\r\n      postAPI.getPostDetail(this.postId).then(res => {\r\n        this.postForm = res\r\n      })\r\n    },\r\n    submitForm() {\r\n      this.$refs.postForm.validate((valid) => {\r\n        if (valid) {\r\n          if (this.isEdit) {\r\n            // 编辑帖子\r\n            postAPI.updatePost(this.postId, this.postForm).then(res => {\r\n              this.$message.success('更新成功')\r\n              this.$router.push(`/community/post/${this.postId}`)\r\n            })\r\n          } else {\r\n            // 发布帖子\r\n            postAPI.createPost(this.postForm).then(res => {\r\n              this.$message.success('发布成功')\r\n              this.$router.push('/community')\r\n            })\r\n          }\r\n        } else {\r\n          return false\r\n        }\r\n      })\r\n    },\r\n    resetForm() {\r\n      this.$refs.postForm.resetFields()\r\n    },\r\n    navigateBack() {\r\n      this.$router.back()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.post-create {\r\n  padding: 20px 0;\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.card-header h2 {\r\n  font-size: 20px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  margin: 0;\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsDA,SAAAA,OAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,MAAA;MACAC,MAAA;MACAC,QAAA;QACAC,IAAA;QACAC,KAAA;QACAC,QAAA;QACAC,IAAA;QACAC,OAAA;MACA;MACAC,KAAA;QACAJ,KAAA,GACA;UAAAK,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAC,GAAA;UAAAC,GAAA;UAAAH,OAAA;UAAAC,OAAA;QAAA,EACA;QACAN,QAAA,GACA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAJ,OAAA,GACA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAC,GAAA;UAAAF,O