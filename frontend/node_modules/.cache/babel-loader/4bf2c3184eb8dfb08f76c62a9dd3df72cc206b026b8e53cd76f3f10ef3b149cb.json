}}万</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-s-finance meta-icon\"></i>\n                <span class=\"meta-label\">出让股权</span>\n                <span class=\"meta-value\">{{ project.equityOffered }}%</span>\n              </div>\n            </div>\n            <div class=\"project-stats\">\n              <div class=\"stat-item\">\n                <i class=\"el-icon-view\"></i>\n                <span>{{ project.viewCount }}</span>\n                <span class=\"stat-label\">浏览</span>\n              </div>\n              <div class=\"stat-item\">\n                <i class=\"el-icon-thumb\"></i>\n                <span>{{ project.likeCount }}</span>\n                <span class=\"stat-label\">点赞</span>\n              </div>\n              <div class=\"stat-item\">\n                <i class=\"el-icon-time\"></i>\n                <span>{{ formatDate(project.createdAt) }}</span>\n                <span class=\"stat-label\">发布</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"header-right\">\n            <div class=\"action-buttons\">\n              <el-button \n                type=\"primary\" \n                size=\"large\" \n                @click=\"toggleFavorite\"\n                :class=\"{ 'favorited': favorited }\"\n              >\n                <i :class=\"favorited ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n                {{ favorited ? '已收藏' : '收藏项目' }}\n              </el-button>\n              <el-button \n                v-if=\"isInvestor\" \n                type=\"success\" \n                size=\"large\" \n                @click=\"showIntent = true\"\n              >\n                <i class=\"el-icon-s-flag\"></i>\n                提交投资意向\n              </el-button>\n              <el-button \n                type=\"info\" \n                size=\"large\" \n                @click=\"showContact = true\"\n              >\n                <i class=\"el-icon-phone\"></i>\n                联系创始人\n              </el-button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 项目详情内容 -->\n      <div class=\"project-content\">\n        <div class=\"content-left\">\n          <!-- 项目介绍 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-document\"></i>\n                <h3 class=\"card-title\">项目介绍</h3>\n              </div>\n            </template>\n            <div class=\"project-description\" v-html=\"project.description\" />\n          </el-card>\n\n          <!-- 市场分析 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-data-analysis\"></i>\n                <h3 class=\"card-title\">市场分析</h3>\n              </div>\n            </template>\n            <div class=\"market-analysis\">\n              <div class=\"analysis-item\">\n                <h4>市场规模</h4>\n                <p>{{ project.marketSize || '该项目尚未提供市场规模分析' }}</p>\n              </div>\n              <div class=\"analysis-item\">\n                <h4>目标用户</h4>\n                <p>{{ project.targetUsers || '该项目尚未提供目标用户分析' }}</p>\n              </div>\n              <div class=\"analysis-item\">\n                <h4>竞争优势</h4>\n                <p>{{ project.competitiveAdvantage || '该项目尚未提供竞争优势分析' }}</p>\n              </div>\n            </div>\n          </el-card>\n\n          <!-- 项目进展 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-flag\"></i>\n                <h3 class=\"card-title\">项目进展</h3>\n              </div>\n            </template>\n            <div class=\"project-milestones\">\n              <div \n                v-for=\"(milestone, index) in project.milestones || mockMilestones\" \n                :key=\"index\"\n                class=\"milestone-item\"\n              >\n                <div class=\"milestone-dot\"></div>\n                <div class=\"milestone-content\">\n                  <h4 class=\"milestone-title\">{{ milestone.title }}</h4>\n                  <p class=\"milestone-description\">{{ milestone.description }}</p>\n                  <span class=\"milestone-date\">{{ milestone.date }}</span>\n                </div>\n              </div>\n            </div>\n          </el-card>\n        </div>\n\n        <div class=\"content-right\">\n          <!-- 创始人信息 -->\n          <el-card class=\"content-card founder-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-user\"></i>\n                <h3 class=\"card-title\">创始人信息</h3>\n              </div>\n            </template>\n            <div class=\"founder-info\">\n              <div class=\"founder-avatar\">\n                {{ (project.founderName || '创').charAt(0) }}\n              </div>\n              <div class=\"founder-details\">\n                <h4 class=\"founder-name\">{{ project.founderName || '创始人' }}</h4>\n                <p class=\"founder-title\">{{ project.founderTitle || 'CEO' }}</p>\n                <p class=\"founder-bio\">{{ project.founderBio || '拥有丰富的行业经验和创业经历' }}</p>\n                <div class=\"founder-contact\">\n                  <div class=\"contact-item\">\n                    <i class=\"el-icon-phone\"></i>\n                    <span>{{ project.founderPhone || '*******1234' }}</span>\n                  </div>\n                  <div class=\"contact-item\">\n                    <i class=\"el-icon-message\"></i>\n                    <span>{{ project.founderEmail || 'founder@example.com' }}</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </el-card>\n\n          <!-- 团队介绍 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-flag\"></i>\n                <h3 class=\"card-title\">团队介绍</h3>\n              </div>\n            </template>\n            <div class=\"team-members\">\n              <div \n                v-for=\"(member, index) in project.teamMembers || mockTeamMembers\" \n                :key=\"index\"\n                class=\"team-member\"\n              >\n                <div class=\"member-avatar\">\n                  {{ member.name.charAt(0) }}\n                </div>\n                <div class=\"member-info\">\n                  <h5 class=\"member-name\">{{ member.name }}</h5>\n                  <p class=\"member-role\">{{ member.role }}</p>\n                </div>\n              </div>\n            </div>\n          </el-card>\n\n          <!-- 相关项目推荐 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-grid\"></i>\n                <h3 class=\"card-title\">相关项目</h3>\n              </div>\n            </template>\n            <div class=\"related-projects\">\n              <div \n                v-for=\"(item, index) in relatedProjects\" \n                :key=\"index\"\n                class=\"related-item\"\n                @click=\"goToProject(item.id)\"\n              >\n                <h5 class=\"related-title\">{{ item.title }}</h5>\n                <p class=\"related-info\">{{ item.industry }} | {{ item.stage }} | {{ item.fundingNeeded }}万</p>\n              </div>\n            </div>\n          </el-card>\n        </div>\n      </div>\n\n      <!-- 提交投资意向对话框 -->\n      <el-dialog \n        title=\"提交投资意向\" \n        :visible.sync=\"showIntent\" \n        width=\"600px\"\n        custom-class=\"intent-dialog\"\n      >\n        <el-form ref=\"intentForm\" :model=\"intentForm\" :rules=\"intentRules\" label-width=\"120px\">\n          <el-form-item label=\"投资金额(万)\" prop=\"amount\">\n            <el-input-number \n              v-model=\"intentForm.amount\" \n              :min=\"0\" \n              :step=\"10\" \n              style=\"width: 100%\"\n            />\n          </el-form-item>\n          <el-form-item label=\"投资期限\" prop=\"duration\">\n            <el-input \n              v-model=\"intentForm.duration\" \n              placeholder=\"如 3年\" \n              style=\"width: 100%\"\n            />\n          </el-form-item>\n          <el-form-item label=\"投资条件/说明\" prop=\"description\">\n            <el-input \n              v-model=\"intentForm.description\" \n              type=\"textarea\" \n              rows=\"4\" \n              placeholder=\"请详细描述您的投资条件和要求\"\n            />\n          </el-form-item>\n          <el-form-item label=\"联系方式\" prop=\"contactInfo\">\n            <el-input \n              v-model=\"intentForm.contactInfo\" \n              placeholder=\"请留下您的联系方式\"\n            />\n          </el-form-item>\n        </el-form>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"showIntent = false\">取消</el-button>\n          <el-button type=\"primary\" @click=\"submitIntent\">提交意向</el-button>\n        </span>\n      </el-dialog>\n\n      <!-- 联系创始人对话框 -->\n      <el-dialog \n        title=\"联系创始人\" \n        :visible.sync=\"showContact\" \n        width=\"500px\"\n        custom-class=\"contact-dialog\"\n      >\n        <div class=\"contact-info\">\n          <div class=\"contact-item\">\n            <i class=\"el-icon-phone\"></i>\n            <span class=\"contact-label\">电话：</span>\n            <span class=\"contact-value\">{{ project.founderPhone || '*******1234' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-message\"></i>\n            <span class=\"contact-label\">邮箱：</span>\n            <span class=\"contact-value\">{{ project.founderEmail || 'founder@example.com' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-chat-dot-round\"></i>\n            <span class=\"contact-label\">微信：</span>\n            <span class=\"contact-value\">{{ project.founderWechat || 'founder_wx' }}</span>\n          </div>\n        </div>\n        <div class=\"contact-note\">\n          <i class=\"el-icon-warning-outline\"></i>\n          <p>请在工作时间联系创始人，保持专业礼貌的沟通方式</p>\n        </div>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button type=\"primary\" @click=\"showContact = false\">我知道了</el-button>\n        </span>\n      </el-dialog>\n    </template>\n  </div>\n</template>\n\n<script>\nimport { getDetail, toggleFavorite, isFavorited } from '@/api/project'\nimport { submit } from '@/api/investment'\nimport { mapGetters } from 'vuex'\nexport default {\n  name: 'ProjectDetail',\n  data() {\n    return {\n      loading: false,\n      project: null,\n      favorited: false,\n      showIntent: false,\n      intentForm: { amount: 0, duration: '', description: '' },\n      intentRules: { amount: [{ required: true, message: '请输入金额', trigger: 'blur' }] }\n    }\n  },\n  computed: {\n    ...mapGetters('user', ['isInvestor'])\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    async load() {\n      this.loading = true\n      try {\n        const id = this.$route.params.id\n        this.project = await getDetail(id)\n        try {\n          this.favorited = await isFavorited(id)\n        } catch (_) {}\n      } finally {\n        this.loading = false\n      }\n    },\n    async toggleFavorite() {\n      await toggleFavorite(this.project.id)\n      this.favorited = !this.favorited\n      this.project.likeCount += this.favorited ? 1 : -1\n      this.$message.success(this.favorited ? '已收藏' : '已取消')\n    },\n    submitIntent() {\n      this.$refs.intentForm.validate(async valid => {\n        if (!valid) return\n        try {\n          await submit({ projectId: this.project.id, amount: this.intentForm.amount, duration: this.intentForm.duration, description: this.intentForm.description })\n          this.$message.success('已提交')\n          this.showIntent = false\n        } catch (e) {\n          this.$message.error(e.response?.data?.message || '提交失败')\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.content { margin-top: 16px; line-height: 1.6; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoTA,SAAAA,SAAA,EAAAC,cAAA,IAAAA,eAAA,EAAAC,WAAA;AACA,SAAAC,MAAA;AACA,SAAAC,UAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,OAAA;MACAC,SAAA;MACAC,UAAA;MACAC,UAAA;QAAAC,MAAA;QAAAC,QAAA;QAAAC,WAAA;MAAA;MACAC,WAAA;QAAAH,MAAA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAAA;IACA;EACA;EACAC,QAAA,EAAAC,aAAA,KACAhB,UAAA,yBACA;EACAiB,OAAA,WAAAA,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAD,IAAA,WAAAA,KAAA;MAAA,IAAAE,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,EAAA,EAAAC,EAAA;QAAA,OAAAJ,YAAA,GAAAK,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAV,KAAA,CAAAjB,OAAA;cAAAyB,QAAA,CAAAC,CAAA;cAEAJ,EAAA,GAAAL,KAAA,CAAAW,MAAA,CAAAC,MAAA,CAAAP,EAAA;cAAAG,QAAA,CAAAE,CAAA;cAAA,OACAlC,SAAA,CAAA6B,EAAA;YAAA;cAAAL,KAAA,CAAAhB,OAAA,GAAAwB,QAAA,CAAAK,CAAA;cAAAL,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEAhC,WAAA,CAAA2B,EAAA;YAAA;cAAAL,KAAA,CAAAf,SAAA,GAAAuB,QAAA,CAAAK,CAAA;cAAAL,QAAA,CAAAE,CAAA;cAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAH,EAAA,GAAAE,QAAA,CAAAK,CAAA;YAAA;cAAAL,QAAA,CAAAC,CAAA;cAGAT,KAAA,CAAAjB,OAAA;cAAA,OAAAyB,QAAA,CAAAM,CAAA;YAAA;cAAA,OAAAN,QAAA,CAAAO,CAAA;UAAA;QAAA,GAAAX,OAAA;MAAA;IAEA;IACA3B,cAAA,WAAAA,eAAA;MAAA,IAAAuC,MAAA;MAAA,OAAAf,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAc,SAAA;QAAA,OAAAf,YAAA