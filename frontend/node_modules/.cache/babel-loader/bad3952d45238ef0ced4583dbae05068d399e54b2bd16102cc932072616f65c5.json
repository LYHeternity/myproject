{"ast":null,"code":"import _objectSpread from \"C:/Users/Administrator/Desktop/lunwen/frontend/node_modules/@babel/runtime/helpers/esm/objectSpread2.js\";\nimport \"core-js/modules/es.array.push.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { mapState, mapGetters, mapActions } from 'vuex';\nexport default {\n  name: 'Layout',\n  data: function data() {\n    return {\n      headerSolid: false,\n      showDashboardBadge: true,\n      pendingAudits: 5\n    };\n  },\n  computed: _objectSpread(_objectSpread(_objectSpread({}, mapState('user', ['username', 'realName'])), mapState('message', ['unreadCount'])), {}, {\n    user: function user() {\n      return {\n        username: this.username,\n        realName: this.realName\n      };\n    }\n  }, mapGetters('user', ['isAdmin', 'isEntrepreneur', 'isInvestor', 'isProvider'])),\n  methods: _objectSpread(_objectSpread(_objectSpread({}, mapActions('message', ['fetchUnreadCount'])), {}, {\n    onScroll: function onScroll() {\n      this.headerSolid = window.scrollY > 48;\n    }\n  }, mapActions('user', ['logout'])), {}, {\n    handleCommand: function handleCommand(cmd) {\n      if (cmd === 'workspace') {\n        // 根据用户角色跳转到相应的工作台\n        if (this.isEntrepreneur) {\n          this.$router.push('/entrepreneur');\n        } else if (this.isInvestor) {\n          this.$router.push('/investor');\n        } else if (this.isProvider) {\n          this.$router.push('/provider');\n        } else {\n          this.$router.push('/home');\n        }\n      } else if (cmd === 'myProjects') {\n        this.$router.push('/my-projects');\n      } else if (cmd === 'myOrders') {\n        this.$router.push('/my-orders');\n      } else if (cmd === 'profile') {\n        this.$router.push('/profile');\n      } else if (cmd === 'logout') {\n        this.logout();\n        this.$router.push('/login');\n      }\n    }\n  }),\n  mounted: function mounted() {\n    window.addEventListener('scroll', this.onScroll, {\n      passive: true\n    });\n    this.onScroll();\n    this.fetchUnreadCount();\n  },\n  beforeDestroy: function beforeDestroy() {\n    window.removeEventListener('scroll', this.onScroll);\n  }\n};","map":{"version":3,"names":["mapState","mapGetters","mapActions","name","data","headerSolid","showDashboardBadge","pendingAudits","computed","_objectSpread","user","username","realName","methods","onScroll","window","scrollY","handleCommand","cmd","isEntrepreneur","$router","push","isInvestor","isProvider","logout","mounted","addEventListener","passive","fetchUnreadCount","beforeDestroy","removeEventListener"],"sources":["src/views/Layout.vue"],"sourcesContent":["<template>\n  <el-container class=\"app-layout\">\n    <!-- 管理员：左侧边栏 -->\n    <el-aside v-if=\"isAdmin\" class=\"admin-sidebar\" width=\"260px\">\n      <div class=\"sidebar-header\">\n        <div class=\"sidebar-logo\">\n          <i class=\"el-icon-s-platform logo-icon\"></i>\n          <span class=\"logo-text\">管理后台</span>\n        </div>\n        <div class=\"sidebar-version\">v1.0.0</div>\n      </div>\n      <el-menu\n        :default-active=\"$route.path\"\n        class=\"admin-menu\"\n        background-color=\"transparent\"\n        text-color=\"#94a3b8\"\n        active-text-color=\"#fff\"\n        router\n        :collapse-transition=\"false\"\n      >\n        <el-menu-item index=\"/admin\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-s-home menu-icon\"></i>\n            <span class=\"menu-text\">工作台</span>\n            <div class=\"menu-badge\" v-if=\"showDashboardBadge\">\n              <span class=\"badge-dot\"></span>\n            </div>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-users\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-user menu-icon\"></i>\n            <span class=\"menu-text\">用户管理</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-roles\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-s-custom menu-icon\"></i>\n            <span class=\"menu-text\">角色权限</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-audit\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-document-checked menu-icon\"></i>\n            <span class=\"menu-text\">内容审核</span>\n            <div class=\"menu-badge\" v-if=\"pendingAudits > 0\">\n              <span class=\"badge-count\">{{ pendingAudits }}</span>\n            </div>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-stats\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-data-analysis menu-icon\"></i>\n            <span class=\"menu-text\">数据统计</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-config\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-setting menu-icon\"></i>\n            <span class=\"menu-text\">系统设置</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-log\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-document menu-icon\"></i>\n            <span class=\"menu-text\">操作日志</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-backup\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-folder-opened menu-icon\"></i>\n            <span class=\"menu-text\">数据备份</span>\n          </div>\n        </el-menu-item>\n      </el-menu>\n      <div class=\"sidebar-footer\">\n        <div class=\"user-info\">\n          <div class=\"user-avatar\">\n            {{ (user.realName || user.username || 'A').charAt(0) }}\n          </div>\n          <div class=\"user-details\">\n            <div class=\"user-name\">{{ user.realName || user.username }}</div>\n            <div class=\"user-role\">管理员</div>\n          </div>\n        </div>\n        <div class=\"logout-btn\" @click=\"handleCommand('logout')\">\n          <i class=\"el-icon-switch-button\"></i>\n          <span>退出登录</span>\n        </div>\n      </div>\n    </el-aside>\n\n    <el-container direction=\"vertical\" class=\"main-wrap\">\n      <!-- 顶栏：吸顶 + 透明→实色 + 下拉动效 -->\n      <header class=\"home-header\">\n        <div class=\"header-container\">\n          <div class=\"header-content\">\n            <div class=\"logo\">\n              <router-link to=\"/home\" class=\"logo-text\" exact-active-class=\"nav-brand-active\">创业者平台</router-link>\n            </div>\n            <nav class=\"nav-menu\" v-if=\"!isAdmin\">\n              <router-link to=\"/home\" class=\"nav-item\" exact active-class=\"nav-item-active\">\n                <i class=\"el-icon-s-home\"></i> 首页\n              </router-link>\n              <router-link to=\"/projects\" class=\"nav-item\" active-class=\"nav-item-active\">\n                <i class=\"el-icon-document\"></i> 项目大厅\n              </router-link>\n              <router-link to=\"/services\" class=\"nav-item\" active-class=\"nav-item-active\">\n                <i class=\"el-icon-goods\"></i> 服务市场\n              </router-link>\n              <router-link to=\"/project-publish\" class=\"nav-item\" active-class=\"nav-item-active\">\n                <i class=\"el-icon-edit-outline\"></i> 发布项目\n              </router-link>\n              <router-link to=\"/messages\" class=\"nav-item\" active-class=\"nav-item-active\">\n                <i class=\"el-icon-message\"></i> 消息中心\n                <span class=\"message-badge\" v-if=\"unreadCount > 0\">{{ unreadCount }}</span>\n              </router-link>\n            </nav>\n            <div class=\"header-actions\">\n              <div class=\"user-wrap\">\n                <div class=\"user-avatar\">\n                  {{ (user.realName || user.username || 'U').charAt(0) }}\n                </div>\n                <el-dropdown trigger=\"click\" @command=\"handleCommand\" class=\"user-dropdown\">\n                  <span class=\"user-info\">\n                    <span class=\"user-name\">{{ user.realName || user.username }}</span>\n                    <i class=\"el-icon-arrow-down el-icon--right\"></i>\n                  </span>\n                  <el-dropdown-menu slot=\"dropdown\" class=\"header-dropdown\">\n                    <el-dropdown-item command=\"workspace\">\n                      <i class=\"el-icon-s-home\"></i> 工作台\n                    </el-dropdown-item>\n                    <el-dropdown-item command=\"myProjects\">\n                      <i class=\"el-icon-s-order\"></i> 我的项目\n                    </el-dropdown-item>\n                    <el-dropdown-item command=\"myOrders\">\n                      <i class=\"el-icon-s-finance\"></i> 我的订单\n                    </el-dropdown-item>\n                    <el-dropdown-item command=\"profile\">\n                      <i class=\"el-icon-user\"></i> 个人中心\n                    </el-dropdown-item>\n                    <el-dropdown-item command=\"logout\" divided>\n                      <i class=\"el-icon-switch-button\"></i> 退出登录\n                    </el-dropdown-item>\n                  </el-dropdown-menu>\n                </el-dropdown>\n              </div>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      <el-main class=\"main-content\">\n        <router-view />\n      </el-main>\n    </el-container>\n  </el-container>\n</template>\n\n<script>\nimport { mapState, mapGetters, mapActions } from 'vuex'\nexport default {\n  name: 'Layout',\n  data() {\n    return {\n      headerSolid: false,\n      showDashboardBadge: true,\n      pendingAudits: 5\n    }\n  },\n  computed: {\n    ...mapState('user', ['username', 'realName']),\n    ...mapState('message', ['unreadCount']),\n    user() {\n      return { username: this.username, realName: this.realName }\n    },\n    ...mapGetters('user', ['isAdmin', 'isEntrepreneur', 'isInvestor', 'isProvider'])\n  },\n  methods: {\n    ...mapActions('message', ['fetchUnreadCount']),\n    onScroll() {\n      this.headerSolid = window.scrollY > 48\n    },\n    ...mapActions('user', ['logout']),\n    handleCommand(cmd) {\n      if (cmd === 'workspace') {\n        // 根据用户角色跳转到相应的工作台\n        if (this.isEntrepreneur) {\n          this.$router.push('/entrepreneur')\n        } else if (this.isInvestor) {\n          this.$router.push('/investor')\n        } else if (this.isProvider) {\n          this.$router.push('/provider')\n        } else {\n          this.$router.push('/home')\n        }\n      } else if (cmd === 'myProjects') {\n        this.$router.push('/my-projects')\n      } else if (cmd === 'myOrders') {\n        this.$router.push('/my-orders')\n      } else if (cmd === 'profile') {\n        this.$router.push('/profile')\n      } else if (cmd === 'logout') {\n        this.logout()\n        this.$router.push('/login')\n      }\n    }\n  },\n  mounted() {\n    window.addEventListener('scroll', this.onScroll, { passive: true })\n    this.onScroll()\n    this.fetchUnreadCount()\n  },\n  beforeDestroy() {\n    window.removeEventListener('scroll', this.onScroll)\n  }\n}\n</script>\n\n<style scoped>\n.app-layout { min-height: 100vh; }\n.admin-sidebar {\n  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);\n  box-shadow: 4px 0 24px rgba(0,0,0,.12);\n  display: flex;\n  flex-direction: column;\n}\n.sidebar-header {\n  padding: 20px 0;\n  border-bottom: 1px solid rgba(255,255,255,.06);\n  text-align: center;\n}\n.sidebar-logo {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  margin-bottom: 8px;\n}\n.logo-icon { \n  font-size: 28px; \n  color: #3b82f6;\n  animation: logoPulse 2s ease-in-out infinite;\n}\n.logo-text {\n  font-size: 19px;\n  font-weight: 700;\n  color: #f1f5f9;\n  letter-spacing: 0.5px;\n}\n.sidebar-version {\n  font-size: 12px;\n  color: #64748b;\n  font-weight: 500;\n}\n.admin-menu {\n  border-right: none;\n  padding: 20px 0;\n  flex: 1;\n}\n.admin-menu .menu-item {\n  margin: 6px 16px;\n  border-radius: 12px;\n  height: 56px;\n  line-height: 56px;\n  transition: all .3s ease;\n  overflow: hidden;\n}\n.admin-menu .menu-item:hover {\n  background: rgba(255,255,255,.08) !important;\n  color: #e2e8f0;\n  transform: translateX(4px);\n}\n.admin-menu .menu-item.is-active {\n  background: linear-gradient(90deg, rgba(59,130,246,.25) 0%, rgba(59,130,246,.1) 100%) !important;\n  color: #fff;\n  border-left: 3px solid #3b82f6;\n}\n.menu-item-content {\n  display: flex;\n  align-items: center;\n  padding: 0 20px;\n  height: 100%;\n}\n.menu-icon {\n  font-size: 20px;\n  margin-right: 14px;\n  width: 24px;\n  text-align: center;\n}\n.menu-text {\n  flex: 1;\n  font-size: 15px;\n  font-weight: 500;\n}\n.menu-badge {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.badge-dot {\n  width: 8px;\n  height: 8px;\n  background: #ef4444;\n  border-radius: 50%;\n  animation: badgePulse 2s ease-in-out infinite;\n}\n.badge-count {\n  background: #3b82f6;\n  color: white;\n  font-size: 12px;\n  font-weight: 600;\n  padding: 2px 8px;\n  border-radius: 10px;\n  min-width: 20px;\n  text-align: center;\n}\n.sidebar-footer {\n  padding: 20px 16px;\n  border-top: 1px solid rgba(255,255,255,.06);\n  background: rgba(15, 23, 42, 0.8);\n}\n.user-info {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-bottom: 20px;\n  padding: 12px;\n  border-radius: 12px;\n  background: rgba(255,255,255,.04);\n  transition: all .3s ease;\n}\n.user-info:hover {\n  background: rgba(255,255,255,.08);\n  transform: translateY(-2px);\n}\n.user-info .user-avatar {\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\n  color: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 16px;\n  flex-shrink: 0;\n}\n.user-details {\n  flex: 1;\n  min-width: 0;\n}\n.user-name {\n  font-size: 15px;\n  font-weight: 600;\n  color: #f1f5f9;\n  margin-bottom: 4px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.user-role {\n  font-size: 13px;\n  color: #94a3b8;\n  font-weight: 500;\n}\n.logout-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 14px;\n  border-radius: 12px;\n  background: rgba(239, 68, 68, 0.1);\n  color: #fca5a5;\n  cursor: pointer;\n  transition: all .3s ease;\n  font-size: 14px;\n  font-weight: 500;\n}\n.logout-btn:hover {\n  background: rgba(239, 68, 68, 0.2);\n  color: #ef4444;\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);\n}\n.logout-btn i {\n  font-size: 16px;\n}\n\n/* 动画效果 */\n@keyframes logoPulse {\n  0%, 100% { transform: scale(1); opacity: 1; }\n  50% { transform: scale(1.05); opacity: 0.9; }\n}\n\n@keyframes badgePulse {\n  0%, 100% { transform: scale(1); opacity: 1; }\n  50% { transform: scale(1.2); opacity: 0.7; }\n}\n\n/* 响应式设计 */\n@media (max-width: 1024px) {\n  .admin-sidebar {\n    width: 220px !important;\n  }\n  \n  .logo-text {\n    font-size: 17px;\n  }\n  \n  .menu-text {\n    font-size: 14px;\n  }\n  \n  .user-name {\n    font-size: 14px;\n  }\n}\n\n@media (max-width: 768px) {\n  .admin-sidebar {\n    position: fixed;\n    left: -260px;\n    top: 0;\n    bottom: 0;\n    z-index: 1001;\n    transition: left .3s ease;\n  }\n  \n  .admin-sidebar.open {\n    left: 0;\n  }\n  \n  .main-content {\n    padding: 16px;\n  }\n}\n\n.main-wrap { flex: 1; min-width: 0; }\n.home-header {\n  position: sticky;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 1000;\n  background: rgba(255, 255, 255, 0.95);\n  backdrop-filter: blur(10px);\n  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);\n  transition: all 0.3s ease;\n}\n\n.header-container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 24px;\n}\n\n.header-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 64px;\n}\n\n.logo {\n  flex-shrink: 0;\n}\n\n.logo-text {\n  font-size: 20px;\n  font-weight: 600;\n  color: var(--hw-primary);\n  letter-spacing: 0.5px;\n  text-decoration: none;\n  padding: 8px 16px;\n  border-radius: var(--hw-radius);\n  transition: all var(--hw-duration);\n}\n\n.logo-text:hover {\n  color: var(--hw-primary-hover);\n  background: var(--hw-primary-light);\n}\n\n.nav-menu {\n  display: flex;\n  align-items: center;\n  gap: 32px;\n}\n\n.nav-item {\n  font-size: 15px;\n  font-weight: 500;\n  color: var(--hw-text);\n  text-decoration: none;\n  padding: 8px 16px;\n  border-radius: var(--hw-radius);\n  transition: all var(--hw-duration);\n  position: relative;\n}\n\n.nav-item:hover {\n  color: var(--hw-primary);\n  background: var(--hw-primary-light);\n}\n\n.nav-item-active {\n  color: var(--hw-primary);\n  background: var(--hw-primary-light);\n}\n\n.nav-item i {\n  margin-right: 6px;\n  font-size: 14px;\n}\n\n.message-badge {\n  position: absolute;\n  top: -4px;\n  right: -4px;\n  min-width: 18px;\n  height: 18px;\n  padding: 0 6px;\n  background: #ff4d4f;\n  color: white;\n  font-size: 12px;\n  font-weight: 600;\n  border-radius: 9px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  line-height: 1;\n  box-shadow: 0 2px 8px rgba(255, 77, 79, 0.4);\n}\n\n.nav-item {\n  position: relative;\n}\n\n/* 桌面端下拉菜单 */\n.user-dropdown.nav-item {\n  cursor: pointer;\n}\n\n.user-dropdown.nav-item .user-info {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 16px;\n  border-radius: var(--hw-radius);\n  transition: all 0.3s ease;\n}\n\n.user-dropdown.nav-item:hover .user-info {\n  background: var(--hw-primary-light);\n  color: var(--hw-primary);\n}\n\n.user-dropdown.nav-item .user-info .el-icon--right {\n  font-size: 12px;\n  transition: transform 0.3s ease;\n}\n\n.user-dropdown.nav-item:hover .user-info .el-icon--right {\n  transform: rotate(180deg);\n}\n\n.header-dropdown .dropdown-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 16px;\n  border-radius: var(--hw-radius);\n  transition: all 0.2s ease;\n  color: var(--hw-text);\n  text-decoration: none;\n  white-space: nowrap;\n}\n\n.header-dropdown .dropdown-item:hover {\n  background: var(--hw-primary-light);\n  color: var(--hw-primary);\n}\n\n.header-dropdown .dropdown-item i {\n  font-size: 14px;\n  margin-right: 4px;\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  flex-shrink: 0;\n}\n\n.user-wrap {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.user-avatar {\n  width: 36px;\n  height: 36px;\n  border-radius: 10px;\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\n  color: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 14px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.user-avatar:hover {\n  transform: scale(1.05);\n  box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);\n}\n\n.user-dropdown {\n  cursor: pointer;\n}\n\n.user-info {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--hw-text);\n  font-size: 14px;\n  font-weight: 500;\n  padding: 6px 10px;\n  border-radius: 8px;\n  transition: background 0.2s;\n}