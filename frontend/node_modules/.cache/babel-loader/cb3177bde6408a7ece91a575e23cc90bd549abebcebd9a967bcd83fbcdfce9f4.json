ass=\"view-toggle\">\n        <el-radio-group v-model=\"viewMode\" size=\"small\">\n          <el-radio-button label=\"table\">表格</el-radio-button>\n          <el-radio-button label=\"card\">卡片</el-radio-button>\n        </el-radio-group>\n      </div>\n    </div>\n    <el-form inline class=\"query-form\">\n      <el-form-item label=\"行业\">\n        <el-input v-model=\"query.industry\" placeholder=\"行业\" clearable style=\"width:120px\" />\n      </el-form-item>\n      <el-form-item label=\"阶段\">\n        <el-select v-model=\"query.stage\" placeholder=\"阶段\" clearable style=\"width:120px\">\n          <el-option label=\"想法\" value=\"idea\" />\n          <el-option label=\"开发中\" value=\"开发中\" />\n          <el-option label=\"已上线\" value=\"已上线\" />\n        </el-select>\n      </el-form-item>\n      <el-form-item>\n        <el-button type=\"primary\" @click=\"load\">查询</el-button>\n      </el-form-item>\n    </el-form>\n    <template v-if=\"viewMode === 'table'\">\n      <el-table v-loading=\"loading\" :data=\"list\" border stripe class=\"hw-table\">\n        <el-table-column prop=\"title\" label=\"项目名称\" min-width=\"200\" />\n        <el-table-column prop=\"industry\" label=\"行业\" width=\"100\" />\n        <el-table-column prop=\"stage\" label=\"阶段\" width=\"100\" />\n        <el-table-column prop=\"fundingNeeded\" label=\"融资需求(万)\" width=\"120\" />\n        <el-table-column prop=\"likeCount\" label=\"点赞\" width=\"80\" />\n        <el-table-column prop=\"viewCount\" label=\"浏览\" width=\"80\" />\n        <el-table-column label=\"操作\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"$router.push('/project/' + scope.row.id)\">详情</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </template>\n    <template v-else>\n      <div v-loading=\"loading\" class=\"project-waterfall\">\n        <div\n          v-for=\"(item, idx) in displayCards\"\n          :key=\"'card-' + (item.id || idx)\"\n          class=\"project-card hw-clickable\"\n          @click=\"$router.push('/project/' + item.id)\"\n        >\n          <div class=\"project-card-img\">\n            <img :src=\"item.coverImage || cardPlaceholder(idx)\" :alt=\"item.title\" loading=\"lazy\" />\n          </div>\n          <div class=\"project-card-body\">\n            <h4>{{ item.title }}</h4>\n            <div class=\"meta\"><span>{{ item.industry }}</span><span>{{ item.stage }}</span></div>\n            <div class=\"funding\">融资需求 {{ item.fundingNeeded != null ? item.fundingNeeded + ' 万' : '-' }}</div>\n            <el-button type=\"primary\" size=\"small\" class=\"btn-detail\">查看详情</el-button>\n          </div>\n        </div>\n      </div>\n    </template>\n    <div v-if=\"!loading && !list.length\" class=\"data-empty\">\n      <div class=\"empty-icon\"><i class=\"el-icon-document\"></i></div>\n      暂无项目数据\n    </div>\n    <el-pagination\n      v-if=\"page.total > 0\"\n      style=\"margin-top:16px\"\n      :current-page=\"page.current\"\n      :page-size=\"page.size\"\n      :total=\"page.total\"\n      layout=\"total, prev, pager, next\"\n      @current-change=\"onPage\"\n    />\n  </div>\n</template>\n\n<script>\nimport { listPublic } from '@/api/project'\nconst PLACEHOLDERS = [\n  'https://images.unsplash.com/photo-1552664730-d307ca884978?w=400',\n  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=400',\n  'https://images.unsplash.com/photo-1556761175-b413da4baf72?w=400',\n  'https://images.unsplash.com/photo-1551434678-e076c223a692?w=400',\n  'https://images.unsplash.com/photo-1557804506-669a67965ba0?w=400'\n]\nexport default {\n  name: 'ProjectList',\n  data() {\n    return {\n      loading: false,\n      list: [],\n      query: { industry: '', stage: '' },\n      page: { current: 1, size: 10, total: 0 },\n      viewMode: 'table'\n    }\n  },\n  computed: {\n    displayCards() {\n      const arr = [...this.list]\n      while (arr.length < 20 && arr.length > 0) {\n        const src = arr[arr.length % arr.length]\n        arr.push({ ...src, id: 'mock-' + arr.length, title: (src.title || '') + ' (示例)' })\n      }\n      if (this.list.length === 0) return []\n      return arr.length >= 20 ? arr : this.list\n    }\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    cardPlaceholder(i) {\n      return PLACEHOLDERS[i % PLACEHOLDERS.length]\n    },\n    async load() {\n      this.loading = true\n      try {\n        const res = await listPublic({ current: this.page.current, size: this.page.size, ...this.query })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally {\n        this.loading = false\n      }\n    },\n    onPage(p) {\n      this.page.current = p\n      this.load()\n    }\n  }\n}\n</script>\n\n<style scoped>\n.list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\n.list-header h3 { margin-bottom: 0; }\n.view-toggle { flex-shrink: 0; }\n.query-form { margin-bottom: 16px; }\n.project-waterfall {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  gap: 20px;\n}\n.project-card {\n  background: var(--hw-bg-card);\n  border-radius: var(--hw-radius-lg);\n  overflow: hidden;\n  border: 1px solid var(--hw-border);\n  box-shadow: var(--hw-shadow);\n  transition: transform var(--hw-duration) ease, box-shadow var(--hw-duration) ease;\n}\n.project-card:hover { box-shadow: var(--hw-shadow-hover); }\n.project-card-img {\n  height: 140px;\n  overflow: hidden;\n  background: #f1f5f9;\n}\n.project-card-img img { width: 100%; height: 100%; object-fit: cover; }\n.project-card-body { padding: 16px; }\n.project-card-body h4 { font-size: 15px; font-weight: 600; color: var(--hw-text); margin-bottom: 8px; }\n.project-card-body .meta { font-size: 12px; color: var(--hw-text-secondary); margin-bottom: 8px; }\n.project-card-body .meta span { margin-right: 12px; }\n.project-card-body .funding { font-size: 13px; color: var(--hw-primary); margin-bottom: 12px; }\n.project-card-body .btn-detail { width: 100%; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA8EA,SAAAA,UAAA;AACA,IAAAC,YAAA,IACA,mEACA,sEACA,mEACA,mEACA,kEACA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,IAAA;MACAC,KAAA;QAAAC,QAAA;QAAAC,KAAA;MAAA;MACAC,IAAA;QAAAC,OAAA;QAAAC,IAAA;QAAAC,KAAA;MAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACAC,YAAA,WAAAA,aAAA;MACA,IAAAC,GAAA,GAAAC,kBAAA,MAAAZ,IAAA;MACA,OAAAW,GAAA,CAAAE,MAAA,SAAAF,GAAA,CAAAE,MAAA;QACA,IAAAC,GAAA,GAAAH,GAAA,CAAAA,GAAA,CAAAE,MAAA,GAAAF,GAAA,CAAAE,MAAA;QACAF,GAAA,CAAAI,IAAA,CAAAC,aAAA,CAAAA,aAAA,KAAAF,GAAA;UAAAG,EAAA,YAAAN,GAAA,CAAAE,MAAA;UAAAK,KAAA,GAAAJ,GAAA,CAAAI,KAAA;QAAA;MACA;MACA,SAAAlB,IAAA,CAAAa,MAAA;MACA,OAAAF,GAAA,CAAAE,MAAA,SAAAF,GAAA,QAAAX,IAAA;IACA;EACA;EACAmB,OAAA,WAAAA,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAC,eAAA,WAAAA,gBAAAC,CAAA;MACA,OAAA3B,YAAA,CAAA2B,CAAA,GAAA3B,YAAA,CAAAiB,MAAA;IACA;IACAO,IAAA,WAAAA,KAAA;MAAA,IAAAI,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA;QAAA,OAAAH,YAAA,GAAAI,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAT,KAAA,CAAAzB,OAAA;cAAAgC,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEAtC,UAAA,CAAAqB,aAAA;gBAAAX,OAAA,EAAAmB,KAAA,CAAApB,IAAA,CAAAC,OAAA;gBAAAC,IAAA,EAAAkB,KAAA,CAAApB,IAAA,CAAAE;cAAA,GAAAkB,KAAA,CAAAvB,KAAA;YAAA;cAAA4B,GAAA,GAAAE,QAAA,CAAAG,CAAA;cACAV,KAAA,CAAAxB,IAAA,GAAA6B,GAAA,CAAAM,OAAA;cACAX,KAAA,CAAApB,IAAA,CAAAG,KAAA,GAAAsB,GAAA,CAAAtB,KAAA;YAAA;cAAAwB,QAAA,CAAAC,CAAA;cAEAR,KAAA,CAAAzB,OAAA;cAAA,OAAAgC,QAAA,CAAAK,CAAA;YAAA;cAAA,OAAAL,QAAA,CAAAM,CAAA;UAAA;QAAA,GAAAT,OAAA;MAAA;IAEA;IACAU,MAAA,WAAAA,OAAAN,CAAA;MACA,KAAA5B,IAAA,CAAAC,OAAA,GAAA2B,CAAA;MACA,KAAAZ,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}