{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.object.to-string.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { postAPI } from '@/api/community';\nexport default {\n  name: 'CommunityManage',\n  data: function data() {\n    return {\n      posts: [],\n      loading: false,\n      currentPage: 1,\n      pageSize: 10,\n      total: 0,\n      searchKeyword: '',\n      searchCategory: '',\n      searchType: ''\n    };\n  },\n  mounted: function mounted() {\n    this.loadPosts();\n  },\n  methods: {\n    loadPosts: function loadPosts() {\n      var _this = this;\n      this.loading = true;\n      postAPI.getPostList({\n        page: this.currentPage,\n        size: this.pageSize,\n        category: this.searchCategory,\n        type: this.searchType,\n        keyword: this.searchKeyword\n      }).then(function (res) {\n        if (res.data && res.data.records) {\n          _this.posts = res.data.records;\n          _this.total = res.data.total || 0;\n        } else {\n          _this.posts = [];\n          _this.total = 0;\n        }\n      })[\"catch\"](function (err) {\n        console.error('加载帖子失败:', err);\n        _this.$message.error('加载帖子失败');\n      })[\"finally\"](function () {\n        _this.loading = false;\n      });\n    },\n    handleSizeChange: function handleSizeChange(size) {\n      this.pageSize = size;\n      this.loadPosts();\n    },\n    handleCurrentChange: function handleCurrentChange(current) {\n      this.currentPage = current;\n      this.loadPosts();\n    },\n    refreshList: function refreshList() {\n      this.loadPosts();\n    },\n    editPost: function editPost(id) {\n      this.$router.push(\"/community/edit/\".concat(id));\n    },\n    deletePost: function deletePost(id) {\n      var _this2 = this;\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(function () {\n        postAPI.deletePost(id).then(function (res) {\n          if (res.code === 200) {\n            _this2.$message.success('删除成功');\n            _this2.loadPosts();\n          } else {\n            _this2.$message.error(res.message || '删除失败');\n          }\n        })[\"catch\"](function (err) {\n          console.error('删除帖子失败:', err);\n          _this2.$message.error('删除失败，请稍后重试');\n        });\n      })[\"catch\"](function () {\n        // 取消删除\n      });\n    },\n    toggleStatus: function toggleStatus(post) {\n      var _this3 = this;\n      var newStatus = post.status === 1 ? 0 : 1;\n      // 这里需要调用更新帖子状态的API\n      // 暂时使用模拟实现\n      postAPI.updatePost(post.id, {\n        status: newStatus\n      }).then(function (res) {\n        if (res.code === 200) {\n          post.status = newStatus;\n          _this3.$message.success('状态更新成功');\n        } else {\n          _this3.$message.error(res.message || '状态更新失败');\n        }\n      })[\"catch\"](function (err) {\n        console.error('更新状态失败:', err);\n        _this3.$message.error('状态更新失败，请稍后重试');\n      });\n    }\n  }\n};","map":{"version":3,"names":["postAPI","name","data","posts","loading","currentPage","pageSize","total","searchKeyword","searchCategory","searchType","mounted","loadPosts","methods","_this","getPostList","page","size","category","type","keyword","then","res","records","err","console","error","$message","handleSizeChange","handleCurrentChange","current","refreshList","editPost","id","$router","push","concat","deletePost","_this2","$confirm","confirmButtonText","cancelButtonText","code","success","message","toggleStatus","post","_this3","newStatus","status","updatePost"],"sources":["src/views/admin/CommunityManage.vue"],"sourcesContent":["<template>\r\n  <div class=\"community-manage\">\r\n    <div class=\"page-container\">\r\n      <div class=\"page-header\">\r\n        <h2 class=\"page-title\">社区管理</h2>\r\n        <el-button type=\"primary\" @click=\"refreshList\" plain>\r\n          <i class=\"el-icon-refresh\"></i> 刷新\r\n        </el-button>\r\n      </div>\r\n      \r\n      <!-- 搜索筛选 -->\r\n      <div class=\"filter-bar\">\r\n        <el-input\r\n          v-model=\"searchKeyword\"\r\n          placeholder=\"搜索帖子标题或内容\"\r\n          class=\"search-input\"\r\n          @keyup.enter=\"loadPosts\"\r\n          size=\"small\"\r\n        >\r\n          <el-button slot=\"append\" icon=\"el-icon-search\" @click=\"loadPosts\" size=\"small\"></el-button>\r\n        </el-input>\r\n        <el-select v-model=\"searchCategory\" placeholder=\"选择分类\" class=\"filter-select\" size=\"small\">\r\n          <el-option label=\"全部\" value=\"\"></el-option>\r\n          <el-option label=\"创业经验\" value=\"创业经验\"></el-option>\r\n          <el-option label=\"融资技巧\" value=\"融资技巧\"></el-option>\r\n          <el-option label=\"技术分享\" value=\"技术分享\"></el-option>\r\n          <el-option label=\"行业动态\" value=\"行业动态\"></el-option>\r\n        </el-select>\r\n        <el-select v-model=\"searchType\" placeholder=\"选择类型\" class=\"filter-select\" size=\"small\">\r\n          <el-option label=\"全部\" value=\"\"></el-option>\r\n          <el-option label=\"文章\" value=\"article\"></el-option>\r\n          <el-option label=\"问题\" value=\"question\"></el-option>\r\n        </el-select>\r\n      </div>\r\n      \r\n      <!-- 帖子列表 -->\r\n      <div class=\"post-list\" v-loading=\"loading\">\r\n        <el-table :data=\"posts\" style=\"width: 100%\" border stripe>\r\n          <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\r\n          <el-table-column prop=\"title\" label=\"标题\" min-width=\"300\">\r\n            <template slot-scope=\"scope\">\r\n              <a :href=\"`/community/post/${scope.row.id}`\" target=\"_blank\" class=\"post-title-link\">{{ scope.row.title }}</a>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"type\" label=\"类型\" width=\"100\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag :type=\"scope.row.type === 'article' ? 'success' : 'warning'\" size=\"small\">\r\n                {{ scope.row.type === 'article' ? '文章' : '问题' }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"category\" label=\"分类\" width=\"120\"></el-table-column>\r\n          <el-table-column prop=\"userId\" label=\"作者ID\" width=\"100\"></el-table-column>\r\n          <el-table-column prop=\"viewCount\" label=\"浏览\" width=\"80\"></el-table-column>\r\n          <el-table-column prop=\"likeCount\" label=\"点赞\" width=\"80\"></el-table-column>\r\n          <el-table-column prop=\"commentCount\" label=\"评论\" width=\"80\"></el-table-column>\r\n          <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag :type=\"scope.row.status === 1 ? 'success' : 'danger'\" size=\"small\">\r\n                {{ scope.row.status === 1 ? '正常' : '禁用' }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"createdAt\" label=\"创建时间\" width=\"180\"></el-table-column>\r\n          <el-table-column label=\"操作\" width=\"200\" fixed=\"right\">\r\n            <template slot-scope=\"scope\">\r\n              <el-button type=\"primary\" size=\"small\" @click=\"editPost(scope.row.id)\" plain>\r\n                编辑\r\n              </el-button>\r\n              <el-button \r\n                type=\"danger\" \r\n                size=\"small\" \r\n                @click=\"deletePost(scope.row.id)\"\r\n                plain\r\n              >\r\n                删除\r\n              </el-button>\r\n              <el-button \r\n                type=\"warning\" \r\n                size=\"small\" \r\n                @click=\"toggleStatus(scope.row)\"\r\n                plain\r\n              >\r\n                {{ scope.row.status === 1 ? '禁用' : '启用' }}\r\n              </el-button>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n      </div>\r\n      \r\n      <!-- 分页 -->\r\n      <div class=\"pagination\" v-if=\"total > 0\">\r\n        <el-pagination\r\n          @size-change=\"handleSizeChange\"\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"currentPage\"\r\n          :page-sizes=\"[10, 20, 50, 100]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          :total=\"total\"\r\n          size=\"small\"\r\n        ></el-pagination>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { postAPI } from '@/api/community'\r\n\r\nexport default {\r\n  name: 'CommunityManage',\r\n  data() {\r\n    return {\r\n      posts: [],\r\n      loading: false,\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      searchKeyword: '',\r\n      searchCategory: '',\r\n      searchType: ''\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadPosts()\r\n  },\r\n  methods: {\r\n    loadPosts() {\r\n      this.loading = true\r\n      postAPI.getPostList({\r\n        page: this.currentPage,\r\n        size: this.pageSize,\r\n        category: this.searchCategory,\r\n        type: this.searchType,\r\n        keyword: this.searchKeyword\r\n      }).then(res => {\r\n        if (res.data && res.data.records) {\r\n          this.posts = res.data.records\r\n          this.total = res.data.total || 0\r\n        } else {\r\n          this.posts = []\r\n          this.total = 0\r\n        }\r\n      }).catch(err => {\r\n        console.error('加载帖子失败:', err)\r\n        this.$message.error('加载帖子失败')\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    handleSizeChange(size) {\r\n      this.pageSize = size\r\n      this.loadPosts()\r\n    },\r\n    handleCurrentChange(current) {\r\n      this.currentPage = current\r\n      this.loadPosts()\r\n    },\r\n    refreshList() {\r\n      this.loadPosts()\r\n    },\r\n    editPost(id) {\r\n      this.$router.push(`/community/edit/${id}`)\r\n    },\r\n    deletePost(id) {\r\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        postAPI.deletePost(id).then(res => {\r\n          if (res.code === 200) {\r\n            this.$message.success('删除成功')\r\n            this.loadPosts()\r\n          } else {\r\n            this.$message.error(res.message || '删除失败')\r\n          }\r\n        }).catch(err => {\r\n          console.error('删除帖子失败:', err)\r\n          this.$message.error('删除失败，请稍后重试')\r\n        })\r\n      }).catch(() => {\r\n        // 取消删除\r\n      })\r\n    },\r\n    toggleStatus(post) {\r\n      const newStatus = post.status === 1 ? 0 : 1\r\n      // 这里需要调用更新帖子状态的API\r\n      // 暂时使用模拟实现\r\n      postAPI.updatePost(post.id, { status: newStatus }).then(res => {\r\n        if (res.code === 200) {\r\n          post.status = newStatus\r\n          this.$message.success('状态更新成功')\r\n        } else {\r\n          this.$message.error(res.message || '状态更新失败')\r\n        }\r\n      }).catch(err => {\r\n        console.error('更新状态失败:', err)\r\n        this.$message.error('状态更新失败，请稍后重试')\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.community-manage {\r\n  padding: 20px;\r\n  min-height: calc(100vh - 100px);\r\n  background: #0f172a;\r\n}\r\n\r\n.page-container {\r\n  background: #1e293b;\r\n  border-radius: 12px;\r\n  padding: 24px;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);\r\n}\r\n\r\n.page-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 24px;\r\n  padding-bottom: 16px;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.page-title {\r\n  font-size: 20px;\r\n  font-weight: 700;\r\n  color: #ffffff;\r\n  margin: 0;\r\n}\r\n\r\n.filter-bar {\r\n  display: flex;\r\n  gap: 12px;\r\n  margin-bottom: 24px;\r\n  align-items: center;\r\n}\r\n\r\n.search-input {\r\n  flex: 1;\r\n  max-width: 400px;\r\n}\r\n\r\n.filter-select {\r\n  width: 160px;\r\n}\r\n\r\n.post-list {\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.pagination {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  margin-top: 20px;\r\n}\r\n\r\n.post-title-link {\r\n  color: #93c5fd;\r\n  text-decoration: none;\r\n  transition: color 0.2s ease;\r\n}\r\n\r\n.post-title-link:hover {\r\n  color: #3b82f6;\r\n  text-decoration: underline;\r\n}\r\n\r\n/* 表格样式 */\r\n:deep(.el-table) {\r\n  background-color: #1e293b !important;\r\n  border-color: rgba(255, 255, 255, 0.1) !important;\r\n}\r\n\r\n:deep(.el-table th) {\r\n  background-color: #0f172a !important;\r\n  color: #94a3b8 !important;\r\n  border-color: rgba(255, 255, 255, 0.1) !important;\r\n}\r\n\r\n:deep(.el-table tr) {\r\n  background-color: #1e293b !important;\r\n}\r\n\r\n:deep(.el-table tr:hover) {\r\n  background-color: rgba(59, 130, 246, 0.1) !important;\r\n}\r\n\r\n:deep(.el-table td) {\r\n  color: #e2e8f0 !important;\r\n  border-color: rgba(255, 255, 255, 0.1) !important;\r\n}\r\n\r\n:deep(.el-table__empty-text) {\r\n  color: #64748b !important;\r\n}\r\n\r\n/* 输入框样式 */\r\n:deep(.el-input__inner) {\r\n  background-color: #0f172a !important;\r\n  border-color: rgba(255, 255, 255, 0.1) !important;\r\n  color: #e2e8f0 !important;\r\n}\r\n\r\n:deep(.el-input__inner:focus) {\r\n  border-color: #3b82f6 !important;\r\n  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2) !important;\r\n}\r\n\r\n/* 选择框样式 */\r\n:deep(.el-select) {\r\n  background-color: #0f172a !important;\r\n}\r\n\r\n:deep(.el-select__input) {\r\n  color: #e2e8f0 !important;\r\n}\r\n\r\n:deep(.el-select-dropdown) {\r\n  background-color: #1e293b !important;\r\n  border-color: rgba(255, 255, 255, 0.1) !important;\r\n}\r\n\r\n:deep(.el-select-dropdown__item) {\r\n  color: #e2e8f0 !important;\r\n}\r\n\r\n:deep(.el-select-dropdown__item:hover) {\r\n  background-color: rgba(59, 130, 246, 0.1) !important;\r\n}\r\n\r\n:deep(.el-select-dropdown__item.selected) {\r\n  color: #3b82f6 !important;\r\n  background-color: rgba(59, 130, 246, 0.1) !important;\r\n}\r\n\r\n/* 按钮样式 */\r\n:deep(.el-button) {\r\n  border-radius: 6px !important;\r\n  transition: all 0.2s ease !important;\r\n}\r\n\r\n:deep(.el-button:hover) {\r\n  transform: none !important;\r\n  box-shadow: none !important;\r\n}\r\n\r\n/* 分页样式 */\r\n:deep(.el-pagination) {\r\n  color: #94a3b8 !important;\r\n}\r\n\r\n:deep(.el-pagination button) {\r\n  background-color: #0f172a !important;\r\n  border-color: rgba(255, 255, 255, 0.1) !important;\r\n  color: #94a3b8 !important;\r\n}\r\n\r\n:deep(.el-pagination button:hover) {\r\n  border-color: #3b82f6 !important;\r\n  color: #3b82f6 !important;\r\n}\r\n\r\n:deep(.el-pagination .el-pager li) {\r\n  background-color: #0f172a !important;\r\n  color: #94a3b8 !important;\r\n  border-color: rgba(255, 255, 255, 0.1) !important;\r\n}\r\n\r\n:deep(.el-pagination .el-pager li:hover) {\r\n  color: #3b82f6 !important;\r\n  border-color: #3b82f6 !important;\r\n}\r\n\r\n:deep(.el-pagination .el-pager li.active) {\r\n  background-color: #3b82f6 !important;\r\n  color: #ffffff !important;\r\n  border-color: #3b82f6 !important;\r\n}\r\n\r\n/* 加载动画样式 */\r\n:deep(.el-loading-spinner .path) {\r\n  stroke: #3b82f6 !important;\r\n}\r\n\r\n:deep(.el-loading-text) {\r\n  color: #94a3b8 !important;\r\n}\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4GA,SAAAA,OAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IA