2599,\n  status: 'serving',\n  createTime: '2025-01-19 10:30'\n}, {\n  id: 1009,\n  serviceName: '市场营销服务',\n  amount: 1500,\n  status: 'pending',\n  createTime: '2025-01-22 09:15'\n}, {\n  id: 1010,\n  serviceName: '技术咨询服务',\n  amount: 3200,\n  status: 'completed',\n  createTime: '2025-01-12 15:40'\n}];\nexport default {\n  name: 'MyOrders',\n  data: function data() {\n    return {\n      loading: false,\n      list: [],\n      orderType: 'buy',\n      query: {\n        status: ''\n      },\n      page: {\n        current: 1,\n        size: 10,\n        total: 0\n      }\n    };\n  },\n  computed: {\n    displayList: function displayList() {\n      if (this.list.length) return this.list;\n      return MOCK_LIST;\n    }\n  },\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    statusText: function statusText(s) {\n      return {\n        unpaid: '待支付',\n        pending: '待确认',\n        serving: '进行中',\n        completed: '已完成',\n        closed: '已关闭'\n      }[s] || s;\n    },\n    getStatusType: function getStatusType(status) {\n      var typeMap = {\n        unpaid: 'warning',\n        pending: 'info',\n        serving: 'primary',\n        completed: 'success',\n        closed: 'danger'\n      };\n      return typeMap[status] || 'info';\n    },\n    viewOrder: function viewOrder(order) {\n      // 这里可以添加查看订单详情的逻辑\n      this.$message.info(\"\\u67E5\\u770B\\u8BA2\\u5355 \".concat(order.id, \" \\u7684\\u8BE6\\u60C5\"));\n    },\n    contactUser: function contactUser(order) {\n      // 这里可以添加联系对方的逻辑，比如打开聊天窗口\n      this.$message.info(\"\\u8054\\u7CFB\\u8BA2\\u5355 \".concat(order.id, \" \\u7684\\u5BF9\\u65B9\"));\n    },\n    payOrder: function payOrder(order) {\n      // 这里可以添加支付订单的逻辑\n      this.$message.info(\"\\u652F\\u4ED8\\u8BA2\\u5355 \".concat(order.id));\n    },\n    confirmOrder: function confirmOrder(order) {\n      // 这里可以添加确认订单的逻辑\n      this.$message.info(\"\\u786E\\u8BA4\\u8BA2\\u5355 \".concat(order.id));\n    },\n    completeOrder: function completeOrder(order) {\n      // 这里可以添加确认完成订单的逻辑\n      this.$message.info(\"\\u786E\\u8BA4\\u5B8C\\u6210\\u8BA2\\u5355 \".concat(order.id));\n    },\n    cancelOrder: function cancelOrder(order) {\n      // 这里可以添加取消订单的逻辑\n      this.$message.info(\"\\u53D6\\u6D88\\u8BA2\\u5355 \".concat(order.id));\n    },\n    load: function load() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var res;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              _context.n = 2;\n              return listMy(_objectSpread({\n                current: _this.page.current,\n                size: _this.page.size,\n                type: _this.orderType\n              }, _this.query));\n            case 2:\n              res = _context.v;\n              _this.list = res.records || [];\n              _this.page.total = res.total || 0;\n            case 3:\n              _context.p = 3;\n              _this.loading = false;\n              return _context.f(3);\n            case 4:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1,, 3, 4]]);\n      }))();\n    },\n    onPage: function onPage(p) {\n      this.page.current = p;\n      this.load();\n    },\n    onSizeChange: function onSizeChange(size) {\n      this.page.size = size;\n      this.page.current = 1;\n      this.load();\n    }\n  }\n};","map":{"version":3,"names":["listMy","MOCK_LIST","id","serviceName","amount","status","createTime","name","data","loading","list","orderType","query","page","current","size","total","computed","displayList","length","created","load","methods","statusText","s","unpaid","pending","serving","completed","closed","getStatusType","typeMap","viewOrder","order","$message","info","concat","contactUser","payOrder","confirmOrder","completeOrder","cancelOrder","_this","_asyncToGenerator","_regenerator","m","_callee","res","w","_context","p","n","_objectSpread","type","v","records","f","a","onPage","onSizeChange"],"sources":["src/views/order/MyList.vue"],"sourcesContent":["<template>\n  <div class=\"page-card my-list-page\">\n    <div class=\"list-header\">\n      <div class=\"header-content\">\n        <h1 class=\"page-title\">我的订单</h1>\n        <p class=\"page-subtitle\">查看和管理您的服务订单</p>\n      </div>\n      <!-- 订单类型切换 -->\n      <div class=\"order-type-tabs\">\n        <el-radio-group v-model=\"orderType\" @change=\"load\">\n          <el-radio-button label=\"buy\">我购买的服务</el-radio-button>\n          <el-radio-button label=\"sell\">我收到的订单</el-radio-button>\n        </el-radio-group>\n      </div>\n    </div>\n    <div class=\"filter-bar hw-filter-bar\">\n      <div class=\"filter-header\">\n        <h3 class=\"filter-title\">筛选条件</h3>\n        <p class=\"filter-subtitle\">根据订单状态筛选</p>\n      </div>\n      <el-form :inline=\"true\" class=\"query-form\">\n        <el-form-item label=\"状态\">\n          <el-select v-model=\"query.status\" placeholder=\"全部状态\" clearable style=\"width:140px\">\n            <el-option label=\"待支付\" value=\"unpaid\" />\n            <el-option label=\"待确认\" value=\"pending\" />\n            <el-option label=\"进行中\" value=\"serving\" />\n            <el-option label=\"已完成\" value=\"completed\" />\n            <el-option label=\"已关闭\" value=\"closed\" />\n          </el-select>\n        </el-form-item>\n        <el-form-item class=\"button-group\">\n          <el-button type=\"primary\" @click=\"load\">\n            <i class=\"el-icon-search\"></i>\n            <span>查询</span>\n          </el-button>\n          <el-button class=\"reset-button\" @click=\"query = { status: '' }; load()\">\n            <i class=\"el-icon-refresh\"></i>\n            <span>重置</span>\n          </el-button>\n        </el-form-item>\n      </el-form>\n    </div>\n    <div class=\"order-table-container unique-project-table-container\" id=\"unique-project-table-container\">\n      <el-table \n        v-loading=\"loading\" \n        :data=\"displayList\" \n        border \n        stripe \n        class=\"order-table unique-project-table\"\n        id=\"unique-project-table\"\n        row-key=\"id\"\n        :cell-style=\"{ backgroundColor: '#ffffff', color: '#4a5568' }\"\n        :header-cell-style=\"{ backgroundColor: '#f7fafc', color: '#2d3748' }\"\n        :row-style=\"{ backgroundColor: '#ffffff' }\"\n        @sort-change=\"handleSortChange\"\n      >\n        <el-table-column prop=\"id\" label=\"订单号\" width=\"120\" align=\"center\" sortable=\"custom\"/>\n        <el-table-column prop=\"serviceName\" label=\"服务名称\" min-width=\"200\" align=\"left\" sortable=\"custom\">\n          <template slot-scope=\"scope\">\n            <span class=\"service-name\">{{ scope.row.serviceName || '服务名称' }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"amount\" label=\"金额\" width=\"100\" align=\"center\" sortable=\"custom\">\n          <template slot-scope=\"scope\">\n            <span class=\"amount-value\">¥{{ scope.row.amount }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-tag \n              :type=\"getStatusType(scope.row.status)\"\n              size=\"small\"\n              class=\"status-tag\"\n            >\n              {{ statusText(scope.row.status) }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"180\" align=\"center\" />\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-button \n              type=\"primary\" \n              size=\"small\" \n              @click=\"viewOrder(scope.row)\"\n              class=\"action-button detail-button\"\n            >\n              查看详情\n            </el-button>\n            <el-button \n              type=\"info\" \n              size=\"small\" \n              @click=\"contactUser(scope.row)\"\n              class=\"action-button\"\n            >\n              联系对方\n            </el-button>\n            <el-button \n              v-if=\"scope.row.status === 'unpaid'\" \n              type=\"success\" \n              size=\"small\" \n              @click=\"payOrder(scope.row)\"\n              class=\"action-button\"\n            >\n              支付\n            </el-button>\n            <el-button \n              v-if=\"scope.row.status === 'pending'\" \n              type=\"warning\" \n              size=\"small\" \n              @click=\"confirmOrder(scope.row)\"\n              class=\"action-button\"\n            >\n              确认\n            </el-button>\n            <el-button \n              v-if=\"scope.row.status === 'serving'\" \n              type=\"success\" \n              size=\"small\" \n              @click=\"completeOrder(scope.row)\"\n              class=\"action-button\"\n            >\n              确认完成\n            </el-button>\n            <el-button \n              v-if=\"['unpaid', 'pending'].includes(scope.row.status)\" \n              type=\"danger\" \n              size=\"small\" \n              @click=\"cancelOrder(scope.row)\"\n              class=\"action-button\"\n            >\n              取消\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </div>\n    <div v-if=\"!loading && !displayList.length\" class=\"data-empty hw-empty\">\n      <div class=\"empty-icon\"><i class=\"el-icon-s-order\"></i></div>\n      <p>暂无订单</p>\n      <p class=\"empty-tip\">{{ orderType === 'buy' ? '在服务市场预约服务后将在此展示' : '暂无收到的订单' }}</p>\n      <el-button v-if=\"orderType === 'buy'\" type=\"primary\" size=\"small\" @click=\"$router.push('/services')\" style=\"margin-top:12px\">去预约</el-button>\n    </div>\n    <el-pagination\n      v-if=\"page.total > 0\"\n      style=\"margin-top:16px\"\n      :current-page=\"page.current\"\n      :page-size=\"page.size\"\n      :page-sizes=\"[5, 10, 20, 50]\"\n      :total=\"page.total\"\n      layout=\"total, sizes, prev, pager, next, jumper\"\n      @current-change=\"onPage\"\n      @size-change=\"onSizeChange\"\n    />\n  </div>\n</template>\n\n<script>\nimport { listMy } from '@/api/order'\nconst MOCK_LIST = [\n  { id: 1001, serviceName: '企业法律咨询服务', amount: 1999, status: 'completed', createTime: '2025-01-15 10:00' },\n  { id: 1002, serviceName: '网站开发服务', amount: 2999, status: 'serving', createTime: '2025-01-18 14:30' },\n  { id: 1003, serviceName: '市场调研服务', amount: 999, status: 'pending', createTime: '2025-01-20 09:00' },\n  { id: 1004, serviceName: '品牌设计服务', amount: 4999, status: 'unpaid', createTime: '2025-01-21 16:00' },\n  { id: 1005, serviceName: '财务审计服务', amount: 1999, status: 'completed', createTime: '2025-01-10 11:20' },\n  { id: 1006, serviceName: '人力资源咨询', amount: 3999, status: 'completed', createTime: '2025-01-08 08:45' },\n  { id: 1007, serviceName: '税务筹划服务', amount: 899, status: 'closed', createTime: '2025-01-05 13:00' },\n  { id: 1008, serviceName: '知识产权服务', amount: 2599, status: 'serving', createTime: '2025-01-19 10:30' },\n  { id: 1009, serviceName: '市场营销服务', amount: 1500, status: 'pending', createTime: '2025-01-22 09:15' },\n  { id: 1010, serviceName: '技术咨询服务', amount: 3200, status: 'completed', createTime: '2025-01-12 15:40' }\n]\nexport default {\n  name: 'MyOrders',\n  data() {\n    return {\n      loading: false,\n      list: [],\n      orderType: 'buy',\n      query: { status: '' },\n      page: { current: 1, size: 10, total: 0 }\n    }\n  },\n  computed: {\n    displayList() {\n      if (this.list.length) return this.list\n      return MOCK_LIST\n    }\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    statusText(s) {\n      return { \n        unpaid: '待支付',\n        pending: '待确认', \n        serving: '进行中', \n        completed: '已完成', \n        closed: '已关闭' \n      }[s] || s\n    },\n    getStatusType(status) {\n      const typeMap = {\n        unpaid: 'warning',\n        pending: 'info',\n        serving: 'primary',\n        completed: 'success',\n        closed: 'danger'\n      }\n      return typeMap[status] || 'info'\n    },\n    viewOrder(order) {\n      // 这里可以添加查看订单详情的逻辑\n      this.$message.info(`查看订单 ${order.id} 的详情`)\n    },\n    contactUser(order) {\n      // 这里可以添加联系对方的逻辑，比如打开聊天窗口\n      this.$message.info(`联系订单 ${order.id} 的对方`)\n    },\n    payOrder(order) {\n      // 这里可以添加支付订单的逻辑\n      this.$message.info(`支付订单 ${order.id}`)\n    },\n    confirmOrder(order) {\n      // 这里可以添加确认订单的逻辑\n      this.$message.info(`确认订单 ${order.id}`)\n    },\n    completeOrder(order) {\n      // 这里可以添加确认完成订单的逻辑\n      this.$message.info(`确认完成订单 ${order.id}`)\n    },\n    cancelOrder(order) {\n      // 这里可以添加取消订单的逻辑\n      this.$message.info(`取消订单 ${order.id}`)\n    },\n    async load() {\n      this.loading = true\n      try {\n        const res = await listMy({ \n          current: this.page.current, \n          size: this.page.size, \n          type: this.orderType,\n          ...this.query \n        })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally {\n        this.loading = false\n      }\n    },\n    onPage(p) {\n      this.page.current = p\n      this.load()\n    },\n    onSizeChange(size) {\n      this.page.size = size\n      this.page.current = 1\n      this.load()\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* 页面容器 */\n.page-card {\n  background: #ffffff;\n  border-radius: 12px;\n  padding: 24px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n  border: 1px solid #e2e8f0;\n  margin: 20px 0;\n}\n\n/* 列表头部 */\n.list-header {\n  margin-bottom: 24px;\n  padding-bottom: 20px;\n  border-bottom: 2px solid #3b82f6;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  flex-wrap: wrap;\n  gap: 20px;\n}\n\n.header-content {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n/* 订单类型切换 */\n.order-type-tabs {\n  margin-bottom: 8px;\n}\n\n.order-type-tabs .el-radio-button__orig-radio:checked + .el-radio-button__inner {\n  background: #3b82f6;\n  border-color: #3b82f6;\n  color: white;\n}\n\n.order-type-tabs .el-radio-button__inner {\n  border-radius: 8px;\n  padding: 8px 20px;\n  font-size: 14px;\n  font-weight: 500;\n  transition: all 0.3s ease;\n}\n\n.order-type-tabs .el-radio-button:first-child .el-radio-button__inner {\n  border-top-left-radius: 8px;\n  border-bottom-left-radius: 8px;\n}\n\n.order-type-tabs .el-radio-button:last-child .el-radio-button__inner {\n  border-top-right-radius: 8px;\n  border-bottom-right-radius: 8px;\n}\n\n.page-title {\n  font-size: 24px;\n  font-weight: 700;\n  color: #1e293b;\n  margin: 0;\n}\n\n.page-subtitle {\n  font-size: 14px;\n  color: #64748b;\n  margin: 0;\n}\n\n/* 筛选栏 */\n.filter-bar {\n  margin-bottom: 24px;\n}\n\n.hw-filter-bar {\n  background: #f8fafc;\n  border-radius: 10px;\n  padding: 20px;\n  border: 1px solid #e2e8f0;\n}\n\n.filter-header {\n  margin-bottom: 16px;\n}\n\n.filter-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #1e293b;\n  margin: 0 0 4px 0;\n}\n\n.filter-subtitle {\n  font-size: 12px;\n  color: #64748b;\n  margin: 0;\n}\n\n.query-form {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  align-items: center;\n}\n\n.button-group {\n  display: flex;\n  gap: 12px;\n}\n\n/* 表格容器 */\n.order-table-container {\n  margin-bottom: 32px;\n}\n\n/* 唯一表格容器 */\n.unique-project-table-container {\n  margin-bottom: 32px;\n  position: relative;\n  z-index: 1;\n}\n\n/* 唯一表格容器 */\n.unique-project-table {\n  border-radius: 12px;\n  overflow: hidden;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\n  border: 1px solid #e2e8f0;\n  background-color: #ffffff;\n  transition: all 0.3s ease;\n  position: relative;\n  z-index: 2;\n}\n\n.unique-project-table:hover {\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);\n}\n\n/* 唯一表格表头 */\n.unique-project-table th {\n  background-color: #f7fafc !important;\n  color: #2d3748 !important;\n  border-bottom: 2px solid #3b82f6 !important;\n  border-top: 1px solid #e2e8f0 !important;\n  font-weight: 600 !important;\n  padding: 14px 16px !important;\n  font-size: 14px !important;\n  text-align: center !important;\n}\n\n/* 唯一表格单元格 */\n.unique-project-table td {\n  background-color: #ffffff !important;\n  color: #4a5568 !important;\n  border-bottom: 1px solid #e2e8f0 !important;\n  padding: 14px 16px !important;\n  font-size: 14px !important;\n  text-align: center !important;\n}\n\n/* 唯一表格行悬停效果 */\n.unique-project-table tr:hover td {\n  background-color: #f0f9ff !important;\n  transition: background-color 0.3s ease;\n}\n\n/* 唯一表格条纹行 */\n.unique-project-table.el-table--striped .el-table__body tr.el-table__row--striped td {\n  background-color: #f8fafc !important;\n}\n\n/* 唯一表格条纹行悬停效果 */\n.unique-project-table.el-table--striped .el-table__body tr.el-table__row--striped:hover td {\n  background-color: #f0f9ff !important;\n}\n\n/* 唯一表格服务名称单元格 */\n.unique-project-table .service-name {\n  font-size: 14px;\n  color: #2d3748;\n  font-weight: 500;\n  line-height: 1.4;\n}\n\n/* 唯一表格金额样式 */\n.unique-project-table .amount-value {\n  font-size: 14px;\n  font-weight: 500;\n  color: #333333;\n}\n\n/* 唯一表格状态标签 */\n.unique-project-table .status-tag {\n  border-radius: 12px;\n  padding: 2px 8px;\n  font-size: 12px;\n}\n\n/* 唯一表格操作按钮 */\n.unique-project-table .action-button {\n  border-radius: 6px;\n  padding: 4px 12px;\n  font-size: 12px;\n  transition: all 0.3s ease;\n  margin-right: 8px;\n  margin-bottom: 8px;\n}\n\n.unique-project-table .action-button:hover {\n  transform: scale(1.05);\n  box-shadow: 0 2px 8px rgba(24, 144, 255, 0.3);\n}\n\n.unique-project-table .detail-button {\n  background: #3b82f6;\n  border-color: #3b82f6;\n  color: white;\n}\n\n.unique-project-tab