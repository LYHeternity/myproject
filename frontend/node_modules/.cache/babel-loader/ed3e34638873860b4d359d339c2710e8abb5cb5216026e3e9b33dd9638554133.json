{"ast":null,"code":"import \"core-js/modules/es.array.find.js\";\nimport \"core-js/modules/es.array.for-each.js\";\nimport \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.object.to-string.js\";\nimport \"core-js/modules/es.string.trim.js\";\nimport \"core-js/modules/web.dom-collections.for-each.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { postAPI, commentAPI, likeAPI } from '@/api/community';\nimport { marked } from 'marked';\nexport default {\n  name: 'PostDetail',\n  data: function data() {\n    return {\n      post: null,\n      comments: [],\n      isLiked: false,\n      showCommentForm: false,\n      commentContent: '',\n      replyingTo: null,\n      replyContent: '',\n      pagination: {\n        currentPage: 1,\n        pageSize: 10,\n        total: 0\n      },\n      currentUserId: null\n    };\n  },\n  mounted: function mounted() {\n    this.loadPostDetail();\n    this.loadComments();\n    this.currentUserId = this.$store.state.user.id;\n  },\n  methods: {\n    loadPostDetail: function loadPostDetail() {\n      var _this = this;\n      var id = this.$route.params.id;\n      postAPI.getPostDetail(id).then(function (res) {\n        if (res.code === 200) {\n          _this.post = res.data;\n          // 检查是否已点赞\n          _this.checkLike();\n        }\n      });\n    },\n    loadComments: function loadComments() {\n      var _this2 = this;\n      var postId = this.$route.params.id;\n      commentAPI.getCommentsByPostId(postId, {\n        page: this.pagination.currentPage,\n        size: this.pagination.pageSize\n      }).then(function (res) {\n        if (res.code === 200) {\n          _this2.comments = res.data.records;\n          _this2.pagination.total = res.data.total;\n          // 加载每个评论的回复\n          _this2.comments.forEach(function (comment) {\n            _this2.loadReplies(comment);\n          });\n        }\n      });\n    },\n    loadReplies: function loadReplies(comment) {\n      commentAPI.getRepliesByCommentId(comment.id).then(function (res) {\n        if (res.code === 200) {\n          comment.replies = res.data;\n        }\n      });\n    },\n    checkLike: function checkLike() {\n      var _this3 = this;\n      if (this.post && this.currentUserId) {\n        likeAPI.checkLike(this.post.id, 'post').then(function (res) {\n          if (res.code === 200) {\n            _this3.isLiked = res.data;\n          }\n        });\n      }\n    },\n    toggleLike: function toggleLike() {\n      var _this4 = this;\n      if (!this.currentUserId) {\n        this.$message.error('请先登录');\n        return;\n      }\n      likeAPI.toggleLike(this.post.id, 'post').then(function (res) {\n        if (res.code === 200) {\n          _this4.isLiked = !_this4.isLiked;\n          _this4.post.likeCount += _this4.isLiked ? 1 : -1;\n        }\n      });\n    },\n    toggleCommentLike: function toggleCommentLike(commentId) {\n      var _this5 = this;\n      if (!this.currentUserId) {\n        this.$message.error('请先登录');\n        return;\n      }\n      likeAPI.toggleLike(commentId, 'comment').then(function (res) {\n        if (res.code === 200) {\n          var comment = _this5.comments.find(function (c) {\n            return c.id === commentId;\n          });\n          if (comment) {\n            comment.isLiked = !comment.isLiked;\n            comment.likeCount += comment.isLiked ? 1 : -1;\n          }\n        }\n      });\n    },\n    submitComment: function submitComment() {\n      var _this6 = this;\n      if (!this.currentUserId) {\n        this.$message.error('请先登录');\n        return;\n      }\n      if (!this.commentContent.trim()) {\n        this.$message.error('评论内容不能为空');\n        return;\n      }\n      commentAPI.createComment({\n        postId: this.post.id,\n        content: this.commentContent,\n        parentId: 0\n      }).then(function (res) {\n        if (res.code === 200) {\n          _this6.$message.success('评论成功');\n          _this6.showCommentForm = false;\n          _this6.commentContent = '';\n          _this6.loadComments();\n          _this6.post.commentCount++;\n        }\n      });\n    },\n    replyToComment: function replyToComment(commentId) {\n      this.replyingTo = commentId;\n    },\n    submitReply: function submitReply(commentId) {\n      var _this7 = this;\n      if (!this.currentUserId) {\n        this.$message.error('请先登录');\n        return;\n      }\n      if (!this.replyContent.trim()) {\n        this.$message.error('回复内容不能为空');\n        return;\n      }\n      commentAPI.createComment({\n        postId: this.post.id,\n        content: this.replyContent,\n        parentId: commentId\n      }).then(function (res) {\n        if (res.code === 200) {\n          _this7.$message.success('回复成功');\n          _this7.replyingTo = null;\n          _this7.replyContent = '';\n          _this7.loadComments();\n          _this7.post.commentCount++;\n        }\n      });\n    },\n    setBestAnswer: function setBestAnswer(commentId) {\n      var _this8 = this;\n      postAPI.setBestAnswer(this.post.id, commentId).then(function (res) {\n        if (res.code === 200) {\n          _this8.$message.success('设置成功');\n          _this8.post.bestAnswerId = commentId;\n        }\n      });\n    },\n    navigateToEdit: function navigateToEdit() {\n      this.$router.push(\"/community/edit/\".concat(this.post.id));\n    },\n    deletePost: function deletePost() {\n      var _this9 = this;\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(function () {\n        postAPI.deletePost(_this9.post.id).then(function (res) {\n          if (res.code === 200) {\n            _this9.$message.success('删除成功');\n            _this9.$router.push('/community');\n          }\n        });\n      })[\"catch\"](function () {\n        // 取消删除\n      });\n    },\n    handleSizeChange: function handleSizeChange(size) {\n      this.pagination.pageSize = size;\n      this.loadComments();\n    },\n    handleCurrentChange: function handleCurrentChange(current) {\n      this.pagination.currentPage = current;\n      this.loadComments();\n    }\n  }\n};","map":{"version":3,"names":["postAPI","commentAPI","likeAPI","marked","name","data","post","comments","isLiked","showCommentForm","commentContent","replyingTo","replyContent","pagination","currentPage","pageSize","total","currentUserId","mounted","loadPostDetail","loadComments","$store","state","user","id","methods","_this","$route","params","getPostDetail","then","res","code","checkLike","_this2","postId","getCommentsByPostId","page","size","records","forEach","comment","loadReplies","getRepliesByCommentId","replies","_this3","toggleLike","_this4","$message","error","likeCount","toggleCommentLike","commentId","_this5","find","c","submitComment","_this6","trim","createComment","content","parentId","success","commentCount","replyToComment","submitReply","_this7","setBestAnswer","_this8","bestAnswerId","navigateToEdit","$router","push","concat","deletePost","_this9","$confirm","confirmButtonText","cancelButtonText","type","handleSizeChange","handleCurrentChange","current"],"sources":["src/views/community/PostDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"post-detail\">\r\n    <div class=\"container\">\r\n      <!-- 帖子内容 -->\r\n      <el-card v-if=\"post\" class=\"post-card\">\r\n        <div class=\"post-header\">\r\n          <h2>{{ post.title }}</h2>\r\n          <div class=\"post-meta\">\r\n            <span>{{ post.createdAt }}</span>\r\n            <span>{{ post.category }}</span>\r\n            <span>{{ post.viewCount }} 浏览</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"post-content\" v-html=\"post.content\"></div>\r\n        <div class=\"post-actions\">\r\n          <el-button \r\n            :type=\"isLiked ? 'primary' : 'default'\"\r\n            @click=\"toggleLike\"\r\n            icon=\"el-icon-star-on\"\r\n          >\r\n            {{ post.likeCount }} 点赞\r\n          </el-button>\r\n          <el-button \r\n            type=\"default\"\r\n            @click=\"showCommentForm = true\"\r\n            icon=\"el-icon-chat-line-round\"\r\n          >\r\n            {{ post.commentCount }} 评论\r\n          </el-button>\r\n          <el-button \r\n            v-if=\"post.userId === currentUserId\" \r\n            type=\"warning\"\r\n            @click=\"navigateToEdit\"\r\n            icon=\"el-icon-edit\"\r\n          >\r\n            编辑\r\n          </el-button>\r\n          <el-button \r\n            v-if=\"post.userId === currentUserId\" \r\n            type=\"danger\"\r\n            @click=\"deletePost\"\r\n            icon=\"el-icon-delete\"\r\n          >\r\n            删除\r\n          </el-button>\r\n        </div>\r\n      </el-card>\r\n      \r\n      <!-- 评论区 -->\r\n      <div class=\"comment-section\">\r\n        <h3>评论 ({{ post?.commentCount || 0 }})</h3>\r\n        \r\n        <!-- 评论表单 -->\r\n        <el-card v-if=\"showCommentForm\" class=\"comment-form\">\r\n          <el-input\r\n            type=\"textarea\"\r\n            v-model=\"commentContent\"\r\n            placeholder=\"写下你的评论...\"\r\n            :rows=\"3\"\r\n          ></el-input>\r\n          <div class=\"form-actions\">\r\n            <el-button @click=\"showCommentForm = false\">取消</el-button>\r\n            <el-button type=\"primary\" @click=\"submitComment\">发布评论</el-button>\r\n          </div>\r\n        </el-card>\r\n        \r\n        <!-- 评论列表 -->\r\n        <div class=\"comment-list\">\r\n          <el-card v-for=\"comment in comments\" :key=\"comment.id\" class=\"comment-item\">\r\n            <div class=\"comment-header\">\r\n              <span class=\"comment-author\">{{ comment.username }}</span>\r\n              <span class=\"comment-time\">{{ comment.createdAt }}</span>\r\n            </div>\r\n            <div class=\"comment-content\">{{ comment.content }}</div>\r\n            <div class=\"comment-actions\">\r\n              <el-button \r\n                size=\"small\" \r\n                :type=\"comment.isLiked ? 'primary' : 'default'\"\r\n                @click=\"toggleCommentLike(comment.id)\"\r\n              >\r\n                {{ comment.likeCount }} 点赞\r\n              </el-button>\r\n              <el-button size=\"small\" @click=\"replyToComment(comment.id)\">\r\n                回复\r\n              </el-button>\r\n              <el-button \r\n                v-if=\"post.type === 'question' && post.userId === currentUserId && !post.bestAnswerId\"\r\n                size=\"small\" \r\n                type=\"success\"\r\n                @click=\"setBestAnswer(comment.id)\"\r\n              >\r\n                设为最佳答案\r\n              </el-button>\r\n            </div>\r\n            \r\n            <!-- 回复列表 -->\r\n            <div class=\"reply-list\" v-if=\"comment.replies && comment.replies.length > 0\">\r\n              <el-card v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"reply-item\">\r\n                <div class=\"reply-header\">\r\n                  <span class=\"reply-author\">{{ reply.username }}</span>\r\n                  <span class=\"reply-time\">{{ reply.createdAt }}</span>\r\n                </div>\r\n                <div class=\"reply-content\">{{ reply.content }}</div>\r\n              </el-card>\r\n            </div>\r\n            \r\n            <!-- 回复表单 -->\r\n            <div v-if=\"replyingTo === comment.id\" class=\"reply-form\">\r\n              <el-input\r\n                type=\"textarea\"\r\n                v-model=\"replyContent\"\r\n                placeholder=\"写下你的回复...\"\r\n                :rows=\"2\"\r\n              ></el-input>\r\n              <div class=\"form-actions\">\r\n                <el-button size=\"small\" @click=\"replyingTo = null\">取消</el-button>\r\n                <el-button size=\"small\" type=\"primary\" @click=\"submitReply(comment.id)\">发布回复</el-button>\r\n              </div>\r\n            </div>\r\n          </el-card>\r\n        </div>\r\n        \r\n        <!-- 评论分页 -->\r\n        <div class=\"pagination\" v-if=\"pagination.total > 0\">\r\n          <el-pagination\r\n            @size-change=\"handleSizeChange\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :current-page=\"pagination.currentPage\"\r\n            :page-sizes=\"[10, 20, 50]\"\r\n            :page-size=\"pagination.pageSize\"\r\n            layout=\"total, sizes, prev, pager, next, jumper\"\r\n            :total=\"pagination.total\"\r\n          ></el-pagination>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { postAPI, commentAPI, likeAPI } from '@/api/community'\r\nimport { marked } from 'marked'\r\n\r\nexport default {\r\n  name: 'PostDetail',\r\n  data() {\r\n    return {\r\n      post: null,\r\n      comments: [],\r\n      isLiked: false,\r\n      showCommentForm: false,\r\n      commentContent: '',\r\n      replyingTo: null,\r\n      replyContent: '',\r\n      pagination: {\r\n        currentPage: 1,\r\n        pageSize: 10,\r\n        total: 0\r\n      },\r\n      currentUserId: null\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadPostDetail()\r\n    this.loadComments()\r\n    this.currentUserId = this.$store.state.user.id\r\n  },\r\n  methods: {\r\n    loadPostDetail() {\r\n      const id = this.$route.params.id\r\n      postAPI.getPostDetail(id).then(res => {\r\n        if (res.code === 200) {\r\n          this.post = res.data\r\n          // 检查是否已点赞\r\n          this.checkLike()\r\n        }\r\n      })\r\n    },\r\n    loadComments() {\r\n      const postId = this.$route.params.id\r\n      commentAPI.getCommentsByPostId(postId, {\r\n        page: this.pagination.currentPage,\r\n        size: this.pagination.pageSize\r\n      }).then(res => {\r\n        if (res.code === 200) {\r\n          this.comments = res.data.records\r\n          this.pagination.total = res.data.total\r\n          // 加载每个评论的回复\r\n          this.comments.forEach(comment => {\r\n            this.loadReplies(comment)\r\n          })\r\n        }\r\n      })\r\n    },\r\n    loadReplies(comment) {\r\n      commentAPI.getRepliesByCommentId(comment.id).then(res => {\r\n        if (res.code === 200) {\r\n          comment.replies = res.data\r\n        }\r\n      })\r\n    },\r\n    checkLike() {\r\n      if (this.post && this.currentUserId) {\r\n        likeAPI.checkLike(this.post.id, 'post').then(res => {\r\n          if (res.code === 200) {\r\n            this.isLiked = res.data\r\n          }\r\n        })\r\n      }\r\n    },\r\n    toggleLike() {\r\n      if (!this.currentUserId) {\r\n        this.$message.error('请先登录')\r\n        return\r\n      }\r\n      likeAPI.toggleLike(this.post.id, 'post').then(res => {\r\n        if (res.code === 200) {\r\n          this.isLiked = !this.isLiked\r\n          this.post.likeCount += this.isLiked ? 1 : -1\r\n        }\r\n      })\r\n    },\r\n    toggleCommentLike(commentId) {\r\n      if (!this.currentUserId) {\r\n        this.$message.error('请先登录')\r\n        return\r\n      }\r\n      likeAPI.toggleLike(commentId, 'comment').then(res => {\r\n        if (res.code === 200) {\r\n          const comment = this.comments.find(c => c.id === commentId)\r\n          if (comment) {\r\n            comment.isLiked = !comment.isLiked\r\n            comment.likeCount += comment.isLiked ? 1 : -1\r\n          }\r\n        }\r\n      })\r\n    },\r\n    submitComment() {\r\n      if (!this.currentUserId) {\r\n        this.$message.error('请先登录')\r\n        return\r\n      }\r\n      if (!this.commentContent.trim()) {\r\n        this.$message.error('评论内容不能为空')\r\n        return\r\n      }\r\n      commentAPI.createComment({\r\n        postId: this.post.id,\r\n        content: this.commentContent,\r\n        parentId: 0\r\n      }).then(res => {\r\n        if (res.code === 200) {\r\n          this.$message.success('评论成功')\r\n          this.showCommentForm = false\r\n          this.commentContent = ''\r\n          this.loadComments()\r\n          this.post.commentCount++\r\n        }\r\n      })\r\n    },\r\n    replyToComment(commentId) {\r\n      this.replyingTo = commentId\r\n    },\r\n    submitReply(commentId) {\r\n      if (!this.currentUserId) {\r\n        this.$message.error('请先登录')\r\n        return\r\n      }\r\n      if (!this.replyContent.trim()) {\r\n        this.$message.error('回复内容不能为空')\r\n        return\r\n      }\r\n      commentAPI.createComment({\r\n        postId: this.post.id,\r\n        content: this.replyContent,\r\n        parentId: commentId\r\n      }).then(res => {\r\n        if (res.code === 200) {\r\n          this.$message.success('回复成功')\r\n          this.replyingTo = null\r\n          this.replyContent = ''\r\n          this.loadComments()\r\n          this.post.commentCount++\r\n        }\r\n      })\r\n    },\r\n    setBestAnswer(commentId) {\r\n      postAPI.setBestAnswer(this.post.id, commentId).then(res => {\r\n        if (res.code === 200) {\r\n          this.$message.success('设置成功')\r\n          this.post.bestAnswerId = commentId\r\n        }\r\n      })\r\n    },\r\n    navigateToEdit() {\r\n      this.$router.push(`/community/edit/${this.post.id}`)\r\n    },\r\n    deletePost() {\r\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        postAPI.deletePost(this.post.id).then(res => {\r\n          if (res.code === 200) {\r\n            this.$message.success('删除成功')\r\n            this.$router.push('/community')\r\n          }\r\n        })\r\n      }).catch(() => {\r\n        // 取消删除\r\n      })\r\n    },\r\n    handleSizeChange(size) {\r\n      this.pagination.pageSize = size\r\n      this.loadComments()\r\n    },\r\n    handleCurrentChange(current) {\r\n      this.pagination.currentPage = current\r\n      this.loadComments()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.post-detail {\r\n  padding: 20px 0;\r\n}\r\n\r\n.post-card {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.post-header {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.post-header h2 {\r\n  font-size: 24px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.post-meta {\r\n  font-size: 14px;\r\n  color: #999;\r\n}\r\n\r\n.post-meta span {\r\n  margin-right: 15px;\r\n}\r\n\r\n.post-content {\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: #333;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.post-actions {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.comment-section {\r\n  margin-top: 40px;\r\n}\r\n\r\n.comment-section h3 {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.comment-form {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.form-actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  margin-top: 10px;\r\n  gap: 10px;\r\n}\r\n\r\n.comment-list {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.comment-item {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.comment-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.comment-author {\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n\r\n.comment-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.comment-content {\r\