-item index=\"/admin\">\r\n          <i class=\"el-icon-s-home\"></i>\r\n          <span>工作台</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-users\">\r\n          <i class=\"el-icon-user\"></i>\r\n          <span>用户管理</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-audit\">\r\n          <i class=\"el-icon-document-checked\"></i>\r\n          <span>内容审核</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-stats\">\r\n          <i class=\"el-icon-data-analysis\"></i>\r\n          <span>数据统计</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-config\">\r\n          <i class=\"el-icon-setting\"></i>\r\n          <span>系统配置</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-log\">\r\n          <i class=\"el-icon-document\"></i>\r\n          <span>操作日志</span>\r\n        </el-menu-item>\r\n      </el-menu>\r\n    </el-aside>\r\n\r\n    <el-container direction=\"vertical\" class=\"main-wrap\">\r\n      <!-- 顶栏 -->\r\n      <el-header class=\"main-header\">\r\n        <div class=\"header-left\">\r\n          <template v-if=\"!isAdmin\">\r\n            <router-link to=\"/projects\" class=\"nav-link\">项目</router-link>\r\n            <router-link to=\"/services\" class=\"nav-link\">服务</router-link>\r\n            <template v-if=\"isEntrepreneur\">\r\n              <router-link to=\"/project-publish\" class=\"nav-link\">发布项目</router-link>\r\n              <router-link to=\"/my-projects\" class=\"nav-link\">我的项目</router-link>\r\n            </template>\r\n            <template v-if=\"isInvestor\">\r\n              <router-link to=\"/my-investments\" class=\"nav-link\">我的意向</router-link>\r\n            </template>\r\n            <template v-if=\"isProvider\">\r\n              <router-link to=\"/service-publish\" class=\"nav-link\">发布服务</router-link>\r\n              <router-link to=\"/my-services\" class=\"nav-link\">我的服务</router-link>\r\n              <router-link to=\"/provider-orders\" class=\"nav-link\">服务订单</router-link>\r\n            </template>\r\n            <router-link to=\"/my-orders\" class=\"nav-link\">我的订单</router-link>\r\n            <router-link to=\"/messages\" class=\"nav-link\">消息</router-link>\r\n          </template>\r\n        </div>\r\n        <div class=\"header-right\">\r\n          <span class=\"user-name\">{{ user.realName || user.username }}</span>\r\n          <el-dropdown trigger=\"click\" @command=\"handleCommand\">\r\n            <span class=\"el-dropdown-link\">\r\n              <i class=\"el-icon-arrow-down el-icon--right\"></i>\r\n            </span>\r\n            <el-dropdown-menu slot=\"dropdown\">\r\n              <el-dropdown-item command=\"profile\">\r\n                <i class=\"el-icon-user\"></i> 个人中心\r\n              </el-dropdown-item>\r\n              <el-dropdown-item command=\"logout\" divided>\r\n                <i class=\"el-icon-switch-button\"></i> 退出登录\r\n              </el-dropdown-item>\r\n            </el-dropdown-menu>\r\n          </el-dropdown>\r\n        </div>\r\n      </el-header>\r\n\r\n      <el-main class=\"main-content\">\r\n        <router-view />\r\n      </el-main>\r\n    </el-container>\r\n  </el-container>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapGetters, mapActions } from 'vuex'\r\nexport default {\r\n  name: 'Layout',\r\n  computed: {\r\n    ...mapState('user', ['username', 'realName']),\r\n    user() {\r\n      return { username: this.username, realName: this.realName }\r\n    },\r\n    ...mapGetters('user', ['isAdmin', 'isEntrepreneur', 'isInvestor', 'isProvider'])\r\n  },\r\n  methods: {\r\n    ...mapActions('user', ['logout']),\r\n    handleCommand(cmd) {\r\n      if (cmd === 'profile') this.$router.push('/profile')\r\n      if (cmd === 'logout') {\r\n        this.logout()\r\n        this.$router.push('/login')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.app-layout { min-height: 100vh; }\r\n.admin-sidebar {\r\n  background: #1e293b;\r\n  box-shadow: 2px 0 12px rgba(0,0,0,.08);\r\n}\r\n.sidebar-logo {\r\n  height: 60px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-bottom: 1px solid rgba(255,255,255,.06);\r\n}\r\n.logo-text {\r\n  font-size: 18px;\r\n  font-weight: 700;\r\n  color: #f1f5f9;\r\n  letter-spacing: 0.5px;\r\n}\r\n.el-menu { border-right: none; }\r\n.el-menu-item { margin: 4px 8px; border-radius: 8px; }\r\n.el-menu-item.is-active { background: rgba(59, 130, 246, .15) !important; }\r\n\r\n.main-wrap { flex: 1; min-width: 0; }\r\n.main-header {\r\n  height: 56px;\r\n  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 24px;\r\n  box-shadow: 0 2px 12px rgba(0,0,0,.1);\r\n}\r\n.header-left { display: flex; align-items: center; gap: 4px; }\r\n.nav-link {\r\n  color: rgba(255,255,255,.9);\r\n  text-decoration: none;\r\n  padding: 6px 14px;\r\n  border-radius: 8px;\r\n  font-size: 14px;\r\n  transition: background .2s;\r\n}\r\n.nav-link:hover { background: rgba(255,255,255,.15); color: #fff; }\r\n\r\n.header-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  color: #fff;\r\n}\r\n.user-name { font-size: 14px; font-weight: 500; }\r\n.el-dropdown-link { cursor: pointer; color: #fff; font-size: 14px; }\r\n\r\n.main-content {\r\n  background: #f1f5f9;\r\n  padding: 24px;\r\n  min-height: calc(100vh - 56px);\r\n}\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA0FA,SAAAA,QAAA,EAAAC,UAAA,EAAAC,UAAA;AACA;EACAC,IAAA;EACAC,QAAA,EAAAC,aAAA,CAAAA,aAAA,KACAL,QAAA;IACAM,IAAA,WAAAA,KAAA;MACA;QAAAC,QAAA,OAAAA,QAAA;QAAAC,QAAA,OAAAA;MAAA;IACA;EAAA,GACAP,UAAA,oEACA;EACAQ,OAAA,EAAAJ,aAAA,CAAAA,aAAA,KACAH,UAAA;IACAQ,aAAA,WAAAA,cAAAC,GAAA;MACA,IAAAA,GAAA,qBAAAC,OAAA,CAAAC,IAAA;MACA,IAAAF,GAAA;QACA,KAAAG,MAAA;QACA,KAAAF,OAAA,CAAAC,IAAA;MAC