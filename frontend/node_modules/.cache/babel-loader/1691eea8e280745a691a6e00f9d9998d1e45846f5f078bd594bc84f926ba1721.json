{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'AdminRoles',\n  data: function data() {\n    return {\n      roleList: [{\n        name: '超级管理员',\n        code: 'admin',\n        desc: '拥有全部管理权限'\n      }, {\n        name: '内容审核员',\n        code: 'auditor',\n        desc: '项目与服务审核'\n      }, {\n        name: '数据统计员',\n        code: 'analyst',\n        desc: '数据统计与报表查看'\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","roleList","code","desc"],"sources":["src/views/admin/RoleManage.vue"],"sourcesContent":["<template>\n  <div class=\"admin-page\">\n    <div class=\"page-card\">\n      <div class=\"page-header\">\n        <h3 class=\"page-title\">角色权限管理</h3>\n        <span class=\"page-subtitle\">管理平台角色及可访问的菜单与操作权限</span>\n      </div>\n      <el-table :data=\"roleList\" border stripe class=\"data-table\" style=\"width:100%\">\n        <el-table-column prop=\"name\" label=\"角色名称\" width=\"160\" />\n        <el-table-column prop=\"code\" label=\"角色代码\" width=\"140\" />\n        <el-table-column prop=\"desc\" label=\"说明\" min-width=\"240\" />\n        <el-table-column label=\"操作\" width=\"180\" fixed=\"right\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" size=\"small\" @click=\"assignPermissions(scope.row.code)\">分配权限</el-button>\n            <el-button type=\"text\" size=\"small\" @click=\"editRole(scope.row.code)\">编辑</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div v-if=\"!roleList.length\" class=\"data-empty\">\n        <div class=\"empty-icon\"><i class=\"el-icon-s-custom\"></i></div>\n        <p class=\"empty-text\">暂无角色数据</p>\n      </div>\n      <div class=\"toolbar\">\n        <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"addRole\">新增角色</el-button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'AdminRoles',\n  data() {\n    return {\n      roleList: [\n        { name: '超级管理员', code: 'admin', desc: '拥有全部管理权限' },\n        { name: '内容审核员', code: 'auditor', desc: '项目与服务审核' },\n        { name: '数据统计员', code: 'analyst', desc: '数据统计与报表查看' }\n      ]\n    }\n  }\n}\n</script>\n\n<style scoped>\n.section-desc { color: #64748b; font-size: 14px; margin-bottom: 20px; }\n.toolbar { margin-top: 20px; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA8BA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,QAAA,GACA;QAAAF,IAAA;QAAAG,IAAA;QAAAC,IAAA;MAAA,GACA;QAAAJ,IAAA;QAAAG,IAAA;QAAAC,IAAA;MAAA,GACA;QAAAJ,IAAA;QAAAG,IAAA;QAAAC,IAAA;MAAA;IAEA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}