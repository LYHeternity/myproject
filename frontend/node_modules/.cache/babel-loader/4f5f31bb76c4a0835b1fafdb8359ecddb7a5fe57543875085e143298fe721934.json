on (res) {\n      _this.stats = res || {};\n    })[\"catch\"](function () {\n      _this.stats = {\n        userCount: 12,\n        projectCount: 8,\n        resourceCount: 6,\n        orderCount: 28\n      };\n    });\n  },\n  mounted: function mounted() {\n    var _this2 = this;\n    this.$nextTick(function () {\n      _this2.initMiniCharts();\n      _this2.initMainChart();\n    });\n  },\n  beforeDestroy: function beforeDestroy() {\n    this.charts.forEach(function (c) {\n      return c && c.dispose();\n    });\n  },\n  methods: {\n    initMiniCharts: function initMiniCharts() {\n      var _this3 = this;\n      var opts = {\n        grid: {\n          left: 0,\n          right: 0,\n          top: 4,\n          bottom: 0\n        },\n        xAxis: {\n          show: false,\n          type: 'category',\n          data: ['1', '2', '3', '4', '5', '6', '7']\n        },\n        yAxis: {\n          show: false,\n          type: 'value'\n        },\n        series: [{\n          type: 'line',\n          data: [2, 5, 4, 8, 6, 9, 12],\n          smooth: true,\n          symbol: 'none',\n          lineStyle: {\n            width: 2,\n            color: '#007dff'\n          },\n          areaStyle: {\n            color: 'rgba(0,125,255,0.15)'\n          }\n        }]\n      };\n      ['chartUser', 'chartProject', 'chartResource', 'chartOrder'].forEach(function (ref, i) {\n        var el = _this3.$refs[ref];\n        if (el) {\n          var chart = echarts.init(el);\n          chart.setOption(_objectSpread(_objectSpread({}, opts), {}, {\n            series: [_objectSpread(_objectSpread({}, opts.series[0]), {}, {\n              data: [1, 3, 4, 6, 5, 8, 10].map(function (v) {\n                return v + i * 2;\n              })\n            })]\n          }));\n          _this3.charts.push(chart);\n        }\n      });\n    },\n    initMainChart: function initMainChart() {\n      var el = this.$refs.mainChart;\n      if (el) {\n        var chart = echarts.init(el);\n        var option = {\n          tooltip: {\n            trigger: 'axis',\n            axisPointer: {\n              type: 'cross',\n              label: {\n                backgroundColor: '#6a7985'\n              }\n            }\n          },\n          legend: {\n            data: ['用户注册', '项目发布', '服务订单'],\n            top: 0\n          },\n          grid: {\n            left: '3%',\n            right: '4%',\n            bottom: '3%',\n            containLabel: true\n          },\n          xAxis: {\n            type: 'category',\n            boundaryGap: false,\n            data: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']\n          },\n          yAxis: {\n            type: 'value'\n          },\n          series: [{\n            name: '用户注册',\n            type: 'line',\n            stack: 'Total',\n            areaStyle: {\n              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{\n                offset: 0,\n                color: 'rgba(0, 125, 255, 0.5)'\n              }, {\n                offset: 1,\n                color: 'rgba(0, 125, 255, 0.1)'\n              }])\n            },\n            emphasis: {\n              focus: 'series'\n            },\n            data: [120, 132, 101, 134, 90, 230, 210, 250, 220, 300, 280, 350]\n          }, {\n            name: '项目发布',\n            type: 'line',\n            stack: 'Total',\n            areaStyle: {\n              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{\n                offset: 0,\n                color: 'rgba(16, 185, 129, 0.5)'\n              }, {\n                offset: 1,\n                color: 'rgba(16, 185, 129, 0.1)'\n              }])\n            },\n            emphasis: {\n              focus: 'series'\n            },\n            data: [220, 182, 191, 234, 290, 330, 310, 350, 320, 400, 380, 450]\n          }, {\n            name: '服务订单',\n            type: 'line',\n            stack: 'Total',\n            areaStyle: {\n              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{\n                offset: 0,\n                color: 'rgba(245, 158, 11, 0.5)'\n              }, {\n                offset: 1,\n                color: 'rgba(245, 158, 11, 0.1)'\n              }])\n            },\n            emphasis: {\n              focus: 'series'\n            },\n            data: [150, 232, 201, 154, 190, 330, 410, 450, 420, 500, 480, 550]\n          }]\n        };\n        chart.setOption(option);\n        this.charts.push(chart);\n      }\n    }\n  }\n};","map":{"version":3,"names":["echarts","adminStats","name","data","stats","todoList","title","due","priority","done","charts","created","_this","overview","then","res","userCount","projectCount","resourceCount","orderCount","mounted","_this2","$nextTick","initMiniCharts","initMainChart","beforeDestroy","forEach","c","dispose","methods","_this3","opts","grid","left","right","top","bottom","xAxis","show","type","yAxis","series","smooth","symbol","lineStyle","width","color","areaStyle","ref","i","el","$refs","chart","init","setOption","_objectSpread","map","v","push","mainChart","option","tooltip","trigger","axisPointer","label","backgroundColor","legend","containLabel","boundaryGap","stack","graphic","LinearGradient","offset","emphasis","focus"],"sources":["src/views/admin/Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"admin-dashboard\">\n    <!-- 顶部卡片 -->\n    <div class=\"top-cards\">\n      <div class=\"welcome-card\">\n        <div class=\"welcome-content\">\n          <h1 class=\"welcome-title\">欢迎回来，{{ $store.state.user.realName || $store.state.user.username }}</h1>\n          <p class=\"welcome-subtitle\">今天是 {{ new Date().toLocaleDateString('zh-CN') }}，以下是平台的核心数据概览</p>\n        </div>\n        <div class=\"welcome-avatar\">\n          {{ ($store.state.user.realName || $store.state.user.username || 'A').charAt(0) }}\n        </div>\n      </div>\n    </div>\n\n    <!-- 数据概览卡片 -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-header\">\n          <h3 class=\"stat-title\">用户总数</h3>\n          <span class=\"stat-icon user\"><i class=\"el-icon-user\"></i></span>\n        </div>\n        <div class=\"stat-body\">\n          <div class=\"stat-value\">{{ stats.userCount || 0 }}</div>\n          <div class=\"stat-change positive\">+12% <span>较上月</span></div>\n        </div>\n        <div class=\"stat-chart\" ref=\"chartUser\"></div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-header\">\n          <h3 class=\"stat-title\">项目总数</h3>\n          <span class=\"stat-icon project\"><i class=\"el-icon-document\"></i></span>\n        </div>\n        <div class=\"stat-body\">\n          <div class=\"stat-value\">{{ stats.projectCount || 0 }}</div>\n          <div class=\"stat-change positive\">+8% <span>较上月</span></div>\n        </div>\n        <div class=\"stat-chart\" ref=\"chartProject\"></div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-header\">\n          <h3 class=\"stat-title\">服务总数</h3>\n          <span class=\"stat-icon service\"><i class=\"el-icon-goods\"></i></span>\n        </div>\n        <div class=\"stat-body\">\n          <div class=\"stat-value\">{{ stats.resourceCount || 0 }}</div>\n          <div class=\"stat-change positive\">+15% <span>较上月</span></div>\n        </div>\n        <div class=\"stat-chart\" ref=\"chartResource\"></div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-header\">\n          <h3 class=\"stat-title\">订单总数</h3>\n          <span class=\"stat-icon order\"><i class=\"el-icon-s-order\"></i></span>\n        </div>\n        <div class=\"stat-body\">\n          <div class=\"stat-value\">{{ stats.orderCount || 0 }}</div>\n          <div class=\"stat-change positive\">+23% <span>较上月</span></div>\n        </div>\n        <div class=\"stat-chart\" ref=\"chartOrder\"></div>\n      </div>\n    </div>\n\n    <!-- 主要内容区域 -->\n    <div class=\"main-content\">\n      <!-- 左侧：图表区域 -->\n      <div class=\"chart-section\">\n        <div class=\"section-header\">\n          <h2 class=\"section-title\">平台活跃度趋势</h2>\n          <div class=\"section-actions\">\n            <el-button size=\"small\" type=\"primary\" plain>周</el-button>\n            <el-button size=\"small\" type=\"primary\">月</el-button>\n            <el-button size=\"small\" type=\"primary\" plain>年</el-button>\n          </div>\n        </div>\n        <div class=\"chart-container\" ref=\"mainChart\"></div>\n      </div>\n\n      <!-- 右侧：快捷功能和待办事项 -->\n      <div class=\"right-panel\">\n        <!-- 快捷功能 -->\n        <div class=\"panel-section\">\n          <h3 class=\"panel-title\">快捷功能</h3>\n          <div class=\"quick-actions\">\n            <div class=\"quick-action-item\" @click=\"$router.push('/admin-users')\">\n              <span class=\"action-icon user\"><i class=\"el-icon-user\"></i></span>\n              <span class=\"action-text\">用户管理</span>\n            </div>\n            <div class=\"quick-action-item\" @click=\"$router.push('/admin-roles')\">\n              <span class=\"action-icon role\"><i class=\"el-icon-s-custom\"></i></span>\n              <span class=\"action-text\">角色权限</span>\n            </div>\n            <div class=\"quick-action-item\" @click=\"$router.push('/admin-audit')\">\n              <span class=\"action-icon audit\"><i class=\"el-icon-document-checked\"></i></span>\n              <span class=\"action-text\">内容审核</span>\n            </div>\n            <div class=\"quick-action-item\" @click=\"$router.push('/admin-stats')\">\n              <span class=\"action-icon stats\"><i class=\"el-icon-data-analysis\"></i></span>\n              <span class=\"action-text\">数据统计</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- 待办事项 -->\n        <div class=\"panel-section\">\n          <h3 class=\"panel-title\">待办事项</h3>\n          <div class=\"todo-list\">\n            <div \n              v-for=\"(item, index) in todoList\" \n              :key=\"index\" \n              class=\"todo-item\"\n              :class=\"{ 'completed': item.done }\"\n            >\n              <div class=\"todo-checkbox\" @click=\"item.done = !item.done\">\n                <i v-if=\"item.done\" class=\"el-icon-check\"></i>\n              </div>\n              <div class=\"todo-content\">\n                <h4 class=\"todo-title\">{{ item.title }}</h4>\n                <p class=\"todo-due\">{{ item.due }}</p>\n              </div>\n              <div class=\"todo-priority\" :class=\"'priority-' + item.priority\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport * as echarts from 'echarts'\nimport { adminStats } from '@/api/admin'\nexport default {\n  name: 'AdminDashboard',\n  data() {\n    return {\n      stats: {},\n      todoList: [\n        { title: '审核待通过项目 3 条', due: '今日', priority: 1, done: false },\n        { title: '新用户注册待查看 5 人', due: '今日', priority: 2, done: false },\n        { title: '服务订单待确认 2 单', due: '明日', priority: 2, done: false },\n        { title: '系统配置备份', due: '本周', priority: 3, done: false },\n        { title: '数据统计报表导出', due: '本周', priority: 3, done: true },\n        { title: '操作日志归档', due: '本月', priority: 3, done: false }\n      ],\n      charts: []\n    }\n  },\n  created() {\n    adminStats.overview().then((res) => {\n      this.stats = res || {}\n      }).catch(() => {\n      this.stats = { userCount: 12, projectCount: 8, resourceCount: 6, orderCount: 28 }\n    })\n  },\n  mounted() {\n    this.$nextTick(() => {\n      this.initMiniCharts()\n      this.initMainChart()\n    })\n  },\n  beforeDestroy() {\n    this.charts.forEach((c) => c && c.dispose())\n  },\n  methods: {\n    initMiniCharts() {\n      const opts = {\n        grid: { left: 0, right: 0, top: 4, bottom: 0 },\n        xAxis: { show: false, type: 'category', data: ['1', '2', '3', '4', '5', '6', '7'] },\n        yAxis: { show: false, type: 'value' },\n        series: [{ type: 'line', data: [2, 5, 4, 8, 6, 9, 12], smooth: true, symbol: 'none', lineStyle: { width: 2, color: '#007dff' }, areaStyle: { color: 'rgba(0,125,255,0.15)' } }]\n      }\n      ;['chartUser', 'chartProject', 'chartResource', 'chartOrder'].forEach((ref, i) => {\n        const el = this.$refs[ref]\n        if (el) {\n          const chart = echarts.init(el)\n          chart.setOption({ ...opts, series: [{ ...opts.series[0], data: [1, 3, 4, 6, 5, 8, 10].map((v) => v + i * 2) }] })\n          this.charts.push(chart)\n        }\n      })\n    },\n    initMainChart() {\n      const el = this.$refs.mainChart\n      if (el) {\n        const chart = echarts.init(el)\n        const option = {\n          tooltip: {\n            trigger: 'axis',\n            axisPointer: {\n              type: 'cross',\n              label: {\n                backgroundColor: '#6a7985'\n              }\n            }\n          },\n          legend: {\n            data: ['用户注册', '项目发布', '服务订单'],\n            top: 0\n          },\n          grid: {\n            left: '3%',\n            right: '4%',\n            bottom: '3%',\n            containLabel: true\n          },\n          xAxis: {\n            type: 'category',\n            boundaryGap: false,\n            data: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']\n          },\n          yAxis: {\n            type: 'value'\n          },\n          series: [\n            {\n              name: '用户注册',\n              type: 'line',\n              stack: 'Total',\n              areaStyle: {\n                color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\n                  { offset: 0, color: 'rgba(0, 125, 255, 0.5)' },\n                  { offset: 1, color: 'rgba(0, 125, 255, 0.1)' }\n                ])\n              },\n              emphasis: {\n                focus: 'series'\n              },\n              data: [120, 132, 101, 134, 90, 230, 210, 250, 220, 300, 280, 350]\n            },\n            {\n              name: '项目发布',\n              type: 'line',\n              stack: 'Total',\n              areaStyle: {\n                color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\n                  { offset: 0, color: 'rgba(16, 185, 129, 0.5)' },\n                  { offset: 1, color: 'rgba(16, 185, 129, 0.1)' }\n                ])\n              },\n              emphasis: {\n                focus: 'series'\n              },\n              data: [220, 182, 191, 234, 290, 330, 310, 350, 320, 400, 380, 450]\n            },\n            {\n              name: '服务订单',\n              type: 'line',\n              stack: 'Total',\n              areaStyle: {\n                color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\n                  { offset: 0, color: 'rgba(245, 158, 11, 0.5)' },\n                  { offset: 1, color: 'rgba(245, 158, 11, 0.1)' }\n                ])\n              },\n              emphasis: {\n                focus: 'series'\n              },\n              data: [150, 232, 201, 154, 190, 330, 410, 450, 420, 500, 480, 550]\n            }\n          ]\n        }\n        chart.setOption(option)\n        this.charts.push(chart)\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* 全局样式 */\n.admin-dashboard {\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 24px;\n  background: #f8fafc;\n  min-height: 100vh;\n}\n\n/* 顶部欢迎卡片 */\n.top-cards {\n  margin-bottom: 32px;\n}\n\n.welcome-card {\n  background: white;\n  border-radius: 16px;\n  padding: 32px;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.welcome-content {\n  flex: 1;\n}\n\n.welcome-title {\n  font-size: 28px;\n  font-weight: 700;\n  color: #1e293b;\n  margin-bottom: 8px;\n}\n\n.welcome-subtitle {\n  font-size: 16px;\n  color: #64748b;\n}\n\n.welcome-avatar {\n  width: 80px;\n  height: 80px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #007dff, #004c99);\n  color: white;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 32px;\n  font-weight: 600;\n  box-shadow: 0 4px 12px rgba(0, 125, 255, 0.3);\n}\n\n/* 数据概览卡片 */\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 24px;\n  margin-bottom: 32px;\n}\n\n.stat-card {\n  background: white;\n  border-radius: 16px;\n  padding: 24px;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n.stat-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n}\n\n.stat-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 20px;\n}\n\n.stat-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #64748b;\n}\n\n.stat-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 24px;\n  color: white;\n}\n\n.stat-icon.user {\n  background: linear-gradient(135deg, #007dff, #004c99);\n}\n\n.stat-icon.project {\n  background: linear-gradient(135deg, #10b981, #059669);\n}\n\n.stat-icon.service {\n  background: linear-gradient(135deg, #f59e0b, #d97706);\n}\n\n.stat-icon.order {\n  background: linear-gradient(135deg, #ef4444, #dc2626);\n}\n\n.stat-body {\n  margin-bottom: 16px;\n}\n\n.stat-value {\n  font-size: 32px;\n  font-weight: 700;\n  color: #1e293b;\n  margin-bottom: 8px;\n}\n\n.stat-change {\n  font-size: 14px;\n  font-weight: 500;\n}\n\n.stat-change.positive {\n  color: #10b981;\n}\n\n.stat-change.positive span {\n  color: #64748b;\n  font-weight: 400;\n}\n\n.stat-chart {\n  height: 60px;\n  margin-top: 16px;\n}\n\n/* 主要内容区域 */\n.main-content {\n  display: grid;\n  grid-template-columns: 2fr 1fr;\n  gap: 32px;\n}\n\n/* 图表区域 */\n.chart-section {\n  background: white;\n  border-radius: 16px;\n  padding: 24px;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 24px;\n}\n\n.section-title {\n  font-size: 20px;\n  font-weight: 600;\n  color: #1e293b;\n}\n\n.section-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.chart-container {\n  height: 400px;\n}\n\n/* 右侧面板 */\n.right-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n.panel-section {\n  background: white;\n  border-radius: 16px;\n  padding: 24px;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n}\n\n.panel-title {\n  font-size: 18px;\n  font-weight: 600;\n  color: #1e293b;\n  margin-bottom: 20px;\n}\n\n/* 快捷功能 */\n.quick-actions {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 16px;\n}\n\n.quick-action-item {\n  background: #f8fafc;\n  border-radius: 12px;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  border: 2px solid transparent;\n}\n\n.quick-action-item:hover {\n  background: #e2e8f0;\n  border-color: #007dff;\n  transform: translateY(-2px);\n}\n\n.action-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 24px;\n  color: white;\n}\n\n.action-icon.user {\n  background: linear-gradient(135deg, #007dff, #004c99);\n}\n\n.action-icon.role {\n  background: linear-gradient(135deg, #8b5cf6, #7c3aed);\n}\n\n.action-icon.audit {\n  background: linear-gradient(135deg, #10b981, #059669);\n}\n\n.action-icon.stats {\n  background: linear-gradient(135deg, #f59e0b, #d97706);\n}\n\n.action-text {\n  font-size: 14px;\n  font-weight: 500;\n  color: #1e293b;\n}\n\n/* 待办事项 */\n.todo-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.todo-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 16px;\n  background: #f8fafc;\n  border-radius: 12px;\n  transition: all 0.2s ease;\n}\n\n.todo-item:hover {\n  background: #e2e8f0;\n}\n\n.todo-item.completed {\n  opacity: 0.7;\n}\n\n.todo-checkbox {\n  width: 20px;\n  height: 20px;\n  border: 2px solid #007dff;\n  border-radius: 4px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  flex-shrink: 0;\n}\n\n.todo-checkbox:hover {\n  background: rgba(0, 125, 255, 0.1);\n}\n\n.todo-item.completed .todo-checkbox {\n  background: #007dff;\n  color: white;\n}\n\n.todo-content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.todo-title {\n  font-size: 14px;\n  font-weight: 500;\n  color: #1e293b;\n}\n\n.todo-item.completed .todo-title {\n  text-decoration: line-through;\n  color: #94a3b8;\n}\n\n.todo-due {\n  font-size: 12px;\n  color: #64748b;\n}\n\n.todo-priority {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.todo-priority.priority-1 {\n  background: #ef4444;\n}\n\n.todo-priority.priority-2 {\n  background: #f59e0b;\n}\n\n.todo-priority.priority-3 {\n  background: #94a3b8;\n}\n\n/* 响应式设计 */\n@media (max-width: 1200px) {\n  .admin-dashboard {\n    padding: 16px;\n  }\n  \n  .main-content {\n    grid-template-columns: 1fr;\n  }\n  \n  .stats-grid {\n    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  }\n  \n  .welcome-card {\n    flex-direction: column;\n    text-align: center;\n    gap: 24px;\n  }\n}\n\n@media (max-width: 768px) {\n  .admin-dashboard {\n    padding: 12px;\n  }\n  \n  .welcome-title {\n    font-size: 24px;\n  }\n  \n  .stats-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .quick-actions {\n    grid-template-columns: 1fr;\n  }\n  \n  .chart-container {\n    height: 300px;\n  }\n}\n</style>\n"]