Detail.vue"],"sourcesContent":["<template>\r\n  <div class=\"article-detail\">\r\n    <el-button @click=\"goBack\" type=\"text\" class=\"back-button\">\r\n      <el-icon><ArrowLeft /></el-icon> 返回列表\r\n    </el-button>\r\n    \r\n    <div v-if=\"article\" class=\"article-content\">\r\n      <h1 class=\"article-title\">{{ article.title }}</h1>\r\n      <div class=\"article-meta\">\r\n        <span class=\"source\">{{ article.source }}</span>\r\n        <span class=\"date\">{{ article.publicationDate }}</span>\r\n        <span class=\"category\">{{ article.category }}</span>\r\n      </div>\r\n      <div class=\"article-body\">\r\n        {{ article.content }}\r\n      </div>\r\n      <div class=\"article-footer\">\r\n        <span class=\"relevance\">相关度: {{ article.relevanceScore.toFixed(2) }}</span>\r\n        <el-button type=\"primary\" @click=\"toggleFavorite\">\r\n          <el-icon><Star /></el-icon> {{ isFavorited ? '取消收藏' : '收藏' }}\r\n        </el-button>\r\n      </div>\r\n    </div>\r\n    <div v-else class=\"loading\">\r\n      <div class=\"article-content\">\r\n        <el-skeleton :rows=\"1\" animated style=\"width: 80%; height: 32px; margin-bottom: 20px;\" />\r\n        <div class=\"article-meta\">\r\n          <el-skeleton :rows=\"1\" animated style=\"width: 100px; display: inline-block; margin-right: 15px;\" />\r\n          <el-skeleton :rows=\"1\" animated style=\"width: 120px; display: inline-block; margin-right: 15px;\" />\r\n          <el-skeleton :rows=\"1\" animated style=\"width: 80px; display: inline-block;\" />\r\n        </div>\r\n        <div style=\"margin-top: 30px;\">\r\n          <el-skeleton :rows=\"8\" animated />\r\n        </div>\r\n        <div class=\"article-footer\">\r\n          <el-skeleton :rows=\"1\" animated style=\"width: 100px;\" />\r\n          <el-skeleton :rows=\"1\" animated style=\"width: 100px; height: 36px;\" />\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getArticleById, toggleFavorite, isFavorited } from '@/api/article'\r\nimport { ArrowLeft, Star } from '@element-plus/icons-vue'\r\n\r\nexport default {\r\n  name: 'ArticleDetail',\r\n  components: {\r\n    ArrowLeft,\r\n    Star\r\n  },\r\n  data() {\r\n    return {\r\n      article: null,\r\n      isFavorited: false,\r\n      loading: true\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadArticle()\r\n  },\r\n  methods: {\r\n    loadArticle() {\r\n      this.loading = true\r\n      const id = this.$route.params.id\r\n      getArticleById(id).then(response => {\r\n        this.article = response.data\r\n        this.checkFavoriteStatus()\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    checkFavoriteStatus() {\r\n      const id = this.$route.params.id\r\n      isFavorited(id).then(response => {\r\n        this.isFavorited = response.data\r\n      })\r\n    },\r\n    goBack() {\r\n      this.$router.push('/article/list')\r\n    },\r\n    toggleFavorite() {\r\n      const id = this.$route.params.id\r\n      toggleFavorite(id).then(response => {\r\n        this.isFavorited = response.data\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.article-detail {\r\n  padding: 20px;\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.back-button {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.article-content {\r\n  background: #fff;\r\n  padding: 30px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.article-title {\r\n  font-size: 24px;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.article-meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 15px;\r\n  margin-bottom: 30px;\r\n  padding-bottom: 15px;\r\n  border-bottom: 1px solid #eee;\r\n  font-size: 14px;\r\n  color: #999;\r\n}\r\n\r\n.article-body {\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: #333;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.article-footer {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding-top: 15px;\r\n  border-top: 1px solid #eee;\r\n  font-size: 14px;\r\n  color: #999;\r\n}\r\n\r\n.loading {\r\n  background: #fff;\r\n  padding: 30px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4CA,SAAAA,cAAA,EAAAC,cAAA,IAAAA,eAAA,EAAAC,WAAA;AACA,SAAAC,SAAA,EAAAC,IAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAH,SAAA,EAAAA,SAAA;IACAC,IAAA,EAAAA;EACA;EACAG,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAN,WAAA;MACAO,OAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACAD,WAAA,WAAAA,YAAA;MAAA,IAAAE,KAAA;MACA,KAAAJ,OAAA;MACA,IAAAK,EAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,EAAA;MACAd,cAAA,CAAAc,EAAA,EAAAG,IAAA,WAAAC,QAAA;QACAL,KAAA,CAAAL,OAAA,GAAAU,QAAA,CAAAX,IAAA;QACAM,KAAA,CAAAM,mBAAA;MACA;QACAN,KAAA,CAAAJ,OAAA;MACA;IACA;IACAU,mBAAA,WAAAA,oBAAA;MAAA,IAAAC,MAAA;MACA,IAAAN,EAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,EAAA;MACAZ,WAAA,CAAAY,EAAA,EAAAG,IAAA,WAAAC,QAAA;QACAE,MAAA,CAAAlB,WAAA,GAAAgB,QAAA,CAAAX,IAAA;MACA;IACA;IACAc,MAAA,WAAAA,OAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAtB,cAAA,WAAAA,eAAA;MAAA,IAAAuB,MAAA;MACA,IAAAV,EAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,EAAA;MACAb,eAAA,CAAAa,EAAA,EAAAG,IAAA,WAAAC,QAAA;QACAM,MAAA,CAAAtB,WAAA,GAAAgB,QAAA,CAAAX,IAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}