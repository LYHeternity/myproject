"](function () {\n        _this.loading = false;\n      });\n    },\n    handleSizeChange: function handleSizeChange(size) {\n      this.pageSize = size;\n      this.loadPosts();\n    },\n    handleCurrentChange: function handleCurrentChange(current) {\n      this.currentPage = current;\n      this.loadPosts();\n    },\n    resetFilters: function resetFilters() {\n      this.searchKeyword = '';\n      this.searchCategory = '';\n      this.searchType = '';\n      this.searchStatus = '';\n      this.currentPage = 1;\n      this.loadPosts();\n    },\n    doExport: function doExport() {\n      try {\n        this.$message.success('导出成功');\n      } catch (error) {\n        console.error('Export error:', error);\n        this.$message.error('导出失败');\n      }\n    },\n    editPost: function editPost(id) {\n      this.dialogVisible = true;\n      this.currentPostId = id;\n      this.loadPostDetail(id);\n    },\n    viewPost: function viewPost(id) {\n      this.viewDialogVisible = true;\n      this.currentPostId = id;\n      this.loadPostDetail(id);\n    },\n    loadPostDetail: function loadPostDetail(id) {\n      var _this2 = this;\n      this.loadingDetail = true;\n      postAPI.getPostDetail(id).then(function (res) {\n        if (res.code === 200 && res.data) {\n          _this2.postForm = _objectSpread({}, res.data);\n        } else {\n          _this2.$message.error('加载帖子详情失败');\n        }\n      })[\"catch\"](function (err) {\n        console.error('加载帖子详情失败:', err);\n        _this2.$message.error('加载帖子详情失败');\n      })[\"finally\"](function () {\n        _this2.loadingDetail = false;\n      });\n    },\n    savePost: function savePost() {\n      var _this3 = this;\n      this.$refs.postForm.validate(function (valid) {\n        if (valid) {\n          _this3.saving = true;\n          postAPI.updatePost(_this3.currentPostId, _this3.postForm).then(function (res) {\n            if (res.code === 200) {\n              _this3.$message.success('更新成功');\n              _this3.dialogVisible = false;\n              _this3.loadPosts();\n            } else {\n              _this3.$message.error(res.message || '更新失败');\n            }\n          })[\"catch\"](function (err) {\n            console.error('更新帖子失败:', err);\n            _this3.$message.error('更新失败，请稍后重试');\n          })[\"finally\"](function () {\n            _this3.saving = false;\n          });\n        }\n      });\n    },\n    deletePost: function deletePost(id) {\n      var _this4 = this;\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(function () {\n        postAPI.deletePost(id).then(function (res) {\n          if (res.code === 200) {\n            _this4.$message.success('删除成功');\n            _this4.loadPosts();\n          } else {\n            _this4.$message.error(res.message || '删除失败');\n          }\n        })[\"catch\"](function (err) {\n          console.error('删除帖子失败:', err);\n          _this4.$message.error('删除失败，请稍后重试');\n        });\n      })[\"catch\"](function () {\n        // 取消删除\n      });\n    },\n    toggleStatus: function toggleStatus(post) {\n      var _this5 = this;\n      var newStatus = post.status === 1 ? 0 : 1;\n      postAPI.updatePost(post.id, {\n        status: newStatus\n      }).then(function (res) {\n        if (res.code === 200) {\n          post.status = newStatus;\n          _this5.$message.success('状态更新成功');\n        } else {\n          _this5.$message.error(res.message || '状态更新失败');\n        }\n      })[\"catch\"](function (err) {\n        console.error('更新状态失败:', err);\n        _this5.$message.error('状态更新失败，请稍后重试');\n      });\n    },\n    getTypeTagClass: function getTypeTagClass(type) {\n      var classMap = {\n        'article': 'tag-ai',\n        'question': 'tag-internet'\n      };\n      return classMap[type] || 'tag-default';\n    },\n    getStatusTagClass: function getStatusTagClass(status) {\n      var classMap = {\n        1: 'tag-status-active',\n        0: 'tag-status-inactive'\n      };\n      return classMap[status] || 'tag-default';\n    }\n  }\n};","map":{"version":3,"names":["postAPI","name","data","posts","loading","currentPage","pageSize","total","searchKeyword","searchCategory","searchType","searchStatus","mounted","loadPosts","methods","_this","getPostList","page","size","category","type","status","keyword","then","res","records","err","console","error","$message","handleSizeChange","handleCurrentChange","current","resetFilters","doExport","success","editPost","id","dialogVisible","currentPostId","loadPostDetail","viewPost","viewDialogVisible","_this2","loadingDetail","getPostDetail","code","postForm","_objectSpread","savePost","_this3","$refs","validate","valid","saving","updatePost","message","deletePost","_this4","$confirm","confirmButtonText","cancelButtonText","toggleStatus","post","_this5","newStatus","getTypeTagClass","classMap","getStatusTagClass"],"sources":["src/views/admin/CommunityManage.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-page\">\r\n    <div class=\"page-header-section\">\r\n      <div class=\"page-header-content\">\r\n        <h1 class=\"page-title\">社区管理</h1>\r\n        <p class=\"page-subtitle\">管理社区帖子，包括编辑、删除和状态管理</p>\r\n      </div>\r\n      <div class=\"page-header-actions\">\r\n        <el-button type=\"primary\" icon=\"el-icon-refresh\" @click=\"loadPosts\" class=\"primary-action-button\">\r\n          刷新数据\r\n        </el-button>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"project-management-section\">\r\n      <div class=\"section-header\">\r\n        <h2 class=\"section-title\">帖子列表</h2>\r\n        <div class=\"section-actions\">\r\n          <el-button type=\"primary\" icon=\"el-icon-download\" @click=\"doExport\" class=\"action-button\">\r\n            导出帖子\r\n          </el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 搜索筛选区域 -->\r\n      <div class=\"search-filter-section\">\r\n        <el-form inline class=\"search-form\">\r\n          <el-form-item label=\"关键词\">\r\n            <el-input v-model=\"searchKeyword\" placeholder=\"标题/内容\" clearable class=\"search-input\" />\r\n          </el-form-item>\r\n          <el-form-item label=\"分类\">\r\n            <el-select v-model=\"searchCategory\" clearable placeholder=\"全部\" class=\"filter-select\">\r\n              <el-option label=\"全部\" value=\"\"></el-option>\r\n              <el-option label=\"创业经验\" value=\"创业经验\" />\r\n              <el-option label=\"融资技巧\" value=\"融资技巧\" />\r\n              <el-option label=\"技术分享\" value=\"技术分享\" />\r\n              <el-option label=\"行业动态\" value=\"行业动态\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item label=\"类型\">\r\n            <el-select v-model=\"searchType\" clearable placeholder=\"全部\" class=\"filter-select\">\r\n              <el-option label=\"全部\" value=\"\"></el-option>\r\n              <el-option label=\"文章\" value=\"article\" />\r\n              <el-option label=\"问题\" value=\"question\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item label=\"状态\">\r\n            <el-select v-model=\"searchStatus\" clearable placeholder=\"全部\" class=\"filter-select\">\r\n              <el-option label=\"全部\" value=\"\"></el-option>\r\n              <el-option label=\"正常\" value=\"1\" />\r\n              <el-option label=\"禁用\" value=\"0\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item>\r\n            <el-button type=\"primary\" @click=\"loadPosts\" class=\"search-button\">\r\n              <i class=\"el-icon-search\"></i> 查询\r\n            </el-button>\r\n            <el-button @click=\"resetFilters\" class=\"reset-button\">\r\n              <i class=\"el-icon-refresh\"></i> 重置\r\n            </el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </div>\r\n\r\n      <!-- 帖子表格 -->\r\n      <div class=\"table-container\">\r\n        <el-table\r\n          v-loading=\"loading\"\r\n          :data=\"posts\"\r\n          style=\"width: 100%\"\r\n          class=\"project-table\"\r\n          stripe\r\n          :cell-style=\"{ backgroundColor: '#1e293b', color: '#f8fafc', borderBottom: '1px solid rgba(255, 255, 255, 0.08)' }\"\r\n          :header-cell-style=\"{ backgroundColor: '#334155', color: '#94a3b8', borderBottom: '1px solid rgba(255, 255, 255, 0.08)' }\"\r\n        >\r\n          <el-table-column prop=\"id\" label=\"ID\" width=\"80\" />\r\n          <el-table-column prop=\"title\" label=\"标题\" min-width=\"200\">\r\n            <template slot-scope=\"scope\">\r\n              <div class=\"project-title\">\r\n                <a :href=\"`/community/post/${scope.row.id}`\" target=\"_blank\" class=\"title-link\">{{ scope.row.title }}</a>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"type\" label=\"类型\" width=\"100\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag :class=\"getTypeTagClass(scope.row.type)\" effect=\"light\">\r\n                {{ scope.row.type === 'article' ? '文章' : '问题' }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"category\" label=\"分类\" width=\"120\" />\r\n          <el-table-column prop=\"userId\" label=\"作者ID\" width=\"80\" />\r\n          <el-table-column prop=\"viewCount\" label=\"浏览\" width=\"80\" />\r\n          <el-table-column prop=\"likeCount\" label=\"点赞\" width=\"80\" />\r\n          <el-table-column prop=\"commentCount\" label=\"评论\" width=\"80\" />\r\n          <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag :class=\"getStatusTagClass(scope.row.status)\" effect=\"light\">\r\n                {{ scope.row.status === 1 ? '正常' : '禁用' }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"createdAt\" label=\"创建时间\" width=\"180\" />\r\n          <el-table-column label=\"操作\" min-width=\"300\" align=\"right\">\r\n            <template slot-scope=\"scope\">\r\n              <div class=\"project-actions\">\r\n                <el-button type=\"primary\" size=\"small\" @click=\"editPost(scope.row.id)\" class=\"action-button primary\">\r\n                  <i class=\"el-icon-view\"></i> 查看\r\n                </el-button>\r\n                <el-button type=\"info\" size=\"small\" @click=\"editPost(scope.row.id)\" class=\"action-button\">\r\n                  <i class=\"el-icon-edit\"></i> 编辑\r\n                </el-button>\r\n                <el-button \r\n                  :type=\"scope.row.status === 1 ? 'danger' : 'success'\" \r\n                  size=\"small\" \r\n                  @click=\"toggleStatus(scope.row)\"\r\n                  class=\"action-button\"\r\n                >\r\n                  <i :class=\"scope.row.status === 1 ? 'el-icon-close' : 'el-icon-check'\">\r\n                  </i> {{ scope.row.status === 1 ? '禁用' : '启用' }}\r\n                </el-button>\r\n                <el-button type=\"danger\" size=\"small\" @click=\"deletePost(scope.row.id)\" class=\"action-button\">\r\n                  <i class=\"el-icon-delete\"></i> 删除\r\n                </el-button>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n\r\n        <!-- 空数据状态 -->\r\n        <div v-if=\"!loading && !posts.length\" class=\"empty-state\">\r\n          <div class=\"empty-icon-container\">\r\n            <i class=\"el-icon-document\"></i>\r\n          </div>\r\n          <h3 class=\"empty-title\">暂无帖子数据</h3>\r\n          <p class=\"empty-description\">当前筛选条件下没有找到帖子信息</p>\r\n          <el-button type=\"primary\" @click=\"resetFilters\" class=\"empty-action-button\">\r\n            重置筛选条件\r\n          </el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 分页控件 -->\r\n      <div class=\"pagination-section\" v-if=\"total > 0\">\r\n        <div class=\"pagination-info\">\r\n          共 {{ total }} 条记录，当前第 {{ currentPage }} 页\r\n        </div>\r\n        <el-pagination\r\n          @size-change=\"handleSizeChange\"\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"currentPage\"\r\n          :page-sizes=\"[10, 20, 50, 100]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          :total=\"total\"\r\n          class=\"pagination-controls\"\r\n        />\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { postAPI } from '@/api/community'\r\n\r\nexport default {\r\n  name: 'CommunityManage',\r\n  data() {\r\n    return {\r\n      posts: [],\r\n      loading: false,\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      searchKeyword: '',\r\n      searchCategory: '',\r\n      searchType: '',\r\n      searchStatus: ''\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadPosts()\r\n  },\r\n  methods: {\r\n    loadPosts() {\r\n      this.loading = true\r\n      postAPI.getPostList({\r\n        page: this.currentPage,\r\n        size: this.pageSize,\r\n        category: this.searchCategory,\r\n        type: this.searchType,\r\n        status: this.searchStatus,\r\n        keyword: this.searchKeyword\r\n      }).then(res => {\r\n        if (res.data && res.data.records) {\r\n          this.posts = res.data.records\r\n          this.total = res.data.total || 0\r\n        } else {\r\n          this.posts = []\r\n          this.total = 0\r\n        }\r\n      }).catch(err => {\r\n        console.error('加载帖子失败:', err)\r\n        this.$message.error('加载帖子失败')\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    handleSizeChange(size) {\r\n      this.pageSize = size\r\n      this.loadPosts()\r\n    },\r\n    handleCurrentChange(current) {\r\n      this.currentPage = current\r\n      this.loadPosts()\r\n    },\r\n    resetFilters() {\r\n      this.searchKeyword = ''\r\n      this.searchCategory = ''\r\n      this.searchType = ''\r\n      this.searchStatus = ''\r\n      this.currentPage = 1\r\n      this.loadPosts()\r\n    },\r\n    doExport() {\r\n      try {\r\n        this.$message.success('导出成功')\r\n      } catch (error) {\r\n        console.error('Export error:', error)\r\n        this.$message.error('导出失败')\r\n      }\r\n    },\r\n    editPost(id) {\r\n      this.dialogVisible = true\r\n      this.currentPostId = id\r\n      this.loadPostDetail(id)\r\n    },\r\n    viewPost(id) {\r\n      this.viewDialogVisible = true\r\n      this.currentPostId = id\r\n      this.loadPostDetail(id)\r\n    },\r\n    loadPostDetail(id) {\r\n      this.loadingDetail = true\r\n      postAPI.getPostDetail(id).then(res => {\r\n        if (res.code === 200 && res.data) {\r\n          this.postForm = { ...res.data }\r\n        } else {\r\n          this.$message.error('加载帖子详情失败')\r\n        }\r\n      }).catch(err => {\r\n        console.error('加载帖子详情失败:', err)\r\n        this.$message.error('加载帖子详情失败')\r\n      }).finally(() => {\r\n        this.loadingDetail = false\r\n      })\r\n    },\r\n    savePost() {\r\n      this.$refs.postForm.validate(valid => {\r\n        if (valid) {\r\n          this.saving = true\r\n          postAPI.updatePost(this.currentPostId, this.postForm).then(res => {\r\n            if (res.code === 200) {\r\n              this.$message.success('更新成功')\r\n              this.dialogVisible = false\r\n              this.loadPosts()\r\n            } else {\r\n              this.$message.error(res.message || '更新失败')\r\n            }\r\n          }).catch(err => {\r\n            console.error('更新帖子失败:', err)\r\n            this.$message.error('更新失败，请稍后重试')\r\n          }).finally(() => {\r\n            this.saving = false\r\n          })\r\n        }\r\n      })\r\n    },\r\n    deletePost(id) {\r\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        postAPI.deletePost(id).then(res => {\r\n          if (res.code === 200) {\r\n            this.$message.success('删除成功')\r\n            this.loadPosts()\r\n          } else {\r\n            this.$message.error(res.message || '删除失败')\r\n          }\r\n        }).catch(err => {\r\n          console.error('删除帖子失败:', err)\r\n          this.$message.error('删除失败，请稍后重试')\r\n        })\r\n      }).catch(() => {\r\n        // 取消删除\r\n      })\r\n    },\r\n    toggleStatus(post) {\r\n      const newStatus = post.status === 1 ? 0 : 1\r\n      postAPI.updatePost(post.id, { status: newStatus }).then(res => {\r\n        if (res.code === 200) {\r\n          post.status = newStatus\r\n          this.$message.success('状态更新成功')\r\n        } else {\r\n          this.$message.error(res.message || '状态更新失败')\r\n        }\r\n      }).catch(err => {\r\n        console.error('更新状态失败:', err)\r\n        this.$message.error('状态更新失败，请稍后重试')\r\n      })\r\n    },\r\n    getTypeTagClass(type) {\r\n      const classMap = {\r\n        'article': 'tag-ai',\r\n        'question': 'tag-internet'\r\n      }\r\n      return classMap[type] || 'tag-default'\r\n    },\r\n    getStatusTagClass(status) {\r\n      const classMap = {\r\n        1: 'tag-status-active',\r\n        0: 'tag-status-inactive'\r\n      }\r\n      return classMap[status] || 'tag-default'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 页面容器 */\r\n.admin-page {\r\n  padding: 20px;\r\n  background: #0f172a;\r\n  min-height: 100vh;\r\n  color: #f8fafc;\r\n}\r\n\r\n/* 页面头部区域 */\r\n.page-header-section {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  margin-bottom: 32px;\r\n  padding-bottom: 20px;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\r\n}\r\n\r\n.page-header-content {\r\n  flex: 1;\r\n}\r\n\r\n.page-title {\r\n  font-size: 32p