fix-icon=\"el-icon-search\"\r\n          @keyup.enter=\"handleSearch\"\r\n        >\r\n          <el-button slot=\"append\" @click=\"handleSearch\" type=\"primary\">搜索</el-button>\r\n        </el-input>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"filter-section\">\r\n      <el-select v-model=\"selectedCategory\" placeholder=\"选择分类\" @change=\"handleCategoryChange\">\r\n        <el-option label=\"全部\" value=\"\"></el-option>\r\n        <el-option label=\"创业资讯\" value=\"创业资讯\"></el-option>\r\n        <el-option label=\"投资融资\" value=\"投资融资\"></el-option>\r\n        <el-option label=\"科技创新\" value=\"科技创新\"></el-option>\r\n        <el-option label=\"政策法规\" value=\"政策法规\"></el-option>\r\n        <el-option label=\"创业故事\" value=\"创业故事\"></el-option>\r\n      </el-select>\r\n    </div>\r\n    \r\n    <div class=\"article-grid\">\r\n      <el-card\r\n        v-for=\"article in articles\"\r\n        :key=\"article.id\"\r\n        class=\"article-card\"\r\n        @click=\"navigateToDetail(article.id)\"\r\n        v-if=\"!loading\"\r\n      >\r\n        <div class=\"article-header\">\r\n          <h3>{{ article.title }}</h3>\r\n          <span class=\"category-tag\">{{ article.category }}</span>\r\n        </div>\r\n        <div class=\"article-meta\">\r\n          <span class=\"source\">{{ article.source }}</span>\r\n          <span class=\"date\">{{ article.publicationDate }}</span>\r\n        </div>\r\n        <div class=\"article-summary\">{{ article.contentSummary }}</div>\r\n        <div class=\"article-footer\">\r\n          <span class=\"relevance\">相关度: {{ article.relevanceScore.toFixed(2) }}</span>\r\n          <el-button type=\"text\" @click.stop=\"navigateToDetail(article.id)\">阅读全文</el-button>\r\n        </div>\r\n      </el-card>\r\n      \r\n      <!-- 骨架屏 -->\r\n      <div v-else class=\"skeleton-grid\">\r\n        <el-card class=\"article-card skeleton-card\" v-for=\"i in 6\" :key=\"i\">\r\n          <div class=\"skeleton-header\">\r\n            <el-skeleton :rows=\"1\" animated />\r\n            <el-skeleton :rows=\"1\" animated style=\"width: 80px;\" />\r\n          </div>\r\n          <div class=\"skeleton-meta\">\r\n            <el-skeleton :rows=\"1\" animated style=\"width: 100px;\" />\r\n            <el-skeleton :rows=\"1\" animated style=\"width: 120px;\" />\r\n          </div>\r\n          <el-skeleton :rows=\"3\" animated />\r\n          <div class=\"skeleton-footer\">\r\n            <el-skeleton :rows=\"1\" animated style=\"width: 100px;\" />\r\n            <el-skeleton :rows=\"1\" animated style=\"width: 80px;\" />\r\n          </div>\r\n        </el-card>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"pagination\">\r\n      <el-pagination\r\n        @size-change=\"handleSizeChange\"\r\n        @current-change=\"handleCurrentChange\"\r\n        :current-page=\"currentPage\"\r\n        :page-sizes=\"[10, 20, 50]\"\r\n        :page-size=\"pageSize\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\"\r\n        :total=\"total\"\r\n      ></el-pagination>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getArticles, searchArticles } from '@/api/article'\r\n\r\nexport default {\r\n  name: 'ArticleList',\r\n  data() {\r\n    return {\r\n      articles: [],\r\n      total: 0,\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      selectedCategory: '',\r\n      searchKeyword: '',\r\n      isSearching: false,\r\n      loading: false\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadArticles()\r\n    \r\n    // 监听新文章通知\r\n    window.addEventListener('newArticles', this.handleNewArticles)\r\n  },\r\n  beforeDestroy() {\r\n    // 移除事件监听器\r\n    window.removeEventListener('newArticles', this.handleNewArticles)\r\n  },\r\n  methods: {\r\n    loadArticles() {\r\n      this.loading = true\r\n      const params = {\r\n        category: this.selectedCategory,\r\n        page: this.currentPage,\r\n        size: this.pageSize\r\n      }\r\n      \r\n      getArticles(params).then(response => {\r\n        this.articles = response\r\n        // Assuming the backend returns total count in response\r\n        this.total = response.length\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    handleSearch() {\r\n      if (this.searchKeyword) {\r\n        this.loading = true\r\n        this.isSearching = true\r\n        const params = {\r\n          page: this.currentPage,\r\n          size: this.pageSize\r\n        }\r\n        searchArticles(this.searchKeyword, params).then(response => {\r\n          this.articles = response.data\r\n          this.total = response.data.length\r\n        }).finally(() => {\r\n          this.loading = false\r\n        })\r\n      } else {\r\n        this.isSearching = false\r\n        this.loadArticles()\r\n      }\r\n    },\r\n    handleCategoryChange() {\r\n      this.currentPage = 1\r\n      this.loadArticles()\r\n    },\r\n    handleSizeChange(size) {\r\n      this.pageSize = size\r\n      this.loadArticles()\r\n    },\r\n    handleCurrentChange(current) {\r\n      this.currentPage = current\r\n      this.loadArticles()\r\n    },\r\n    navigateToDetail(id) {\r\n      this.$router.push(`/article/detail/${id}`)\r\n    },\r\n    handleNewArticles(event) {\r\n      const articleCount = event.detail\r\n      this.$message({\r\n        message: `有 ${articleCount} 篇新的创业资讯`,\r\n        type: 'success',\r\n        duration: 3000\r\n      })\r\n      // 刷新文章列表\r\n      this.loadArticles()\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.article-list {\r\n  padding: 20px;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.header h1 {\r\n  font-size: 28px;\r\n  color: #333;\r\n  margin: 0;\r\n}\r\n\r\n.search-bar {\r\n  width: 400px;\r\n}\r\n\r\n.filter-section {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.article-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));\r\n  gap: 20px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.article-card {\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.article-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.article-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.article-header h3 {\r\n  font-size: 18px;\r\n  color: #333;\r\n  margin: 0;\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.category-tag {\r\n  background-color: #f0f0f0;\r\n  padding: 2px 8px;\r\n  border-radius: 10px;\r\n  font-size: 12px;\r\n  color: #666;\r\n}\r\n\r\n.article-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  font-size: 12px;\r\n  color: #999;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.article-summary {\r\n  font-size: 14px;\r\n  color: #666;\r\n  line-height: 1.5;\r\n  margin-bottom: 15px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n}\r\n\r\n.article-footer {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.relevance {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.pagination {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 30px;\r\n}\r\n\r\n.skeleton-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));\r\n  gap: 20px;\r\n}\r\n\r\n.skeleton-card {\r\n  height: 100%;\r\n}\r\n\r\n.skeleton-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.skeleton-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.skeleton-footer {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-top: 15px;\r\n}\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqFA,SAAAA,WAAA,EAAAC,cAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,QAAA;MACAC,KAAA;MACAC,WAAA;MACAC,QAAA;MACAC,gBAAA;MACAC,aAAA;MACAC,WAAA;MACAC,OAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,YAAA;;IAEA;IACAC,MAAA,CAAAC,gBAAA,qBAAAC,iBAAA;EACA;EACAC,aAAA,WAAAA,cAAA;IACA;IACAH,MAAA,CAAAI,mBAAA,qBAAAF,iBAAA;EACA;EACAG,OAAA;IACAN,YAAA,WAAAA,aAAA;MAAA,IAAAO,KAAA;MACA,KAAAT,OAAA;MACA,IAAAU,MAAA;QACAC,QAAA,OAAAd,gBAAA;QACAe,IAAA,OAAAjB,WAAA;QACAkB,IAAA,OAAAjB;MACA;MAEAP,WAAA,CAAAqB,MAAA,EAAAI,IAAA,WAAAC,QAAA;QACAN,KAAA,CAAAhB,QAAA,GAAAsB,QAAA;QACA;QACAN,KAAA,CAAAf,KAAA,GAAAqB,QAAA,CAAAC,MAAA;MACA;QACAP,KAAA,CAAAT,OAAA;MACA;IACA;IACAiB,YAAA,WAAAA,aAAA;MAAA,IAAAC,MAAA;MACA,SAAApB,aAAA;QACA,KAAAE,OAAA;QACA,KAAAD,WAAA;QACA,IAAAW,MAAA;UACAE,IAAA,OAAAjB,WAAA;UACAkB,IAAA,OAAAjB;QACA;QACAN,cAAA,MAAAQ,aAAA,EAAAY,MAAA,EAAAI,IAAA,WAAAC,QAAA;UACAG,MAAA,CAAAzB,QAAA,GAAAsB,QAAA,CAAAvB,IAAA;UACA0B,MAAA,CAAAxB,KAAA,GAAAqB,QAAA,CAAAvB,IAAA,CAAAwB,MAAA;QACA;UACAE,MAAA,CAAAlB,OAAA;QACA;MACA;QACA,KAAAD,WAAA;QACA,KAAAG,YAAA;MACA;IACA;IACAiB,oBAAA,WAAAA,qBAAA;MACA,KAAAxB,WAAA;MACA,KAAAO,YAAA;IACA;IACAkB,gBAAA,WAAAA,iBAAAP,IAAA;MACA,KAAAjB,QAAA,GAAAiB,IAAA;MACA,KAAAX,YAAA;IACA;IACAmB,mBAAA,WAAAA,oBAAAC,OAAA;MACA,KAAA3B,WAAA,GAAA2B,OAAA;MACA,KAAApB,YAAA;IACA;IACAqB,gBAAA,WAAAA,iBAAAC,EAAA;MACA,KAAAC,OAAA,CAAAC,IAAA,oBAAAC,MAAA,CAAAH,EAAA;IACA;IACAnB,iBAAA,WAAAA,kBAAAuB,KAAA;MACA,IAAAC,YAAA,GAAAD,KAAA,CAAAE,MAAA;MACA,KAAAC,QAAA;QACAC,OAAA,YAAAL,MAAA,CAAAE,YAAA;QACAI,IAAA;QACAC,QAAA;MACA;MACA;MACA,KAAAhC,YAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}