{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'AdminBackup',\n  data: function data() {\n    return {\n      backupList: []\n    };\n  }\n};","map":{"version":3,"names":["name","data","backupList"],"sources":["src/views/admin/Backup.vue"],"sourcesContent":["<template>\r\n  <div class=\"page-card\">\r\n    <h3>数据备份与恢复</h3>\r\n    <p class=\"section-desc\">对平台数据进行备份或从备份恢复，建议定期备份。</p>\r\n    <el-row :gutter=\"24\">\r\n      <el-col :span=\"12\">\r\n        <div class=\"backup-card\">\r\n          <i class=\"el-icon-download backup-icon\"></i>\r\n          <h4>备份数据</h4>\r\n          <p>将当前数据库导出为备份文件，可下载到本地保存。</p>\r\n          <el-button type=\"primary\" icon=\"el-icon-download\">立即备份</el-button>\r\n        </div>\r\n      </el-col>\r\n      <el-col :span=\"12\">\r\n        <div class=\"backup-card\">\r\n          <i class=\"el-icon-upload2 backup-icon\"></i>\r\n          <h4>恢复数据</h4>\r\n          <p>从已保存的备份文件中恢复数据，请谨慎操作。</p>\r\n          <el-button type=\"warning\" icon=\"el-icon-upload2\">选择文件恢复</el-button>\r\n        </div>\r\n      </el-col>\r\n    </el-row>\r\n    <div class=\"page-card\" style=\"margin-top:24px\">\r\n      <h3>备份记录</h3>\r\n      <el-table :data=\"backupList\" border stripe>\r\n        <el-table-column prop=\"name\" label=\"备份名称\" width=\"200\" />\r\n        <el-table-column prop=\"time\" label=\"备份时间\" width=\"180\" />\r\n        <el-table-column prop=\"size\" label=\"大小\" width=\"100\" />\r\n        <el-table-column label=\"操作\">\r\n          <template slot-scope=\"scope\">\r\n            <el-button type=\"text\" size=\"small\">下载</el-button>\r\n            <el-button type=\"text\" size=\"small\">恢复</el-button>\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n      <div class=\"data-empty\" v-if=\"!backupList.length\">\r\n        <div class=\"empty-icon\"><i class=\"el-icon-folder-opened\"></i></div>\r\n        暂无备份记录\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'AdminBackup',\r\n  data() {\r\n    return {\r\n      backupList: []\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.section-desc { color: #64748b; font-size: 14px; margin-bottom: 24px; }\r\n.backup-card {\r\n  background: #f8fafc;\r\n  border: 1px solid #e2e8f0;\r\n  border-radius: 12px;\r\n  padding: 28px;\r\n  text-align: center;\r\n}\r\n.backup-icon { font-size: 48px; color: #3b82f6; margin-bottom: 16px; }\r\n.backup-card h4 { font-size: 16px; margin-bottom: 8px; color: #0f172a; }\r\n.backup-card p { font-size: 13px; color: #64748b; margin-bottom: 20px; line-height: 1.5; }\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4CA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}