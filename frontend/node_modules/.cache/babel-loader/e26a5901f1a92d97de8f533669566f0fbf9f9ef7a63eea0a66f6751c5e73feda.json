in-menu\"\r\n        background-color=\"transparent\"\r\n        text-color=\"#94a3b8\"\r\n        active-text-color=\"#fff\"\r\n        router\r\n      >\r\n        <el-menu-item index=\"/admin\" class=\"menu-item\">\r\n          <i class=\"el-icon-s-home\"></i>\r\n          <span>工作台</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-users\" class=\"menu-item\">\r\n          <i class=\"el-icon-user\"></i>\r\n          <span>用户管理</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-roles\" class=\"menu-item\">\r\n          <i class=\"el-icon-s-custom\"></i>\r\n          <span>角色权限</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-audit\" class=\"menu-item\">\r\n          <i class=\"el-icon-document-checked\"></i>\r\n          <span>内容审核</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-stats\" class=\"menu-item\">\r\n          <i class=\"el-icon-data-analysis\"></i>\r\n          <span>数据统计</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-config\" class=\"menu-item\">\r\n          <i class=\"el-icon-setting\"></i>\r\n          <span>系统设置</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-log\" class=\"menu-item\">\r\n          <i class=\"el-icon-document\"></i>\r\n          <span>操作日志</span>\r\n        </el-menu-item>\r\n        <el-menu-item index=\"/admin-backup\" class=\"menu-item\">\r\n          <i class=\"el-icon-folder-opened\"></i>\r\n          <span>数据备份</span>\r\n        </el-menu-item>\r\n      </el-menu>\r\n    </el-aside>\r\n\r\n    <el-container direction=\"vertical\" class=\"main-wrap\">\r\n      <!-- 顶栏：高端深色导航 -->\r\n      <header class=\"main-header\">\r\n        <div class=\"header-left\">\r\n          <router-link to=\"/home\" class=\"nav-brand\">\r\n            <i class=\"el-icon-s-home\"></i>\r\n            <span>首页</span>\r\n          </router-link>\r\n          <nav class=\"nav-links\" v-if=\"!isAdmin\">\r\n            <router-link to=\"/projects\" class=\"nav-link\">项目大厅</router-link>\r\n            <router-link to=\"/services\" class=\"nav-link\">服务市场</router-link>\r\n            <template v-if=\"isEntrepreneur\">\r\n              <router-link to=\"/project-publish\" class=\"nav-link\">发布项目</router-link>\r\n              <router-link to=\"/my-projects\" class=\"nav-link\">我的项目</router-link>\r\n            </template>\r\n            <template v-if=\"isInvestor\">\r\n              <router-link to=\"/my-investments\" class=\"nav-link\">投资意向</router-link>\r\n            </template>\r\n            <template v-if=\"isProvider\">\r\n              <router-link to=\"/service-publish\" class=\"nav-link\">发布服务</router-link>\r\n              <router-link to=\"/my-services\" class=\"nav-link\">我的服务</router-link>\r\n              <router-link to=\"/provider-orders\" class=\"nav-link\">服务订单</router-link>\r\n            </template>\r\n            <router-link to=\"/my-orders\" class=\"nav-link\">我的订单</router-link>\r\n            <router-link to=\"/messages\" class=\"nav-link\">\r\n              <i class=\"el-icon-message\"></i> 消息\r\n            </router-link>\r\n          </nav>\r\n        </div>\r\n        <div class=\"header-right\">\r\n          <div class=\"user-wrap\">\r\n            <div class=\"user-avatar\">\r\n              {{ (user.realName || user.username || 'U').charAt(0) }}\r\n            </div>\r\n            <el-dropdown trigger=\"click\" @command=\"handleCommand\" class=\"user-dropdown\">\r\n              <span class=\"user-info\">\r\n                <span class=\"user-name\">{{ user.realName || user.username }}</span>\r\n                <i class=\"el-icon-arrow-down el-icon--right\"></i>\r\n              </span>\r\n              <el-dropdown-menu slot=\"dropdown\" class=\"header-dropdown\">\r\n                <el-dropdown-item command=\"profile\">\r\n                  <i class=\"el-icon-user\"></i> 个人中心\r\n                </el-dropdown-item>\r\n                <el-dropdown-item command=\"logout\" divided>\r\n                  <i class=\"el-icon-switch-button\"></i> 退出登录\r\n                </el-dropdown-item>\r\n              </el-dropdown-menu>\r\n            </el-dropdown>\r\n          </div>\r\n        </div>\r\n      </header>\r\n\r\n      <el-main class=\"main-content\">\r\n        <router-view />\r\n      </el-main>\r\n    </el-container>\r\n  </el-container>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapGetters, mapActions } from 'vuex'\r\nexport default {\r\n  name: 'Layout',\r\n  computed: {\r\n    ...mapState('user', ['username', 'realName']),\r\n    user() {\r\n      return { username: this.username, realName: this.realName }\r\n    },\r\n    ...mapGetters('user', ['isAdmin', 'isEntrepreneur', 'isInvestor', 'isProvider'])\r\n  },\r\n  methods: {\r\n    ...mapActions('user', ['logout']),\r\n    handleCommand(cmd) {\r\n      if (cmd === 'profile') this.$router.push('/profile')\r\n      if (cmd === 'logout') {\r\n        this.logout()\r\n        this.$router.push('/login')\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.app-layout { min-height: 100vh; }\r\n.admin-sidebar {\r\n  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);\r\n  box-shadow: 4px 0 24px rgba(0,0,0,.12);\r\n}\r\n.sidebar-logo {\r\n  height: 64px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  border-bottom: 1px solid rgba(255,255,255,.06);\r\n}\r\n.logo-icon { font-size: 24px; color: #3b82f6; }\r\n.logo-text {\r\n  font-size: 17px;\r\n  font-weight: 700;\r\n  color: #f1f5f9;\r\n  letter-spacing: 0.5px;\r\n}\r\n.admin-menu { border-right: none; padding: 12px 0; }\r\n.admin-menu .menu-item {\r\n  margin: 4px 12px;\r\n  border-radius: 10px;\r\n  height: 48px;\r\n  line-height: 48px;\r\n  transition: all .2s ease;\r\n}\r\n.admin-menu .menu-item i { margin-right: 10px; font-size: 18px; }\r\n.admin-menu .menu-item:hover { background: rgba(255,255,255,.06) !important; color: #e2e8f0; }\r\n.admin-menu .menu-item.is-active {\r\n  background: linear-gradient(90deg, rgba(59,130,246,.25) 0%, rgba(59,130,246,.1) 100%) !important;\r\n  color: #fff;\r\n}\r\n\r\n.main-wrap { flex: 1; min-width: 0; }\r\n.main-header {\r\n  height: var(--header-height);\r\n  background: var(--header-bg);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 28px;\r\n  box-shadow: 0 4px 20px rgba(0,0,0,.15);\r\n  position: relative;\r\n  z-index: 100;\r\n}\r\n.header-left { display: flex; align-items: center; gap: 8px; }\r\n.nav-brand {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  color: #fff;\r\n  text-decoration: none;\r\n  font-weight: 600;\r\n  font-size: 15px;\r\n  padding: 8px 14px;\r\n  border-radius: 10px;\r\n  margin-right: 16px;\r\n  transition: background .2s;\r\n}\r\n.nav-brand:hover { background: rgba(255,255,255,.1); color: #fff; }\r\n.nav-brand i { font-size: 18px; }\r\n.nav-links { display: flex; align-items: center; gap: 2px; }\r\n.nav-link {\r\n  color: rgba(255,255,255,.88);\r\n  text-decoration: none;\r\n  padding: 10px 16px;\r\n  border-radius: 10px;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  transition: all .2s ease;\r\n}\r\n.nav-link:hover { background: rgba(255,255,255,.12); color: #fff; }\r\n.nav-link.router-link-active { background: rgba(255,255,255,.15); color: #fff; }\r\n.nav-link i { margin-right: 4px; font-size: 14px; }\r\n\r\n.header-right { display: flex; align-items: center; }\r\n.user-wrap { display: flex; align-items: center; gap: 12px; }\r\n.user-avatar {\r\n  width: 36px;\r\n  height: 36px;\r\n  border-radius: 10px;\r\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\r\n  color: #fff;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-weight: 600;\r\n  font-size: 14px;\r\n}\r\n.user-dropdown { cursor: pointer; }\r\n.user-info {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  color: #fff;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  padding: 6px 10px;\r\n  border-radius: 8px;\r\n  transition: background .2s;\r\n}\r\n.user-info:hover { background: rgba(255,255,255,.1); }\r\n.user-info .el-icon--right { font-size: 12px; margin-left: 2px; }\r\n.main-content {\r\n  background: #f8fafc;\r\n  padding: 24px;\r\n  min-height: calc(100vh - var(--header-height));\r\n}\r\n</style>\r\n\r\n<style>\r\n.header-dropdown.el-dropdown-menu { border-radius: 12px; padding: 8px; box-shadow: 0 10px 40px rgba(0,0,0,.15); }\r\n.header-dropdown .el-dropdown-menu__item { border-radius: 8px; padding: 10px 16px; }\r\n.header-dropdown .el-dropdown-menu__item i { margin-right: 8px; }\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA+GA,SAAAA,QAAA,EAAAC,UAAA,EAAAC,UAAA;AACA;EACAC,IAAA;EACAC,QAAA,EAAAC,aAAA,CAAAA,aAAA,KACAL,QAAA;IACAM,IAAA,WAAAA,KAAA;MACA;QAAAC,QAAA,OAAAA,QAAA;QAAAC,QAAA,OAAAA;MAAA;IACA;EAAA,GACAP,UAAA,oEACA;EACAQ,OAAA,EAAAJ,aAAA,CAAAA,aAAA,KACAH,UAAA;IACAQ,aAAA,WAAAA,cAAAC,GAAA;MACA,IAAAA,GAAA,qBAAAC,OAAA,CAAAC,IAAA;MACA,IAAAF,GAAA;QACA,KAAAG,MAAA;QACA,KAAAF,OAAA,CAAAC,IAAA;MACA;IACA;EAAA;AAEA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}