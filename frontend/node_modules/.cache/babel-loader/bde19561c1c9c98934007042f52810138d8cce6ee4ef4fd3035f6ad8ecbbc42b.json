erator().m(function _callee() {\n        var id, _t;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              id = _this.$route.params.id;\n              _context.n = 2;\n              return getDetail(id);\n            case 2:\n              _this.project = _context.v;\n              _context.p = 3;\n              _context.n = 4;\n              return isFavorited(id);\n            case 4:\n              _this.favorited = _context.v;\n              _context.n = 6;\n              break;\n            case 5:\n              _context.p = 5;\n              _t = _context.v;\n            case 6:\n              _context.p = 6;\n              _this.loading = false;\n              return _context.f(6);\n            case 7:\n              return _context.a(2);\n          }\n        }, _callee, null, [[3, 5], [1,, 6, 7]]);\n      }))();\n    },\n    toggleFavorite: function toggleFavorite() {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.n) {\n            case 0:\n              _context2.n = 1;\n              return _toggleFavorite(_this2.project.id);\n            case 1:\n              _this2.favorited = !_this2.favorited;\n              _this2.project.likeCount += _this2.favorited ? 1 : -1;\n              _this2.$message.success(_this2.favorited ? '已收藏' : '已取消');\n            case 2:\n              return _context2.a(2);\n          }\n        }, _callee2);\n      }))();\n    },\n    submitIntent: function submitIntent() {\n      var _this3 = this;\n      this.$refs.intentForm.validate(/*#__PURE__*/function () {\n        var _ref = _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3(valid) {\n          var _e$response, _t2;\n          return _regenerator().w(function (_context3) {\n            while (1) switch (_context3.p = _context3.n) {\n              case 0:\n                if (valid) {\n                  _context3.n = 1;\n                  break;\n                }\n                return _context3.a(2);\n              case 1:\n                _context3.p = 1;\n                _context3.n = 2;\n                return submit({\n                  projectId: _this3.project.id,\n                  amount: _this3.intentForm.amount,\n                  duration: _this3.intentForm.duration,\n                  description: _this3.intentForm.description,\n                  contactInfo: _this3.intentForm.contactInfo\n                });\n              case 2:\n                _this3.$message.success('已提交投资意向');\n                _this3.showIntent = false;\n                _context3.n = 4;\n                break;\n              case 3:\n                _context3.p = 3;\n                _t2 = _context3.v;\n                _this3.$message.error(((_e$response = _t2.response) === null || _e$response === void 0 || (_e$response = _e$response.data) === null || _e$response === void 0 ? void 0 : _e$response.message) || '提交失败');\n              case 4:\n                return _context3.a(2);\n            }\n          }, _callee3, null, [[1, 3]]);\n        }));\n        return function (_x) {\n          return _ref.apply(this, arguments);\n        };\n      }());\n    },\n    getStatusText: function getStatusText(status) {\n      var statusMap = {\n        'draft': '草稿',\n        'pending': '审核中',\n        'published': '已发布',\n        'rejected': '已拒绝',\n        'closed': '已关闭'\n      };\n      return statusMap[status] || '未知状态';\n    },\n    formatDate: function formatDate(dateString) {\n      if (!dateString) return '未知时间';\n      var date = new Date(dateString);\n      return date.toLocaleDateString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit'\n      });\n    },\n    goToProject: function goToProject(id) {\n      this.$router.push(\"/project/\".concat(id));\n    }\n  }\n};","map":{"version":3,"names":["getDetail","toggleFavorite","isFavorited","submit","mapGetters","name","data","loading","project","favorited","showIntent","showContact","intentForm","amount","duration","description","contactInfo","intentRules","required","message","trigger","mockMilestones","title","date","mockTeamMembers","role","relatedProjects","id","industry","stage","fundingNeeded","computed","_objectSpread","created","load","methods","_this","_asyncToGenerator","_regenerator","m","_callee","_t","w","_context","p","n","$route","params","v","f","a","_this2","_callee2","_context2","likeCount","$message","success","submitIntent","_this3","$refs","validate","_ref","_callee3","valid","_e$response","_t2","_context3","projectId","error","response","_x","apply","arguments","getStatusText","status","statusMap","formatDate","dateString","Date","toLocaleDateString","year","month","day","goToProject","$router","push","concat"],"sources":["src/views/project/Detail.vue"],"sourcesContent":["<template>\n  <div class=\"project-detail-page\" v-loading=\"loading\">\n    <template v-if=\"project\">\n      <!-- 项目头部信息 -->\n      <div class=\"project-header\">\n        <div class=\"header-content\">\n          <div class=\"header-left\">\n            <div class=\"project-status-badge\" :class=\"project.status\">\n              {{ getStatusText(project.status) }}\n            </div>\n            <h1 class=\"project-title\">{{ project.title }}</h1>\n            <p class=\"project-subtitle\">{{ project.subtitle || '创新项目，引领未来' }}</p>\n            <div class=\"project-meta\">\n              <div class=\"meta-item\">\n                <i class=\"el-icon-s-marketing meta-icon\"></i>\n                <span class=\"meta-label\">行业</span>\n                <span class=\"meta-value\">{{ project.industry }}</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-s-order meta-icon\"></i>\n                <span class=\"meta-label\">阶段</span>\n                <span class=\"meta-value\">{{ project.stage }}</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-coin meta-icon\"></i>\n                <span class=\"meta-label\">融资需求</span>\n                <span class=\"meta-value\">{{ project.fundingNeeded }}万</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-s-finance meta-icon\"></i>\n                <span class=\"meta-label\">出让股权</span>\n                <span class=\"meta-value\">{{ project.equityOffered }}%</span>\n              </div>\n            </div>\n            <div class=\"project-stats\">\n              <div class=\"stat-item\">\n                <i class=\"el-icon-view\"></i>\n                <span>{{ project.viewCount }}</span>\n                <span class=\"stat-label\">浏览</span>\n              </div>\n              <div class=\"stat-item\">\n                <i class=\"el-icon-thumb\"></i>\n                <span>{{ project.likeCount }}</span>\n                <span class=\"stat-label\">点赞</span>\n              </div>\n              <div class=\"stat-item\">\n                <i class=\"el-icon-time\"></i>\n                <span>{{ formatDate(project.createdAt) }}</span>\n                <span class=\"stat-label\">发布</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"header-right\">\n            <div class=\"action-buttons\">\n              <el-button \n                type=\"primary\" \n                size=\"large\" \n                @click=\"toggleFavorite\"\n                :class=\"{ 'favorited': favorited }\"\n              >\n                <i :class=\"favorited ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n                {{ favorited ? '已收藏' : '收藏项目' }}\n              </el-button>\n              <el-button \n                v-if=\"isInvestor\" \n                type=\"success\" \n                size=\"large\" \n                @click=\"showIntent = true\"\n              >\n                <i class=\"el-icon-s-flag\"></i>\n                提交投资意向\n              </el-button>\n              <el-button \n                type=\"info\" \n                size=\"large\" \n                @click=\"showContact = true\"\n              >\n                <i class=\"el-icon-phone\"></i>\n                联系创始人\n              </el-button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 项目详情内容 -->\n      <div class=\"project-content\">\n        <div class=\"content-left\">\n          <!-- 项目介绍 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-document\"></i>\n                <h3 class=\"card-title\">项目介绍</h3>\n              </div>\n            </template>\n            <div class=\"project-description\" v-html=\"project.description\" />\n          </el-card>\n\n          <!-- 市场分析 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-data-analysis\"></i>\n                <h3 class=\"card-title\">市场分析</h3>\n              </div>\n            </template>\n            <div class=\"market-analysis\">\n              <div class=\"analysis-item\">\n                <h4>市场规模</h4>\n                <p>{{ project.marketSize || '该项目尚未提供市场规模分析' }}</p>\n              </div>\n              <div class=\"analysis-item\">\n                <h4>目标用户</h4>\n                <p>{{ project.targetUsers || '该项目尚未提供目标用户分析' }}</p>\n              </div>\n              <div class=\"analysis-item\">\n                <h4>竞争优势</h4>\n                <p>{{ project.competitiveAdvantage || '该项目尚未提供竞争优势分析' }}</p>\n              </div>\n            </div>\n          </el-card>\n\n          <!-- 项目进展 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-flag\"></i>\n                <h3 class=\"card-title\">项目进展</h3>\n              </div>\n            </template>\n            <div class=\"project-milestones\">\n              <div \n                v-for=\"(milestone, index) in project.milestones || mockMilestones\" \n                :key=\"index\"\n                class=\"milestone-item\"\n              >\n                <div class=\"milestone-dot\"></div>\n                <div class=\"milestone-content\">\n                  <h4 class=\"milestone-title\">{{ milestone.title }}</h4>\n                  <p class=\"milestone-description\">{{ milestone.description }}</p>\n                  <span class=\"milestone-date\">{{ milestone.date }}</span>\n                </div>\n              </div>\n            </div>\n          </el-card>\n        </div>\n\n        <div class=\"content-right\">\n          <!-- 创始人信息 -->\n          <el-card class=\"content-card founder-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-user\"></i>\n                <h3 class=\"card-title\">创始人信息</h3>\n              </div>\n            </template>\n            <div class=\"founder-info\">\n              <div class=\"founder-avatar\">\n                <img v-if=\"project.founderAvatar\" :src=\"project.founderAvatar\" class=\"founder-avatar-image\" alt=\"创始人头像\" />\n                <span v-else>{{ (project.founderName || '创').charAt(0) }}</span>\n              </div>\n              <div class=\"founder-details\">\n                <h4 class=\"founder-name\">{{ project.founderName || '创始人' }}</h4>\n                <p class=\"founder-title\">{{ project.founderTitle || 'CEO' }}</p>\n                <p class=\"founder-bio\">{{ project.founderBio || '拥有丰富的行业经验和创业经历' }}</p>\n                <div class=\"founder-contact\">\n                  <div class=\"contact-item\">\n                    <i class=\"el-icon-phone\"></i>\n                    <span>{{ project.founderPhone || '*******1234' }}</span>\n                  </div>\n                  <div class=\"contact-item\">\n                    <i class=\"el-icon-message\"></i>\n                    <span>{{ project.founderEmail || 'founder@example.com' }}</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </el-card>\n\n          <!-- 团队介绍 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-flag\"></i>\n                <h3 class=\"card-title\">团队介绍</h3>\n              </div>\n            </template>\n            <div class=\"team-members\">\n              <div \n                v-for=\"(member, index) in project.teamMembers || mockTeamMembers\" \n                :key=\"index\"\n                class=\"team-member\"\n              >\n                <div class=\"member-avatar\">\n                    <img v-if=\"member.avatar\" :src=\"member.avatar\" class=\"member-avatar-image\" alt=\"团队成员头像\" />\n                    <span v-else>{{ member.name.charAt(0) }}</span>\n                  </div>\n                <div class=\"member-info\">\n                  <h5 class=\"member-name\">{{ member.name }}</h5>\n                  <p class=\"member-role\">{{ member.role }}</p>\n                </div>\n              </div>\n            </div>\n          </el-card>\n\n          <!-- 相关项目推荐 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-grid\"></i>\n                <h3 class=\"card-title\">相关项目</h3>\n              </div>\n            </template>\n            <div class=\"related-projects\">\n              <div \n                v-for=\"(item, index) in relatedProjects\" \n                :key=\"index\"\n                class=\"related-item\"\n                @click=\"goToProject(item.id)\"\n              >\n                <h5 class=\"related-title\">{{ item.title }}</h5>\n                <p class=\"related-info\">{{ item.industry }} | {{ item.stage }} | {{ item.fundingNeeded }}万</p>\n              </div>\n            </div>\n          </el-card>\n        </div>\n      </div>\n\n      <!-- 提交投资意向对话框 -->\n      <el-dialog \n        title=\"提交投资意向\" \n        :visible.sync=\"showIntent\" \n        width=\"600px\"\n        custom-class=\"intent-dialog\"\n      >\n        <el-form ref=\"intentForm\" :model=\"intentForm\" :rules=\"intentRules\" label-width=\"120px\">\n          <el-form-item label=\"投资金额(万)\" prop=\"amount\">\n            <el-input-number \n              v-model=\"intentForm.amount\" \n              :min=\"0\" \n              :step=\"10\" \n              style=\"width: 100%\"\n            />\n          </el-form-item>\n          <el-form-item label=\"投资期限\" prop=\"duration\">\n            <el-input \n              v-model=\"intentForm.duration\" \n              placeholder=\"如 3年\" \n              style=\"width: 100%\"\n            />\n          </el-form-item>\n          <el-form-item label=\"投资条件/说明\" prop=\"description\">\n            <el-input \n              v-model=\"intentForm.description\" \n              type=\"textarea\" \n              rows=\"4\" \n              placeholder=\"请详细描述您的投资条件和要求\"\n            />\n          </el-form-item>\n          <el-form-item label=\"联系方式\" prop=\"contactInfo\">\n            <el-input \n              v-model=\"intentForm.contactInfo\" \n              placeholder=\"请留下您的联系方式\"\n            />\n          </el-form-item>\n        </el-form>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"showIntent = false\">取消</el-button>\n          <el-button type=\"primary\" @click=\"submitIntent\">提交意向</el-button>\n        </span>\n      </el-dialog>\n\n      <!-- 联系创始人对话框 -->\n      <el-dialog \n        title=\"联系创始人\" \n        :visible.sync=\"showContact\" \n        width=\"500px\"\n        custom-class=\"contact-dialog\"\n      >\n        <div class=\"contact-info\">\n          <div class=\"contact-item\">\n            <i class=\"el-icon-phone\"></i>\n            <span class=\"contact-label\">电话：</span>\n            <span class=\"contact-value\">{{ project.founderPhone || '*******1234' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-message\"></i>\n            <span class=\"contact-label\">邮箱：</span>\n            <span class=\"contact-value\">{{ project.founderEmail || 'founder@example.com' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-chat-dot-round\"></i>\n            <span class=\"contact-label\">微信：</span>\n            <span class=\"contact-value\">{{ project.founderWechat || 'founder_wx' }}</span>\n          </div>\n        </div>\n        <div class=\"contact-note\">\n          <i class=\"el-icon-warning-outline\"></i>\n          <p>请在工作时间联系创始人，保持专业礼貌的沟通方式</p>\n        </div>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button type=\"primary\" @click=\"showContact = false\">我知道了</el-button>\n        </span>\n      </el-dialog>\n    </template>\n  </div>\n</template>\n\n<script>\nimport { getDetail, toggleFavorite, isFavorited } from '@/api/project'\nimport { submit } from '@/api/investment'\nimport { mapGetters } from 'vuex'\nexport default {\n  name: 'ProjectDetail',\n  data() {\n    return {\n      loading: false,\n      project: null,\n      favorited: false,\n      showIntent: false,\n      showContact: false,\n      intentForm: { \n        amount: 0, \n        duration: '', \n        description: '',\n        contactInfo: '' \n      },\n      intentRules: {\n        amount: [{ required: true, message: '请输入金额', trigger: 'blur' }],\n        contactInfo: [{ required: true, 