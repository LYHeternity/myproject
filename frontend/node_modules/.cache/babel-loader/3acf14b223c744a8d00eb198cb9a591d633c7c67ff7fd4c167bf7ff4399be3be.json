":3,"names":["mapState","mapGetters","mapActions","name","data","headerSolid","showDashboardBadge","pendingAudits","computed","_objectSpread","user","username","realName","mounted","window","addEventListener","onScroll","passive","beforeDestroy","removeEventListener","methods","scrollY","handleCommand","cmd","$router","push","logout"],"sources":["src/views/Layout.vue"],"sourcesContent":["<template>\n  <el-container class=\"app-layout\">\n    <!-- 管理员：左侧边栏 -->\n    <el-aside v-if=\"isAdmin\" class=\"admin-sidebar\" width=\"260px\">\n      <div class=\"sidebar-header\">\n        <div class=\"sidebar-logo\">\n          <i class=\"el-icon-s-platform logo-icon\"></i>\n          <span class=\"logo-text\">管理后台</span>\n        </div>\n        <div class=\"sidebar-version\">v1.0.0</div>\n      </div>\n      <el-menu\n        :default-active=\"$route.path\"\n        class=\"admin-menu\"\n        background-color=\"transparent\"\n        text-color=\"#94a3b8\"\n        active-text-color=\"#fff\"\n        router\n        :collapse-transition=\"false\"\n      >\n        <el-menu-item index=\"/admin\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-s-home menu-icon\"></i>\n            <span class=\"menu-text\">工作台</span>\n            <div class=\"menu-badge\" v-if=\"showDashboardBadge\">\n              <span class=\"badge-dot\"></span>\n            </div>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-users\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-user menu-icon\"></i>\n            <span class=\"menu-text\">用户管理</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-roles\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-s-custom menu-icon\"></i>\n            <span class=\"menu-text\">角色权限</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-audit\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-document-checked menu-icon\"></i>\n            <span class=\"menu-text\">内容审核</span>\n            <div class=\"menu-badge\" v-if=\"pendingAudits > 0\">\n              <span class=\"badge-count\">{{ pendingAudits }}</span>\n            </div>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-stats\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-data-analysis menu-icon\"></i>\n            <span class=\"menu-text\">数据统计</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-config\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-setting menu-icon\"></i>\n            <span class=\"menu-text\">系统设置</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-log\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-document menu-icon\"></i>\n            <span class=\"menu-text\">操作日志</span>\n          </div>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-backup\" class=\"menu-item\">\n          <div class=\"menu-item-content\">\n            <i class=\"el-icon-folder-opened menu-icon\"></i>\n            <span class=\"menu-text\">数据备份</span>\n          </div>\n        </el-menu-item>\n      </el-menu>\n      <div class=\"sidebar-footer\">\n        <div class=\"user-info\">\n          <div class=\"user-avatar\">\n            {{ (user.realName || user.username || 'A').charAt(0) }}\n          </div>\n          <div class=\"user-details\">\n            <div class=\"user-name\">{{ user.realName || user.username }}</div>\n            <div class=\"user-role\">管理员</div>\n          </div>\n        </div>\n        <div class=\"logout-btn\" @click=\"handleCommand('logout')\">\n          <i class=\"el-icon-switch-button\"></i>\n          <span>退出登录</span>\n        </div>\n      </div>\n    </el-aside>\n\n    <el-container direction=\"vertical\" class=\"main-wrap\">\n      <!-- 顶栏：吸顶 + 透明→实色 + 下拉动效 -->\n      <header class=\"home-header\">\n        <div class=\"header-container\">\n          <div class=\"header-content\">\n            <div class=\"logo\">\n              <router-link to=\"/home\" class=\"logo-text\" exact-active-class=\"nav-brand-active\">创业者平台</router-link>\n            </div>\n            <nav class=\"nav-menu\" v-if=\"!isAdmin\">\n              <router-link to=\"/home\" class=\"nav-item\" exact active-class=\"nav-item-active\">首页</router-link>\n              <router-link to=\"/projects\" class=\"nav-item\" active-class=\"nav-item-active\">项目大厅</router-link>\n              <router-link to=\"/services\" class=\"nav-item\" active-class=\"nav-item-active\">服务市场</router-link>\n              <router-link to=\"/project-publish\" class=\"nav-item\" active-class=\"nav-item-active\">发布项目</router-link>\n              <router-link to=\"/my-projects\" class=\"nav-item\" active-class=\"nav-item-active\">我的项目</router-link>\n              <router-link to=\"/my-orders\" class=\"nav-item\" active-class=\"nav-item-active\">我的订单</router-link>\n              <router-link to=\"/messages\" class=\"nav-item\" active-class=\"nav-item-active\">\n                <i class=\"el-icon-message\"></i> 消息中心\n              </router-link>\n            </nav>\n            <div class=\"header-actions\">\n              <div class=\"user-wrap\">\n                <div class=\"user-avatar\">\n                  {{ (user.realName || user.username || 'U').charAt(0) }}\n                </div>\n                <el-dropdown trigger=\"click\" @command=\"handleCommand\" class=\"user-dropdown\">\n                  <span class=\"user-info\">\n                    <span class=\"user-name\">{{ user.realName || user.username }}</span>\n                    <i class=\"el-icon-arrow-down el-icon--right\"></i>\n                  </span>\n                  <el-dropdown-menu slot=\"dropdown\" class=\"header-dropdown\">\n                    <el-dropdown-item command=\"profile\">\n                      <i class=\"el-icon-user\"></i> 个人中心\n                    </el-dropdown-item>\n                    <el-dropdown-item command=\"logout\" divided>\n                      <i class=\"el-icon-switch-button\"></i> 退出登录\n                    </el-dropdown-item>\n                  </el-dropdown-menu>\n                </el-dropdown>\n              </div>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      <el-main class=\"main-content\">\n        <router-view />\n      </el-main>\n    </el-container>\n  </el-container>\n</template>\n\n<script>\nimport { mapState, mapGetters, mapActions } from 'vuex'\nexport default {\n  name: 'Layout',\n  data() {\n    return {\n      headerSolid: false,\n      showDashboardBadge: true,\n      pendingAudits: 5\n    }\n  },\n  computed: {\n    ...mapState('user', ['username', 'realName']),\n    user() {\n      return { username: this.username, realName: this.realName }\n    },\n    ...mapGetters('user', ['isAdmin', 'isEntrepreneur', 'isInvestor', 'isProvider'])\n  },\n  mounted() {\n    window.addEventListener('scroll', this.onScroll, { passive: true })\n    this.onScroll()\n  },\n  beforeDestroy() {\n    window.removeEventListener('scroll', this.onScroll)\n  },\n  methods: {\n    onScroll() {\n      this.headerSolid = window.scrollY > 48\n    },\n    ...mapActions('user', ['logout']),\n    handleCommand(cmd) {\n      if (cmd === 'profile') this.$router.push('/profile')\n      if (cmd === 'logout') {\n        this.logout()\n        this.$router.push('/login')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.app-layout { min-height: 100vh; }\n.admin-sidebar {\n  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);\n  box-shadow: 4px 0 24px rgba(0,0,0,.12);\n}\n.sidebar-logo {\n  height: 64px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  border-bottom: 1px solid rgba(255,255,255,.06);\n}\n.logo-icon { font-size: 24px; color: #3b82f6; }\n.logo-text {\n  font-size: 17px;\n  font-weight: 700;\n  color: #f1f5f9;\n  letter-spacing: 0.5px;\n}\n.admin-menu { border-right: none; padding: 12px 0; }\n.admin-menu .menu-item {\n  margin: 4px 12px;\n  border-radius: 10px;\n  height: 48px;\n  line-height: 48px;\n  transition: all .2s ease;\n}\n.admin-menu .menu-item i { margin-right: 10px; font-size: 18px; }\n.admin-menu .menu-item:hover { background: rgba(255,255,255,.06) !important; color: #e2e8f0; }\n.admin-menu .menu-item.is-active {\n  background: linear-gradient(90deg, rgba(59,130,246,.25) 0%, rgba(59,130,246,.1) 100%) !important;\n  color: #fff;\n}\n\n.main-wrap { flex: 1; min-width: 0; }\n.home-header {\n  position: sticky;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 1000;\n  background: rgba(255, 255, 255, 0.95);\n  backdrop-filter: blur(10px);\n  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);\n  transition: all 0.3s ease;\n}\n\n.header-container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 24px;\n}\n\n.header-content {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 64px;\n}\n\n.logo {\n  flex-shrink: 0;\n}\n\n.logo-text {\n  font-size: 20px;\n  font-weight: 600;\n  color: var(--hw-primary);\n  letter-spacing: 0.5px;\n  text-decoration: none;\n  padding: 8px 16px;\n  border-radius: var(--hw-radius);\n  transition: all var(--hw-duration);\n}\n\n.logo-text:hover {\n  color: var(--hw-primary-hover);\n  background: var(--hw-primary-light);\n}\n\n.nav-menu {\n  display: flex;\n  align-items: center;\n  gap: 32px;\n}\n\n.nav-item {\n  font-size: 15px;\n  font-weight: 500;\n  color: var(--hw-text);\n  text-decoration: none;\n  padding: 8px 16px;\n  border-radius: var(--hw-radius);\n  transition: all var(--hw-duration);\n  position: relative;\n}\n\n.nav-item:hover {\n  color: var(--hw-primary);\n  background: var(--hw-primary-light);\n}\n\n.nav-item-active {\n  color: var(--hw-primary);\n  background: var(--hw-primary-light);\n}\n\n.nav-item i {\n  margin-right: 6px;\n  font-size: 14px;\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  flex-shrink: 0;\n}\n\n.user-wrap {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.user-avatar {\n  width: 36px;\n  height: 36px;\n  border-radius: 10px;\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\n  color: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 14px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.user-avatar:hover {\n  transform: scale(1.05);\n  box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);\n}\n\n.user-dropdown {\n  cursor: pointer;\n}\n\n.user-info {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--hw-text);\n  font-size: 14px;\n  font-weight: 500;\n  padding: 6px 10px;\n  border-radius: 8px;\n  transition: background 0.2s;\n}\n\n.user-info:hover {\n  background: var(--hw-primary-light);\n  color: var(--hw-primary);\n}\n\n.user-info .el-icon--right {\n  font-size: 12px;\n  margin-left: 2px;\n}\n.main-content {\n  background: #f8fafc;\n  padding: 24px;\n  min-height: calc(100vh - var(--header-height));\n}\n</style>\n\n<style>\n/* 下拉菜单：平滑展开 + 阴影过渡 */\n.header-dropdown.el-dropdown-menu {\n  border-radius: var(--hw-radius-lg);\n  padding: 8px;\n  box-shadow: var(--hw-shadow-modal);\n  border: 1px solid var(--hw-border);\n  transition: opacity var(--hw-duration) ease, transform var(--hw-duration) ease;\n}\n.header-dropdown .el-dropdown-menu__item {\n  border-radius: var(--hw-radius);\n  padding: 10px 16px;\n  transition: background var(--hw-duration) ease;\n}\n.header-dropdown .el-dropdown-menu__item i { margin-right: 8px; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;