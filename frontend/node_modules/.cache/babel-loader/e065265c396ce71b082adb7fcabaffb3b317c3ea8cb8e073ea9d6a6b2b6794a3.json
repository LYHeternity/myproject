le: '新能源出行方案',\n  status: 'online',\n  likeCount: 28\n}, {\n  id: 'm4',\n  title: '医疗健康数字化',\n  status: 'rejected',\n  likeCount: 0\n}, {\n  id: 'm5',\n  title: '教育科技产品',\n  status: 'online',\n  likeCount: 5\n}, {\n  id: 'm6',\n  title: '跨境电商服务',\n  status: 'pending',\n  likeCount: 0\n}, {\n  id: 'm7',\n  title: '本地生活O2O',\n  status: 'online',\n  likeCount: 19\n}, {\n  id: 'm8',\n  title: '金融科技风控',\n  status: 'online',\n  likeCount: 7\n}, {\n  id: 'm9',\n  title: 'AI内容生产工具',\n  status: 'pending',\n  likeCount: 0\n}, {\n  id: 'm10',\n  title: '供应链协同平台',\n  status: 'online',\n  likeCount: 3\n}];\nexport default {\n  name: 'MyProjects',\n  data: function data() {\n    return {\n      loading: false,\n      list: [],\n      query: {\n        status: ''\n      },\n      page: {\n        current: 1,\n        size: 10,\n        total: 0\n      }\n    };\n  },\n  computed: {\n    displayList: function displayList() {\n      return this.list;\n    },\n    totalProjects: function totalProjects() {\n      return this.list.length;\n    },\n    onlineProjects: function onlineProjects() {\n      return this.list.filter(function (item) {\n        return item.status === 'online';\n      }).length;\n    },\n    pendingProjects: function pendingProjects() {\n      return this.list.filter(function (item) {\n        return item.status === 'pending';\n      }).length;\n    },\n    totalLikes: function totalLikes() {\n      return this.list.reduce(function (total, item) {\n        return total + (item.likeCount || 0);\n      }, 0);\n    }\n  },\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    statusText: function statusText(s) {\n      return {\n        pending: '待审核',\n        online: '已上线',\n        rejected: '已拒绝'\n      }[s] || s;\n    },\n    getStatusType: function getStatusType(status) {\n      return status === 'online' ? 'success' : status === 'rejected' ? 'danger' : 'info';\n    },\n    load: function load() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var res;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              _context.n = 2;\n              return listMy(_objectSpread({\n                current: _this.page.current,\n                size: _this.page.size\n              }, _this.query));\n            case 2:\n              res = _context.v;\n              _this.list = res.records || [];\n              _this.page.total = res.total || 0;\n            case 3:\n              _context.p = 3;\n              _this.loading = false;\n              return _context.f(3);\n            case 4:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1,, 3, 4]]);\n      }))();\n    },\n    onPage: function onPage(p) {\n      this.page.current = p;\n      this.load();\n    },\n    onSizeChange: function onSizeChange(size) {\n      this.page.size = size;\n      this.page.current = 1;\n      this.load();\n    },\n    resetFilters: function resetFilters() {\n      this.query = {\n        status: ''\n      };\n      this.load();\n    },\n    viewDetail: function viewDetail(row) {\n      if (row.id && String(row.id).indexOf('m') === 0) {\n        this.$message.info('这是模拟数据，无法查看详细信息');\n      } else {\n        this.$router.push('/project/' + row.id);\n      }\n    },\n    edit: function edit(row) {\n      if (row.id && String(row.id).indexOf('m') === 0) {\n        this.$message.info('这是模拟数据，无法编辑');\n      } else {\n        this.$router.push('/project/' + row.id + '?edit=1');\n      }\n    },\n    viewPublic: function viewPublic(row) {\n      if (row.id && String(row.id).indexOf('m') === 0) {\n        this.$message.info('这是模拟数据，无法查看公开页面');\n      } else {\n        this.$router.push('/project/' + row.id);\n      }\n    },\n    handleSortChange: function handleSortChange(_ref) {\n      var prop = _ref.prop,\n        order = _ref.order;\n      if (!prop || !order) {\n        this.load();\n        return;\n      }\n      var sortedList = _toConsumableArray(this.displayList).sort(function (a, b) {\n        if (prop === 'title') {\n          var aVal = a[prop] || '';\n          var bVal = b[prop] || '';\n          return order === 'ascending' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);\n        } else if (prop === 'likeCount') {\n          var _aVal = a[prop] || 0;\n          var _bVal = b[prop] || 0;\n          return order === 'ascending' ? _aVal - _bVal : _bVal - _aVal;\n        }\n        return 0;\n      });\n      this.list = sortedList;\n    }\n  }\n};","map":{"version":3,"names":["listMy","MOCK_LIST","id","title","status","likeCount","name","data","loading","list","query","page","current","size","total","computed","displayList","totalProjects","length","onlineProjects","filter","item","pendingProjects","totalLikes","reduce","created","load","methods","statusText","s","pending","online","rejected","getStatusType","_this","_asyncToGenerator","_regenerator","m","_callee","res","w","_context","p","n","_objectSpread","v","records","f","a","onPage","onSizeChange","resetFilters","viewDetail","row","String","indexOf","$message","info","$router","push","edit","viewPublic","handleSortChange","_ref","prop","order","sortedList","_toConsumableArray","sort","b","aVal","bVal","localeCompare"],"sources":["src/views/project/MyList.vue"],"sourcesContent":["<template>\n  <div class=\"my-projects-page\">\n    <!-- 页面头部 -->\n    <div class=\"page-header\">\n      <div class=\"header-content\">\n        <h1 class=\"page-title\">我的项目</h1>\n        <p class=\"page-subtitle\">管理您发布的创业项目，跟踪项目状态和数据</p>\n        <el-button type=\"primary\" @click=\"$router.push('/project-publish')\" class=\"primary-action-btn\">\n          <i class=\"el-icon-plus\"></i>\n          <span>发布新项目</span>\n        </el-button>\n      </div>\n    </div>\n\n    <!-- 数据概览卡片 -->\n    <div class=\"stats-cards\">\n      <div class=\"stat-card\">\n        <div class=\"stat-icon project-icon\">\n          <i class=\"el-icon-document\"></i>\n        </div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">{{ totalProjects }}</div>\n          <div class=\"stat-label\">总项目数</div>\n        </div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-icon online-icon\">\n          <i class=\"el-icon-check\"></i>\n        </div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">{{ onlineProjects }}</div>\n          <div class=\"stat-label\">已上线</div>\n        </div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-icon pending-icon\">\n          <i class=\"el-icon-time\"></i>\n        </div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">{{ pendingProjects }}</div>\n          <div class=\"stat-label\">待审核</div>\n        </div>\n      </div>\n      <div class=\"stat-card\">\n        <div class=\"stat-icon like-icon\">\n          <i class=\"el-icon-star-on\"></i>\n        </div>\n        <div class=\"stat-content\">\n          <div class=\"stat-number\">{{ totalLikes }}</div>\n          <div class=\"stat-label\">总点赞数</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 筛选栏 -->\n    <div class=\"filter-section\">\n      <div class=\"filter-header\">\n        <h3 class=\"filter-title\">筛选与搜索</h3>\n      </div>\n      <el-form :inline=\"true\" class=\"filter-form\">\n        <el-form-item label=\"状态\">\n          <el-select v-model=\"query.status\" placeholder=\"全部状态\" clearable style=\"width:140px\" class=\"filter-select\">\n            <el-option label=\"待审核\" value=\"pending\" />\n            <el-option label=\"已上线\" value=\"online\" />\n            <el-option label=\"已拒绝\" value=\"rejected\" />\n          </el-select>\n        </el-form-item>\n        <el-form-item class=\"filter-actions\">\n          <el-button type=\"primary\" @click=\"load\" class=\"search-btn\">\n            <i class=\"el-icon-search\"></i>\n            <span>查询</span>\n          </el-button>\n          <el-button @click=\"resetFilters\" class=\"reset-btn\">\n            <i class=\"el-icon-refresh\"></i>\n            <span>重置</span>\n          </el-button>\n        </el-form-item>\n      </el-form>\n    </div>\n\n    <!-- 项目列表 -->\n    <div class=\"project-list-section\">\n      <div class=\"section-header\">\n        <h3 class=\"section-title\">项目列表</h3>\n        <span class=\"project-count\">{{ displayList.length }} 个项目</span>\n      </div>\n      \n      <div class=\"project-table-wrapper\">\n        <el-table \n          v-loading=\"loading\" \n          :data=\"displayList\" \n          border \n          stripe \n          class=\"project-table\"\n          :cell-style=\"{ backgroundColor: '#ffffff', color: '#4a5568' }\"\n          :header-cell-style=\"{ backgroundColor: '#f8fafc', color: '#2d3748' }\"\n          @sort-change=\"handleSortChange\"\n        >\n          <el-table-column prop=\"title\" label=\"项目名称\" min-width=\"220\" align=\"left\" sortable=\"custom\">\n            <template slot-scope=\"scope\">\n              <div class=\"project-title-cell\">\n                <span class=\"project-title\">{{ scope.row.title }}</span>\n              </div>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"status\" label=\"状态\" width=\"120\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <el-tag :type=\"getStatusType(scope.row.status)\" size=\"small\" class=\"status-tag\">\n                {{ statusText(scope.row.status) }}\n              </el-tag>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"likeCount\" label=\"点赞\" width=\"100\" align=\"center\" sortable=\"custom\">\n            <template slot-scope=\"scope\">\n              <div class=\"like-count\">\n                <i class=\"el-icon-star-on like-icon-small\"></i>\n                <span>{{ scope.row.likeCount || 0 }}</span>\n              </div>\n            </template>\n          </el-table-column>\n          <el-table-column label=\"操作\" width=\"200\" align=\"center\">\n            <template slot-scope=\"scope\">\n              <div class=\"action-buttons\">\n                <el-button \n                  type=\"primary\" \n                  size=\"small\" \n                  @click=\"viewDetail(scope.row)\"\n                  class=\"action-btn detail-btn\"\n                >\n                  详情\n                </el-button>\n                <el-button \n                  v-if=\"['pending','rejected'].includes(scope.row.status)\" \n                  type=\"info\" \n                  size=\"small\" \n                  @click=\"edit(scope.row)\"\n                  class=\"action-btn edit-btn\"\n                >\n                  编辑\n                </el-button>\n                <el-button \n                  v-if=\"scope.row.status === 'online'\" \n                  type=\"warning\" \n                  size=\"small\" \n                  @click=\"viewPublic(scope.row)\"\n                  class=\"action-btn view-btn\"\n                >\n                  查看\n                </el-button>\n              </div>\n            </template>\n          </el-table-column>\n        </el-table>\n      </div>\n\n      <!-- 空数据状态 -->\n      <div v-if=\"!loading && !displayList.length\" class=\"empty-state\">\n        <div class=\"empty-icon-large\">\n          <i class=\"el-icon-document\"></i>\n        </div>\n        <h4 class=\"empty-title\">暂无项目数据</h4>\n        <p class=\"empty-description\">您还没有发布任何项目，点击下方按钮开始发布</p>\n        <el-button type=\"primary\" @click=\"$router.push('/project-publish')\" class=\"empty-action-btn\">\n          <i class=\"el-icon-plus\"></i>\n          <span>发布项目</span>\n        </el-button>\n      </div>\n\n      <!-- 分页 -->\n      <div v-if=\"page.total > 0\" class=\"pagination-section\">\n        <el-pagination\n          :current-page=\"page.current\"\n          :page-size=\"page.size\"\n          :page-sizes=\"[5, 10, 20, 50]\"\n          :total=\"page.total\"\n          layout=\"total, sizes, prev, pager, next, jumper\"\n          @current-change=\"onPage\"\n          @size-change=\"onSizeChange\"\n        />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { listMy } from '@/api/project'\nconst MOCK_LIST = [\n  { id: 'm1', title: '智能硬件孵化项目', status: 'online', likeCount: 12 },\n  { id: 'm2', title: '企业SaaS平台', status: 'pending', likeCount: 0 },\n  { id: 'm3', title: '新能源出行方案', status: 'online', likeCount: 28 },\n  { id: 'm4', title: '医疗健康数字化', status: 'rejected', likeCount: 0 },\n  { id: 'm5', title: '教育科技产品', status: 'online', likeCount: 5 },\n  { id: 'm6', title: '跨境电商服务', status: 'pending', likeCount: 0 },\n  { id: 'm7', title: '本地生活O2O', status: 'online', likeCount: 19 },\n  { id: 'm8', title: '金融科技风控', status: 'online', likeCount: 7 },\n  { id: 'm9', title: 'AI内容生产工具', status: 'pending', likeCount: 0 },\n  { id: 'm10', title: '供应链协同平台', status: 'online', likeCount: 3 }\n]\nexport default {\n  name: 'MyProjects',\n  data() {\n    return {\n      loading: false,\n      list: [],\n      query: { status: '' },\n      page: { current: 1, size: 10, total: 0 }\n    }\n  },\n  computed: {\n    displayList() {\n      return this.list\n    },\n    totalProjects() {\n      return this.list.length\n    },\n    onlineProjects() {\n      return this.list.filter(item => item.status === 'online').length\n    },\n    pendingProjects() {\n      return this.list.filter(item => item.status === 'pending').length\n    },\n    totalLikes() {\n      return this.list.reduce((total, item) => total + (item.likeCount || 0), 0)\n    }\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    statusText(s) {\n      return { pending: '待审核', online: '已上线', rejected: '已拒绝' }[s] || s\n    },\n    getStatusType(status) {\n      return status === 'online' ? 'success' : status === 'rejected' ? 'danger' : 'info'\n    },\n    async load() {\n      this.loading = true\n      try {\n        const res = await listMy({ current: this.page.current, size: this.page.size, ...this.query })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally {\n        this.loading = false\n      }\n    },\n    onPage(p) {\n      this.page.current = p\n      this.load()\n    },\n    onSizeChange(size) {\n      this.page.size = size\n      this.page.current = 1\n      this.load()\n    },\n    resetFilters() {\n      this.query = { status: '' }\n      this.load()\n    },\n    viewDetail(row) {\n      if (row.id && String(row.id).indexOf('m') === 0) {\n        this.$message.info('这是模拟数据，无法查看详细信息')\n      } else {\n        this.$router.push('/project/' + row.id)\n      }\n    },\n    edit(row) {\n      if (row.id && String(row.id).indexOf('m') === 0) {\n        this.$message.info('这是模拟数据，无法编辑')\n      } else {\n        this.$router.push('/project/' + row.id + '?edit=1')\n      }\n    },\n    viewPublic(row) {\n      if (row.id && String(row.id).indexOf('m') === 0) {\n        this.$message.info('这是模拟数据，无法查看公开页面')\n      } else {\n        this.$router.push('/project/' + row.id)\n      }\n    },\n    handleSortChange({ prop, order }) {\n      if (!prop || !order) {\n        this.load()\n        return\n      }\n      \n      const sortedList = [...this.displayList].sort((a, b) => {\n        if (prop === 'title') {\n          const aVal = a[prop] || ''\n          const bVal = b[prop] || ''\n          return order === 'ascending' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal)\n        } else if (prop === 'likeCount') {\n          const aVal = a[prop] || 0\n          const bVal = b[prop] || 0\n          return order === 'ascending' ? aVal - bVal : bVal - aVal\n        }\n        return 0\n      })\n      \n      this.list = sortedList\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* 页面容器 */\n.my-projects-page {\n  padding: 32px;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n/* 页面头部 */\n.page-header {\n  margin-bottom: 32px;\n  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);\n  border-radius: 16px;\n  padding: 40px;\n  border: 1px solid rgba(59, 130, 246, 0.1);\n  box-shadow: 0 8px 32px rgba(59, 130, 246, 0.1);\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.page-header:hover {\n  box-shadow: 0 12px 48px rgba(59, 130, 246, 0.15);\n  transform: translateY(-2px);\n}\n\n.header-content {\n  text-align: center;\n}\n\n.page-title {\n  font-size: 32px;\n  font-weight: 700;\n  color: #1e293b;\n  margin: 0 0 12px 0;\n  line-height: 1.2;\n}\n\n.page-subtitle {\n  font-size: 16px;\n  color: #64748b;\n  margin: 0 0 24px 0;\n  line-height: 1.4;\n}\n\n.primary-action-btn {\n  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);\n  border: none;\n  border-radius: 12px;\n  padding: 12px 24px;\n  font-size: 16px;\n  font-weight: 600;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);\n}\n\n.primary-action-btn:hover {\n  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);\n}\n\n/* 数据概览卡片 */\n.stats-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 20px;\n  margin-bottom: 32px;\n}\n\n.stat-card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 24px;\n  border: 1px solid rgba(0, 0, 0, 0.08);\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.stat-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);\n  border-color: rgba(59, 130, 246, 0.2);\n}\n\n.stat-icon {\n  width: 56px;\n  height: 56px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: cente