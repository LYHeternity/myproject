     priority: 3,\n        done: false\n      }],\n      activityList: [{\n        type: 'user',\n        typeText: '用户注册',\n        detail: '新用户张三注册成功',\n        user: '张三',\n        time: '2024-01-15 14:30'\n      }, {\n        type: 'project',\n        typeText: '项目发布',\n        detail: '项目\"智能硬件研发\"发布成功',\n        user: '李四',\n        time: '2024-01-15 13:45'\n      }, {\n        type: 'service',\n        typeText: '服务订购',\n        detail: '订购了\"法律咨询\"服务',\n        user: '王五',\n        time: '2024-01-15 12:20'\n      }, {\n        type: 'audit',\n        typeText: '内容审核',\n        detail: '项目\"人工智能应用\"审核通过',\n        user: '管理员',\n        time: '2024-01-15 11:10'\n      }, {\n        type: 'user',\n        typeText: '用户登录',\n        detail: '用户赵六登录系统',\n        user: '赵六',\n        time: '2024-01-15 10:05'\n      }],\n      charts: []\n    };\n  },\n  created: function created() {\n    var _this = this;\n    adminStats.overview().then(function (res) {\n      _this.stats = res || {};\n    })[\"catch\"](function () {\n      _this.stats = {\n        userCount: 12,\n        projectCount: 8,\n        resourceCount: 6,\n        orderCount: 28\n      };\n    });\n  },\n  mounted: function mounted() {\n    var _this2 = this;\n    this.$nextTick(function () {\n      _this2.initMiniCharts();\n      _this2.initMainChart();\n    });\n  },\n  beforeDestroy: function beforeDestroy() {\n    this.charts.forEach(function (c) {\n      return c && c.dispose();\n    });\n  },\n  methods: {\n    initMiniCharts: function initMiniCharts() {\n      var _this3 = this;\n      var opts = {\n        grid: {\n          left: 0,\n          right: 0,\n          top: 4,\n          bottom: 0\n        },\n        xAxis: {\n          show: false,\n          type: 'category',\n          data: ['1', '2', '3', '4', '5', '6', '7']\n        },\n        yAxis: {\n          show: false,\n          type: 'value'\n        },\n        series: [{\n          type: 'line',\n          data: [2, 5, 4, 8, 6, 9, 12],\n          smooth: true,\n          symbol: 'none',\n          lineStyle: {\n            width: 2,\n            color: '#3b82f6'\n          },\n          areaStyle: {\n            color: 'rgba(59, 130, 246, 0.15)'\n          }\n        }]\n      };\n      ['chartUser', 'chartProject', 'chartResource', 'chartOrder'].forEach(function (ref, i) {\n        var el = _this3.$refs[ref];\n        if (el) {\n          var chart = echarts.init(el);\n          chart.setOption(_objectSpread(_objectSpread({}, opts), {}, {\n            series: [_objectSpread(_objectSpread({}, opts.series[0]), {}, {\n              data: [1, 3, 4, 6, 5, 8, 10].map(function (v) {\n                return v + i * 2;\n              })\n            })]\n          }));\n          _this3.charts.push(chart);\n        }\n      });\n    },\n    initMainChart: function initMainChart() {\n      var el = this.$refs.mainChart;\n      if (el) {\n        var chart = echarts.init(el);\n        var option = {\n          tooltip: {\n            trigger: 'axis',\n            axisPointer: {\n              type: 'cross',\n              label: {\n                backgroundColor: '#6a7985'\n              }\n            }\n          },\n          legend: {\n            data: ['用户注册', '项目发布', '服务订单'],\n            top: 0,\n            textStyle: {\n              color: '#94a3b8'\n            }\n          },\n          grid: {\n            left: '3%',\n            right: '4%',\n            bottom: '3%',\n            containLabel: true\n          },\n          xAxis: {\n            type: 'category',\n            boundaryGap: false,\n            data: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'],\n            axisLine: {\n              lineStyle: {\n                color: '#334155'\n              }\n            },\n            axisLabel: {\n              color: '#94a3b8'\n            }\n          },\n          yAxis: {\n            type: 'value',\n            axisLine: {\n              lineStyle: {\n                color: '#334155'\n              }\n            },\n            axisLabel: {\n              color: '#94a3b8'\n            },\n            splitLine: {\n              lineStyle: {\n                color: '#1e293b'\n              }\n            }\n          },\n          series: [{\n            name: '用户注册',\n            type: 'line',\n            stack: 'Total',\n            areaStyle: {\n              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{\n                offset: 0,\n                color: 'rgba(59, 130, 246, 0.5)'\n              }, {\n                offset: 1,\n                color: 'rgba(59, 130, 246, 0.1)'\n              }])\n            },\n            emphasis: {\n              focus: 'series'\n            },\n            lineStyle: {\n              width: 3,\n              color: '#3b82f6'\n            },\n            symbol: 'circle',\n            symbolSize: 6,\n            itemStyle: {\n              color: '#3b82f6'\n            },\n            data: [120, 132, 101, 134, 90, 230, 210, 250, 220, 300, 280, 350]\n          }, {\n            name: '项目发布',\n            type: 'line',\n            stack: 'Total',\n            areaStyle: {\n              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{\n                offset: 0,\n                color: 'rgba(16, 185, 129, 0.5)'\n              }, {\n                offset: 1,\n                color: 'rgba(16, 185, 129, 0.1)'\n              }])\n            },\n            emphasis: {\n              focus: 'series'\n            },\n            lineStyle: {\n              width: 3,\n              color: '#10b981'\n            },\n            symbol: 'circle',\n            symbolSize: 6,\n            itemStyle: {\n              color: '#10b981'\n            },\n            data: [220, 182, 191, 234, 290, 330, 310, 350, 320, 400, 380, 450]\n          }, {\n            name: '服务订单',\n            type: 'line',\n            stack: 'Total',\n            areaStyle: {\n              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{\n                offset: 0,\n                color: 'rgba(245, 158, 11, 0.5)'\n              }, {\n                offset: 1,\n                color: 'rgba(245, 158, 11, 0.1)'\n              }])\n            },\n            emphasis: {\n              focus: 'series'\n            },\n            lineStyle: {\n              width: 3,\n              color: '#f59e0b'\n            },\n            symbol: 'circle',\n            symbolSize: 6,\n            itemStyle: {\n              color: '#f59e0b'\n            },\n            data: [150, 232, 201, 154, 190, 330, 410, 450, 420, 500, 480, 550]\n          }]\n        };\n        chart.setOption(option);\n        this.charts.push(chart);\n      }\n    }\n  }\n};","map":{"version":3,"names":["echarts","adminStats","name","data","stats","todoList","title","due","priority","done","activityList","type","typeText","detail","user","time","charts","created","_this","overview","then","res","userCount","projectCount","resourceCount","orderCount","mounted","_this2","$nextTick","initMiniCharts","initMainChart","beforeDestroy","forEach","c","dispose","methods","_this3","opts","grid","left","right","top","bottom","xAxis","show","yAxis","series","smooth","symbol","lineStyle","width","color","areaStyle","ref","i","el","$refs","chart","init","setOption","_objectSpread","map","v","push","mainChart","option","tooltip","trigger","axisPointer","label","backgroundColor","legend","textStyle","containLabel","boundaryGap","axisLine","axisLabel","splitLine","stack","graphic","LinearGradient","offset","emphasis","focus","symbolSize","itemStyle"],"sources":["src/views/admin/Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"admin-dashboard\">\n    <!-- 顶部卡片 -->\n    <div class=\"top-cards\">\n      <div class=\"welcome-card\">\n        <div class=\"welcome-content\">\n          <h1 class=\"welcome-title\">欢迎回来，{{ $store.state.user.realName || $store.state.user.username }}</h1>\n          <p class=\"welcome-subtitle\">今天是 {{ new Date().toLocaleDateString('zh-CN') }}，以下是平台的核心数据概览</p>\n        </div>\n        <div class=\"welcome-avatar\">\n          {{ ($store.state.user.realName || $store.state.user.username || 'A').charAt(0) }}\n        </div>\n      </div>\n    </div>\n\n    <!-- 数据概览卡片 -->\n    <div class=\"stats-grid\">\n      <div class=\"stat-card\">\n        <div class=\"stat-header\">\n          <h3 class=\"stat-title\">用户总数</h3>\n          <span class=\"stat-icon user\"><i class=\"el-icon-user\"></i></span>\n        </div>\n        <div class=\"stat-body\">\n          <div class=\"stat-value\">{{ stats.userCount || 0 }}</div>\n          <div class=\"stat-change positive\">+12% <span>较上月</span></div>\n        </div>\n        <div class=\"stat-chart\" ref=\"chartUser\"></div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-header\">\n          <h3 class=\"stat-title\">项目总数</h3>\n          <span class=\"stat-icon project\"><i class=\"el-icon-document\"></i></span>\n        </div>\n        <div class=\"stat-body\">\n          <div class=\"stat-value\">{{ stats.projectCount || 0 }}</div>\n          <div class=\"stat-change positive\">+8% <span>较上月</span></div>\n        </div>\n        <div class=\"stat-chart\" ref=\"chartProject\"></div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-header\">\n          <h3 class=\"stat-title\">服务总数</h3>\n          <span class=\"stat-icon service\"><i class=\"el-icon-goods\"></i></span>\n        </div>\n        <div class=\"stat-body\">\n          <div class=\"stat-value\">{{ stats.resourceCount || 0 }}</div>\n          <div class=\"stat-change positive\">+15% <span>较上月</span></div>\n        </div>\n        <div class=\"stat-chart\" ref=\"chartResource\"></div>\n      </div>\n      \n      <div class=\"stat-card\">\n        <div class=\"stat-header\">\n          <h3 class=\"stat-title\">订单总数</h3>\n          <span class=\"stat-icon order\"><i class=\"el-icon-s-order\"></i></span>\n        </div>\n        <div class=\"stat-body\">\n          <div class=\"stat-value\">{{ stats.orderCount || 0 }}</div>\n          <div class=\"stat-change positive\">+23% <span>较上月</span></div>\n        </div>\n        <div class=\"stat-chart\" ref=\"chartOrder\"></div>\n      </div>\n    </div>\n\n    <!-- 主要内容区域 -->\n    <div class=\"main-content\">\n      <!-- 左侧：图表区域 -->\n      <div class=\"chart-section\">\n        <div class=\"section-header\">\n          <h2 class=\"section-title\">平台活跃度趋势</h2>\n          <div class=\"section-actions\">\n            <el-button size=\"small\" type=\"primary\" plain>周</el-button>\n            <el-button size=\"small\" type=\"primary\">月</el-button>\n            <el-button size=\"small\" type=\"primary\" plain>年</el-button>\n          </div>\n        </div>\n        <div class=\"chart-container\" ref=\"mainChart\"></div>\n      </div>\n\n      <!-- 右侧：快捷功能和待办事项 -->\n      <div class=\"right-panel\">\n        <!-- 快捷功能 -->\n        <div class=\"panel-section\">\n          <h3 class=\"panel-title\">快捷功能</h3>\n          <div class=\"quick-actions\">\n            <div class=\"quick-action-item\" @click=\"$router.push('/admin-users')\">\n              <span class=\"action-icon user\"><i class=\"el-icon-user\"></i></span>\n              <span class=\"action-text\">用户管理</span>\n            </div>\n            <div class=\"quick-action-item\" @click=\"$router.push('/admin-roles')\">\n              <span class=\"action-icon role\"><i class=\"el-icon-s-custom\"></i></span>\n              <span class=\"action-text\">角色权限</span>\n            </div>\n            <div class=\"quick-action-item\" @click=\"$router.push('/admin-audit')\">\n              <span class=\"action-icon audit\"><i class=\"el-icon-document-checked\"></i></span>\n              <span class=\"action-text\">内容审核</span>\n            </div>\n            <div class=\"quick-action-item\" @click=\"$router.push('/admin-stats')\">\n              <span class=\"action-icon stats\"><i class=\"el-icon-data-analysis\"></i></span>\n              <span class=\"action-text\">数据统计</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- 待办事项 -->\n        <div class=\"panel-section\">\n          <h3 class=\"panel-title\">待办事项</h3>\n          <div class=\"todo-list\">\n            <div \n              v-for=\"(item, index) in todoList\" \n              :key=\"index\" \n              class=\"todo-item\"\n              :class=\"{ 'completed': item.done }\"\n            >\n              <div class=\"todo-checkbox\" @click=\"item.done = !item.done\">\n                <i v-if=\"item.done\" class=\"el-icon-check\"></i>\n              </div>\n              <div class=\"todo-content\">\n                <h4 class=\"todo-title\">{{ item.title }}</h4>\n                <p class=\"todo-due\">{{ item.due }}</p>\n              </div>\n              <div class=\"todo-priority\" :class=\"'priority-' + item.priority\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 最近活动表格 -->\n    <div class=\"activity-section\">\n      <div class=\"section-header\">\n        <h2 class=\"section-title\">最近活动</h2>\n        <el-button size=\"small\" type=\"primary\" plain>查看全部</el-button>\n      </div>\n      <div class=\"activity-table\">\n        <el-table :data=\"activityList\" style=\"width: 100%\" :border=\"false\" class=\"custom-table\">\n          <el-table-column prop=\"type\" label=\"类型\" width=\"120\">\n            <template slot-scope=\"scope\">\n              <span class=\"activity-type\" :class=\"scope.row.type\">{{ scope.row.typeText }}</span>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"detail\" label=\"详情\" />\n          <el-table-column prop=\"user\" label=\"用户\" width=\"180\">\n            <template slot-scope=\"scope\">\n              <div class=\"user-info\">\n                <div class=\"user-avatar small\">{{ scope.row.user.charAt(0) }}</div>\n                <span class=\"user-name\">{{ scope.row.user }}</span>\n              </div>\n            </template>\n          </el-table-column>\n          <el-table-column prop=\"time\" label=\"时间\" width=\"180\" />\n        </el-table>\n      </div>\n      \n      <!-- 分页 -->\n      <div class=\"pagination\">\n        <div class=\"pagination-controls\">\n          <button class=\"page-btn disabled\" aria-disabled=\"true\">\n            <i class=\"el-icon-arrow-left\"></i>\n          </button>\n          <button class=\"page-btn active\">1</button>\n          <button class=\"page-btn\">2</button>\n          <button class=\"page-btn\">3</button>\n          <button class=\"page-btn\">4</button>\n          <button class=\"page-btn\">5</button>\n          <button class=\"page-btn\">\n            <i class=\"el-icon-arrow-right\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport * as echarts from 'echarts'\nimport { adminStats } from '@/api/admin'\nexport default {\n  name: 'AdminDashboard',\n  data() {\n    return {\n      stats: {},\n      todoList: [\n        { title: '审核待通过项目 3 条', due: '今日', priority: 1, done: false },\n        { title: '新用户注册待查看 5 人', due: '今日', priority: 2, done: false },\n        { title: '服务订单待确认 2 单', due: '明日', priority: 2, done: false },\n        { title: '系统配置备份', due: '本周', priority: 3, done: false },\n        { title: '数据统计报表导出', due: '本周', priority: 3, done: true },\n        { title: '操作日志归档', due: '本月', priority: 3, done: false }\n      ],\n      activityList: [\n        { type: 'user', typeText: '用户注册', detail: '新用户张三注册成功', user: '张三', time: '2024-01-15 14:30' },\n        { type: 'project', typeText: '项目发布', detail: '项目\"智能硬件研发\"发布成功', user: '李四', time: '2024-01-15 13:45' },\n        { type: 'service', typeText: '服务订购', detail: '订购了\"法律咨询\"服务', user: '王五', time: '2024-01-15 12:20' },\n        { type: 'audit', typeText: '内容审核', det