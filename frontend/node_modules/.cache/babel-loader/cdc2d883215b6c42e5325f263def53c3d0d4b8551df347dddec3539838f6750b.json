"userAvatar","e","payOrder","info","concat","confirmOrder","completeOrder","cancelOrder","_this2","_callee2","res","_context2","_objectSpread","type","records","onPage","onSizeChange","handleSortChange","_ref","prop","sortedList","_toConsumableArray","sort","b","aVal","bVal","localeCompare","Date"],"sources":["src/views/order/MyList.vue"],"sourcesContent":["<template>\n  <div class=\"page-card my-list-page\">\n    <div class=\"list-header\">\n      <div class=\"header-content\">\n        <h1 class=\"page-title\">我的订单</h1>\n        <p class=\"page-subtitle\">查看和管理您的服务订单</p>\n      </div>\n      <!-- 订单类型切换 -->\n      <div class=\"order-type-tabs\">\n        <el-radio-group v-model=\"orderType\" @change=\"load\">\n          <el-radio-button label=\"buy\">我购买的服务</el-radio-button>\n          <el-radio-button label=\"sell\">我收到的订单</el-radio-button>\n        </el-radio-group>\n      </div>\n    </div>\n    <div class=\"filter-bar hw-filter-bar\">\n      <div class=\"filter-header\">\n        <h3 class=\"filter-title\">筛选条件</h3>\n        <p class=\"filter-subtitle\">根据订单状态筛选</p>\n      </div>\n      <el-form :inline=\"true\" class=\"query-form\">\n        <el-form-item label=\"状态\">\n          <el-select v-model=\"query.status\" placeholder=\"全部状态\" clearable style=\"width:140px\">\n            <el-option label=\"待支付\" value=\"unpaid\" />\n            <el-option label=\"待确认\" value=\"pending\" />\n            <el-option label=\"进行中\" value=\"serving\" />\n            <el-option label=\"已完成\" value=\"completed\" />\n            <el-option label=\"已关闭\" value=\"closed\" />\n          </el-select>\n        </el-form-item>\n        <el-form-item class=\"button-group\">\n          <el-button type=\"primary\" @click=\"load\">\n            <i class=\"el-icon-search\"></i>\n            <span>查询</span>\n          </el-button>\n          <el-button class=\"reset-button\" @click=\"query = { status: '' }; load()\">\n            <i class=\"el-icon-refresh\"></i>\n            <span>重置</span>\n          </el-button>\n        </el-form-item>\n      </el-form>\n    </div>\n    <div class=\"order-table-container unique-project-table-container\" id=\"unique-project-table-container\">\n      <el-table \n        v-loading=\"loading\" \n        :data=\"displayList\" \n        border \n        stripe \n        class=\"order-table unique-project-table\"\n        id=\"my-orders-table\"\n        row-key=\"id\"\n        :cell-style=\"{ backgroundColor: '#ffffff', color: '#4a5568' }\"\n        :header-cell-style=\"{ backgroundColor: '#f7fafc', color: '#2d3748' }\"\n        :row-style=\"{ backgroundColor: '#ffffff' }\"\n        @sort-change=\"handleSortChange\"\n      >\n        <el-table-column prop=\"id\" label=\"订单号\" width=\"120\" align=\"center\" sortable=\"custom\"/>\n        <el-table-column prop=\"serviceName\" label=\"服务名称\" min-width=\"200\" align=\"left\" sortable=\"custom\">\n          <template slot-scope=\"scope\">\n            <span class=\"service-name\">{{ scope.row.serviceName || '服务名称' }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"amount\" label=\"金额\" width=\"100\" align=\"center\" sortable=\"custom\">\n          <template slot-scope=\"scope\">\n            <span class=\"amount-value\">¥{{ scope.row.amount }}</span>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"status\" label=\"状态\" width=\"100\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-tag \n              :type=\"getStatusType(scope.row.status)\"\n              size=\"small\"\n              class=\"status-tag\"\n            >\n              {{ statusText(scope.row.status) }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"createTime\" label=\"创建时间\" width=\"180\" align=\"center\" sortable=\"custom\" />\n        <el-table-column label=\"操作\" width=\"200\" fixed=\"right\" align=\"center\">\n          <template slot-scope=\"scope\">\n            <el-button \n              type=\"primary\" \n              size=\"small\" \n              @click=\"viewOrder(scope.row)\"\n              class=\"action-button detail-button\"\n            >\n              查看详情\n            </el-button>\n            <el-button \n              type=\"info\" \n              size=\"small\" \n              @click=\"contactUser(scope.row)\"\n              class=\"action-button\"\n            >\n              联系对方\n            </el-button>\n            <el-button \n              v-if=\"scope.row.status === 'unpaid'\" \n              type=\"success\" \n              size=\"small\" \n              @click=\"payOrder(scope.row)\"\n              class=\"action-button\"\n            >\n              支付\n            </el-button>\n            <el-button \n              v-if=\"scope.row.status === 'pending'\" \n              type=\"warning\" \n              size=\"small\" \n              @click=\"confirmOrder(scope.row)\"\n              class=\"action-button\"\n            >\n              确认\n            </el-button>\n            <el-button \n              v-if=\"scope.row.status === 'serving'\" \n              type=\"success\" \n              size=\"small\" \n              @click=\"completeOrder(scope.row)\"\n              class=\"action-button\"\n            >\n              确认完成\n            </el-button>\n            <el-button \n              v-if=\"['unpaid', 'pending'].includes(scope.row.status)\" \n              type=\"danger\" \n              size=\"small\" \n              @click=\"cancelOrder(scope.row)\"\n              class=\"action-button\"\n            >\n              取消\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </div>\n    <div v-if=\"!loading && !displayList.length\" class=\"data-empty hw-empty\">\n      <div class=\"empty-icon\"><i class=\"el-icon-s-order\"></i></div>\n      <p>暂无订单</p>\n      <p class=\"empty-tip\">{{ orderType === 'buy' ? '在服务市场预约服务后将在此展示' : '暂无收到的订单' }}</p>\n      <el-button v-if=\"orderType === 'buy'\" type=\"primary\" size=\"small\" @click=\"$router.push('/services')\" style=\"margin-top:12px\">去预约</el-button>\n    </div>\n    <el-pagination\n      v-if=\"page.total > 0\"\n      style=\"margin-top:16px\"\n      :current-page=\"page.current\"\n      :page-size=\"page.size\"\n      :page-sizes=\"[5, 10, 20, 50]\"\n      :total=\"page.total\"\n      layout=\"total, sizes, prev, pager, next, jumper\"\n      @current-change=\"onPage\"\n      @size-change=\"onSizeChange\"\n    />\n\n    <!-- 订单详情对话框 -->\n    <el-dialog\n      title=\"订单详情\"\n      :visible.sync=\"showOrderDetail\"\n      width=\"800px\"\n      custom-class=\"order-detail-dialog\"\n    >\n      <div v-loading=\"detailLoading\" class=\"order-detail-content\">\n        <template v-if=\"orderDetail\">\n          <div class=\"detail-section\">\n            <h3 class=\"section-title\">订单信息</h3>\n            <div class=\"detail-grid\">\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">订单号：</span>\n                <span class=\"detail-value\">{{ orderDetail.id }}</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">服务名称：</span>\n                <span class=\"detail-value\">{{ orderDetail.serviceName }}</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">订单金额：</span>\n                <span class=\"detail-value amount\">{{ orderDetail.amount }}</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">订单状态：</span>\n                <el-tag :type=\"getStatusType(orderDetail.status)\">\n                  {{ statusText(orderDetail.status) }}\n                </el-tag>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">创建时间：</span>\n                <span class=\"detail-value\">{{ orderDetail.createTime }}</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">更新时间：</span>\n                <span class=\"detail-value\">{{ orderDetail.updateTime }}</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"detail-section\">\n            <h3 class=\"section-title\">服务信息</h3>\n            <div class=\"detail-grid\">\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">服务描述：</span>\n                <span class=\"detail-value\">{{ orderDetail.description }}</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">服务方式：</span>\n                <span class=\"detail-value\">{{ orderDetail.serviceMethod === 'online' ? '线上服务' : orderDetail.serviceMethod === 'offline' ? '线下服务' : '线上+线下' }}</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">期望时间：</span>\n                <span class=\"detail-value\">{{ orderDetail.expectTime }}</span>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"detail-section\">\n            <h3 class=\"section-title\">联系信息</h3>\n            <div class=\"detail-grid\">\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">联系人：</span>\n                <span class=\"detail-value\">{{ orderDetail.contactInfo }}</span>\n              </div>\n            </div>\n          </div>\n        </template>\n      </div>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"showOrderDetail = false\">关闭</el-button>\n      </span>\n    </el-dialog>\n\n    <!-- 聊天对话窗口 -->\n    <ChatDialog\n      :visible.sync=\"showChat\"\n      title=\"与对方聊天\"\n      :user-id=\"chatUserId\"\n      :user-name=\"chatUserName\"\n      :user-avatar=\"chatUserAvatar\"\n    />\n  </div>\n</template>\n\n<script>\nimport { listMy, getDetail, setStatus } from '@/api/order'\nimport ChatDialog from '@/components/ChatDialog.vue'\nconst MOCK_LIST = [\n  { id: 1001, serviceName: '企业法律咨询服务', amount: 1999, status: 'completed', createTime: '2025-01-15 10:00' },\n  { id: 1002, serviceName: '网站开发服务', amount: 2999, status: 'serving', createTime: '2025-01-18 14:30' },\n  { id: 1003, serviceName: '市场调研服务', amount: 999, status: 'pending', createTime: '2025-01-20 09:00' },\n  { id: 1004, serviceName: '品牌设计服务', amount: 4999, status: 'unpaid', createTime: '2025-01-21 16:00' },\n  { id: 1005, serviceName: '财务审计服务', amount: 1999, status: 'completed', createTime: '2025-01-10 11:20' },\n  { id: 1006, serviceName: '人力资源咨询', amount: 3999, status: 'completed', createTime: '2025-01-08 08:45' },\n  { id: 1007, serviceName: '税务筹划服务', amount: 899, status: 'closed', createTime: '2025-01-05 13:00' },\n  { id: 1008, serviceName: '知识产权服务', amount: 2599, status: 'serving', createTime: '2025-01-19 10:30' },\n  { id: 1009, serviceName: '市场营销服务', amount: 1500, status: 'pending', createTime: '2025-01-22 09:15' },\n  { id: 1010, serviceName: '技术咨询服务', amount: 3200, status: 'completed', createTime: '2025-01-12 15:40' }\n]\nexport default {\n  name: 'MyOrders',\n  components: {\n    ChatDialog\n  },\n  data() {\n    return {\n      loading: false,\n      list: [],\n      orderType: 'buy',\n      query: { status: '' },\n      page: { current: 1, size: 10, total: 0 },\n      // 订单详情\n      showOrderDetail: false,\n      orderDetail: null,\n      detailLoading: false,\n      // 聊天对话框\n      showChat: false,\n      chatUserId: '',\n      chatUserName: '',\n      chatUserAvatar: ''\n    }\n  },\n  computed: {\n    displayList() {\n      if (this.list.length) return this.list\n      return MOCK_LIST\n    }\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    statusText(s) {\n      return { \n        unpaid: '待支付',\n        pending: '待确认', \n        serving: '进行中', \n        completed: '已完成', \n        closed: '已关闭' \n      }[s] || s\n    },\n    getStatusType(status) {\n      const typeMap = {\n        unpaid: 'warning',\n        pending: 'info',\n        serving: 'primary',\n        completed: 'success',\n        closed: 'danger'\n      }\n      return typeMap[status] || 'info'\n    },\n    async viewOrder(order) {\n      try {\n        this.detailLoading = true\n        const detail = await getDetail(order.id)\n        this.orderDetail = detail\n        this.showOrderDetail = true\n      } catch (e) {\n        this.$message.error('获取订单详情失败，请稍后重试')\n        console.error('获取订单详情失败:', e)\n      } finally {\n        this.detailLoading = false\n      }\n    },\n    contactUser(order) {\n      try {\n        // 根据订单类型设置聊天对象\n        if (this.orderType === 'buy') {\n          // 购买方联系服务提供方\n          this.chatUserId = order.providerId || '1'\n          this.chatUserName = order.providerName || '服务商'\n          this.chatUserAvatar = order.providerAvatar || ''\n        } else {\n          // 服务提供方联系购买方\n          this.chatUserId = order.userId || '1'\n          this.chatUserName = order.userName || '客户'\n          this.chatUserAvatar = order.userAvatar || ''\n        }\n        this.showChat = true\n      } catch (e) {\n        this.$message.error('打开聊天窗口失败，请稍后重试')\n        console.error('打开聊天窗口失败:', e)\n      }\n    },\n    payOrder(order) {\n      // 这里可以添加支付订单的逻辑\n      this.$message.info(`支付订单 ${order.id}`)\n    },\n    confirmOrder(order) {\n      // 这里可以添加确认订单的逻辑\n      this.$message.info(`确认订单 ${order.id}`)\n    },\n    completeOrder(order) {\n      // 这里可以添加确认完成订单的逻辑\n      this.$message.info(`确认完成订单 ${order.id}`)\n    },\n    cancelOrder(order) {\n      // 这里可以添加取消订单的逻辑\n      this.$message.info(`取消订单 ${order.id}`)\n    },\n    async load() {\n      this.loading = true\n      try {\n        const res = await listMy({ \n          current: this.page.current, \n          size: this.page.size, \n          type: this.orderType,\n          ...this.query \n        })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally {\n        this.loading = false\n      }\n    },\n    onPage(p) {\n      this.page.current = p\n      this.load()\n    },\n    onSizeChange(size) {\n      this.page.size = size\n      this.page.current = 1\n      this.load()\n    },\n    handleSortChange({ prop, order }) {\n      // 处理排序逻辑\n      if (!prop || !order) {\n        // 重置排序\n        this.load()\n        return\n      }\n      \n      // 对显示数据进行排序\n      const sortedList = [...this.displayList].sort((a, b) => {\n        if (prop === 'id') {\n          // 订单号排序\n          const aVal = a[prop] || ''\n          const bVal = b[prop] || ''\n          return order === 'ascending' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal)\n        } else if (prop === 'serviceName') {\n          // 服务名称排序\n          const aVal = a[prop] || ''\n          const bVal = b[prop] || ''\n          return order === 'ascending' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal)\n        } else if (prop === 'amount') {\n          // 金额排序\n          const aVal = a[prop] || 0\n          const bVal = b[prop] || 0\n          return order === 'ascending' ? aVal - bVal : bVal - aVal\n        } else if (prop === 'createTime') {\n          // 时间排序\n          const aVal = new Date(a[prop] || 0)\n          const bVal = new Date(b[prop] || 0)\n          return order === 'ascending' ? aVal - bVal : bVal - aVal\n        }\n        return 0\n      })\n      \n      // 更新显示数据\n      this.list = sortedList\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* 页面容器 */\n.page-card {\n  background: #ffffff;\n  border-radius: 12px;\n  padding: 24px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n  border: 1px solid #e2e8f0;\n  margin: 20px 0;\n}\n\n/* 列表头部 */\n.list-header {\n  margin-bottom: 24px;\n  padding-bottom: 20px;\n  border-bottom: 2px solid #3b82f6;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\