le: '服务配置',\n        description: '价格、周期、版本、部署环境等配置信息'\n      }, {\n        title: '服务详情',\n        description: '服务描述、接口定义、依赖管理等详细信息'\n      }],\n      form: {\n        title: '',\n        category: '',\n        type: 'service',\n        tags: [],\n        price: 0,\n        serviceCycle: '',\n        version: '',\n        deploymentEnv: '',\n        summary: '',\n        description: '',\n        apiDefinition: '',\n        dependencies: ''\n      },\n      rules: {\n        title: [{\n          required: true,\n          message: '请输入服务名称',\n          trigger: 'blur'\n        }],\n        category: [{\n          required: true,\n          message: '请选择服务类型',\n          trigger: 'change'\n        }],\n        price: [{\n          required: true,\n          message: '请输入服务价格',\n          trigger: 'blur'\n        }],\n        summary: [{\n          required: true,\n          message: '请输入服务简介',\n          trigger: 'blur'\n        }],\n        description: [{\n          required: true,\n          message: '请输入服务详情',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  methods: {\n    showGuidelines: function showGuidelines() {\n      this.showGuidelinesDialog = true;\n    },\n    addTag: function addTag() {\n      if (this.inputTag && !this.form.tags.includes(this.inputTag)) {\n        this.form.tags.push(this.inputTag);\n        this.inputTag = '';\n      }\n    },\n    removeTag: function removeTag(tag) {\n      this.form.tags = this.form.tags.filter(function (t) {\n        return t !== tag;\n      });\n    },\n    prevStep: function prevStep() {\n      if (this.currentStep > 0) {\n        this.currentStep--;\n      }\n    },\n    nextStep: function nextStep() {\n      var _this = this;\n      if (this.currentStep === 0) {\n        this.$refs.form.validateField(['title', 'category'], function (err) {\n          if (!err) _this.currentStep = 1;\n        });\n      } else if (this.currentStep === 1) {\n        this.$refs.form.validateField(['price'], function (err) {\n          if (!err) _this.currentStep = 2;\n        });\n      }\n    },\n    submit: function submit() {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.n) {\n            case 0:\n              _this2.$refs.form.validate(/*#__PURE__*/function () {\n                var _ref = _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee(valid) {\n                  var _e$response, _t;\n                  return _regenerator().w(function (_context) {\n                    while (1) switch (_context.p = _context.n) {\n                      case 0:\n                        if (valid) {\n                          _context.n = 1;\n                          break;\n                        }\n                        return _context.a(2);\n                      case 1:\n                        _this2.loading = true;\n                        _context.p = 2;\n                        _context.n = 3;\n                        return publish(_this2.form);\n                      case 3:\n                        _this2.$message.success('服务已提交，等待审核');\n                        _this2.$router.push('/my-services');\n                        _context.n = 5;\n                        break;\n                      case 4:\n                        _context.p = 4;\n                        _t = _context.v;\n                        _this2.$message.error(((_e$response = _t.response) === null || _e$response === void 0 || (_e$response = _e$response.data) === null || _e$response === void 0 ? void 0 : _e$response.message) || _t.message || '提交失败');\n                      case 5:\n                        _context.p = 5;\n                        _this2.loading = false;\n                        return _context.f(5);\n                      case 6:\n                        return _context.a(2);\n                    }\n                  }, _callee, null, [[2, 4, 5, 6]]);\n                }));\n                return function (_x) {\n                  return _ref.apply(this, arguments);\n                };\n              }());\n            case 1:\n              return _context2.a(2);\n          }\n        }, _callee2);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["publish","name","data","currentStep","loading","showGuidelinesDialog","inputTag","steps","title","description","form","category","type","tags","price","serviceCycle","version","deploymentEnv","summary","apiDefinition","dependencies","rules","required","message","trigger","methods","showGuidelines","addTag","includes","push","removeTag","tag","filter","t","prevStep","nextStep","_this","$refs","validateField","err","submit","_this2","_asyncToGenerator","_regenerator","m","_callee2","w","_context2","n","validate","_ref","_callee","valid","_e$response","_t","_context","p","a","$message","success","$router","v","error","response","f","_x","apply","arguments"],"sources":["src/views/resource/Publish.vue"],"sourcesContent":["<template>\n  <div class=\"service-publish-container\">\n    <!-- 页面头部 -->\n    <div class=\"publish-header\">\n      <div class=\"header-content\">\n        <h1 class=\"page-title\">发布服务</h1>\n        <p class=\"page-subtitle\">创建并提交您的服务，为创业者提供专业支持</p>\n      </div>\n      <div class=\"header-actions\">\n        <el-button type=\"info\" icon=\"el-icon-info\" @click=\"showGuidelines\">\n          发布指南\n        </el-button>\n      </div>\n    </div>\n\n    <!-- 进度指示器 -->\n    <div class=\"progress-indicator\">\n      <div \n        v-for=\"(step, index) in steps\" \n        :key=\"index\"\n        class=\"progress-step\"\n        :class=\"{ 'active': currentStep === index, 'completed': currentStep > index }\"\n      >\n        <div class=\"step-number\">{{ index + 1 }}</div>\n        <div class=\"step-content\">\n          <h3 class=\"step-title\">{{ step.title }}</h3>\n          <p class=\"step-description\">{{ step.description }}</p>\n        </div>\n        <div class=\"step-line\" v-if=\"index < steps.length - 1\"></div>\n      </div>\n    </div>\n\n    <!-- 表单内容 -->\n    <div class=\"form-container\">\n      <el-form ref=\"form\" :model=\"form\" :rules=\"rules\" label-width=\"140px\" class=\"service-form\">\n        <!-- 基本信息 -->\n        <template v-if=\"currentStep === 0\">\n          <div class=\"form-section\">\n            <h2 class=\"section-title\">基本信息</h2>\n            <p class=\"section-description\">填写服务的基本信息，让创业者快速了解您的服务</p>\n          </div>\n\n          <el-form-item label=\"服务名称\" prop=\"title\" class=\"form-item\">\n            <el-input \n              v-model=\"form.title\" \n              placeholder=\"请输入服务名称\" \n              clearable \n              maxlength=\"100\" \n              show-word-limit\n              class=\"form-input\"\n            />\n            <div class=\"form-hint\">简洁明了的服务名称有助于创业者快速理解您的服务内容</div>\n          </el-form-item>\n\n          <el-form-item label=\"服务类型\" prop=\"category\" class=\"form-item\">\n            <el-select \n              v-model=\"form.category\" \n              placeholder=\"请选择服务类型\" \n              clearable\n              class=\"form-select\"\n            >\n              <el-option label=\"技术开发\" value=\"技术开发\" />\n              <el-option label=\"法律咨询\" value=\"法律咨询\" />\n              <el-option label=\"财务服务\" value=\"财务服务\" />\n              <el-option label=\"市场营销\" value=\"市场营销\" />\n              <el-option label=\"人力资源\" value=\"人力资源\" />\n              <el-option label=\"其他\" value=\"其他\" />\n            </el-select>\n          </el-form-item>\n\n          <el-form-item label=\"服务标签\" class=\"form-item\">\n            <el-tag\n              v-for=\"tag in form.tags\"\n              :key=\"tag\"\n              closable\n              @close=\"removeTag(tag)\"\n              class=\"service-tag\"\n            >\n              {{ tag }}\n            </el-tag>\n            <el-input\n              v-model=\"inputTag\"\n              placeholder=\"输入标签并按Enter添加\"\n              @keyup.enter=\"addTag\"\n              class=\"tag-input\"\n            />\n            <div class=\"form-hint\">添加相关标签，提高服务曝光率</div>\n          </el-form-item>\n\n          <div class=\"form-actions\">\n            <el-button type=\"primary\" @click=\"nextStep\" class=\"action-button primary\">\n              下一步\n            </el-button>\n          </div>\n        </template>\n\n        <!-- 服务配置 -->\n        <template v-if=\"currentStep === 1\">\n          <div class=\"form-section\">\n            <h2 class=\"section-title\">服务配置</h2>\n            <p class=\"section-description\">详细配置您的服务参数和价格信息</p>\n          </div>\n\n          <el-form-item label=\"服务价格(元)\" prop=\"price\" class=\"form-item\">\n            <el-input-number \n              v-model=\"form.price\" \n              :min=\"0\" \n              :max=\"999999\" \n              placeholder=\"请输入服务价格\"\n              class=\"form-input-number\"\n            />\n          </el-form-item>\n\n          <el-form-item label=\"服务周期\" prop=\"serviceCycle\" class=\"form-item\">\n            <el-input \n              v-model=\"form.serviceCycle\" \n              placeholder=\"如 30天、1个月\" \n              clearable\n              class=\"form-input\"\n            />\n          </el-form-item>\n\n          <el-form-item label=\"服务版本\" class=\"form-item\">\n            <el-input \n              v-model=\"form.version\" \n              placeholder=\"如 v1.0.0\" \n              clearable\n              class=\"form-input\"\n            />\n          </el-form-item>\n\n          <el-form-item label=\"部署环境\" class=\"form-item\">\n            <el-select \n              v-model=\"form.deploymentEnv\" \n              placeholder=\"请选择部署环境\" \n              clearable\n              class=\"form-select\"\n            >\n              <el-option label=\"本地部署\" value=\"local\" />\n              <el-option label=\"云端部署\" value=\"cloud\" />\n              <el-option label=\"混合部署\" value=\"hybrid\" />\n            </el-select>\n          </el-form-item>\n\n          <div class=\"form-actions\">\n            <el-button @click=\"prevStep\" class=\"action-button\">\n              上一步\n            </el-button>\n            <el-button type=\"primary\" @click=\"nextStep\" class=\"action-button primary\">\n              下一步\n            </el-button>\n          </div>\n        </template>\n\n        <!-- 服务详情 -->\n        <template v-if=\"currentStep === 2\">\n          <div class=\"form-section\">\n            <h2 class=\"section-title\">服务详情</h2>\n            <p class=\"section-description\">详细描述您的服务内容、接口定义和依赖管理</p>\n          </div>\n\n          <el-form-item label=\"服务简介\" prop=\"summary\" class=\"form-item\">\n            <el-input \n              v-model=\"form.summary\" \n              type=\"textarea\" \n              :rows=\"3\" \n              placeholder=\"请简要描述服务的核心价值和目标\" \n              maxlength=\"200\" \n              show-word-limit\n              class=\"form-textarea\"\n            />\n            <div class=\"form-hint\">简洁明了的服务简介，让创业者快速了解服务价值</div>\n          </el-form-item>\n\n          <el-form-item label=\"服务详情\" prop=\"description\" class=\"form-item\">\n            <el-input \n              v-model=\"form.description\" \n              type=\"textarea\" \n              :rows=\"8\" \n              placeholder=\"请详细描述服务的功能、优势和使用场景\" \n              maxlength=\"2000\" \n              show-word-limit\n              class=\"form-textarea\"\n            />\n          </el-form-item>\n\n          <el-form-item label=\"接口定义\" class=\"form-item\">\n            <el-input \n              v-model=\"form.apiDefinition\" \n              type=\"textarea\" \n              :rows=\"5\" \n              placeholder=\"请描述服务提供的接口和使用方法\" \n              maxlength=\"1000\" \n              show-word-limit\n              class=\"form-textarea\"\n            />\n          </el-form-item>\n\n          <el-form-item label=\"服务依赖\" class=\"form-item\">\n            <el-input \n              v-model=\"form.dependencies\" \n              type=\"textarea\" \n              :rows=\"4\" \n              placeholder=\"请说明服务的依赖项和环境要求\" \n              maxlength=\"800\" \n              show-word-limit\n              class=\"form-textarea\"\n            />\n          </el-form-item>\n\n          <div class=\"form-actions\">\n            <el-button @click=\"prevStep\" class=\"action-button\">\n              上一步\n            </el-button>\n            <el-button type=\"primary\" :loading=\"loading\" @click=\"submit\" class=\"action-button primary\">\n              提交审核\n            </el-button>\n          </div>\n        </template>\n      </el-form>\n    </div>\n\n    <!-- 发布指南弹窗 -->\n    <el-dialog\n      title=\"服务发布指南\"\n      :visible.sync=\"showGuidelinesDialog\"\n      width=\"800px\"\n      class=\"guidelines-dialog\"\n    >\n      <div class=\"guidelines-content\">\n        <h3>发布服务的最佳实践</h3>\n        <ul class=\"guidelines-list\">\n          <li><strong>服务名称</strong>：简洁明了，能准确反映服务核心内容</li>\n          <li><strong>服务类型</strong>：选择最符合服务的分类</li>\n          <li><strong>服务价格</strong>：合理定价，明确收费标准</li>\n          <li><strong>服务周期</strong>：清晰说明服务提供的时间范围</li>\n          <li><strong>服务详情</strong>：详细描述服务的功能、优势和使用场景</li>\n          <li><strong>接口定义</strong>：明确服务提供的接口和使用方法</li>\n          <li><strong>服务依赖</strong>：清晰说明服务的依赖项和环境要求</li>\n        </ul>\n        <p class=\"guidelines-note\">\n          提示：服务提交后将进入审核流程，审核通过后将在服务市场展示。\n        </p>\n      </div>\n      <template #footer>\n        <span class=\"dialog-footer\">\n          <el-button @click=\"showGuidelinesDialog = false\">我知道了</el-button>\n        </span>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { publish } from '@/api/resource'\nexport default {\n  name: 'ServicePublish',\n  data() {\n    return {\n      currentStep: 0,\n      loading: false,\n      showGuidelinesDialog: false,\n      inputTag: '',\n      steps: [\n        { title: '基本信息', description: '服务名称、类型、标签等基本信息' },\n        { title: '服务配置', description: '价格、周期、版本、部署环境等配置信息' },\n        { title: '服务详情', description: '服务描述、接口定义、依赖管理等详细信息' }\n      ],\n      form: {\n        title: '',\n        category: '',\n        type: 'service',\n        tags: [],\n        price: 0,\n        serviceCycle: '',\n        version: '',\n        deploymentEnv: '',\n        summary: '',\n        description: '',\n        apiDefinition: '',\n        dependencies: ''\n      },\n      rules: {\n        title: [{ required: true, message: '请输入服务名称', trigger: 'blur' }],\n        category: [{ required: true, message: '请选择服务类型', trigger: 'change' }],\n        price: [{ required: true, message: '请输入服务价格', trigger: 'blur' }],\n        summary: [{ required: true, message: '请输入服务简介', trigger: 'blur' }],\n        description: [{ required: true, message: '请输入服务详情', trigger: 'blur' }]\n      }\n    }\n  },\n  methods: {\n    showGuidelines() {\n      this.showGuidelinesDialog = true\n    },\n    addTag() {\n      if (this.inputTag && !this.form.tags.includes(this.inputTag)) {\n        this.form.tags.push(this.inputTag)\n        this.inputTag = ''\n      }\n    },\n    removeTag(tag) {\n      this.form.tags = this.form.tags.filter(t => t !== tag)\n    },\n    prevStep() {\n      if (this.currentStep > 0) {\n        this.currentStep--\n      }\n    },\n    nextStep() {\n      if (this.currentStep === 0) {\n        this.$refs.form.validateField(['title', 'category'], (err) => {\n          if (!err) this.currentStep = 1\n        })\n      } else if (this.currentStep === 1) {\n        this.$refs.form.validateField(['price'], (err) => {\n          if (!err) this.currentStep = 2\n        })\n      }\n    },\n    async submit() {\n      this.$refs.form.validate(async (valid) => {\n        if (!valid) return\n        this.loading = true\n        try {\n          await publish(this.form)\n          this.$message.success('服务已提交，等待审核')\n          this.$router.push('/my-services')\n        } catch (e) {\n          this.$message.error(e.response?.data?.message || e.message || '提交失败')\n        } finally {\n          this.loading = false\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* 页面容器 */\n.service-publish-container {\n  padding: 24px;\n  max-width: 1200px;\n  margin: 0 auto;\n  min-height: 100vh;\n  background: #0f172a;\n  color: #f8fafc;\n}\n\n/* 页面头部 */\n.publish-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 40px;\n  padding-bottom: 24px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.header-content {\n  flex: 1;\n}\n\n.page-title {\n  font-size: 32px;\n  font-weight: 700;\n  color: #f8fafc;\n  margin-bottom: 8px;\n  line-height: 1.2;\n}\n\n.page-subtitle {\n  font-size: 16px;\n  color: #94a3b8;\n  font-weight: 500;\n  margin: 0;\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n/* 进度指示器 */\n.progress-indicator {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 48px;\n  position: relative;\n}\n\n.progress-step {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  flex: 1;\n  position: relative;\n  z-index: 1;\n}\n\n.step-number {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: #334155;\n  color: #94a3b8;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 16px;\n  margin-bottom: 12px;\n  transition: all 0.3s ease;\n  border: 2px solid transparent;\n}\n\n.progress-step.active .step-number {\n  background: #3b82f6;\n  color: #fff;\n  border-color: #60a5fa;\n  box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);\n}\n\n.progress-step.completed .step-number {\n  background: #10b981;\n  color: #fff;\n  border-color: #34d399;\n}\n\n.step-content {\n  text-align: center;\n  max-width: 200px;\n}\n\n.step-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #94a3b8;\n  margin-bottom: 4px;\n  transition: all 0.3s ease;\n}\n\n.progress-step.active .step-title {\n  color: #f8fafc;\n}\n\n.progress-step.completed .step-title {\n  color: #10b981;\n}\n\n.step-description {\n  font-size: 14px;\n  color: #64748b;\n  margin: 0;\n}\n\n.step-line {\n  position: absolute;\n  top: 20px;\n  left: 50%;\n  width: 100%;\n  height: 2px;\n  background: #334155;\n  z-index: -1;\n}\n\n.progress-step.completed .step-line {\n  background: #10b981;\n}\n\n/* 表单容器 */\n.form-container {\n  background: #1e293b;\n  border-radius: 16px;\n  padding: 32px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n/* 表单部分 */\n.form-section {\n  margin-bottom: 32px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.section-title {\n  font-size: 20px;\n  font-weight: 600;\n  color: #f8fafc;\n  margin-bottom: 8px;\n}\n\n.section-description {\n  font-size: 14px;\n  color: #94a3b8;\n  margin: 0;\n}\n\n/* 表单项目 */\n.form-item {\n  margin-bottom: 24px;\n}\n\n.form-input,\n.form-select,\n.form-textarea,\n.form-input-number {\n  width: 100%;\n  border-radius: 8px;\n  background: #334155;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #f8fafc;\n  transition: all 0.3s ease;\n}\n\n.form-input:focus,\n.form-select:focus,\n.form-textarea:focus,\n.form-input-number:focus {\n  border-color: #3b82f6;\n  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);\n}\n\n.form-hint {\n  font-size: 12px;\n  color: #64748b;\n  margin-top: 8px;\n}\n\n/* 标签样式 */\n.service-tag {\n  margin-right: 8px;\n  margin-bottom: 8px;\n  background: rgba(59, 130, 246, 0.1);\n  color: #3b82f6;\n  border-color: rgba(59, 130, 246, 0.3);\n  border-radius: 16px;\n  padding: 4px 12px;\n  font-size: 12px;\n}\n\n.tag-input {\n  margin-top: 12px;\n  width: 100%;\n  max-width: 300px;\n}\n\n/* 表单操作按钮 */\n.form-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-top: 40px;\n  padding-top: 24px;\n  border-top: 1p