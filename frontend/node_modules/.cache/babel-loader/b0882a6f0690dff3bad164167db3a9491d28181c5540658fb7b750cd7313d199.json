{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.date.to-string.js\";\nimport \"core-js/modules/es.object.to-string.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { postAPI } from '@/api/community';\nexport default {\n  name: 'CommunityHome',\n  data: function data() {\n    return {\n      posts: [],\n      filters: {\n        category: '',\n        type: '',\n        keyword: ''\n      },\n      pagination: {\n        currentPage: 1,\n        pageSize: 10,\n        total: 0\n      },\n      loading: false\n    };\n  },\n  mounted: function mounted() {\n    this.loadPosts();\n  },\n  methods: {\n    loadPosts: function loadPosts() {\n      var _this = this;\n      this.loading = true;\n      postAPI.getPostList({\n        page: this.pagination.currentPage,\n        size: this.pagination.pageSize,\n        category: this.filters.category,\n        type: this.filters.type,\n        keyword: this.filters.keyword\n      }).then(function (res) {\n        if (res.data && res.data.records) {\n          _this.posts = res.data.records || [];\n          _this.pagination.total = res.data.total || 0;\n        } else {\n          _this.posts = [];\n          _this.pagination.total = 0;\n        }\n      })[\"catch\"](function (err) {\n        console.error('加载帖子失败:', err);\n        _this.posts = [];\n        _this.pagination.total = 0;\n      })[\"finally\"](function () {\n        _this.loading = false;\n      });\n    },\n    handleSizeChange: function handleSizeChange(size) {\n      this.pagination.pageSize = size;\n      this.loadPosts();\n    },\n    handleCurrentChange: function handleCurrentChange(current) {\n      this.pagination.currentPage = current;\n      this.loadPosts();\n    },\n    navigateToCreate: function navigateToCreate() {\n      // 检查是否登录\n      if (!this.$store.state.user.token) {\n        this.$message.warning('请先登录');\n        this.$router.push('/login');\n        return;\n      }\n      this.$router.push('/community/create');\n    },\n    navigateToDetail: function navigateToDetail(id) {\n      this.$router.push(\"/community/post/\".concat(id));\n    },\n    formatDate: function formatDate(dateString) {\n      var date = new Date(dateString);\n      var now = new Date();\n      var diff = now - date;\n      var days = Math.floor(diff / (1000 * 60 * 60 * 24));\n      var hours = Math.floor(diff / (1000 * 60 * 60));\n      var minutes = Math.floor(diff / (1000 * 60));\n      if (days > 0) {\n        return \"\".concat(days, \"\\u5929\\u524D\");\n      } else if (hours > 0) {\n        return \"\".concat(hours, \"\\u5C0F\\u65F6\\u524D\");\n      } else if (minutes > 0) {\n        return \"\".concat(minutes, \"\\u5206\\u949F\\u524D\");\n      } else {\n        return '刚刚';\n      }\n    }\n  }\n};","map":{"version":3,"names":["postAPI","name","data","posts","filters","category","type","keyword","pagination","currentPage","pageSize","total","loading","mounted","loadPosts","methods","_this","getPostList","page","size","then","res","records","err","console","error","handleSizeChange","handleCurrentChange","current","navigateToCreate","$store","state","user","token","$message","warning","$router","push","navigateToDetail","id","concat","formatDate","dateString","date","Date","now","diff","days","Math","floor","hours","minutes"],"sources":["src/views/community/CommunityHome.vue"],"sourcesContent":["<template>\r\n  <div class=\"community-home\">\r\n    <div class=\"container\">\r\n      <!-- 顶部导航 -->\r\n      <div class=\"community-header\">\r\n        <h1 class=\"community-title\">社区交流</h1>\r\n        <el-button type=\"primary\" size=\"large\" @click=\"navigateToCreate\" class=\"create-btn\">\r\n          <i class=\"el-icon-edit\"></i> 发布帖子\r\n        </el-button>\r\n      </div>\r\n      \r\n      <!-- 分类筛选 -->\r\n      <div class=\"filter-bar\">\r\n        <el-select v-model=\"filters.category\" placeholder=\"选择分类\" class=\"filter-item\">\r\n          <el-option label=\"全部\" value=\"\"></el-option>\r\n          <el-option label=\"创业经验\" value=\"创业经验\"></el-option>\r\n          <el-option label=\"融资技巧\" value=\"融资技巧\"></el-option>\r\n          <el-option label=\"技术分享\" value=\"技术分享\"></el-option>\r\n          <el-option label=\"行业动态\" value=\"行业动态\"></el-option>\r\n        </el-select>\r\n        \r\n        <el-select v-model=\"filters.type\" placeholder=\"选择类型\" class=\"filter-item\">\r\n          <el-option label=\"全部\" value=\"\"></el-option>\r\n          <el-option label=\"文章\" value=\"article\"></el-option>\r\n          <el-option label=\"问题\" value=\"question\"></el-option>\r\n        </el-select>\r\n        \r\n        <el-input\r\n          v-model=\"filters.keyword\"\r\n          placeholder=\"搜索帖子\"\r\n          class=\"filter-item search-input\"\r\n          @keyup.enter=\"loadPosts\"\r\n        >\r\n          <el-button slot=\"append\" icon=\"el-icon-search\" @click=\"loadPosts\"></el-button>\r\n        </el-input>\r\n      </div>\r\n      \r\n      <!-- 帖子列表 -->\r\n      <div class=\"post-list\" v-loading=\"loading\">\r\n        <el-card v-for=\"post in posts\" :key=\"post.id\" class=\"post-card\" @click.native=\"navigateToDetail(post.id)\">\r\n          <div class=\"post-header\">\r\n            <span class=\"post-title\">{{ post.title }}</span>\r\n            <span class=\"post-type\" :class=\"post.type\">{{ post.type === 'article' ? '文章' : '问题' }}</span>\r\n          </div>\r\n          <div class=\"post-content\">{{ post.content.substring(0, 120) }}...</div>\r\n          <div class=\"post-footer\">\r\n            <div class=\"post-meta-left\">\r\n              <span class=\"post-meta\">{{ formatDate(post.createdAt) }}</span>\r\n              <span class=\"post-meta category-tag\">{{ post.category }}</span>\r\n            </div>\r\n            <div class=\"post-meta-right\">\r\n              <span class=\"post-meta\">\r\n                <i class=\"el-icon-view\"></i> {{ post.viewCount }}\r\n              </span>\r\n              <span class=\"post-meta\">\r\n                <i class=\"el-icon-thumb\"></i> {{ post.likeCount }}\r\n              </span>\r\n              <span class=\"post-meta\">\r\n                <i class=\"el-icon-chat-dot-round\"></i> {{ post.commentCount }}\r\n              </span>\r\n            </div>\r\n          </div>\r\n        </el-card>\r\n        \r\n        <!-- 空状态 -->\r\n        <div v-if=\"!loading && posts.length === 0\" class=\"empty-state\">\r\n          <el-empty description=\"暂无帖子\" />\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 分页 -->\r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n          @size-change=\"handleSizeChange\"\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"pagination.currentPage\"\r\n          :page-sizes=\"[10, 20, 50]\"\r\n          :page-size=\"pagination.pageSize\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          :total=\"pagination.total\"\r\n        ></el-pagination>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { postAPI } from '@/api/community'\r\n\r\nexport default {\r\n  name: 'CommunityHome',\r\n  data() {\r\n    return {\r\n      posts: [],\r\n      filters: {\r\n        category: '',\r\n        type: '',\r\n        keyword: ''\r\n      },\r\n      pagination: {\r\n        currentPage: 1,\r\n        pageSize: 10,\r\n        total: 0\r\n      },\r\n      loading: false\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadPosts()\r\n  },\r\n  methods: {\r\n    loadPosts() {\r\n      this.loading = true\r\n      postAPI.getPostList({\r\n        page: this.pagination.currentPage,\r\n        size: this.pagination.pageSize,\r\n        category: this.filters.category,\r\n        type: this.filters.type,\r\n        keyword: this.filters.keyword\r\n      }).then(res => {\r\n        if (res.data && res.data.records) {\r\n          this.posts = res.data.records || []\r\n          this.pagination.total = res.data.total || 0\r\n        } else {\r\n          this.posts = []\r\n          this.pagination.total = 0\r\n        }\r\n      }).catch(err => {\r\n        console.error('加载帖子失败:', err)\r\n        this.posts = []\r\n        this.pagination.total = 0\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    handleSizeChange(size) {\r\n      this.pagination.pageSize = size\r\n      this.loadPosts()\r\n    },\r\n    handleCurrentChange(current) {\r\n      this.pagination.currentPage = current\r\n      this.loadPosts()\r\n    },\r\n    navigateToCreate() {\r\n      // 检查是否登录\r\n      if (!this.$store.state.user.token) {\r\n        this.$message.warning('请先登录')\r\n        this.$router.push('/login')\r\n        return\r\n      }\r\n      this.$router.push('/community/create')\r\n    },\r\n    navigateToDetail(id) {\r\n      this.$router.push(`/community/post/${id}`)\r\n    },\r\n    formatDate(dateString) {\r\n      const date = new Date(dateString)\r\n      const now = new Date()\r\n      const diff = now - date\r\n      const days = Math.floor(diff / (1000 * 60 * 60 * 24))\r\n      const hours = Math.floor(diff / (1000 * 60 * 60))\r\n      const minutes = Math.floor(diff / (1000 * 60))\r\n      \r\n      if (days > 0) {\r\n        return `${days}天前`\r\n      } else if (hours > 0) {\r\n        return `${hours}小时前`\r\n      } else if (minutes > 0) {\r\n        return `${minutes}分钟前`\r\n      } else {\r\n        return '刚刚'\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.community-home {\r\n  padding: 30px 0;\r\n  min-height: calc(100vh - 120px);\r\n}\r\n\r\n.container {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 0 20px;\r\n}\r\n\r\n.community-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: 30px;\r\n  padding-bottom: 20px;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.community-title {\r\n  font-size: 32px;\r\n  font-weight: 700;\r\n  color: #1890ff;\r\n  margin: 0;\r\n}\r\n\r\n.create-btn {\r\n  font-size: 16px;\r\n  padding: 10px 24px;\r\n  border-radius: 8px;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.create-btn:hover {\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 4px 12px rgba(24, 144, 255, 0.3);\r\n}\r\n\r\n.filter-bar {\r\n  display: flex;\r\n  margin-bottom: 30px;\r\n  gap: 16px;\r\n  align-items: center;\r\n  background: #f8f9fa;\r\n  padding: 20px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.filter-item {\r\n  width: 160px;\r\n}\r\n\r\n.search-input {\r\n  flex: 1;\r\n  max-width: 450px;\r\n}\r\n\r\n.post-list {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));\r\n  gap: 24px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.post-card {\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  border: 1px solid #e8e8e8;\r\n}\r\n\r\n.post-card:hover {\r\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);\r\n  transform: translateY(-4px);\r\n  border-color: #1890ff;\r\n}\r\n\r\n.post-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  margin-bottom: 12px;\r\n  padding-bottom: 12px;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.post-title {\r\n  font-size: 20px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  flex: 1;\r\n  line-height: 1.4;\r\n  margin-right: 12px;\r\n  transition: color 0.3s ease;\r\n}\r\n\r\n.post-title:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.post-type {\r\n  padding: 4px 12px;\r\n  border-radius: 16px;\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n}\r\n\r\n.post-type.article {\r\n  background-color: #e6f7ff;\r\n  color: #1890ff;\r\n  border: 1px solid #91d5ff;\r\n}\r\n\r\n.post-type.question {\r\n  background-color: #fff7e6;\r\n  color: #fa8c16;\r\n  border: 1px solid #ffd591;\r\n}\r\n\r\n.post-content {\r\n  color: #666;\r\n  margin-bottom: 16px;\r\n  line-height: 1.6;\r\n  font-size: 14px;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n\r\n.post-footer {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 13px;\r\n  color: #999;\r\n  padding-top: 12px;\r\n  border-top: 1px solid #f0f0f0;\r\n}\r\n\r\n.post-meta-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.post-meta-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n}\r\n\r\n.post-meta {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  transition: color 0.3s ease;\r\n}\r\n\r\n.post-meta:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.category-tag {\r\n  padding: 2px 8px;\r\n  background-color: #f0f0f0;\r\n  border-radius: 4px;\r\n  font-size: 12px;\r\n}\r\n\r\n.empty-state {\r\n  grid-column: 1 / -1;\r\n  text-align: center;\r\n  padding: 60px 0;\r\n}\r\n\r\n.pagination {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 40px;\r\n  padding-top: 20px;\r\n  border-top: 1px solid #f0f0f0;\r\n}\r\n\r\n/* 响应式设计 */\r\n@media (max-width: 768px) {\r\n  .community-home {\r\n    padding: 20px 0;\r\n  }\r\n  \r\n  .container {\r\n    padding: 0 15px;\r\n  }\r\n  \r\n  .community-header {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 16px;\r\n  }\r\n  \r\n  .filter-bar {\r\n    flex-direction: column;\r\n    align-items: stretch;\r\n    gap: 12px;\r\n  }\r\n  \r\n  .filter-item {\r\n    width: 100%;\r\n  }\r\n  \r\n  .post-list {\r\n    grid-template-columns: 1fr;\r\n    gap: 16px;\r\n  }\r\n  \r\n  .post-card {\r\n    margin-bottom: 0;\r\n  }\r\n  \r\n  .post-footer {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 8px;\r\n  }\r\n  \r\n  .post-meta-right {\r\n    width: 100%;\r\n    justify-content: space-between;\r\n  }\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAuFA,SAAAA,OAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,KAAA;MACAC,OAAA;QACAC,QAAA;QACAC,IAAA;QACAC,OAAA;MACA;MACAC,UAAA;QACAC,WAAA;QACAC,QAAA;QACAC,KAAA;MACA;MACAC,OAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,SAAA;EACA;EACAC,OAAA;IACAD,SAAA,WAAAA,UAAA;MAAA,IAAAE,KAAA;MACA,KAAAJ,OAAA;MACAZ,OAAA,CAAAiB,WAAA;QACAC,IAAA,OAAAV,UAAA,CAAAC,WAAA;QACAU,IAAA,OAAAX,UAAA,CAAAE,QAAA;QACAL,QAAA,OAAAD,OAAA,CAAAC,QAAA;QACAC,IAAA,OAAAF,OAAA,CAAAE,IAAA;QACAC,OAAA,OAAAH,OAAA,CAAAG;MACA,GAAAa,IAAA,WAAAC,GAAA;QACA,IAAAA,GAAA,CAAAnB,IAAA,IAAAmB,GAAA,CAAAnB,IAAA,CAAAoB,OAAA;UACAN,KAAA,CAAAb,KAAA,GAAAkB,GAAA,CAAAnB,IAAA,CAAAoB,OAAA;UACAN,KAAA,CAAAR,UAAA,CAAAG,KAAA,GAAAU,GAAA,CAAAnB,IAAA,CAAAS,KAAA;QACA;UACAK,KAAA,CAAAb,KAAA;UACAa,KAAA,CAAAR,UAAA,CAAAG,KAAA;QACA;MACA,sBAAAY,GAAA;QACAC,OAAA,CAAAC,KAAA,YAAAF,GAAA;QACAP,KAAA,CAAAb,KAAA;QACAa,KAAA,CAAAR,UAAA,CAAAG,KAAA;MACA;QACAK,KAAA,CAAAJ,OAAA;MACA;IACA;IACAc,gBAAA,WAAAA,iBAAAP,IAAA;MACA,KAAAX,UAAA,CAAAE,QAAA,GAAAS,IAAA;MACA,KAAAL,SAAA;IACA;IACAa,mBAAA,WAAAA,oBAAAC,OAAA;MACA,KAAApB,UAAA,CAAAC,WAAA,GAAAmB,OAAA;MACA,KAAAd,SAAA;IACA;IACAe,gBAAA,WAAAA,iBAAA;MACA;MACA,UAAAC,MAAA,CAAAC,KAAA,CAAAC,IAAA,CAAAC,KAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;QACA;MACA;MACA,KAAAD,OAAA,CAAAC,IAAA;IACA;IACAC,gBAAA,WAAAA,iBAAAC,EAAA;MACA,KAAAH,OAAA,CAAAC,IAAA,oBAAAG,MAAA,CAAAD,EAAA;IACA;IACAE,UAAA,WAAAA,WAAAC,UAAA;MACA,IAAAC,IAAA,OAAAC,IAAA,CAAAF,UAAA;MACA,IAAAG,GAAA,OAAAD,IAAA;MACA,IAAAE,IAAA,GAAAD,GAAA,GAAAF,IAAA;MACA,IAAAI,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAH,IAAA;MACA,IAAAI,KAAA,GAAAF,IAAA,CAAAC,KAAA,CAAAH,IAAA;MACA,IAAAK,OAAA,GAAAH,IAAA,CAAAC,KAAA,CAAAH,IAAA;MAEA,IAAAC,IAAA;QACA,UAAAP,MAAA,CAAAO,IAAA;MACA,WAAAG