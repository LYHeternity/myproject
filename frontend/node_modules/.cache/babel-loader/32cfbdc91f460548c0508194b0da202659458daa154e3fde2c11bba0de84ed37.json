阶段\" clearable class=\"hw-select\">\n            <el-option label=\"想法\" value=\"idea\" />\n            <el-option label=\"开发中\" value=\"开发中\" />\n            <el-option label=\"已上线\" value=\"已上线\" />\n          </el-select>\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" class=\"hw-btn-primary\" @click=\"load\">查询</el-button>\n          <el-button @click=\"query = { industry: '', stage: '' }; load()\">重置</el-button>\n        </el-form-item>\n      </el-form>\n    </div>\n    <template v-if=\"viewMode === 'table'\">\n      <el-table v-loading=\"loading\" :data=\"list\" border stripe class=\"hw-table\">\n        <el-table-column prop=\"title\" label=\"项目名称\" min-width=\"200\" />\n        <el-table-column prop=\"industry\" label=\"行业\" width=\"100\" />\n        <el-table-column prop=\"stage\" label=\"阶段\" width=\"100\" />\n        <el-table-column prop=\"fundingNeeded\" label=\"融资需求(万)\" width=\"120\" />\n        <el-table-column prop=\"likeCount\" label=\"点赞\" width=\"80\" />\n        <el-table-column prop=\"viewCount\" label=\"浏览\" width=\"80\" />\n        <el-table-column label=\"操作\" width=\"120\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" @click=\"$router.push('/project/' + scope.row.id)\">详情</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n    </template>\n    <template v-else>\n      <div v-loading=\"loading\" class=\"project-waterfall\">\n        <div\n          v-for=\"(item, idx) in displayCards\"\n          :key=\"'card-' + (item.id || idx)\"\n          class=\"project-card hw-clickable\"\n          @click=\"$router.push('/project/' + item.id)\"\n        >\n          <div class=\"project-card-img\">\n            <img :src=\"item.coverImage || cardPlaceholder(idx)\" :alt=\"item.title\" loading=\"lazy\" />\n          </div>\n          <div class=\"project-card-body\">\n            <h4>{{ item.title }}</h4>\n            <div class=\"meta\"><span>{{ item.industry }}</span><span>{{ item.stage }}</span></div>\n            <div class=\"funding\">融资需求 {{ item.fundingNeeded != null ? item.fundingNeeded + ' 万' : '-' }}</div>\n            <el-button type=\"primary\" size=\"small\" class=\"btn-detail\">查看详情</el-button>\n          </div>\n        </div>\n      </div>\n    </template>\n    <div v-if=\"!loading && !list.length\" class=\"data-empty\">\n      <div class=\"empty-icon\"><i class=\"el-icon-document\"></i></div>\n      暂无项目数据\n    </div>\n    <el-pagination\n      v-if=\"page.total > 0\"\n      style=\"margin-top:16px\"\n      :current-page=\"page.current\"\n      :page-size=\"page.size\"\n      :total=\"page.total\"\n      layout=\"total, prev, pager, next\"\n      @current-change=\"onPage\"\n    />\n  </div>\n</template>\n\n<script>\nimport { listPublic } from '@/api/project'\nconst PLACEHOLDERS = [\n  'https://images.unsplash.com/photo-1552664730-d307ca884978?w=400',\n  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=400',\n  'https://images.unsplash.com/photo-1556761175-b413da4baf72?w=400',\n  'https://images.unsplash.com/photo-1551434678-e076c223a692?w=400',\n  'https://images.unsplash.com/photo-1557804506-669a67965ba0?w=400'\n]\nexport default {\n  name: 'ProjectList',\n  data() {\n    return {\n      loading: false,\n      list: [],\n      query: { industry: '', stage: '' },\n      page: { current: 1, size: 10, total: 0 },\n      viewMode: 'table'\n    }\n  },\n  computed: {\n    displayCards() {\n      return this.list\n    }\n  },\n  created() {\n    this.load()\n  },\n  methods: {\n    cardPlaceholder(i) {\n      return PLACEHOLDERS[i % PLACEHOLDERS.length]\n    },\n    async load() {\n      this.loading = true\n      try {\n        const res = await listPublic({ current: this.page.current, size: this.page.size, ...this.query })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally {\n        this.loading = false\n      }\n    },\n    onPage(p) {\n      this.page.current = p\n      this.load()\n    }\n  }\n}\n</script>\n\n<style scoped>\n.list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\n.list-header h3 { margin-bottom: 0; }\n.view-toggle { flex-shrink: 0; }\n.query-form { margin-bottom: 16px; }\n.project-waterfall {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  gap: 20px;\n}\n.project-card {\n  background: var(--hw-bg-card);\n  border-radius: var(--hw-radius-lg);\n  overflow: hidden;\n  border: 1px solid var(--hw-border);\n  box-shadow: var(--hw-shadow);\n  transition: transform var(--hw-duration) ease, box-shadow var(--hw-duration) ease;\n}\n.project-card:hover { box-shadow: var(--hw-shadow-hover); }\n.project-card-img {\n  height: 140px;\n  overflow: hidden;\n  background: #f1f5f9;\n}\n.project-card-img img { width: 100%; height: 100%; object-fit: cover; }\n.project-card-body { padding: 16px; }\n.project-card-body h4 { font-size: 15px; font-weight: 600; color: var(--hw-text); margin-bottom: 8px; }\n.project-card-body .meta { font-size: 12px; color: var(--hw-text-secondary); margin-bottom: 8px; }\n.project-card-body .meta span { margin-right: 12px; }\n.project-card-body .funding { font-size: 13px; color: var(--hw-primary); margin-bottom: 12px; }\n.project-card-body .btn-detail { width: 100%; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAiFA,SAAAA,UAAA;AACA,IAAAC,YAAA,IACA,mEACA,sEACA,mEACA,mEACA,kEACA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,IAAA;MACAC,KAAA;QAAAC,QAAA;QAAAC,KAAA;MAAA;MACAC,IAAA;QAAAC,OAAA;QAAAC,IAAA;QAAAC,KAAA;MAAA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACAC,YAAA,WAAAA,aAAA;MACA,YAAAV,IAAA;IACA;EACA;EACAW,OAAA,WAAAA,QAAA;IACA,KAAAC,IAAA;EACA;EACAC,OAAA;IACAC,eAAA,WAAAA,gBAAAC,CAAA;MACA,OAAAnB,YAAA,CAAAmB,CAAA,GAAAnB,YAAA,CAAAoB,MAAA;IACA;IACAJ,IAAA,WAAAA,KAAA;MAAA,IAAAK,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CA