{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { adminStats } from '@/api/admin';\nexport default {\n  name: 'AdminDashboard',\n  data: function data() {\n    return {\n      stats: {}\n    };\n  },\n  created: function created() {\n    var _this = this;\n    adminStats.overview().then(function (res) {\n      _this.stats = res || {};\n    })[\"catch\"](function () {});\n  }\n};","map":{"version":3,"names":["adminStats","name","data","stats","created","_this","overview","then","res"],"sources":["src/views/admin/Dashboard.vue"],"sourcesContent":["<template>\n  <div>\n    <div class=\"page-card\">\n      <h3>工作台</h3>\n      <p class=\"welcome\">欢迎回来，{{ $store.state.user.realName || $store.state.user.username }}。</p>\n      <el-row :gutter=\"20\" class=\"stat-row\">\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"stat-card\">\n            <div class=\"label\">用户总数</div>\n            <div class=\"value\">{{ stats.userCount || 0 }}</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"stat-card\">\n            <div class=\"label\">项目总数</div>\n            <div class=\"value\">{{ stats.projectCount || 0 }}</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"stat-card\">\n            <div class=\"label\">服务总数</div>\n            <div class=\"value\">{{ stats.resourceCount || 0 }}</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"stat-card\">\n            <div class=\"label\">投资意向</div>\n            <div class=\"value\">{{ stats.investmentCount || 0 }}</div>\n          </div>\n        </el-col>\n      </el-row>\n      <div class=\"quick-actions\">\n        <el-button @click=\"$router.push('/admin-users')\" icon=\"el-icon-user\">用户管理</el-button>\n        <el-button @click=\"$router.push('/admin-audit')\" icon=\"el-icon-document-checked\">内容审核</el-button>\n        <el-button @click=\"$router.push('/admin-stats')\" icon=\"el-icon-data-analysis\">数据统计</el-button>\n        <el-button @click=\"$router.push('/admin-config')\" icon=\"el-icon-setting\">系统配置</el-button>\n        <el-button @click=\"$router.push('/admin-log')\" icon=\"el-icon-document\">操作日志</el-button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { adminStats } from '@/api/admin'\nexport default {\n  name: 'AdminDashboard',\n  data() { return { stats: {} } },\n  created() {\n    adminStats.overview().then(res => { this.stats = res || {} }).catch(() => {})\n  }\n}\n</script>\n\n<style scoped>\n.welcome { color: #64748b; margin-bottom: 24px; font-size: 15px; }\n.stat-row { margin-bottom: 24px; }\n.quick-actions { display: flex; flex-wrap: wrap; gap: 12px; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA2CA,SAAAA,UAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IAAA;MAAAC,KAAA;IAAA;EAAA;EACAC,OAAA,WAAAA,QAAA;IAAA,IAAAC,KAAA;IACAL,UAAA,CAAAM,QAAA,GAAAC,IAAA,WAAAC,GAAA;MAAAH,KAAA,CAAAF,KAAA,GAAAK,GAAA;IAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}