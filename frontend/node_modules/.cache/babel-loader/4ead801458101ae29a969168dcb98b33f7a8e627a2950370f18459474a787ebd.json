{"ast":null,"code":"import \"core-js/modules/es.array.find.js\";\nimport \"core-js/modules/es.array.for-each.js\";\nimport \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.date.to-string.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.object.to-string.js\";\nimport \"core-js/modules/es.string.trim.js\";\nimport \"core-js/modules/web.dom-collections.for-each.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { postAPI, commentAPI, likeAPI } from '@/api/community';\nimport { messageAPI } from '@/api/message';\nexport default {\n  name: 'PostDetail',\n  data: function data() {\n    return {\n      post: null,\n      comments: [],\n      isLiked: false,\n      showCommentForm: false,\n      commentContent: '',\n      replyingTo: null,\n      replyingToReply: null,\n      replyContent: '',\n      pagination: {\n        currentPage: 1,\n        pageSize: 10,\n        total: 0\n      },\n      currentUserId: null,\n      username: '',\n      userAvatar: '',\n      submitting: false,\n      loading: false\n    };\n  },\n  mounted: function mounted() {\n    this.loadUserInfo();\n    this.loadPostDetail();\n    this.loadComments();\n  },\n  methods: {\n    loadUserInfo: function loadUserInfo() {\n      var user = this.$store.state.user;\n      if (user.token) {\n        this.currentUserId = user.id || user.userId;\n        this.username = user.username;\n        this.userAvatar = user.avatar;\n      }\n    },\n    loadPostDetail: function loadPostDetail() {\n      var _this = this;\n      var id = this.$route.params.id;\n      this.loading = true;\n      postAPI.getPostDetail(id).then(function (res) {\n        if (res.data) {\n          _this.post = res.data;\n          // 检查是否已点赞\n          _this.checkLike();\n        }\n      })[\"catch\"](function (err) {\n        console.error('加载帖子详情失败:', err);\n        _this.$message.error('加载帖子详情失败');\n      })[\"finally\"](function () {\n        _this.loading = false;\n      });\n    },\n    loadComments: function loadComments() {\n      var _this2 = this;\n      var postId = this.$route.params.id;\n      this.loading = true;\n      commentAPI.getCommentsByPostId(postId, {\n        page: this.pagination.currentPage,\n        size: this.pagination.pageSize\n      }).then(function (res) {\n        if (res.data && res.data.records) {\n          _this2.comments = res.data.records;\n          _this2.pagination.total = res.data.total || 0;\n          // 加载每个评论的回复\n          _this2.comments.forEach(function (comment) {\n            _this2.loadReplies(comment);\n          });\n        } else {\n          _this2.comments = [];\n          _this2.pagination.total = 0;\n        }\n      })[\"catch\"](function (err) {\n        console.error('加载评论失败:', err);\n        _this2.$message.error('加载评论失败');\n      })[\"finally\"](function () {\n        _this2.loading = false;\n      });\n    },\n    loadReplies: function loadReplies(comment) {\n      commentAPI.getRepliesByCommentId(comment.id).then(function (res) {\n        if (res.data) {\n          comment.replies = res.data;\n        } else {\n          comment.replies = [];\n        }\n      });\n    },\n    checkLike: function checkLike() {\n      var _this3 = this;\n      if (this.post && this.currentUserId) {\n        likeAPI.checkLike(this.post.id, 'post').then(function (res) {\n          if (res.data) {\n            _this3.isLiked = res.data;\n          }\n        });\n      }\n    },\n    toggleLike: function toggleLike() {\n      var _this4 = this;\n      if (!this.currentUserId) {\n        this.$message.error('请先登录');\n        return;\n      }\n      likeAPI.toggleLike(this.post.id, 'post').then(function (res) {\n        if (res.code === 200) {\n          _this4.isLiked = !_this4.isLiked;\n          _this4.post.likeCount += _this4.isLiked ? 1 : -1;\n          _this4.$message.success(_this4.isLiked ? '点赞成功' : '取消点赞');\n        }\n      });\n    },\n    toggleCommentLike: function toggleCommentLike(commentId) {\n      var _this5 = this;\n      if (!this.currentUserId) {\n        this.$message.error('请先登录');\n        return;\n      }\n      likeAPI.toggleLike(commentId, 'comment').then(function (res) {\n        if (res.code === 200) {\n          var comment = _this5.comments.find(function (c) {\n            return c.id === commentId;\n          });\n          if (comment) {\n            comment.isLiked = !comment.isLiked;\n            comment.likeCount += comment.isLiked ? 1 : -1;\n            _this5.$message.success(comment.isLiked ? '点赞成功' : '取消点赞');\n          }\n        }\n      });\n    },\n    submitComment: function submitComment() {\n      var _this6 = this;\n      if (!this.currentUserId) {\n        this.$message.error('请先登录');\n        return;\n      }\n      if (!this.commentContent.trim()) {\n        this.$message.error('评论内容不能为空');\n        return;\n      }\n      this.submitting = true;\n      commentAPI.createComment({\n        postId: this.post.id,\n        content: this.commentContent,\n        parentId: 0\n      }).then(function (res) {\n        if (res.code === 200) {\n          _this6.$message.success('评论成功');\n          _this6.showCommentForm = false;\n          _this6.commentContent = '';\n          _this6.loadComments();\n          _this6.post.commentCount++;\n\n          // 发送评论通知给帖子作者\n          if (_this6.post.userId !== _this6.currentUserId) {\n            _this6.sendCommentNotification(_this6.post.userId, _this6.post.id, _this6.post.title);\n          }\n        }\n      })[\"catch\"](function (err) {\n        console.error('发布评论失败:', err);\n        _this6.$message.error('发布评论失败，请稍后重试');\n      })[\"finally\"](function () {\n        _this6.submitting = false;\n      });\n    },\n    replyToComment: function replyToComment(commentId) {\n      this.replyingTo = commentId;\n      this.replyingToReply = null;\n    },\n    replyToReply: function replyToReply(commentId, replyId) {\n      this.replyingTo = commentId;\n      this.replyingToReply = replyId;\n    },\n    submitReply: function submitReply(commentId) {\n      var _this7 = this;\n      if (!this.currentUserId) {\n        this.$message.error('请先登录');\n        return;\n      }\n      if (!this.replyContent.trim()) {\n        this.$message.error('回复内容不能为空');\n        return;\n      }\n      this.submitting = true;\n      commentAPI.createComment({\n        postId: this.post.id,\n        content: this.replyContent,\n        parentId: commentId\n      }).then(function (res) {\n        if (res.code === 200) {\n          _this7.$message.success('回复成功');\n          _this7.replyingTo = null;\n          _this7.replyingToReply = null;\n          _this7.replyContent = '';\n          _this7.loadComments();\n          _this7.post.commentCount++;\n\n          // 发送回复通知给被回复的用户\n          var comment = _this7.comments.find(function (c) {\n            return c.id === commentId;\n          });\n          if (comment && comment.userId !== _this7.currentUserId) {\n            _this7.sendCommentNotification(comment.userId, _this7.post.id, _this7.post.title);\n          }\n        }\n      })[\"catch\"](function (err) {\n        console.error('发布回复失败:', err);\n        _this7.$message.error('发布回复失败，请稍后重试');\n      })[\"finally\"](function () {\n        _this7.submitting = false;\n      });\n    },\n    sendCommentNotification: function sendCommentNotification(targetUserId, postId, postTitle) {\n      messageAPI.sendNotification({\n        targetUserId: targetUserId,\n        type: 'comment',\n        content: \"\\u6709\\u4EBA\\u8BC4\\u8BBA\\u4E86\\u4F60\\u7684\\u5E16\\u5B50\\u300A\".concat(postTitle, \"\\u300B\"),\n        relatedId: postId,\n        relatedType: 'post'\n      }).then(function (res) {\n        if (res.code !== 200) {\n          console.error('发送通知失败:', res);\n        }\n      })[\"catch\"](function (err) {\n        console.error('发送通知失败:', err);\n      });\n    },\n    setBestAnswer: function setBestAnswer(commentId) {\n      var _this8 = this;\n      postAPI.setBestAnswer(this.post.id, commentId).then(function (res) {\n        if (res.code === 200) {\n          _this8.$message.success('设置成功');\n          _this8.post.bestAnswerId = commentId;\n          // 更新评论列表中的最佳答案标记\n          _this8.comments.forEach(function (comment) {\n            comment.isBestAnswer = comment.id === commentId;\n          });\n        }\n      });\n    },\n    navigateToEdit: function navigateToEdit() {\n      this.$router.push(\"/community/edit/\".concat(this.post.id));\n    },\n    deletePost: function deletePost() {\n      var _this9 = this;\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(function () {\n        postAPI.deletePost(_this9.post.id).then(function (res) {\n          if (res.code === 200) {\n            _this9.$message.success('删除成功');\n            _this9.$router.push('/community');\n          }\n        });\n      })[\"catch\"](function () {\n        // 取消删除\n      });\n    },\n    handleSizeChange: function handleSizeChange(size) {\n      this.pagination.pageSize = size;\n      this.loadComments();\n    },\n    handleCurrentChange: function handleCurrentChange(current) {\n      this.pagination.currentPage = current;\n      this.loadComments();\n    },\n    formatDate: function formatDate(dateString) {\n      var date = new Date(dateString);\n      var now = new Date();\n      var diff = now - date;\n      var days = Math.floor(diff / (1000 * 60 * 60 * 24));\n      var hours = Math.floor(diff / (1000 * 60 * 60));\n      var minutes = Math.floor(diff / (1000 * 60));\n      if (days > 0) {\n        return \"\".concat(days, \"\\u5929\\u524D\");\n      } else if (hours > 0) {\n        return \"\".concat(hours, \"\\u5C0F\\u65F6\\u524D\");\n      } else if (minutes > 0) {\n        return \"\".concat(minutes, \"\\u5206\\u949F\\u524D\");\n      } else {\n        return '刚刚';\n      }\n    }\n  }\n};","map":{"version":3,"names":["postAPI","commentAPI","likeAPI","messageAPI","name","data","post","comments","isLiked","showCommentForm","commentContent","replyingTo","replyingToReply","replyContent","pagination","currentPage","pageSize","total","currentUserId","username","userAvatar","submitting","loading","mounted","loadUserInfo","loadPostDetail","loadComments","methods","user","$store","state","token","id","userId","avatar","_this","$route","params","getPostDetail","then","res","checkLike","err","console","error","$message","_this2","postId","getCommentsByPostId","page","size","records","forEach","comment","loadReplies","getRepliesByCommentId","replies","_this3","toggleLike","_this4","code","likeCount","success","toggleCommentLike","commentId","_this5","find","c","submitComment","_this6","trim","createComment","content","parentId","commentCount","sendCommentNotification","title","replyToComment","replyToReply","replyId","submitReply","_this7","targetUserId","postTitle","sendNotification","type","concat","relatedId","relatedType","setBestAnswer","_this8","bestAnswerId","isBestAnswer","navigateToEdit","$router","push","deletePost","_this9","$confirm","confirmButtonText","cancelButtonText","handleSizeChange","handleCurrentChange","current","formatDate","dateString","date","Date","now","diff","days","Math","floor","hours","minutes"],"sources":["src/views/community/PostDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"post-detail\">\r\n    <div class=\"container\">\r\n      <!-- 帖子内容 -->\r\n      <el-card v-if=\"post\" class=\"post-card\">\r\n        <div class=\"post-header\">\r\n          <h2 class=\"post-title\">{{ post.title }}</h2>\r\n          <div class=\"post-meta\">\r\n            <div class=\"author-info\">\r\n              <el-avatar :size=\"48\" :src=\"post.authorAvatar || 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\" class=\"author-avatar\"></el-avatar>\r\n              <div class=\"author-details\">\r\n                <span class=\"author-name\">{{ post.authorName || '匿名用户' }}</span>\r\n                <div class=\"post-stats\">\r\n                  <span class=\"stat-item\"><i class=\"el-icon-time\"></i> {{ formatDate(post.createdAt) }}</span>\r\n                  <span class=\"stat-item\"><i class=\"el-icon-folder\"></i> {{ post.category }}</span>\r\n                  <span class=\"stat-item\"><i class=\"el-icon-view\"></i> {{ post.viewCount }} 浏览</span>\r\n                  <span class=\"stat-item\"><i class=\"el-icon-thumb\"></i> {{ post.likeCount }} 点赞</span>\r\n                  <span class=\"stat-item\"><i class=\"el-icon-chat-dot-round\"></i> {{ post.commentCount }} 评论</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div v-if=\"post.tags\" class=\"post-tags\">\r\n              <el-tag v-for=\"tag in post.tags.split(',')\" :key=\"tag\" size=\"small\" effect=\"plain\" class=\"tag-item\">{{ tag.trim() }}</el-tag>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"post-content\" v-html=\"post.content\"></div>\r\n        <div class=\"post-actions\">\r\n          <el-button \r\n            :type=\"isLiked ? 'primary' : 'default'\"\r\n            @click=\"toggleLike\"\r\n            icon=\"el-icon-star-on\"\r\n            class=\"action-btn\"\r\n          >\r\n            {{ post.likeCount }} 点赞\r\n          </el-button>\r\n          <el-button \r\n            type=\"default\"\r\n            @click=\"showCommentForm = true\"\r\n            icon=\"el-icon-chat-line-round\"\r\n            class=\"action-btn\"\r\n          >\r\n            {{ post.commentCount }} 评论\r\n          </el-button>\r\n          <el-button \r\n            v-if=\"post.userId === currentUserId\" \r\n            type=\"warning\"\r\n            @click=\"navigateToEdit\"\r\n            icon=\"el-icon-edit\"\r\n            class=\"action-btn\"\r\n          >\r\n            编辑\r\n          </el-button>\r\n          <el-button \r\n            v-if=\"post.userId === currentUserId\" \r\n            type=\"danger\"\r\n            @click=\"deletePost\"\r\n            icon=\"el-icon-delete\"\r\n            class=\"action-btn\"\r\n          >\r\n            删除\r\n          </el-button>\r\n        </div>\r\n      </el-card>\r\n      \r\n      <!-- 评论区 -->\r\n      <div class=\"comment-section\">\r\n        <div class=\"comment-header-section\">\r\n          <h3 class=\"comment-title\">评论 ({{ post && post.commentCount ? post.commentCount : 0 }})</h3>\r\n          <el-button type=\"primary\" @click=\"showCommentForm = true\" class=\"comment-btn\">\r\n            <i class=\"el-icon-edit\"></i> 发表评论\r\n          </el-button>\r\n        </div>\r\n        \r\n        <!-- 评论表单 -->\r\n        <el-card v-if=\"showCommentForm\" class=\"comment-form\" shadow=\"hover\">\r\n          <div class=\"form-header\">\r\n            <el-avatar :size=\"40\" :src=\"userAvatar || 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\" class=\"form-avatar\"></el-avatar>\r\n            <span class=\"form-username\">{{ username || '匿名用户' }}</span>\r\n          </div>\r\n          <el-input\r\n            type=\"textarea\"\r\n            v-model=\"commentContent\"\r\n            placeholder=\"写下你的评论...\"\r\n            :rows=\"4\"\r\n            resize=\"none\"\r\n            class=\"comment-textarea\"\r\n          ></el-input>\r\n          <div class=\"form-actions\">\r\n            <el-button @click=\"showCommentForm = false\" class=\"cancel-btn\">取消</el-button>\r\n            <el-button type=\"primary\" @click=\"submitComment\" :loading=\"submitting\" class=\"submit-btn\">\r\n              发布评论\r\n            </el-button>\r\n          </div>\r\n        </el-card>\r\n        \r\n        <!-- 评论列表 -->\r\n        <div class=\"comment-list\">\r\n          <el-card v-for=\"comment in comments\" :key=\"comment.id\" class=\"comment-item\" shadow=\"hover\">\r\n            <div class=\"comment-header\">\r\n              <el-avatar :size=\"40\" :src=\"comment.avatar || 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\" class=\"comment-avatar\"></el-avatar>\r\n              <div class=\"comment-header-info\">\r\n                <div class=\"comment-author-row\">\r\n                  <span class=\"comment-author\">{{ comment.username }}</span>\r\n                  <span class=\"comment-time\">{{ formatDate(comment.createdAt) }}</span>\r\n                  <el-tag v-if=\"comment.isBestAnswer\" type=\"success\" size=\"small\" class=\"best-answer-tag\">最佳答案</el-tag>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"comment-content\">{{ comment.content }}</div>\r\n            <div class=\"comment-actions\">\r\n              <el-button \r\n                size=\"small\" \r\n                :type=\"comment.isLiked ? 'primary' : 'default'\"\r\n                @click=\"toggleCommentLike(comment.id)\"\r\n                class=\"comment-action-btn\"\r\n              >\r\n                <i class=\"el-icon-thumb\"></i> {{ comment.likeCount }}\r\n              </el-button>\r\n              <el-button size=\"small\" @click=\"replyToComment(comment.id)\" class=\"comment-action-btn\">\r\n                <i class=\"el-icon-chat-dot-round\"></i> 回复\r\n              </el-button>\r\n              <el-button \r\n                v-if=\"post.type === 'question' && post.userId === currentUserId && !post.bestAnswerId\"\r\n                size=\"small\" \r\n                type=\"success\"\r\n                @click=\"setBestAnswer(comment.id)\"\r\n                class=\"comment-action-btn\"\r\n              >\r\n                <i class=\"el-icon-check\"></i> 设为最佳答案\r\n              </el-button>\r\n            </div>\r\n            \r\n            <!-- 回复列表 -->\r\n            <div class=\"reply-list\" v-if=\"comment.replies && comment.replies.length > 0\">\r\n              <el-card v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"reply-item\">\r\n                <div class=\"reply-header\">\r\n                  <el-avatar :size=\"32\" :src=\"reply.avatar || 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\" class=\"reply-avatar\"></el-avatar>\r\n                  <div class=\"reply-header-info\">\r\n                    <div class=\"reply-author-row\">\r\n                      <span class=\"reply-author\">{{ reply.username }}</span>\r\n                      <span class=\"reply-time\">{{ formatDate(reply.createdAt) }}</span>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                <div class=\"reply-content\">{{ reply.content }}</div>\r\n                <div class=\"reply-actions\">\r\n                  <el-button size=\"mini\" @click=\"replyToReply(comment.id, reply.id)\" class=\"reply-action-btn\">\r\n                    <i class=\"el-icon-chat-dot-round\"></i> 回复\r\n                  </el-button>\r\n                </div>\r\n                \r\n                <!-- 嵌套回复 -->\r\n                <div class=\"nested-reply-list\" v-if=\"reply.replies && reply.replies.length > 0\">\r\n                  <el-card v-for=\"nestedReply in reply.replies\" :key=\"nestedReply.id\" class=\"nested-reply-item\">\r\n                    <div class=\"reply-header\">\r\n                      <el-avatar :size=\"28\" :src=\"nestedReply.avatar || 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\" class=\"reply-avatar\"></el-avatar>\r\n                      <div class=\"reply-header-info\">\r\n                        <div class=\"reply-author-row\">\r\n                          <span class=\"reply-author\">{{ nestedReply.username }}</span>\r\n                          <span class=\"reply-time\">{{ formatDate(nestedReply.createdAt) }}</span>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                    <div class=\"reply-content\">{{ nestedReply.content }}</div>\r\n                    <div class=\"reply-actions\">\r\n                      <el-button size=\"mini\" @click=\"replyToReply(comment.id, reply.id, nestedReply.id)\" class=\"reply-action-btn\">\r\n                        <i class=\"el-icon-chat-dot-round\"></i> 回复\r\n                      </el-button>\r\n                    </div>\r\n                  </el-card>\r\n                </div>\r\n              </el-card>\r\n            </div>\r\n            \r\n            <!-- 回复表单 -->\r\n            <div v-if=\"replyingTo === comment.id\" class=\"reply-form\">\r\n              <div class=\"form-header\">\r\n                <el-avatar :size=\"32\" :src=\"userAvatar || 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\" class=\"form-avatar\"></el-avatar>\r\n                <span class=\"form-username\">{{ username || '匿名用户' }}</span>\r\n              </div>\r\n              <el-input\r\n                type=\"textarea\"\r\n                v-model=\"replyContent\"\r\n                placeholder=\"写下你的回复...\"\r\n                :rows=\"3\"\r\n                resize=\"none\"\r\n                class=\"reply-textarea\"\r\n              ></el-input>\r\n              <div class=\"form-actions\">\r\n                <el-button size=\"small\" @click=\"replyingTo = null\" class=\"cancel-btn\">取消</el-button>\r\n                <el-button size=\"small\" type=\"primary\" @click=\"submitReply(comment.id)\" :loading=\"submitting\" class=\"submit-btn\">\r\n                  发布回复\r\n                </el-button>\r\n              </div>\r\n            </div>\r\n          </el-card>\r\n        </div>\r\n        \r\n        <!-- 空状态 -->\r\n        <div v-if=\"!loading && comments.length === 0\" class=\"empty-comments\">\r\n          <el-empty description=\"暂无评论，快来发表第一条评论吧！\" />\r\n        </div>\r\n        \r\n        <!-- 评论分页 -->\r\n        <div class=\"pagination\" v-if=\"pagination.total > 0\">\r\n          <el-pagination\r\n            @size-change=\"handleSizeChange\"\r\n            @current-change=\"handleCurrentChange\"\r\n            :current-page=\"pagination.currentPage\"\r\n            :page-sizes=\"[10, 20, 50]\"\r\n            :page-size=\"pagination.pageSize\"\r\n            layout=\"total, sizes, prev, pager, next, jumper\"\r\n            :total=\"pagination.total\"\r\n            class=\"comment-pagination\"\r\n          ></el-pagination>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { postAPI, commentAPI, likeAPI } from '@/api/community'\r\nimport { messageAPI } from '@/api/message'\r\n\r\nexport default {\r\n  name: 'PostDetail',\r\n  data() {\r\n    return {\r\n      post: null,\r\n      comments: [],\r\n      isLiked: false,\r\n      showCommentForm: false,\r\n      commentContent: '',\r\n      replyingTo: null,\r\n      replyingToReply: null,\r\n      replyContent: '',\r\n      pagination: {\r\n        currentPage: 1,\r\n        pageSize: 10,\r\n        total: 0\r\n      },\r\n      currentUserId: null,\r\n      username: '',\r\n      userAvatar: '',\r\n      submitting: false,\r\n      loading: false\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadUserInfo()\r\n    this.loadPostDetail()\r\n    this.loadComments()\r\n  },\r\n  methods: {\r\n    loadUserInfo() {\r\n      const user = this.$store.state.user\r\n      if (user.token) {\r\n        this.currentUserId = user.id || user.userId\r\n        this.username = user.username\r\n        this.userAvatar = user.avatar\r\n      }\r\n    },\r\n    loadPostDetail() {\r\n      const id = this.$route.params.id\r\n      this.loading = true\r\n      postAPI.getPostDetail(id).then(res => {\r\n        if (res.data) {\r\n          this.post = res.data\r\n          // 检查是否已点赞\r\n          this.checkLike()\r\n        }\r\n      }).catch(err => {\r\n        console.error('加载帖子详情失败:', err)\r\n        this.$message.error('加载帖子详情失败')\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    loadComments() {\r\n      const postId = this.$route.params.id\r\n      this.loading = true\r\n      commentAPI.getCommentsByPostId(postId, {\r\n        page: this.pagination.currentPage,\r\n        size: this.pagination.pageSize\r\n      }).then(res => {\r\n        if (res.data && res.data.records) {\r\n          this.comments = res.data.records\r\n          this.pagination.total = res.data.total || 0\r\n          // 加载每个评论的回复\r\n          this.comments.forEach(comment => {\r\n            this.loadReplies(comment)\r\n          })\r\n        } else {\r\n          this.comments = []\r\n          this.pagination.total = 0\r\n        }\r\n      }).catch(err => {\r\n        console.error('加载评论失败:', err)\r\n        this.$message.error('加载评论失败')\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    loadReplies(comment) {\r\n      commentAPI.getRepliesByCommentId(comment.id).then(res => {\r\n        if (res.data) {\r\n          comment.replies = res.data\r\n        } else {\r\n          comment.replies = []\r\n        }\r\n      })\r\n    },\r\n    checkLike() {\r\n      if (this.post && this.currentUserId) {\r\n        likeAPI.checkLike(this.post.id, 'post').then(res => {\r\n          if (res.data) {\r\n            this.isLiked = res.data\r\n          }\r\n        })\r\n      }\r\n    },\r\n    toggleLike() {\r\n      if (!this.currentUserId) {\r\n        this.$message.error('请先登录')\r\n        return\r\n      }\r\n      likeAPI.toggleLike(this.post.id, 'post').then(res => {\r\n        if (res.code === 200) {\r\n          this.isLiked = !this.isLiked\r\n          this.post.likeCount += this.isLiked ? 1 : -1\r\n          this.$message.success(this.isLiked ? '点赞成功' : '取消点赞')\r\n        }\r\n      })\r\n    },\r\n    toggleCommentLike(commentId) {\r\n      if (!this.currentUserId) {\r\n        this.$message.error('请先登录')\r\n        return\r\n      }\r\n      likeAPI.toggleLike(commentId, 'comment').then(res => {\r\n        if (res.code === 200) {\r\n          const comment = this.comments.find(c => c.id === commentId)\r\n          if (comment) {\r\n            comment.isLiked = !comment.isLiked\r\n            comment.likeCount += comment.isLiked ? 1 : -1\r\n            this.$message.success(comment.isLiked ? '点赞成功' : '取消点赞')\r\n          }\r\n        }\r\n      })\r\n    },\r\n    submitComment() {\r\n      if (!this.currentUserId) {\r\n        this.$message.error('请先登录')\r\n        return\r\n      }\r\n      if (!this.commentContent.trim()) {\r\n        this.$message.error('评论内容不能为空')\r\n        return\r\n      }\r\n      this.submitting = true\r\n      commentAPI.createComment({\r\n        postId: this.post.id,\r\n        content: this.commentContent,\r\n        parentId: 0\r\n      }).then(res => {\r\n        if (res.code === 200) {\r\n          this.$message.success('评论成功')\r\n          this.showCommentForm = false\r\n          this.commentContent = ''\r\n          this.loadComments()\r\n          this.post.commentCount++\r\n          \r\n          // 发送评论通知给帖子作者\r\n          if (this.post.userId !== this.currentUserId) {\r\n            this.sendCommentNotification(this.post.userId, this.post.id, this.post.title)\r\n          }\r\n        }\r\n      }).catch(err => {\r\n        console.error('发布评论失败:', err)\r\n        this.$message.error('发布评论失败，请稍后重试')\r\n      }).finally(() => {\r\n        this.submitting = false\r\n      })\r\n    },\r\n    replyToComment(commentId) {\r\n      this.replyingTo = commentId\r\n      this.replyingToReply = null\r\n    },\r\n    replyToReply(commentId, replyId) {\r\n      this.replyingTo = commentId\r\n      this.replyingToReply = replyId\r\n    },\r\n    submitReply(commentId) {\r\n      if (!this.currentUserId) {\r\n        this.$message.error('请先登录')\r\n        return\r\n      }\r\n      if (!this.replyContent.trim()) {\r\n        this.$message.error('回复内容不能为空')\r\n        return\r\n      }\r\n      this.submitting = true\r\n      commentAPI.createComment({\r\n        postId: this.post.id,\r\n        content: this.replyContent,\r\n        parentId: commentId\r\n      }).then(res => {\r\n        if (res.code === 200) {\r\n          this.$message.success('回复成功')\r\n          this.replyingTo = null\r\n          this.replyingToReply = null\r\n          this.replyContent = ''\r\n          this.loadComments()\r\n          this.post.commentCount++\r\n          \r\n          // 发送回复通知给被回复的用户\r\n          const comment = this.comments.find(c => c.id === commentId)\r\n          if (comment && comment.userId !== this.currentUserId) {\r\n            this.sendCommentNotification(comment.userId, this.post.id, this.post.title)\r\n          }\r\n        }\r\n      }).catch(err => {\r\n        console.error('发布回复失败:', err)\r\n        this.$message.error('发布回复失败，请稍后重试')\r\n      }).finally(() => {\r\n        this.submitting = false\r\n      })\r\n    },\r\n    sendCommentNotification(targetUserId, postId, postTitle) {\r\n      messageAPI.sendNotification({\r\n        targetUserId,\r\n        type: 'comment',\r\n        content: `有人评论了你的帖子《${postTitle}》`,\r\n        relatedId: postId,\r\n        relatedType: 'post'\r\n      }).then(res => {\r\n        if (res.code !== 200) {\r\n          console.error('发送通知失败:', res)\r\n        }\r\n      }).catch(err => {\r\n        console.error('发送通知失败:', err)\r\n      })\r\n    },\r\n    setBestAnswer(commentId) {\r\n      postAPI.setBestAnswer(this.post.id, commentId).then(res => {\r\n        if (res.code === 200) {\r\n          this.$message.success('设置成功')\r\n          this.post.bestAnswerId = commentId\r\n          // 更新评论列表中的最佳答案标记\r\n          this.comments.forEach(comment => {\r\n            comment.isBestAnswer = comment.id === commentId\r\n          })\r\n        }\r\n      })\r\n    },\r\n    navigateToEdit() {\r\n      this.$router.push(`/community/edit/${this.post.id}`)\r\n    },\r\n    deletePost() {\r\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        postAPI.deletePost(this.post.id).then(res => {\r\n          if (res.code === 200) {\r\n            this.$message.success('删除成功')\r\n            this.$router.push('/community')\r\n          }\r\n        })\r\n      }).catch(() => {\r\n        // 取消删除\r\n      })\r\n    },\r\n    handleSizeChange(size) {\r\n      this.pagination.pageSize = size\r\n      this.loadComments()\r\n    },\r\n    handleCurrentChange(current) {\r\n      this.pagination.currentPage = current\r\n      this.loadComments()\r\n    },\r\n    formatDate(dateString) {\r\n      const date = new Date(dateString)\r\n      const now = new Date()\r\n      const diff = now - date\r\n      const days = Math.floor(diff / (1000 * 60 * 60 * 24))\r\n      const hours = Math.floor(diff / (1000 * 60 * 60))\r\n      const minutes = Math.floor(diff / (1000 * 60))\r\n      \r\n      if (days > 0) {\r\n        return `${days}天前`\r\n      } else if (hours > 0) {\r\n        return `${hours}小时前`\r\n      } else if (minutes > 0) {\r\n        return `${minutes}分钟前`\r\n      } else {\r\n        return '刚刚'\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.post-detail {\r\n  padding: 30px 0;\r\n  min-height: calc(100vh - 120px);\r\n}\r\n\r\n.container {\r\n  max-width: 1000px;\r\n  margin: 0 auto;\r\n  padding: 0 20px;\r\n}\r\n\r\n.post-card {\r\n  margin-bottom: 40px;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.post-card:hover {\r\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.post-header {\r\n  padding: 24px;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.post-title {\r\n  font-size: 28px;\r\n  font-weight: 700;\r\n  color: #1890ff;\r\n  margin-bottom: 20px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.post-meta {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n}\r\n\r\n.author-info {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 16px;\r\n}\r\n\r\n.author-avatar {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.author-details {\r\n  flex: 1;\r\n}\r\n\r\n.author-name {\r\n  display: block;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.post-stats {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 16px;\r\n  font-size: 14px;\r\n  color: #666;\r\n}\r\n\r\n.stat-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.post-tags {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n  margin-top: 8px;\r\n}\r\n\r\n.tag-item {\r\n  border-radius: 16px;\r\n  font-size: 12px;\r\n}\r\n\r\n.post-content {\r\n  padding: 24px;\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: #333;\r\n}\r\n\r\n.post-actions {\r\n  padding: 0 24px 24px;\r\n  display: flex;\r\n  gap: 12px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.action-btn {\r\n  border-radius: 8px;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.action-btn:hover {\r\n  transform: translateY(-