llee4","blob","url","_t3","_context4","window","URL","createObjectURL","document","createElement","href","download","click","revokeObjectURL"],"sources":["src/views/admin/UserList.vue"],"sourcesContent":["<template>\n  <div class=\"page-card\">\n    <h3>用户管理</h3>\n    <el-form inline>\n      <el-form-item label=\"关键词\">\n        <el-input v-model=\"query.keyword\" placeholder=\"用户名/手机/邮箱\" clearable style=\"width:180px\" />\n      </el-form-item>\n      <el-form-item label=\"角色\">\n        <el-select v-model=\"query.role\" clearable placeholder=\"全部\" style=\"width:120px\">\n          <el-option label=\"创业者\" value=\"entrepreneur\" />\n          <el-option label=\"投资人\" value=\"investor\" />\n          <el-option label=\"服务商\" value=\"provider\" />\n          <el-option label=\"管理员\" value=\"admin\" />\n        </el-select>\n      </el-form-item>\n      <el-form-item label=\"状态\">\n        <el-select v-model=\"query.status\" clearable placeholder=\"全部\" style=\"width:100px\">\n          <el-option label=\"启用\" :value=\"1\" />\n          <el-option label=\"禁用\" :value=\"0\" />\n        </el-select>\n      </el-form-item>\n      <el-form-item>\n        <el-button type=\"primary\" @click=\"load\">查询</el-button>\n        <el-button @click=\"query = { role: '', keyword: '', status: null }; load()\">重置</el-button>\n      </el-form-item>\n    </el-form>\n    <div class=\"toolbar\">\n      <el-button type=\"primary\" icon=\"el-icon-download\" @click=\"doExport\">导出 Excel</el-button>\n      <el-button icon=\"el-icon-s-operation\">批量操作</el-button>\n    </div>\n    <el-table v-loading=\"loading\" :data=\"list\" border stripe>\n      <el-table-column prop=\"id\" label=\"ID\" width=\"80\" />\n      <el-table-column prop=\"username\" label=\"用户名\" width=\"120\" />\n      <el-table-column prop=\"realName\" label=\"姓名\" width=\"100\" />\n      <el-table-column prop=\"role\" label=\"角色\" width=\"100\" />\n      <el-table-column prop=\"phone\" label=\"手机\" width=\"120\" />\n      <el-table-column prop=\"status\" label=\"状态\" width=\"80\">\n        <template slot-scope=\"scope\">\n          <el-tag :type=\"scope.row.status === 1 ? 'success' : 'danger'\">{{ scope.row.status === 1 ? '启用' : '禁用' }}</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column label=\"操作\" width=\"200\">\n        <template slot-scope=\"scope\">\n          <el-button type=\"text\" size=\"small\" @click=\"setStatus(scope.row.id, scope.row.status === 1 ? 0 : 1)\">{{ scope.row.status === 1 ? '禁用' : '启用' }}</el-button>\n          <el-button type=\"text\" size=\"small\" @click=\"resetPwd(scope.row.id)\">重置密码</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n    <div v-if=\"!loading && !list.length\" class=\"data-empty\">\n      <div class=\"empty-icon\"><i class=\"el-icon-user\"></i></div>\n      暂无用户数据\n    </div>\n    <el-pagination\n      v-if=\"page.total > 0\"\n      style=\"margin-top:16px\" :current-page=\"page.current\" :page-size=\"page.size\" :total=\"page.total\" layout=\"total, prev, pager, next\" @current-change=\"p => { page.current = p; load() }\"     />\n  </div>\n</template>\n\n<script>\nimport { adminUser, exportUsers } from '@/api/admin'\nexport default {\n  name: 'AdminUserList',\n  data() {\n    return { loading: false, list: [], query: { role: '', keyword: '', status: null }, page: { current: 1, size: 10, total: 0 } }\n  },\n  created() { this.load() },\n  methods: {\n    async load() {\n      this.loading = true\n      try {\n        const res = await adminUser.list({ current: this.page.current, size: this.page.size, role: this.query.role, keyword: this.query.keyword, status: this.query.status })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally { this.loading = false }\n    },\n    async setStatus(id, status) {\n      try {\n        await adminUser.setStatus(id, status)\n        this.$message.success('已更新')\n        this.load()\n      } catch (e) { this.$message.error(e.message || '操作失败') }\n    },\n    async resetPwd(id) {\n      try {\n        await this.$confirm('确定将该用户密码重置为 Admin@1234？', '提示', { type: 'warning' })\n        await adminUser.resetPassword(id, 'Admin@1234')\n        this.$message.success('已重置')\n      } catch (e) { if (e !== 'cancel') this.$message.error(e.message || '操作失败') }\n    },\n    async doExport() {\n      try {\n        const blob = await exportUsers()\n        const url = window.URL.createObjectURL(blob)\n        const a = document.createElement('a')\n        a.href = url\n        a.download = '用户列表.xlsx'\n        a.click()\n        window.URL.revokeObjectURL(url)\n        this.$message.success('导出成功')\n      } catch (e) {\n        this.$message.error('导出失败')\n      }\n    }\n  }\n}\n</script>\n<style scoped>\n.page-card {\n  background: #1e293b;\n  border-radius: 12px;\n  padding: 24px;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  color: #f8fafc;\n  min-height: calc(100vh - 120px);\n}\n\nh3 {\n  font-size: 20px;\n  font-weight: 700;\n  color: #f8fafc;\n  margin-bottom: 24px;\n}\n\n.toolbar {\n  margin-bottom: 16px;\n  display: flex;\n  gap: 12px;\n}\n\n/* 表单样式 */\n.el-form {\n  margin-bottom: 24px;\n}\n\n.el-form-item__label {\n  color: #94a3b8;\n}\n\n.el-input__inner {\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #f8fafc;\n  border-radius: 8px;\n}\n\n.el-input__inner:focus {\n  border-color: #3b82f6;\n  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);\n}\n\n.el-select .el-input__inner {\n  background: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #f8fafc;\n}\n\n.el-select-dropdown {\n  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 8px;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);\n}\n\n.el-select-dropdown__item {\n  color: #f8fafc;\n  padding: 12px 16px;\n}\n\n.el-select-dropdown__item:hover {\n  background: rgba(59, 130, 246, 0.1);\n}\n\n.el-select-dropdown__item.selected {\n  background: rgba(59, 130, 246, 0.2);\n  color: #3b82f6;\n}\n\n/* 按钮样式 */\n.el-button {\n  border-radius: 8px;\n  font-weight: 500;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.el-button--primary {\n  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);\n  border: none;\n}\n\n.el-button--primary:hover {\n  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);\n  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.4);\n}\n\n.el-button {\n  background: #334155;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #f8fafc;\n}\n\n.el-button:hover {\n  background: #475569;\n  border-color: rgba(59, 130, 246, 0.3);\n  color: #f8fafc;\n}\n\n/* 表格样式 */\n.el-table {\n  background: transparent !important;\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n.el-table th {\n  background: #334155 !important;\n  color: #94a3b8 !important;\n  font-weight: 600 !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n}\n\n.el-table td {\n  background: #1e293b !important;\n  color: #f8fafc !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n}\n\n.el-table tr:hover td {\n  background: #334155 !important;\n}\n\n/* 分页样式 */\n.el-pagination {\n  margin-top: 24px;\n  display: flex;\n  justify-content: flex-end;\n}\n\n.el-pagination__total {\n  color: #94a3b8;\n}\n\n.el-pager li {\n  background: #334155;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #94a3b8;\n  border-radius: 6px;\n  margin: 0 4px;\n}\n\n.el-pager li:hover {\n  background: #475569;\n  color: #f8fafc;\n}\n\n.el-pager li.active {\n  background: #3b82f6;\n  color: #fff;\n  border-color: #3b82f6;\n}\n\n.el-pagination__prev,\n.el-pagination__next {\n  background: #334155;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #94a3b8;\n  border-radius: 6px;\n}\n\n.el-pagination__prev:hover,\n.el-pagination__next:hover {\n  background: #475569;\n  color: #f8fafc;\n}\n\n/* 空数据样式 */\n.data-empty {\n  text-align: center;\n  padding: 48px 24px;\n  color: #94a3b8;\n}\n\n.empty-icon {\n  font-size: 48px;\n  margin-bottom: 16px;\n  opacity: 0.5;\n}\n\n/* 标签样式 */\n.el-tag {\n  border-radius: 8px;\n  padding: 4px 12px;\n  font-size: 12px;\n  font-weight: 500;\n}\n\n/* 按钮文本样式 */\n.el-button--text {\n  color: #94a3b8;\n}\n\n.el-button--text:hover {\n  color: #3b82f6;\n}\n\n/* 响应式设计 */\n@media (max-width: 768px) {\n  .page-card {\n    padding: 16px;\n  }\n  \n  h3 {\n    font-size: 18px;\n    margin-bottom: 16px;\n  }\n  \n  .toolbar {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  \n  .el-form {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  \n  .el-form-item {\n    margin-right: 0;\n    margin-bottom: 12px;\n  }\n  \n  .el-pagination {\n    justify-content: center;\n  }\n}\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA2DA,SAAAA,SAAA,EAAAC,WAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MAAAC,OAAA;MAAAC,IAAA;MAAAC,KAAA;QAAAC,IAAA;QAAAC,OAAA;QAAAC,MAAA;MAAA;MAAAC,IAAA;QAAAC,OAAA;QAAAC,IAAA;QAAAC,KAAA;MAAA;IAAA;EACA;EACAC,OAAA,WAAAA,QAAA;IAAA,KAAAC,IAAA;EAAA;EACAC,OAAA;IACAD,IAAA,WAAAA,KAAA;MAAA,IAAAE,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA;QAAA,OAAAH,YAAA,GAAAI,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAT,KAAA,CAAAb,OAAA;cAAAoB,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEA1B,SAAA,CAAAK,IAAA;gBAAAM,OAAA,EAAAM,KAAA,CAAAP,IAAA,CAAAC,OAAA;gBAAAC,IAAA,EAAAK,KAAA,CAAAP,IAAA,CAAAE,IAAA;gBAAAL,IAAA,EAAAU,KAAA,CAAAX,KAAA,CAAAC,IAAA;gBAAAC,OAAA,EAAAS,KAAA,CAAAX,KAAA,CAAAE,OAAA;gBAAAC,MAAA,EAAAQ,KAAA,CAAAX,KAAA,CAAAG;cAAA;YAAA;cAAAa,GAAA,GAAAE,QAAA,CAAAG,CAAA;cACAV,KAAA,CAAAZ,IAAA,GAAAiB,GAAA,CAAAM,OAAA;cACAX,KAAA,CAAAP,IAAA,CAAAG,KAAA,GAAAS,GAAA,CAAAT,KAAA;YAAA;cAAAW,QAAA,CAAAC,CAAA;cACAR,KAAA,CAAAb,OAAA;cAAA,OAAAoB,QAAA,CAAAK,CAAA;YAAA;cAAA,OAAAL,QAAA