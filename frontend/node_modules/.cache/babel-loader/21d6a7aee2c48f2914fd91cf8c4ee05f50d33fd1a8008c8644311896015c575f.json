sponse.data.url;\n      this.$message.success('图片上传成功');\n    },\n    handleImageUploadError: function handleImageUploadError() {\n      this.$message.error('图片上传失败，请重试');\n    },\n    removeImage: function removeImage() {\n      this.form.resourceImage = '';\n      this.$message.success('图片已删除');\n    },\n    handleProviderAvatarUploadSuccess: function handleProviderAvatarUploadSuccess(response) {\n      this.form.providerAvatar = response.data.url;\n      this.$message.success('头像上传成功');\n    },\n    removeProviderAvatar: function removeProviderAvatar() {\n      this.form.providerAvatar = '';\n      this.$message.success('头像已删除');\n    },\n    submit: function submit() {\n      var _this3 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3() {\n        return _regenerator().w(function (_context3) {\n          while (1) switch (_context3.n) {\n            case 0:\n              _this3.$refs.form.validate(/*#__PURE__*/function () {\n                var _ref = _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2(valid) {\n                  var formData, _e$response, _t2;\n                  return _regenerator().w(function (_context2) {\n                    while (1) switch (_context2.p = _context2.n) {\n                      case 0:\n                        if (valid) {\n                          _context2.n = 1;\n                          break;\n                        }\n                        return _context2.a(2);\n                      case 1:\n                        _this3.loading = true;\n                        _context2.p = 2;\n                        // 将标签数组转换为字符串\n                        formData = _objectSpread({}, _this3.form);\n                        if (Array.isArray(formData.tags)) {\n                          formData.tags = formData.tags.join(',');\n                        }\n                        _context2.n = 3;\n                        return publish(formData);\n                      case 3:\n                        _this3.$message.success('服务已提交，等待审核');\n                        _this3.$router.push('/my-services');\n                        _context2.n = 5;\n                        break;\n                      case 4:\n                        _context2.p = 4;\n                        _t2 = _context2.v;\n                        _this3.$message.error(((_e$response = _t2.response) === null || _e$response === void 0 || (_e$response = _e$response.data) === null || _e$response === void 0 ? void 0 : _e$response.message) || _t2.message || '提交失败');\n                      case 5:\n                        _context2.p = 5;\n                        _this3.loading = false;\n                        return _context2.f(5);\n                      case 6:\n                        return _context2.a(2);\n                    }\n                  }, _callee2, null, [[2, 4, 5, 6]]);\n                }));\n                return function (_x) {\n                  return _ref.apply(this, arguments);\n                };\n              }());\n            case 1:\n              return _context3.a(2);\n          }\n        }, _callee3);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["publish","upload","name","data","currentStep","loading","showGuidelinesDialog","inputTag","uploadUrl","token","steps","title","description","form","subtitle","category","type","tags","resourceImage","price","serviceCycle","version","deploymentEnv","summary","apiDefinition","dependencies","serviceContent","serviceProcess","deliveryStandards","serviceArea","serviceHighlights","providerName","providerLevel","providerAvatar","yearsExperience","providerDescription","rules","required","message","trigger","created","localStorage","getItem","methods","showGuidelines","addTag","includes","push","removeTag","tag","filter","t","prevStep","nextStep","_this","$refs","validateField","err","beforeImageUpload","file","isJPG","isLt5M","size","$message","error","uploadImage","_this2","_asyncToGenerator","_r