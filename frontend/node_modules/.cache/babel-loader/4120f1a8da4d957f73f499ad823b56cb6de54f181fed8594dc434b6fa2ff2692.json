      _this.stats = res || {};\n      _this.overviewMock.orderCount = (res && res.orderCount) != null ? res.orderCount : 28;\n    })[\"catch\"](function () {\n      _this.stats = {\n        userCount: 12,\n        projectCount: 8,\n        resourceCount: 6,\n        orderCount: 28\n      };\n      _this.overviewMock.orderCount = 28;\n    });\n  },\n  mounted: function mounted() {\n    var _this2 = this;\n    this.$nextTick(function () {\n      _this2.initMiniCharts();\n    });\n  },\n  beforeDestroy: function beforeDestroy() {\n    this.charts.forEach(function (c) {\n      return c && c.dispose();\n    });\n  },\n  methods: {\n    initMiniCharts: function initMiniCharts() {\n      var _this3 = this;\n      var opts = {\n        grid: {\n          left: 0,\n          right: 0,\n          top: 4,\n          bottom: 0\n        },\n        xAxis: {\n          show: false,\n          type: 'category',\n          data: ['1', '2', '3', '4', '5', '6', '7']\n        },\n        yAxis: {\n          show: false,\n          type: 'value'\n        },\n        series: [{\n          type: 'line',\n          data: [2, 5, 4, 8, 6, 9, 12],\n          smooth: true,\n          symbol: 'none',\n          lineStyle: {\n            width: 2,\n            color: '#007dff'\n          },\n          areaStyle: {\n            color: 'rgba(0,125,255,0.15)'\n          }\n        }]\n      };\n      ['chartUser', 'chartProject', 'chartResource', 'chartOrder'].forEach(function (ref, i) {\n        var el = _this3.$refs[ref];\n        if (el) {\n          var chart = echarts.init(el);\n          chart.setOption(_objectSpread(_objectSpread({}, opts), {}, {\n            series: [_objectSpread(_objectSpread({}, opts.series[0]), {}, {\n              data: [1, 3, 4, 6, 5, 8, 10].map(function (v) {\n                return v + i * 2;\n              })\n            })]\n          }));\n          _this3.charts.push(chart);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["echarts","adminStats","name","data","stats","overviewMock","orderCount","todoList","title","due","priority","done","charts","created","_this","overview","then","res","userCount","projectCount","resourceCount","mounted","_this2","$nextTick","initMiniCharts","beforeDestroy","forEach","c","dispose","methods","_this3","opts","grid","left","right","top","bottom","xAxis","show","type","yAxis","series","smooth","symbol","lineStyle","width","color","areaStyle","ref","i","el","$refs","chart","init","setOption","_objectSpread","map","v","push"],"sources":["src/views/admin/Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"admin-dashboard\">\n    <div class=\"welcome-bar\">\n      <h2 class=\"welcome-title\">工作台</h2>\n      <p class=\"welcome-desc\">欢迎回来，{{ $store.state.user.realName || $store.state.user.username }}。以下是平台核心数据与快捷入口。</p>\n    </div>\n\n    <!-- 数据概览区：4-6 卡片 + 迷你图表 -->\n    <section class=\"section overview-section\">\n      <h3 class=\"section-title\">数据概览</h3>\n      <el-row :gutter=\"20\" class=\"overview-row\">\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"stat-card hw-stat-card\">\n            <div class=\"stat-icon user\"><i class=\"el-icon-user-solid\"></i></div>\n            <div class=\"stat-info\">\n              <div class=\"stat-value\">{{ stats.userCount ?? 0 }}</div>\n              <div class=\"stat-label\">用户总数</div>\n            </div>\n            <div class=\"stat-mini-chart\" ref=\"chartUser\"></div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"stat-card hw-stat-card\">\n            <div class=\"stat-icon project\"><i class=\"el-icon-document\"></i></div>\n            <div class=\"stat-info\">\n              <div class=\"stat-value\">{{ stats.projectCount ?? 0 }}</div>\n              <div class=\"stat-label\">项目总数</div>\n            </div>\n            <div class=\"stat-mini-chart\" ref=\"chartProject\"></div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"stat-card hw-stat-card\">\n            <div class=\"stat-icon service\"><i class=\"el-icon-goods\"></i></div>\n            <div class=\"stat-info\">\n              <div class=\"stat-value\">{{ stats.resourceCount ?? 0 }}</div>\n              <div class=\"stat-label\">服务总数</div>\n            </div>\n            <div class=\"stat-mini-chart\" ref=\"chartResource\"></div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"stat-card hw-stat-card\">\n            <div class=\"stat-icon order\"><i class=\"el-icon-s-order\"></i></div>\n            <div class=\"stat-info\">\n              <div class=\"stat-value\">{{ stats.orderCount ?? 0 }}</div>\n              <div class=\"stat-label\">订单总数</div>\n            </div>\n            <div class=\"stat-mini-chart\" ref=\"chartOrder\"></div>\n          </div>\n        </el-col>\n      </el-row>\n    </section>\n\n    <!-- 快捷功能区：8-10 入口 -->\n    <section class=\"section quick-section\">\n      <h3 class=\"section-title\">快捷功能</h3>\n      <div class=\"quick-grid\">\n        <div class=\"quick-item hw-clickable\" @click=\"$router.push('/admin-users')\">\n          <i class=\"el-icon-user\"></i>\n          <span>用户管理</span>\n        </div>\n        <div class=\"quick-item hw-clickable\" @click=\"$router.push('/admin-roles')\">\n          <i class=\"el-icon-s-custom\"></i>\n          <span>角色权限</span>\n        </div>\n        <div class=\"quick-item hw-clickable\" @click=\"$router.push('/admin-audit')\">\n          <i class=\"el-icon-document-checked\"></i>\n          <span>内容审核</span>\n        </div>\n        <div class=\"quick-item hw-clickable\" @click=\"$router.push('/admin-stats')\">\n          <i class=\"el-icon-data-analysis\"></i>\n          <span>数据统计</span>\n        </div>\n        <div class=\"quick-item hw-clickable\" @click=\"$router.push('/admin-config')\">\n          <i class=\"el-icon-setting\"></i>\n          <span>系统设置</span>\n        </div>\n        <div class=\"quick-item hw-clickable\" @click=\"$router.push('/admin-log')\">\n          <i class=\"el-icon-document\"></i>\n          <span>操作日志</span>\n        </div>\n        <div class=\"quick-item hw-clickable\" @click=\"$router.push('/admin-backup')\">\n          <i class=\"el-icon-folder-opened\"></i>\n          <span>数据备份</span>\n        </div>\n        <div class=\"quick-item hw-clickable\" @click=\"$router.push('/home')\">\n          <i class=\"el-icon-s-home\"></i>\n          <span>返回首页</span>\n        </div>\n      </div>\n    </section>\n\n    <!-- 待办事项区 -->\n    <section class=\"section todo-section\">\n      <h3 class=\"section-title\">待办事项</h3>\n      <div class=\"todo-list\">\n        <div\n          v-for=\"(item, idx) in todoList\"\n          :key=\"idx\"\n          class=\"todo-item\"\n          :class=\"{ 'todo-done': item.done }\"\n        >\n          <span class=\"todo-priority\" :class=\"'p' + item.priority\"></span>\n          <div class=\"todo-content\">\n            <span class=\"todo-title\">{{ item.title }}</span>\n            <span class=\"todo-due\">{{ item.due }}</span>\n          </div>\n          <el-button v-if=\"!item.done\" type=\"primary\" size=\"mini\" @click=\"item.done = true\">处理</el-button>\n        </div>\n      </div>\n    </section>\n  </div>\n</template>\n\n<script>\nimport * as echarts from 'echarts'\nimport { adminStats } from '@/api/admin'\nexport default {\n  name: 'AdminDashboard',\n  data() {\n    return {\n      stats: {},\n      overviewMock: { orderCount: 0 },\n      todoList: [\n        { title: '审核待通过项目 3 条', due: '今日', priority: 1, done: false },\n        { title: '新用户注册待查看 5 人', due: '今日', priority: 2, done: false },\n        { title: '服务订单待确认 2 单', due: '明日', priority: 2, done: false },\n        { title: '系统配置备份', due: '本周', priority: 3, done: false },\n        { title: '数据统计报表导出', due: '本周', priority: 3, done: true },\n        { title: '操作日志归档', due: '本月', priority: 3, done: false }\n      ],\n      charts: []\n    }\n  },\n  created() {\n    adminStats.overview().then((res) => {\n      this.stats = res || {}\n      this.overviewMock.orderCount = (res && res.orderCount) != null ? res.orderCount : 28\n    }).catch(() => {\n      this.stats = { userCount: 12, projectCount: 8, resourceCount: 6, orderCount: 28 }\n      this.overviewMock.orderCount = 28\n    })\n  },\n  mounted() {\n    this.$nextTick(() => {\n      this.initMiniCharts()\n    })\n  },\n  beforeDestroy() {\n    this.charts.forEach((c) => c && c.dispose())\n  },\n  methods: {\n    initMiniCharts() {\n      const opts = {\n        grid: { left: 0, right: 0, top: 4, bottom: 0 },\n        xAxis: { show: false, type: 'category', data: ['1', '2', '3', '4', '5', '6', '7'] },\n        yAxis: { show: false, type: 'value' },\n        series: [{ type: 'line', data: [2, 5, 4, 8, 6, 9, 12], smooth: true, symbol: 'none', lineStyle: { width: 2, color: '#007dff' }, areaStyle: { color: 'rgba(0,125,255,0.15)' } }]\n      }\n      ;['chartUser', 'chartProject', 'chartResource', 'chartOrder'].forEach((ref, i) => {\n        const el = this.$refs[ref]\n        if (el) {\n          const chart = echarts.init(el)\n          chart.setOption({ ...opts, series: [{ ...opts.series[0], data: [1, 3, 4, 6, 5, 8, 10].map((v) => v + i * 2) }] })\n          this.charts.push(chart)\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.admin-dashboard { max-width: 1280px; }\n.welcome-bar { margin-bottom: 28px; }\n.welcome-title { font-size: 22px; font-weight: 600; color: #1e293b; margin-bottom: 8px; }\n.welcome-desc { font-size: 14px; color: #64748b; }\n.section { margin-bottom: 28px; }\n.section-title { font-size: 16px; font-weight: 600; color: #1e293b; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid #e2e8f0; }\n.overview-row { margin-bottom: 0; }\n.hw-stat-card {\n  background: #fff;\n  border-radius: 12px;\n  padding: 20px;\n  border: 1px solid #e2e8f0;\n  box-shadow: 0 2px 12px rgba(0,0,0,.06);\n  position: relative;\n  overflow: hidden;\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\n}\n.hw-stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.08); }\n.stat-icon {\n  width: 44px;\n  height: 44px;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 22px;\n  color: #fff;\n  margin-bottom: 12px;\n}\n.stat-icon.user { background: linear-gradient(135deg, #007dff, #0052a3); }\n.stat-icon.project { background: linear-gradient(135deg, #1e293b, #0f172a); }\n.stat-icon.service { background: linear-gradient(135deg, #007dff, #004c99); }\n.stat-icon.order { background: linear-gradient(135deg, #10b981, #059669); }\n.stat-value { font-size: 26px; font-weight: 700; color: #1e293b; }\n.stat-label { font-size: 13px; color: #64748b; margin-top: 4px; }\n.stat-mini-chart { position: absolute; right: 12px; bottom: 12px; width: 80px; height: 36px; }\n.quick-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));\n  gap: 16px;\n}\n.quick-item {\n  background: #fff;\n  border-radius: 12px;\n  padding: 20px;\n  border: 1px solid #e2e8f0;\n  box-shadow: 0 2px 12px rgba(0,0,0,.06);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  cursor: pointer;\n  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s;\n}\n.quick-item:hover { border-color: rgba(0,125,255,.3); box-shadow: 0 6px 20px rgba(0,125,255,.12); }\n.quick-item i { font-size: 28px; color: #007dff; }\n.quick-item span { font-size: 13px; font-weight: 500; color: #1e293b; }\n.todo-list { display: flex; flex-direction: column; gap: 12px; }\n.todo-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 14px 16px;\n  background: #fff;\n  border-radius: 8px;\n  border: 1px solid #e2e8f0;\n  transition: background 0.2s;\n}\n.todo-item:hover { background: #f8fafc; }\n.todo-done .todo-title { text-decoration: line-through; color: #94a3b8; }\n.todo-priority { width: 4px; height: 32px; border-radius: 2px; flex-shrink: 0; }\n.todo-priority.p1 { background: #007dff; }\n.todo-priority.p2 { background: #f59e0b; }\n.todo-priority.p3 { background: #94a3b8; }\n.todo-content { flex: 1; display: flex; flex-direction: column; gap: 2px; }\n.todo-title { font-size: 14px; font-weight: 500; color: #1e293b; }\n.todo-due { font-size: 12px; color: #64748b; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoHA,YAAAA,OAAA;AACA,SAAAC,UAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,KAAA;MACAC,YAAA;QAAAC,UAAA;MAAA;MACAC,QAAA,GACA;QAAAC,KAAA;QAAAC,GAAA;QAAAC,QAAA;QAAAC,IAAA;MAAA,GACA;QAAAH,KAAA;QAAAC,GAAA;QAAAC,QAAA;QAAAC,IAAA;MAAA,GACA;QAAAH,KAAA;QAAAC,GAAA;QAAAC,QAAA;QAAAC,IAAA;MAAA,GACA;QAAAH,KAAA;QAAAC,GAAA;QAAAC,QAAA;QAAAC,IAAA;MAAA,GACA;QAAAH,KAAA;QAAAC,GAAA;QAAAC,QAAA;QAAAC,IAAA;MAAA,GACA;QAAAH,KAAA;QAAAC,GAAA;QAAAC,QAAA;QAAAC,IAAA;MAAA,EACA;MACAC,MAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IAAA,IAAAC,KAAA;IACAb,UAAA,CAAAc,QAAA,GAAAC,IAAA,WAAAC,GAAA;MACAH,KAAA,CAAAV,KAAA,GAAAa,GAAA;MACAH,KAAA,CAAAT,YAAA,CAAAC,UAAA,IAAAW,GAAA,IAAAA,GAAA,CAAAX,UAAA,YAAAW,GAAA,CAAAX,UAAA;IACA;MACAQ,KAAA,CAAAV,KAAA;QAAAc,SAAA;QAAAC,YAAA;QAAAC,aAAA;QAAAd,UAAA;MAAA;MACAQ,KAAA,CAAAT,YAAA,CAAAC,UAAA;IACA;EACA;EACAe,OAAA,WAAAA,QAAA;IAAA,IAAAC,MAAA;IACA,KAAAC,SAAA;MACAD,MAAA,CAAAE,cAAA;IACA;EACA;EACAC,aAAA,WAAAA,cAAA;IACA,KAAAb,MAAA,CAAAc,OAAA,WAAAC,CAAA;MAAA,OAAAA,CAAA,IAAAA,CAAA,CAAAC,OAAA;IAAA;EACA;EACAC,OAAA;IACAL,cAAA,WAAAA,eAAA;MAAA,IAAAM,MAAA;MACA,IAAAC,IAAA;QACAC,IAAA;UAAAC,IAAA;UAAAC,KAAA;UAAAC,GAAA;UAAAC,MAAA;QAAA;QACAC,KAAA;UAAAC,IAAA;UAAAC,IAAA;UAAApC,IAAA;QAAA;QACAqC,KAAA;UAAAF,IAAA;UAAAC,IAAA;QAAA;QACAE,MAAA;UAAAF,IAAA;UAAApC,IAAA;UAAAuC,MAAA;UAAAC,MAAA;UAAAC,SAAA;YAAAC,KAAA;YAAAC,KAAA;UAAA;UAAAC,SAAA;YAAAD,KAAA;UAAA;QAAA;MACA;MACA,6DAAApB,OAAA,WAAAsB,GAAA,EAAAC,CAAA;QACA,IAAA