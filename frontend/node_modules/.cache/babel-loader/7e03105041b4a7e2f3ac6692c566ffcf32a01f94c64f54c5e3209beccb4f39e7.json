智慧农业与溯源', 'IP授权与衍生开发', '企业学习与人才发展', '智能客服与工单系统', '数据合规与隐私保护', '电子存证与司法链', '短视频与直播带货', '跨境结算与汇兑', '设备联网与预测维护', '新消费品牌从0到1', '社区团购与私域运营'];\nvar TAGS = ['融资案例', '服务案例', '合作案例', '产品案例', '孵化案例'];\nfunction buildCaseList() {\n  return CASE_TITLES.slice(0, 22).map(function (title, i) {\n    return {\n      id: i + 1,\n      title: title,\n      desc: CASE_DESCS[i % CASE_DESCS.length],\n      image: CASE_IMAGES[i % CASE_IMAGES.length],\n      tag: TAGS[i % TAGS.length]\n    };\n  });\n}\nexport default {\n  name: 'Home',\n  data: function data() {\n    return {\n      overview: {\n        userCount: 0,\n        projectCount: 0,\n        resourceCount: 0,\n        orderCount: 0\n      },\n      caseList: buildCaseList(),\n      trendChart: null,\n      heroBgStyle: {\n        backgroundImage: \"url(\".concat(BANNER_IMG, \")\")\n      }\n    };\n  },\n  computed: _objectSpread(_objectSpread(_objectSpread({}, mapGetters('user', ['isLoggedIn'])), mapState('user', ['role'])), {}, {\n    roleEntry: function roleEntry() {\n      if (this.role === 'admin') return '/admin';\n      if (this.role === 'entrepreneur') return '/entrepreneur';\n      if (this.role === 'investor') return '/investor';\n      if (this.role === 'provider') return '/provider';\n      return '/home';\n    }\n  }),\n  created: function created() {\n    this.loadOverview();\n  },\n  mounted: function mounted() {\n    var _this = this;\n    this.$nextTick(function () {\n      _this.triggerReveal([_this.$refs.heroTitle, _this.$refs.heroDesc, _this.$refs.heroActions]);\n      _this.setupRevealObserver();\n      _this.initTrendChart();\n    });\n  },\n  beforeDestroy: function beforeDestroy() {\n    if (this.trendChart) this.trendChart.dispose();\n  },\n  methods: {\n    loadOverview: function loadOverview() {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var res, _res$userCount, _res$projectCount, _res$resourceCount, _res$orderCount, _t;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _context.p = 0;\n              _context.n = 1;\n              return request({\n                url: '/stats/overview',\n                method: 'get'\n              });\n            case 1:\n              res = _context.v;\n              if (res && _typeof(res) === 'object') {\n                _this2.overview.userCount = (_res$userCount = res.userCount) !== null && _res$userCount !== void 0 ? _res$userCount : 0;\n                _this2.overview.projectCount = (_res$projectCount = res.projectCount) !== null && _res$projectCount !== void 0 ? _res$projectCount : 0;\n                _this2.overview.resourceCount = (_res$resourceCount = res.resourceCount) !== null && _res$resourceCount !== void 0 ? _res$resourceCount : 0;\n                _this2.overview.orderCount = (_res$orderCount = res.orderCount) !== null && _res$orderCount !== void 0 ? _res$orderCount : 0;\n              }\n              _context.n = 3;\n              break;\n            case 2:\n              _context.p = 2;\n              _t = _context.v;\n              _this2.overview = {\n                userCount: 128,\n                projectCount: 56,\n                resourceCount: 34,\n                orderCount: 89\n              };\n            case 3:\n              return _context.a(2);\n          }\n        }, _callee, null, [[0, 2]]);\n      }))();\n    },\n    triggerReveal: function triggerReveal(els) {\n      if (!els) return;\n      els.forEach(function (el, i) {\n        if (!el) return;\n        setTimeout(function () {\n          return el.classList.add('reveal-in');\n        }, 120 + i * 80);\n      });\n    },\n    setupRevealObserver: function setupRevealObserver() {\n      var _this3 = this;\n      var refs = ['t1', 'c1', 'c2', 'c3', 'c4', 't2', 'chartWrap', 't3', 'f1', 'f2', 'f3', 'f4', 't4', 'introCard', 't5', 'waterfall', 't6', 'faqList'];\n      var observer = new IntersectionObserver(function (entries) {\n        entries.forEach(function (entry) {\n          if (entry.isIntersecting) {\n            entry.target.classList.add('reveal-in');\n          }\n        });\n      }, {\n        threshold: 0.15,\n        rootMargin: '0px 0px -40px 0px'\n      });\n      refs.forEach(function (r) {\n        var el = _this3.$refs[r];\n        if (el) (Array.isArray(el) ? el : [el]).forEach(function (e) {\n          return e && observer.observe(e);\n        });\n      });\n    },\n    initTrendChart: function initTrendChart() {\n      var el = this.$refs.trendChart;\n      if (!el) return;\n      this.trendChart = echarts.init(el);\n      var dates = ['周一', '周二', '周三', '周四', '周五', '周六', '周日'];\n      var values = [22, 38, 45, 52, 48, 65, 72];\n      this.trendChart.setOption({\n        tooltip: {\n          trigger: 'axis'\n        },\n        grid: {\n          left: '3%',\n          right: '4%',\n          bottom: '3%',\n          top: '12%',\n          containLabel: true\n        },\n        xAxis: {\n          type: 'category',\n          data: dates,\n          boundaryGap: false,\n          axisLine: {\n            lineStyle: {\n              color: '#e2e8f0'\n            }\n          }\n        },\n        yAxis: {\n          type: 'value',\n          name: '数量',\n          axisLine: {\n            show: false\n          },\n          splitLine: {\n            lineStyle: {\n              color: '#f1f5f9'\n            }\n          }\n        },\n        series: [{\n          name: '平台活跃',\n          type: 'line',\n          smooth: true,\n          data: values,\n          symbol: 'circle',\n          symbolSize: 8,\n          lineStyle: {\n            width: 2,\n            color: '#007dff'\n          },\n          itemStyle: {\n            color: '#007dff'\n          },\n          areaStyle: {\n            color: {\n              type: 'linear',\n              x: 0,\n              y: 0,\n              x2: 0,\n              y2: 1,\n              colorStops: [{\n                offset: 0,\n                color: 'rgba(0,125,255,0.25)'\n              }, {\n                offset: 1,\n                color: 'rgba(0,125,255,0.02)'\n              }]\n            }\n          }\n        }],\n        animation: true,\n        animationDuration: 1200,\n        animationEasing: 'cubicOut'\n      });\n    },\n    handleCaseClick: function handleCaseClick(item) {\n      this.$router.push('/projects');\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapGetters","request","echarts","BANNER_IMG","CASE_IMAGES","CASE_TITLES","CASE_DESCS","TAGS","buildCaseList","slice","map","title","i","id","desc","length","image","tag","name","data","overview","userCount","projectCount","resourceCount","orderCount","caseList","trendChart","heroBgStyle","backgroundImage","concat","computed","_objectSpread","roleEntry","role","created","loadOverview","mounted","_this","$nextTick","triggerReveal","$refs","heroTitle","heroDesc","heroActions","setupRevealObserver","initTrendChart","beforeDestroy","dispose","methods","_this2","_asyncToGenerator","_regenerator","m","_callee","res","_res$userCount","_res$projectCount","_res$resourceCount","_res$orderCount","_t","w","_context","p","n","url","method","v","_typeof","a","els","forEach","el","setTimeout","classList","add","_this3","refs","observer","IntersectionObserver","entries","entry","isIntersecting","target","threshold","rootMargin","r","Array","isArray","e","observe","init","dates","values","setOption","tooltip","trigger","grid","left","right","bottom","top","containLabel","xAxis","type","boundaryGap","axisLine","lineStyle","color","yAxis","show","splitLine","series","smooth","symbol","symbolSize","width","itemStyle","areaStyle","x","y","x2","y2","colorStops","offset","animation","animationDuration","animationEasing","handleCaseClick","item","$router","push"],"sources":["src/views/Home.vue"],"sourcesContent":["<template>\n  <div class=\"home-page\">\n    <!-- 首屏：视差 Banner + 渐变蒙版 -->\n    <section class=\"hero\" ref=\"hero\">\n      <div class=\"hero-bg\" :style=\"heroBgStyle\"></div>\n      <div class=\"hero-mask\"></div>\n      <div class=\"hero-content\">\n        <h1 class=\"hero-title reveal-item\" ref=\"heroTitle\">创业者综合服务平台</h1>\n        <p class=\"hero-desc reveal-item\" ref=\"heroDesc\">一站式对接项目、投资与服务资源，助力创业全周期</p>\n        <div class=\"hero-actions\" :class=\"{ 'reveal-item': true }\" ref=\"heroActions\">\n          <template v-if=\"!isLoggedIn\">\n            <router-link to=\"/register\" class=\"btn-primary\">立即注册</router-link>\n            <router-link to=\"/login\" class=\"btn-outline\">登录</router-link>\n          </template>\n          <template v-else>\n            <router-link :to=\"roleEntry\" class=\"btn-primary\">进入工作台</router-link>\n            <router-link to=\"/projects\" class=\"btn-outline\">浏览项目</router-link>\n          </template>\n        </div>\n      </div>\n    </section>\n\n    <!-- 平台数据概览（数字 + 动态生长感） -->\n    <section class=\"section overview-section\">\n      <h2 class=\"section-title reveal-item\" ref=\"t1\">平台数据概览</h2>\n      <el-row :gutter=\"24\" class=\"overview-row\">\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"overview-card hw-clickable reveal-item\" @click=\"$router.push('/projects')\" ref=\"c1\">\n            <div class=\"overview-icon project\"><i class=\"el-icon-document\"></i></div>\n            <div class=\"overview-num\">{{ overview.projectCount }}</div>\n            <div class=\"overview-label\">在营项目</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"overview-card hw-clickable reveal-item\" @click=\"$router.push('/services')\" ref=\"c2\">\n            <div class=\"overview-icon service\"><i class=\"el-icon-goods\"></i></div>\n            <div class=\"overview-num\">{{ overview.resourceCount }}</div>\n            <div class=\"overview-label\">服务资源</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"overview-card reveal-item\" ref=\"c3\">\n            <div class=\"overview-icon user\"><i class=\"el-icon-user-solid\"></i></div>\n            <div class=\"overview-num\">{{ overview.userCount }}</div>\n            <div class=\"overview-label\">注册用户</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"overview-card reveal-item\" ref=\"c4\">\n            <div class=\"overview-icon order\"><i class=\"el-icon-s-order\"></i></div>\n            <div class=\"overview-num\">{{ overview.orderCount }}</div>\n            <div class=\"overview-label\">服务订单</div>\n          </div>\n        </el-col>\n      </el-row>\n    </section>\n\n    <!-- 数据趋势图（ECharts 动态生长） -->\n    <section class=\"section chart-section\">\n      <h2 class=\"section-title reveal-item\" ref=\"t2\">数据成果展示</h2>\n      <div class=\"chart-wrap reveal-item\" ref=\"chartWrap\">\n        <div ref=\"trendChart\" class=\"trend-chart\"></div>\n      </div>\n    </section>\n\n    <!-- 核心功能入口 -->\n    <section class=\"section\">\n      <h2 class=\"section-title reveal-item\" ref=\"t3\">核心功能</h2>\n      <el-row :gutter=\"24\" class=\"feature-row\">\n        <el-col :xs=\"24\" :sm=\"12\" :md=\"6\">\n          <div class=\"feature-card hw-clickable reveal-item\" @click=\"$router.push('/projects')\" ref=\"f1\">\n            <div class=\"feature-icon\"><i class=\"el-icon-document\"></i></div>\n            <h3>项目大厅</h3>\n            <p>浏览、发布与对接创业项目，获取融资与资源</p>\n          </div>\n        </el-col>\n        <el-col :xs=\"24\" :sm=\"12\" :md=\"6\">\n          <div class=\"feature-card hw-clickable reveal-item\" @click=\"$router.push('/services')\" ref=\"f2\">\n            <div class=\"feature-icon\"><i class=\"el-icon-goods\"></i></div>\n            <h3>服务市场</h3>\n            <p>技术、法律、市场等专业服务预约与对接</p>\n          </div>\n        </el-col>\n        <el-col :xs=\"24\" :sm=\"12\" :md=\"6\">\n          <div class=\"feature-card hw-clickable reveal-item\" @click=\"$router.push('/my-investments')\" ref=\"f3\">\n            <div class=\"feature-icon\"><i class=\"el-icon-coin\"></i></div>\n            <h3>投资对接</h3>\n            <p>提交意向、在线沟通与投资记录管理</p>\n          </div>\n        </el-col>\n        <el-col :xs=\"24\" :sm=\"12\" :md=\"6\">\n          <div class=\"feature-card hw-clickable reveal-item\" @click=\"$router.push('/messages')\" ref=\"f4\">\n            <div class=\"feature-icon\"><i class=\"el-icon-message\"></i></div>\n            <h3>消息中心</h3>\n            <p>系统通知、业务消息与在线沟通</p>\n          </div>\n        </el-col>\n      </el-row>\n    </section>\n\n    <!-- 品牌简介 -->\n    <section class=\"section intro-section\">\n      <h2 class=\"section-title reveal-item\" ref=\"t4\">关于平台</h2>\n      <div class=\"intro-card reveal-item\" ref=\"introCard\">\n        <p>创业者综合服务平台面向<strong>创业者、投资人、服务商</strong>三类角色，提供项目展示、融资对接、服务预约、消息通知等一站式能力。平台采用前后端分离架构，支持多角色权限与内容审核，无第三方支付与短信依赖，可在本地完成全流程闭环。</p>\n        <p>支持项目与服务的发布与审核、投资意向提交与沟通、服务订单与评价、管理员数据统计与系统配置等核心能力。</p>\n      </div>\n    </section>\n\n    <!-- 客户/案例展示（瀑布流 20+ 卡片） -->\n    <section class=\"section cases-section\">\n      <h2 class=\"section-title reveal-item\" ref=\"t5\">案例与成果</h2>\n      <div class=\"waterfall reveal-item\" ref=\"waterfall\">\n        <div\n          v-for=\"(item, index) in caseList\"\n          :key=\"item.id\"\n          class=\"waterfall-item\"\n          :style=\"{ animationDelay: (index % 4) * 0.08 + 's' }\"\n          @click=\"handleCaseClick(item)\"\n        >\n          <div class=\"case-img-wrap\">\n            <img :src=\"item.image\" :alt=\"item.title\" loading=\"lazy\" />\n            <div class=\"case-overlay\"></div>\n          </div>\n          <div class=\"case-body\">\n            <h4>{{ item.title }}</h4>\n            <p>{{ item.desc }}</p>\n            <span class=\"case-tag\">{{ item.tag }}</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 常见问题 / 帮助入口 -->\n    <section class=\"section faq-section\">\n      <h2 class=\"section-title reveal-item\" ref=\"t6\">常见问题</h2>\n      <div class=\"faq-list reveal-item\" ref=\"faqList\">\n        <div class=\"faq-item\">\n          <h4>如何发布项目？</h4>\n          <p>注册并登录创业者账号后，在「发布项目」中填写项目名称、行业、阶段、融资需求等信息，提交后等待审核通过即可展示。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h4>服务商如何接单？</h4>\n          <p>服务商在「服务市场」发布服务后，用户可在线预约；订单将出现在「服务订单」中，可进行接单与履约管理。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h4>投资人如何提交意向？</h4>\n          <p>在项目详情页点击「提交投资意向」，填写意向说明与联系方式，创业者可在「我的项目」中查看并回复意向。</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- 底部 -->\n    <footer class=\"home-footer\">\n      <div class=\"footer-inner\">\n        <div class=\"footer-links\">\n          <router-link to=\"/home\">首页</router-link>\n          <router-link to=\"/projects\">项目大厅</router-link>\n          <router-link to=\"/services\">服务市场</router-link>\n        </div>\n        <p class=\"footer-copy\">© 创业者综合服务平台 · 仅供学习与演示使用</p>\n      </div>\n    </footer>\n  </div>\n</template>\n\n<script>\nimport { mapState, mapGetters } from 'vuex'\nimport request from '@/utils/request'\nimport * as echarts from 'echarts'\n\nconst BANNER_IMG = 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1920'\nconst CASE_IMAGES = [\n  'https://images.unsplash.com/photo-1552664730-d307ca884978?w=600',\n  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=600',\n  'https://images.unsplash.com/photo-1556761175-b413da4baf72?w=600',\n  'https://images.unsplash.com/photo-1551434678-e076c223a692?w=600',\n  'https://images.unsplash.com/photo-1557804506-669a67965ba0?w=600',\n  'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=600',\n  'https://images.unsplash.com/photo-1552581234-26160f608093?w=600',\n  'https://images.unsplash.com/photo-1556760560-9ec2a5d2c2a0?w=600',\n  'https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=600',\n  'https://images.unsplash.com/photo-1552664730-d307ca884978?w=600',\n  'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600',\n  'https://images.unsplash.com/photo-1556761175-4b46a572b786?w=600',\n  'https://images.unsplash.com/photo-1552664730-d307ca884978?w=600',\n  'https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=600',\n  'https://images.unsplash.com/photo-1556761175-b413da4baf72?w=600',\n  'https://images.unsplash.com/photo-1551434678-e076c223a692?w=600',\n  'https://images.unsplash.com/photo-1557804506-669a67965ba0?w=600',\n  'https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?w=600',\n  'https://images.unsplash.com/photo-1552581234-26160f608093?w=600',\n  'https://images.unsplash.com/photo-1556760560-9ec2a5d2c2a0?w=600',\n  'https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=600',\n  'https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=600',\n  'https://images.unsplash.com/photo-1556761175-4b46a572b786?w=600'\n]\nconst CASE_TITLES = [\n  '智能硬件孵化项目', '企业级SaaS解决方案', '新能源出行平台', '医疗健康数字化', '教育科技产品', '跨境电商服务', '本地生活O2O', '金融科技风控', 'AI内容生产工具', '供应链协同平台',\n  '智慧园区建设', '环保科技应用', '农业物联网', '文创IP孵化', '企业培训SaaS', '智能客服系统', '数据安全方案', '区块链存证', '短视频营销', '跨境支付对接', '工业互联网', '消费品牌孵化', '社区团购运营'\n]\nconst CASE_DESCS = [\n  '从0到1的孵化与融资对接案例', '多轮融资与规模化落地经验', '政企合作与试点推广', '技术驱动与产品迭代', '市场拓展与用户增长', '团队组建与组织升级', '合规与资质办理', '品牌与PR建设', '供应链与渠道整合', '国际化与出海',\n  '产业园区数字化升级', '节能减排与碳管理', '智慧农业与溯源', 'IP授权与衍生开发', '企业学习与人才发展', '智能客服与工单系统', '数据合规与隐私保护', '电子存证与司法链', '短视频与直播带货', '跨境结算与汇兑', '设备联网与预测维护', '新消费品牌从0到1', '社区团购与私域运营'\n]\nconst TAGS = ['融资案例', '服务案例', '合作案例', '产品案例', '孵化案例']\n\nfunction buildCaseList() {\n  return CASE_TITLES.slice(0, 22).map((title, i) => ({\n    id: i + 1,\n    title,\n    desc: CASE_DESCS[i % CASE_DESCS.length],\n    image: CASE_IMAGES[i % CASE_IMAGES.length],\n    tag: TAGS[i % TAGS.length]\n  }))\n}\n\nexport default {\n  name: 'Home',\n  data() {\n    return {\n      overview: { userCount: 0, projectCount: 0, resourceCount: 0, orderCount: 0 },\n      caseList: buildCaseList(),\n      trendChart: null,\n      heroBgStyle: { backgroundImage: `url(${BANNER_IMG})` }\n    }\n  },\n  computed: {\n    ...mapGetters('user', ['isLoggedIn']),\n    ...mapState('user', ['role']),\n    roleEntry() {\n      if (this.role === 'admin') return '/admin'\n      if (this.role === 'entrepreneur') return '/entrepreneur'\n      if (this.role === 'investor') return '/investor'\n      if (this.role === 'provider') return '/provider'\n      return '/home'\n    }\n  },\n  created() {\n    this.loadOverview()\n  },\n  mounted() {\n    this.$nextTick(() => {\n      this.triggerReveal([this.$refs.heroTitle, this.$refs.heroDesc, this.$refs.heroActions])\n      this.setupRevealObserver()\n      this.initTrendChart()\n    })\n  },\n  beforeDestroy() {\n    if (this.trendChart) this.trendChart.dispose()\n  },\n  methods: {\n    async loadOverview() {\n      try {\n        const res = await request({ url: '/stats/overview', method: 'get' })\n        if (res && typeof res === 'object') {\n          this.overview.userCount = res.userCount ?? 0\n          this.overview.projectCount = res.projectCount ?? 0\n          this.overview.resourceCount = res.resourceCount ?? 0\n          this.overview.orderCount = res.orderCount ?? 0\n        }\n      } catch (_) {\n        this.overview = { userCount: 128, projectCount: 56, resourceCount: 34, orderCount: 89 }\n      }\n    },\n    triggerReveal(els) {\n      if (!els) return\n      els.forEach((el, i) => {\n        if (!el) return\n        setTimeout(() => el.classList.add('reveal-in'), 120 + i * 80)\n      })\n    },\n    setupRevealObserver() {\n      const refs = ['t1', 'c1', 'c2', 'c3', 'c4', 't2', 'chartWrap', 't3', 'f1', 'f2', 'f3', 'f4', 't4', 'introCard', 't5', 'waterfall', 't6', 'faqList']\n      const observer = new IntersectionObserver(\n        (entries) => {\n          entries.forEach((entry) => {\n            if (entry.isIntersecting) {\n              entry.target.classList.add('reveal-in')\n            }\n          })\n        },\n        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }\n      )\n      refs.forEach((r) => {\n        const el = this.$refs[r]\n        if (el) (Array.isArray(el) ? el : [el]).forEach((e) => e && observer.observe(e))\n      })\n    },\n    initTrendChart() {\n      const el = this.$refs.trendChart\n      if (!el) return\n      this.trendChart = echarts.init(el)\n      const dates = ['周一', '周二', '周三', '周四', '周五', '周六', '周日']\n      const values = [22, 38, 45, 52, 48, 65, 72]\n      this.trendChart.setOption({\n        tooltip: { trigger: 'axis' },\n        grid: { left: '3%', right: '4%', bottom: '3%', top: '12%', containLabel: true },\n        xAxis: { type: 'category', data: dates, boundaryGap: false, axisLine: { lineStyle: { color: '#e2e8f0' } } },\n        yAxis: { type: 'value', name: '数量', axisLine: { show: false }, splitLine: { lineStyle: { color: '#f1f5f9' } } },\n        series: [\n          {\n            name: '平台活跃',\n            type: 'line',\n            smooth: true,\n            data: values,\n            symbol: 'circle',\n            symbolSize: 8,\n            lineStyle: { width: 2, color: '#007dff' },\n            itemStyle: { color: '#007dff' },\n            areaStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: 'rgba(0,125,255,0.25)' }, { offset: 1, color: 'rgba(0,125,255,0.02)' }] } }\n          }\n        ],\n        animation: true,\n        animationDuration: 1200,\n        animationEasing: 'cubicOut'\n      })\n    },\n    handleCaseClick(item) {\n      this.$router.push('/projects')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.home-page { max-width: 1280px; margin: 0 auto; padding-bottom: 0; }\n.hero {\n  position: relative;\n  border-radius: var(--hw-radius-xl);\n  overflow: hidden;\n  margin: -24px -24px 40px -24px;\n  min-height: 420px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.hero-bg {\n  position: absolute;\n  inset: 0;\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  background-attachment: fixed;\n  transform: translateZ(0);\n  will-change: transform;\n}\n.hero-mask {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(135deg, rgba(15,23,42,0.88) 0%, rgba(30,41,59,0.82) 50%, rgba(15,23,42,0.9) 100%);\n  pointer-events: none;\n}\n.hero-content { position: relative; z-index: 1; text-align: center; padding: 56px 24px; }\n.hero-title {\n  font-size: 36px;\n  font-weight: 700;\n  color: #fff;\n  margin-bottom: 16px;\n  letter-spacing: 1px;\n}\n.hero-desc {\n  font-size: 17px;\n  color: rgba(255,255,255,.88);\n  margin-bottom: 36px;\n  max-width: 520px;\n  margin-left: auto;\n  margin-right: auto;\n}\n.hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }\n.btn-primary {\n  display: inline-block;\n  padding: 14px 32px;\n  background: var(--hw-primary);\n  color: #fff;\n  border-radius: var(--hw-radius);\n  font-weight: 600;\n  text-decoration: none;\n  transition: transform var(--hw-duration) ease, box-shadow var(--hw-duration) ease, background-color var(--hw-duration);\n  box-shadow: 0 4px 14px rgba(0,125,255,.35);\n}\n.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,125,255,.45); color: #fff; background: var(--hw-primary-hover); }\n.btn-outline {\n  display: inline-block;\n  padding: 14px 32px;\n  border: 2px solid rgba(255,255,255,.5);\n  color: #fff;\n  border-radius: var(--hw-radius);\n  font-weight: 600;\n  text-decoration: none;\n  transition: all var(--hw-duration);\n}\n.btn-outline:hover { background: rgba(255,255,255,.12); border-color: #fff; color: #fff; }\n\n.section { margin-bottom: 56px; }\n.section-title {\n  font-size: 22px;\n  font-weight: 600;\n  color: var(--hw-text);\n  margin-bottom: 24px;\n  padding-bottom: 12px;\n  border-bottom: 2px solid var(--hw-border);\n  letter-spacing: 0.3px;\n}\n.overview-row { margin-bottom: 0; }\n.overview-card {\n  background: var(--hw-bg-card);\n  border-radius: var(--hw-radius-lg);\n  padding: 24px;\n  text-align: center;\n  box-shadow: var(--hw-shadow);\n  border: 1px solid var(--hw-border);\n  cursor: pointer;\n  transition: transform var(--hw-duration) ease, box-shadow var(--hw-duration) ease;\n  margin-bottom: 20px;\n}\n.overview-card:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--hw-shadow-hover);\n}\n.overview-icon {\n  width: 56px;\n  height: 56px;\n  border-radius: 14px;\n  margin: 0 auto 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 26px;\n  color: #fff;\n}\n.overview-icon.project { background: linear-gradient(135deg, #007dff, #0066cc); }\n.overview-icon.service { background: linear-gradient(135deg, #10b981, #059669); }\n.overview-icon.user { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }\n.overview-icon.order { background: linear-gradient(135deg, #f59e0b, #d97706); }\n.overview-num { font-size: 28px; font-weight: 700; color: var(--hw-text); margin-bottom: 4px; }\n.overview-label { font-size: 13px; color: var(--hw-text-secondary); }\n\n.chart-section .chart-wrap {\n  background: var(--hw-bg-card);\n  border-radius: var(--hw-radius-lg);\n  padding: 24px;\n  border: 1px solid var(--hw-border);\n  box-shadow: var(--hw-shadow);\n}\n.trend-chart { height: 320px; }\n\n.feature-row { margin-bottom: 0; }\n.feature-card {\n  background: var(--hw-bg-card);\n  border-radius: var(--hw-radius-lg);\n  padding: 28px;\n  border: 1px solid var(--hw-border);\n  box-shadow: var(--hw-shadow);\n  cursor: pointer;\n  transition: transform var(--hw-duration) ease, box-shadow var(--hw-duration) ease, border-color var(--hw-duration);\n  margin-bottom: 20px;\n  height: 100%;\n}\n.feature-card:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--hw-shadow-hover);\n  border-color: var(--hw-primary-light);\n}\n.feature-icon {\n  width: 52px;\n  height: 52px;\n  bor