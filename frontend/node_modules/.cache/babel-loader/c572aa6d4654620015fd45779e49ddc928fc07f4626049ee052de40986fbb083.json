{"ast":null,"code":"import _objectSpread from \"C:/Users/Administrator/Desktop/lunwen/frontend/node_modules/@babel/runtime/helpers/esm/objectSpread2.js\";\nimport \"core-js/modules/es.array.push.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { mapState, mapGetters, mapActions } from 'vuex';\nexport default {\n  name: 'Layout',\n  data: function data() {\n    return {\n      headerSolid: false\n    };\n  },\n  computed: _objectSpread(_objectSpread({}, mapState('user', ['username', 'realName'])), {}, {\n    user: function user() {\n      return {\n        username: this.username,\n        realName: this.realName\n      };\n    }\n  }, mapGetters('user', ['isAdmin', 'isEntrepreneur', 'isInvestor', 'isProvider'])),\n  mounted: function mounted() {\n    window.addEventListener('scroll', this.onScroll, {\n      passive: true\n    });\n    this.onScroll();\n  },\n  beforeDestroy: function beforeDestroy() {\n    window.removeEventListener('scroll', this.onScroll);\n  },\n  methods: _objectSpread(_objectSpread({\n    onScroll: function onScroll() {\n      this.headerSolid = window.scrollY > 48;\n    }\n  }, mapActions('user', ['logout'])), {}, {\n    handleCommand: function handleCommand(cmd) {\n      if (cmd === 'profile') this.$router.push('/profile');\n      if (cmd === 'logout') {\n        this.logout();\n        this.$router.push('/login');\n      }\n    }\n  })\n};","map":{"version":3,"names":["mapState","mapGetters","mapActions","name","data","headerSolid","computed","_objectSpread","user","username","realName","mounted","window","addEventListener","onScroll","passive","beforeDestroy","removeEventListener","methods","scrollY","handleCommand","cmd","$router","push","logout"],"sources":["src/views/Layout.vue"],"sourcesContent":["<template>\n  <el-container class=\"app-layout\">\n    <!-- 管理员：左侧边栏 -->\n    <el-aside v-if=\"isAdmin\" class=\"admin-sidebar\" width=\"240px\">\n      <div class=\"sidebar-logo\">\n        <i class=\"el-icon-s-platform logo-icon\"></i>\n        <span class=\"logo-text\">管理后台</span>\n      </div>\n      <el-menu\n        :default-active=\"$route.path\"\n        class=\"admin-menu\"\n        background-color=\"transparent\"\n        text-color=\"#94a3b8\"\n        active-text-color=\"#fff\"\n        router\n      >\n        <el-menu-item index=\"/admin\" class=\"menu-item\">\n          <i class=\"el-icon-s-home\"></i>\n          <span>工作台</span>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-users\" class=\"menu-item\">\n          <i class=\"el-icon-user\"></i>\n          <span>用户管理</span>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-roles\" class=\"menu-item\">\n          <i class=\"el-icon-s-custom\"></i>\n          <span>角色权限</span>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-audit\" class=\"menu-item\">\n          <i class=\"el-icon-document-checked\"></i>\n          <span>内容审核</span>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-stats\" class=\"menu-item\">\n          <i class=\"el-icon-data-analysis\"></i>\n          <span>数据统计</span>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-config\" class=\"menu-item\">\n          <i class=\"el-icon-setting\"></i>\n          <span>系统设置</span>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-log\" class=\"menu-item\">\n          <i class=\"el-icon-document\"></i>\n          <span>操作日志</span>\n        </el-menu-item>\n        <el-menu-item index=\"/admin-backup\" class=\"menu-item\">\n          <i class=\"el-icon-folder-opened\"></i>\n          <span>数据备份</span>\n        </el-menu-item>\n      </el-menu>\n    </el-aside>\n\n    <el-container direction=\"vertical\" class=\"main-wrap\">\n      <!-- 顶栏：吸顶 + 透明→实色 + 下拉动效 -->\n      <header class=\"main-header\" :class=\"{ 'header-solid': headerSolid }\">\n        <div class=\"header-left\">\n          <router-link to=\"/home\" class=\"nav-brand\">\n            <i class=\"el-icon-s-home\"></i>\n            <span>首页</span>\n          </router-link>\n          <nav class=\"nav-links\" v-if=\"!isAdmin\">\n            <router-link to=\"/projects\" class=\"nav-link\">项目大厅</router-link>\n            <router-link to=\"/services\" class=\"nav-link\">服务市场</router-link>\n            <template v-if=\"isEntrepreneur\">\n              <router-link to=\"/project-publish\" class=\"nav-link\">发布项目</router-link>\n              <router-link to=\"/my-projects\" class=\"nav-link\">我的项目</router-link>\n            </template>\n            <template v-if=\"isInvestor\">\n              <router-link to=\"/my-investments\" class=\"nav-link\">投资意向</router-link>\n            </template>\n            <template v-if=\"isProvider\">\n              <router-link to=\"/service-publish\" class=\"nav-link\">发布服务</router-link>\n              <router-link to=\"/my-services\" class=\"nav-link\">我的服务</router-link>\n              <router-link to=\"/provider-orders\" class=\"nav-link\">服务订单</router-link>\n            </template>\n            <router-link to=\"/my-orders\" class=\"nav-link\">我的订单</router-link>\n            <router-link to=\"/messages\" class=\"nav-link\">\n              <i class=\"el-icon-message\"></i> 消息\n            </router-link>\n          </nav>\n        </div>\n        <div class=\"header-right\">\n          <div class=\"user-wrap\">\n            <div class=\"user-avatar\">\n              {{ (user.realName || user.username || 'U').charAt(0) }}\n            </div>\n            <el-dropdown trigger=\"click\" @command=\"handleCommand\" class=\"user-dropdown\">\n              <span class=\"user-info\">\n                <span class=\"user-name\">{{ user.realName || user.username }}</span>\n                <i class=\"el-icon-arrow-down el-icon--right\"></i>\n              </span>\n              <el-dropdown-menu slot=\"dropdown\" class=\"header-dropdown\">\n                <el-dropdown-item command=\"profile\">\n                  <i class=\"el-icon-user\"></i> 个人中心\n                </el-dropdown-item>\n                <el-dropdown-item command=\"logout\" divided>\n                  <i class=\"el-icon-switch-button\"></i> 退出登录\n                </el-dropdown-item>\n              </el-dropdown-menu>\n            </el-dropdown>\n          </div>\n        </div>\n      </header>\n\n      <el-main class=\"main-content\">\n        <router-view />\n      </el-main>\n    </el-container>\n  </el-container>\n</template>\n\n<script>\nimport { mapState, mapGetters, mapActions } from 'vuex'\nexport default {\n  name: 'Layout',\n  data() {\n    return { headerSolid: false }\n  },\n  computed: {\n    ...mapState('user', ['username', 'realName']),\n    user() {\n      return { username: this.username, realName: this.realName }\n    },\n    ...mapGetters('user', ['isAdmin', 'isEntrepreneur', 'isInvestor', 'isProvider'])\n  },\n  mounted() {\n    window.addEventListener('scroll', this.onScroll, { passive: true })\n    this.onScroll()\n  },\n  beforeDestroy() {\n    window.removeEventListener('scroll', this.onScroll)\n  },\n  methods: {\n    onScroll() {\n      this.headerSolid = window.scrollY > 48\n    },\n    ...mapActions('user', ['logout']),\n    handleCommand(cmd) {\n      if (cmd === 'profile') this.$router.push('/profile')\n      if (cmd === 'logout') {\n        this.logout()\n        this.$router.push('/login')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.app-layout { min-height: 100vh; }\n.admin-sidebar {\n  background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);\n  box-shadow: 4px 0 24px rgba(0,0,0,.12);\n}\n.sidebar-logo {\n  height: 64px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  border-bottom: 1px solid rgba(255,255,255,.06);\n}\n.logo-icon { font-size: 24px; color: #3b82f6; }\n.logo-text {\n  font-size: 17px;\n  font-weight: 700;\n  color: #f1f5f9;\n  letter-spacing: 0.5px;\n}\n.admin-menu { border-right: none; padding: 12px 0; }\n.admin-menu .menu-item {\n  margin: 4px 12px;\n  border-radius: 10px;\n  height: 48px;\n  line-height: 48px;\n  transition: all .2s ease;\n}\n.admin-menu .menu-item i { margin-right: 10px; font-size: 18px; }\n.admin-menu .menu-item:hover { background: rgba(255,255,255,.06) !important; color: #e2e8f0; }\n.admin-menu .menu-item.is-active {\n  background: linear-gradient(90deg, rgba(59,130,246,.25) 0%, rgba(59,130,246,.1) 100%) !important;\n  color: #fff;\n}\n\n.main-wrap { flex: 1; min-width: 0; }\n.main-header {\n  height: var(--header-height);\n  background: rgba(15, 23, 42, 0.88);\n  backdrop-filter: saturate(180%) blur(12px);\n  -webkit-backdrop-filter: saturate(180%) blur(12px);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 28px;\n  box-shadow: none;\n  position: sticky;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 100;\n  transition: background var(--hw-duration-slow) ease, box-shadow var(--hw-duration-slow) ease;\n}\n.main-header.header-solid {\n  background: var(--header-bg-solid);\n  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15);\n}\n.header-left { display: flex; align-items: center; gap: 8px; }\n.nav-brand {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  color: #fff;\n  text-decoration: none;\n  font-weight: 600;\n  font-size: 15px;\n  padding: 8px 14px;\n  border-radius: 10px;\n  margin-right: 16px;\n  transition: background .2s;\n}\n.nav-brand:hover { background: rgba(255,255,255,.1); color: #fff; }\n.nav-brand i { font-size: 18px; }\n.nav-links { display: flex; align-items: center; gap: 2px; }\n.nav-link {\n  color: rgba(255,255,255,.88);\n  text-decoration: none;\n  padding: 10px 16px;\n  border-radius: 10px;\n  font-size: 14px;\n  font-weight: 500;\n  transition: all .2s ease;\n}\n.nav-link:hover { background: rgba(255,255,255,.12); color: #fff; }\n.nav-link.router-link-active { background: rgba(255,255,255,.15); color: #fff; }\n.nav-link i { margin-right: 4px; font-size: 14px; }\n\n.header-right { display: flex; align-items: center; }\n.user-wrap { display: flex; align-items: center; gap: 12px; }\n.user-avatar {\n  width: 36px;\n  height: 36px;\n  border-radius: 10px;\n  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);\n  color: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  font-size: 14px;\n}\n.user-dropdown { cursor: pointer; }\n.user-info {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  color: #fff;\n  font-size: 14px;\n  font-weight: 500;\n  padding: 6px 10px;\n  border-radius: 8px;\n  transition: background .2s;\n}\n.user-info:hover { background: rgba(255,255,255,.1); }\n.user-info .el-icon--right { font-size: 12px; margin-left: 2px; }\n.main-content {\n  background: #f8fafc;\n  padding: 24px;\n  min-height: calc(100vh - var(--header-height));\n}\n</style>\n\n<style>\n/* 下拉菜单：平滑展开 + 阴影过渡 */\n.header-dropdown.el-dropdown-menu {\n  border-radius: var(--hw-radius-lg);\n  padding: 8px;\n  box-shadow: var(--hw-shadow-modal);\n  border: 1px solid var(--hw-border);\n  transition: opacity var(--hw-duration) ease, transform var(--hw-duration) ease;\n}\n.header-dropdown .el-dropdown-menu__item {\n  border-radius: var(--hw-radius);\n  padding: 10px 16px;\n  transition: background var(--hw-duration) ease;\n}\n.header-dropdown .el-dropdown-menu__item i { margin-right: 8px; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA+GA,SAAAA,QAAA,EAAAC,UAAA,EAAAC,UAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MAAAC,WAAA;IAAA;EACA;EACAC,QAAA,EAAAC,aAAA,CAAAA,aAAA,KACAP,