ectTime: ''\n      }\n    };\n  },\n  computed: _objectSpread({}, mapGetters('user', ['isEntrepreneur'])),\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    load: function load() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var id;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              id = _this.$route.params.id;\n              _context.n = 2;\n              return getDetail(id);\n            case 2:\n              _this.resource = _context.v;\n            case 3:\n              _context.p = 3;\n              _this.loading = false;\n              return _context.f(3);\n            case 4:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1,, 3, 4]]);\n      }))();\n    },\n    toggleFavorite: function toggleFavorite() {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.n) {\n            case 0:\n              _context2.n = 1;\n              return _toggleFavorite(_this2.resource.id);\n            case 1:\n              _this2.$message.success('已收藏');\n            case 2:\n              return _context2.a(2);\n          }\n        }, _callee2);\n      }))();\n    },\n    submitBook: function submitBook() {\n      var _this3 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3() {\n        var _e$response, _t;\n        return _regenerator().w(function (_context3) {\n          while (1) switch (_context3.p = _context3.n) {\n            case 0:\n              _context3.p = 0;\n              _context3.n = 1;\n              return create({\n                resourceId: _this3.resource.id,\n                providerId: _this3.resource.providerId,\n                amount: _this3.resource.price,\n                description: _this3.bookForm.description,\n                expectTime: _this3.bookForm.expectTime\n              });\n            case 1:\n              _this3.$message.success('预约已提交');\n              _this3.showBook = false;\n              _context3.n = 3;\n              break;\n            case 2:\n              _context3.p = 2;\n              _t = _context3.v;\n              _this3.$message.error(((_e$response = _t.response) === null || _e$response === void 0 || (_e$response = _e$response.data) === null || _e$response === void 0 ? void 0 : _e$response.message) || '提交失败');\n            case 3:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[0, 2]]);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["getDetail","toggleFavorite","create","mapGetters","name","data","loading","resource","showBook","bookForm","description","expectTime","computed","_objectSpread","created","load","methods","_this","_asyncToGenerator","_regenerator","m","_callee","id","w","_context","p","n","$route","params","v","f","a","_this2","_callee2","_context2","$message","success","submitBook","_this3","_callee3","_e$response","_t","_context3","resourceId","providerId","amount","price","error","response","message"],"sources":["src/views/resource/Detail.vue"],"sourcesContent":["<template>\n  <div class=\"service-detail-page\" v-loading=\"loading\">\n    <template v-if=\"resource\">\n      <!-- 服务头部信息 -->\n      <div class=\"service-header\">\n        <div class=\"header-content\">\n          <div class=\"header-left\">\n            <div class=\"service-category-badge\">\n              {{ resource.category }}\n            </div>\n            <h1 class=\"service-title\">{{ resource.title }}</h1>\n            <p class=\"service-subtitle\">{{ resource.subtitle || '专业服务，助力企业成长' }}</p>\n            <div class=\"service-meta\">\n              <div class=\"meta-item\">\n                <i class=\"el-icon-price-tag meta-icon\"></i>\n                <span class=\"meta-label\">价格</span>\n                <span class=\"meta-value price\">¥{{ resource.price }}</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-star-on meta-icon\"></i>\n                <span class=\"meta-label\">评分</span>\n                <span class=\"meta-value rating\">{{ resource.rating || '暂无评分' }}</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-s-comment meta-icon\"></i>\n                <span class=\"meta-label\">评价</span>\n                <span class=\"meta-value\">{{ resource.reviewCount || 0 }}条</span>\n              </div>\n              <div class=\"meta-item\">\n                <i class=\"el-icon-time meta-icon\"></i>\n                <span class=\"meta-label\">发布时间</span>\n                <span class=\"meta-value\">{{ formatDate(resource.createdAt) }}</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"header-right\">\n            <div class=\"provider-info\">\n              <div class=\"provider-avatar\">\n                {{ (resource.providerName || '服').charAt(0) }}\n              </div>\n              <div class=\"provider-details\">\n                <h4 class=\"provider-name\">{{ resource.providerName }}</h4>\n                <p class=\"provider-level\">{{ resource.providerLevel || '认证服务商' }}</p>\n                <div class=\"provider-stats\">\n                  <span class=\"stat-item\">{{ resource.serviceCount || 0 }}服务</span>\n                  <span class=\"stat-item\">{{ resource.completionRate || 100 }}%完成率</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 服务详情内容 -->\n      <div class=\"service-content\">\n        <div class=\"content-left\">\n          <!-- 服务介绍 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-document\"></i>\n                <h3 class=\"card-title\">服务介绍</h3>\n              </div>\n            </template>\n            <div class=\"service-description\" v-html=\"resource.description\" />\n          </el-card>\n\n          <!-- 服务详情 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-grid\"></i>\n                <h3 class=\"card-title\">服务详情</h3>\n              </div>\n            </template>\n            <div class=\"service-details\">\n              <div class=\"detail-item\">\n                <h4>服务内容</h4>\n                <p>{{ resource.serviceContent || '该服务尚未提供详细内容说明' }}</p>\n              </div>\n              <div class=\"detail-item\">\n                <h4>服务流程</h4>\n                <p>{{ resource.serviceProcess || '该服务尚未提供流程说明' }}</p>\n              </div>\n              <div class=\"detail-item\">\n                <h4>交付标准</h4>\n                <p>{{ resource.deliveryStandard || '该服务尚未提供交付标准' }}</p>\n              </div>\n              <div class=\"detail-item\">\n                <h4>服务保障</h4>\n                <p>{{ resource.serviceGuarantee || '该服务尚未提供保障说明' }}</p>\n              </div>\n            </div>\n          </el-card>\n\n          <!-- 用户评价 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-comment\"></i>\n                <h3 class=\"card-title\">用户评价</h3>\n              </div>\n            </template>\n            <div class=\"user-reviews\">\n              <div \n                v-for=\"(review, index) in resource.reviews || mockReviews\" \n                :key=\"index\"\n                class=\"review-item\"\n              >\n                <div class=\"review-header\">\n                  <div class=\"reviewer-info\">\n                    <div class=\"reviewer-avatar\">{{ review.username.charAt(0) }}</div>\n                    <div class=\"reviewer-details\">\n                      <h5 class=\"reviewer-name\">{{ review.username }}</h5>\n                      <p class=\"review-time\">{{ formatDate(review.createdAt) }}</p>\n                    </div>\n                  </div>\n                  <div class=\"review-rating\">\n                    <i class=\"el-icon-star-on\" v-for=\"i in review.rating\" :key=\"i\"></i>\n                  </div>\n                </div>\n                <div class=\"review-content\">\n                  {{ review.content }}\n                </div>\n              </div>\n              <div v-if=\"!(resource.reviews && resource.reviews.length)\" class=\"no-reviews\">\n                <i class=\"el-icon-info\"></i>\n                <p>暂无用户评价</p>\n              </div>\n            </div>\n          </el-card>\n        </div>\n\n        <div class=\"content-right\">\n          <!-- 操作按钮 -->\n          <el-card class=\"content-card action-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-operation\"></i>\n                <h3 class=\"card-title\">服务操作</h3>\n              </div>\n            </template>\n            <div class=\"action-buttons\">\n              <el-button \n                type=\"primary\" \n                size=\"large\" \n                @click=\"toggleFavorite\"\n                :class=\"{ 'favorited': favorited }\"\n              >\n                <i :class=\"favorited ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n                {{ favorited ? '已收藏' : '收藏服务' }}\n              </el-button>\n              <el-button \n                v-if=\"isEntrepreneur\" \n                type=\"success\" \n                size=\"large\" \n                @click=\"showBook = true\"\n              >\n                <i class=\"el-icon-s-order\"></i>\n                预约服务\n              </el-button>\n              <el-button \n                type=\"info\" \n                size=\"large\" \n                @click=\"showContact = true\"\n              >\n                <i class=\"el-icon-phone\"></i>\n                联系服务商\n              </el-button>\n            </div>\n            <div class=\"service-tags\">\n              <span class=\"tag-item\" v-for=\"(tag, index) in resource.tags || ['专业服务', '认证保障', '售后支持']\" :key=\"index\">\n                {{ tag }}\n              </span>\n            </div>\n          </el-card>\n\n          <!-- 相关服务推荐 -->\n          <el-card class=\"content-card\">\n            <template slot=\"header\">\n              <div class=\"card-header\">\n                <i class=\"el-icon-s-grid\"></i>\n                <h3 class=\"card-title\">相关服务</h3>\n              </div>\n            </template>\n            <div class=\"related-services\">\n              <div \n                v-for=\"(item, index) in relatedServices\" \n                :key=\"index\"\n                class=\"related-item\"\n                @click=\"goService(item.id)\"\n              >\n                <h5 class=\"related-title\">{{ item.title }}</h5>\n                <div class=\"related-info\">\n                  <span class=\"related-category\">{{ item.category }}</span>\n                  <span class=\"related-price\">¥{{ item.price }}</span>\n                </div>\n              </div>\n            </div>\n          </el-card>\n        </div>\n      </div>\n\n      <!-- 预约服务对话框 -->\n      <el-dialog \n        title=\"预约服务\" \n        :visible.sync=\"showBook\" \n        width=\"600px\"\n        custom-class=\"book-dialog\"\n      >\n        <el-form ref=\"bookForm\" :model=\"bookForm\" :rules=\"bookRules\" label-width=\"120px\">\n          <el-form-item label=\"需求说明\" prop=\"description\">\n            <el-input \n              v-model=\"bookForm.description\" \n              type=\"textarea\" \n              rows=\"4\" \n              placeholder=\"请详细描述您的需求\"\n            />\n          </el-form-item>\n          <el-form-item label=\"期望时间\" prop=\"expectTime\">\n            <el-date-picker \n              v-model=\"bookForm.expectTime\" \n              type=\"datetime\" \n              placeholder=\"选择期望服务时间\"\n              style=\"width: 100%\"\n            />\n          </el-form-item>\n          <el-form-item label=\"联系方式\" prop=\"contactInfo\">\n            <el-input \n              v-model=\"bookForm.contactInfo\" \n              placeholder=\"请留下您的联系方式\"\n            />\n          </el-form-item>\n        </el-form>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"showBook = false\">取消</el-button>\n          <el-button type=\"primary\" @click=\"submitBook\">提交预约</el-button>\n        </span>\n      </el-dialog>\n\n      <!-- 联系服务商对话框 -->\n      <el-dialog \n        title=\"联系服务商\" \n        :visible.sync=\"showContact\" \n        width=\"500px\"\n        custom-class=\"contact-dialog\"\n      >\n        <div class=\"contact-info\">\n          <div class=\"contact-item\">\n            <i class=\"el-icon-phone\"></i>\n            <span class=\"contact-label\">电话：</span>\n            <span class=\"contact-value\">{{ resource.providerPhone || '*******1234' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-message\"></i>\n            <span class=\"contact-label\">邮箱：</span>\n            <span class=\"contact-value\">{{ resource.providerEmail || 'provider@example.com' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-chat-dot-round\"></i>\n            <span class=\"contact-label\">微信：</span>\n            <span class=\"contact-value\">{{ resource.providerWechat || 'service_wx' }}</span>\n          </div>\n        </div>\n        <div class=\"contact-note\">\n          <i class=\"el-icon-warning-outline\"></i>\n          <p>请在工作时间联系服务商，保持专业礼貌的沟通方式</p>\n        </div>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button type=\"primary\" @click=\"showContact = false\">我知道了</el-button>\n        </span>\n      </el-dialog>\n    </template>\n  </div>\n</template>\n\n<script>\nimport { getDetail, toggleFavorite } from '@/api/resource'\nimport { create } from '@/api/order'\nimport { mapGetters } from 'vuex'\nexport default {\n  name: 'ServiceDetail',\n  data() {\n    return { loading: false, resource: null, showBook: false, bookForm: { description: '', expectTime: '' } }\n  },\n  computed: { ...mapGetters('user', ['isEntrepreneur']) },\n  created() { this.load() },\n  methods: {\n    async load() {\n      this.loading = true\n      try {\n        const id = this.$route.params.id\n        this.resource = await getDetail(id)\n      } finally { this.loading = false }\n    },\n    async toggleFavorite() {\n      await toggleFavorite(this.resource.id)\n      this.$message.success('已收藏')\n    },\n    async submitBook() {\n      try {\n        await create({ resourceId: this.resource.id, providerId: this.resource.providerId, amount: this.resource.price, description: this.bookForm.description, expectTime: this.bookForm.expectTime })\n        this.$message.success('预约已提交')\n        this.showBook = false\n      } catch (e) {\n        this.$message.error(e.response?.data?.message || '提交失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.content { margin-top: 16px; line-height: 1.6; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqRA,SAAAA,SAAA,EAAAC,cAAA,IAAAA,eAAA;AACA,SAAAC,MAAA;AACA,SAAAC,UAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MAAAC,OAAA;MAAAC,QAAA;MAAAC,QAAA;MAAAC,QAAA;QAAAC,WAAA;QAAAC,UAAA