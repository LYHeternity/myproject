//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { getDetail, toggleFavorite as _toggleFavorite } from '@/api/resource';\nimport { create } from '@/api/order';\nimport { mapGetters } from 'vuex';\nexport default {\n  name: 'ServiceDetail',\n  data: function data() {\n    return {\n      loading: false,\n      resource: null,\n      showBook: false,\n      bookForm: {\n        description: '',\n        expectTime: ''\n      }\n    };\n  },\n  computed: _objectSpread({}, mapGetters('user', ['isEntrepreneur'])),\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    load: function load() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var id;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              id = _this.$route.params.id;\n              _context.n = 2;\n              return getDetail(id);\n            case 2:\n              _this.resource = _context.v;\n            case 3:\n              _context.p = 3;\n              _this.loading = false;\n              return _context.f(3);\n            case 4:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1,, 3, 4]]);\n      }))();\n    },\n    toggleFavorite: function toggleFavorite() {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.n) {\n            case 0:\n              _context2.n = 1;\n              return _toggleFavorite(_this2.resource.id);\n            case 1:\n              _this2.$message.success('已收藏');\n            case 2:\n              return _context2.a(2);\n          }\n        }, _callee2);\n      }))();\n    },\n    submitBook: function submitBook() {\n      var _this3 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3() {\n        var _e$response, _t;\n        return _regenerator().w(function (_context3) {\n          while (1) switch (_context3.p = _context3.n) {\n            case 0:\n              _context3.p = 0;\n              _context3.n = 1;\n              return create({\n                resourceId: _this3.resource.id,\n                providerId: _this3.resource.providerId,\n                amount: _this3.resource.price,\n                description: _this3.bookForm.description,\n                expectTime: _this3.bookForm.expectTime\n              });\n            case 1:\n              _this3.$message.success('预约已提交');\n              _this3.showBook = false;\n              _context3.n = 3;\n              break;\n            case 2:\n              _context3.p = 2;\n              _t = _context3.v;\n              _this3.$message.error(((_e$response = _t.response) === null || _e$response === void 0 || (_e$response = _e$response.data) === null || _e$response === void 0 ? void 0 : _e$response.message) || '提交失败');\n            case 3:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[0, 2]]);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["getDetail","toggleFavorite","create","mapGetters","name","data","loading","resource","showBook","bookForm","description","expectTime","computed","_objectSpread","created","load","methods","_this","_asyncToGenerator","_regenerator","m","_callee","id","w","_context","p","n","$route","params","v","f","a","_this2","_callee2","_context2","$message","success","submitBook","_this3","_callee3","_e$response","_t","_context3","resourceId","providerId","amount","price","error","response","message"],"sources":["src/views/resource/Detail.vue"],"sourcesContent":["<template>\n  <div class=\"service-detail-page\" v-loading=\"loading\">\n    <template v-if=\"resource\">\n      <!-- 服务头部信息 -->\n      <div class=\"service-header\">\n        <div class=\"header-container\">\n          <div class=\"header-content\">\n            <div class=\"header-left\">\n              <div class=\"service-category-badge\">\n                {{ resource.category }}\n              </div>\n              <h1 class=\"service-title\">{{ resource.title }}</h1>\n              <p class=\"service-subtitle\">{{ resource.subtitle || '专业服务，助力企业成长' }}</p>\n              <div class=\"service-meta\">\n                <div class=\"meta-item\">\n                  <i class=\"el-icon-price-tag meta-icon\"></i>\n                  <span class=\"meta-label\">价格</span>\n                  <span class=\"meta-value price\">¥{{ resource.price }}</span>\n                </div>\n                <div class=\"meta-item\">\n                  <i class=\"el-icon-star-on meta-icon\"></i>\n                  <span class=\"meta-label\">评分</span>\n                  <span class=\"meta-value rating\">{{ resource.rating || '暂无评分' }}</span>\n                </div>\n                <div class=\"meta-item\">\n                  <i class=\"el-icon-s-comment meta-icon\"></i>\n                  <span class=\"meta-label\">评价</span>\n                  <span class=\"meta-value\">{{ resource.reviewCount || 0 }}条</span>\n                </div>\n                <div class=\"meta-item\">\n                  <i class=\"el-icon-time meta-icon\"></i>\n                  <span class=\"meta-label\">发布时间</span>\n                  <span class=\"meta-value\">{{ formatDate(resource.createdAt) }}</span>\n                </div>\n                <div class=\"meta-item\">\n                  <i class=\"el-icon-view meta-icon\"></i>\n                  <span class=\"meta-label\">浏览量</span>\n                  <span class=\"meta-value\">{{ resource.viewCount || 0 }}</span>\n                </div>\n              </div>\n            </div>\n            <div class=\"header-right\">\n              <div class=\"provider-info\">\n                <div class=\"provider-avatar\">\n                  {{ (resource.providerName || '服').charAt(0) }}\n                </div>\n                <div class=\"provider-details\">\n                  <h4 class=\"provider-name\">{{ resource.providerName }}</h4>\n                  <p class=\"provider-level\">{{ resource.providerLevel || '认证服务商' }}</p>\n                  <div class=\"provider-stats\">\n                    <span class=\"stat-item\">{{ resource.serviceCount || 0 }}服务</span>\n                    <span class=\"stat-item\">{{ resource.completionRate || 100 }}%完成率</span>\n                    <span class=\"stat-item\">{{ resource.providerRating || 4.8 }}分</span>\n                  </div>\n                  <button class=\"provider-profile-btn\" @click=\"viewProviderProfile\">\n                    <i class=\"el-icon-user\"></i> 查看服务商资料\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 服务详情内容 -->\n      <div class=\"service-content\">\n        <div class=\"content-container\">\n          <div class=\"content-left\">\n            <!-- 服务介绍 -->\n            <el-card class=\"content-card\">\n              <template slot=\"header\">\n                <div class=\"card-header\">\n                  <i class=\"el-icon-document\"></i>\n                  <h3 class=\"card-title\">服务介绍</h3>\n                </div>\n              </template>\n              <div class=\"service-description\" v-html=\"resource.description || '<p>专业服务，助力企业成长</p><p>我们提供高质量的服务，满足您的业务需求</p>'\" />\n            </el-card>\n\n            <!-- 服务详情 -->\n            <el-card class=\"content-card\">\n              <template slot=\"header\">\n                <div class=\"card-header\">\n                  <i class=\"el-icon-s-grid\"></i>\n                  <h3 class=\"card-title\">服务详情</h3>\n                </div>\n              </template>\n              <div class=\"service-details\">\n                <div class=\"detail-item\">\n                  <h4>服务内容</h4>\n                  <div class=\"detail-content\">\n                    <p>{{ resource.serviceContent || '• 提供专业的咨询服务' }}</p>\n                    <p>{{ resource.serviceContent || '• 定制化解决方案' }}</p>\n                    <p>{{ resource.serviceContent || '• 全程跟踪服务质量' }}</p>\n                    <p>{{ resource.serviceContent || '• 提供详细的服务报告' }}</p>\n                  </div>\n                </div>\n                <div class=\"detail-item\">\n                  <h4>服务流程</h4>\n                  <div class=\"process-steps\">\n                    <div class=\"step-item\" v-for=\"(step, index) in serviceProcessSteps\" :key=\"index\">\n                      <div class=\"step-number\">{{ index + 1 }}</div>\n                      <div class=\"step-content\">\n                        <h5>{{ step.title }}</h5>\n                        <p>{{ step.description }}</p>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div class=\"detail-item\">\n                  <h4>交付标准</h4>\n                  <div class=\"delivery-standards\">\n                    <div class=\"standard-item\" v-for=\"(standard, index) in deliveryStandards\" :key=\"index\">\n                      <i class=\"el-icon-check-circle\"></i>\n                      <span>{{ standard }}</span>\n                    </div>\n                  </div>\n                </div>\n                <div class=\"detail-item\">\n                  <h4>服务保障</h4>\n                  <div class=\"guarantee-items\">\n                    <div class=\"guarantee-item\">\n                      <i class=\"el-icon-shield\"></i>\n                      <div>\n                        <h5>质量保证</h5>\n                        <p>服务质量不符合要求可申请退款</p>\n                      </div>\n                    </div>\n                    <div class=\"guarantee-item\">\n                      <i class=\"el-icon-clock\"></i>\n                      <div>\n                        <h5>按时交付</h5>\n                        <p>严格按照约定时间完成服务</p>\n                      </div>\n                    </div>\n                    <div class=\"guarantee-item\">\n                      <i class=\"el-icon-headset\"></i>\n                      <div>\n                        <h5>售后支持</h5>\n                        <p>提供7天售后技术支持</p>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </el-card>\n\n            <!-- 用户评价 -->\n            <el-card class=\"content-card\">\n              <template slot=\"header\">\n                <div class=\"card-header\">\n                  <i class=\"el-icon-s-comment\"></i>\n                  <h3 class=\"card-title\">用户评价</h3>\n                  <span class=\"review-count\">({{ resource.reviewCount || 0 }}条)</span>\n                </div>\n              </template>\n              <div class=\"user-reviews\">\n                <div \n                  v-for=\"(review, index) in resource.reviews || mockReviews\" \n                  :key=\"index\"\n                  class=\"review-item\"\n                >\n                  <div class=\"review-header\">\n                    <div class=\"reviewer-info\">\n                      <div class=\"reviewer-avatar\">{{ review.username.charAt(0) }}</div>\n                      <div class=\"reviewer-details\">\n                        <h5 class=\"reviewer-name\">{{ review.username }}</h5>\n                        <p class=\"review-time\">{{ formatDate(review.createdAt) }}</p>\n                      </div>\n                    </div>\n                    <div class=\"review-rating\">\n                      <i class=\"el-icon-star-on\" v-for=\"i in review.rating\" :key=\"i\"></i>\n                      <i class=\"el-icon-star-off\" v-for=\"i in (5 - review.rating)\" :key=\"i + 5\"></i>\n                    </div>\n                  </div>\n                  <div class=\"review-content\">\n                    {{ review.content }}\n                  </div>\n                  <div class=\"review-tags\" v-if=\"review.tags && review.tags.length\">\n                    <span class=\"review-tag\" v-for=\"(tag, tagIndex) in review.tags\" :key=\"tagIndex\">{{ tag }}</span>\n                  </div>\n                </div>\n                <div v-if=\"!(resource.reviews && resource.reviews.length)\" class=\"no-reviews\">\n                  <i class=\"el-icon-info\"></i>\n                  <p>暂无用户评价</p>\n                  <p class=\"no-reviews-tip\">成为第一个评价此服务的用户吧！</p>\n                </div>\n              </div>\n            </el-card>\n\n            <!-- 常见问题 -->\n            <el-card class=\"content-card\">\n              <template slot=\"header\">\n                <div class=\"card-header\">\n                  <i class=\"el-icon-question\"></i>\n                  <h3 class=\"card-title\">常见问题</h3>\n                </div>\n              </template>\n              <div class=\"faq-section\">\n                <el-collapse>\n                  <el-collapse-item title=\"服务周期是多久？\" name=\"1\">\n                    <div class=\"faq-content\">\n                      服务周期根据具体需求而定，一般为3-15个工作日，具体时间会在服务合同中明确约定。\n                    </div>\n                  </el-collapse-item>\n                  <el-collapse-item title=\"如何保证服务质量？\" name=\"2\">\n                    <div class=\"faq-content\">\n                      我们有严格的服务质量控制流程，每个服务环节都有专业人员负责，确保服务质量符合标准。\n                    </div>\n                  </el-collapse-item>\n                  <el-collapse-item title=\"可以提供发票吗？\" name=\"3\">\n                    <div class=\"faq-content\">\n                      是的，我们可以提供正规增值税发票，您在预约服务时可以注明开票需求。\n                    </div>\n                  </el-collapse-item>\n                  <el-collapse-item title=\"如何修改服务需求？\" name=\"4\">\n                    <div class=\"faq-content\">\n                      在服务开始前，您可以随时联系服务商修改需求；服务开始后，重大需求变更可能会影响服务周期和价格。\n                    </div>\n                  </el-collapse-item>\n                </el-collapse>\n              </div>\n            </el-card>\n          </div>\n\n          <div class=\"content-right\">\n            <!-- 操作按钮 -->\n            <el-card class=\"content-card action-card\">\n              <template slot=\"header\">\n                <div class=\"card-header\">\n                  <i class=\"el-icon-s-operation\"></i>\n                  <h3 class=\"card-title\">服务操作</h3>\n                </div>\n              </template>\n              <div class=\"action-buttons\">\n                <el-button \n                  type=\"primary\" \n                  size=\"large\" \n                  @click=\"toggleFavorite\"\n                  :class=\"{ 'favorited': favorited }\"\n                  class=\"action-btn primary\"\n                >\n                  <i :class=\"favorited ? 'el-icon-star-on' : 'el-icon-star-off'\"></i>\n                  {{ favorited ? '已收藏' : '收藏服务' }}\n                </el-button>\n                <el-button \n                  v-if=\"isEntrepreneur\" \n                  type=\"success\" \n                  size=\"large\" \n                  @click=\"showBook = true\"\n                  class=\"action-btn success\"\n                >\n                  <i class=\"el-icon-s-order\"></i>\n                  预约服务\n                </el-button>\n                <el-button \n                  type=\"info\" \n                  size=\"large\" \n                  @click=\"showContact = true\"\n                  class=\"action-btn info\"\n                >\n                  <i class=\"el-icon-phone\"></i>\n                  联系服务商\n                </el-button>\n              </div>\n              <div class=\"service-tags\">\n                <span class=\"tag-item\" v-for=\"(tag, index) in resource.tags || ['专业服务', '认证保障', '售后支持', '免费咨询']\" :key=\"index\">\n                  {{ tag }}\n                </span>\n              </div>\n              <div class=\"service-highlights\">\n                <h4>服务亮点</h4>\n                <ul>\n                  <li v-for=\"(highlight, index) in serviceHighlights\" :key=\"index\">\n                    <i class=\"el-icon-check\"></i> {{ highlight }}\n                  </li>\n                </ul>\n              </div>\n            </el-card>\n\n            <!-- 服务统计 -->\n            <el-card class=\"content-card stats-card\">\n              <template slot=\"header\">\n                <div class=\"card-header\">\n                  <i class=\"el-icon-data-line\"></i>\n                  <h3 class=\"card-title\">服务数据</h3>\n                </div>\n              </template>\n              <div class=\"service-stats\">\n                <div class=\"stat-row\">\n                  <span class=\"stat-label\">服务次数</span>\n                  <span class=\"stat-value\">{{ resource.serviceCount || 0 }}</span>\n                </div>\n                <div class=\"stat-row\">\n                  <span class=\"stat-label\">好评率</span>\n                  <span class=\"stat-value\">{{ resource好评Rate || 98 }}%</span>\n                </div>\n                <div class=\"stat-row\">\n                  <span class=\"stat-label\">响应速度</span>\n                  <span class=\"stat-value\">{{ resource.responseTime || '1小时内' }}</span>\n                </div>\n                <div class=\"stat-row\">\n                  <span class=\"stat-label\">服务区域</span>\n                  <span class=\"stat-value\">{{ resource.serviceArea || '全国' }}</span>\n                </div>\n              </div>\n            </el-card>\n\n            <!-- 相关服务推荐 -->\n            <el-card class=\"content-card\">\n              <template slot=\"header\">\n                <div class=\"card-header\">\n                  <i class=\"el-icon-s-grid\"></i>\n                  <h3 class=\"card-title\">相关服务</h3>\n                </div>\n              </template>\n              <div class=\"related-services\">\n                <div \n                  v-for=\"(item, index) in relatedServices\" \n                  :key=\"index\"\n                  class=\"related-item\"\n                  @click=\"goService(item.id)\"\n                >\n                  <div class=\"related-header\">\n                    <h5 class=\"related-title\">{{ item.title }}</h5>\n                    <div class=\"related-price\">¥{{ item.price }}</div>\n                  </div>\n                  <div class=\"related-info\">\n                    <span class=\"related-category\">{{ item.category }}</span>\n                    <div class=\"related-rating\">\n                      <i class=\"el-icon-star-on\" v-for=\"i in Math.floor(item.rating || 4)\" :key=\"i\"></i>\n                      <i class=\"el-icon-star-off\" v-for=\"i in (5 - Math.floor(item.rating || 4))\" :key=\"i + 5\"></i>\n                    </div>\n                  </div>\n                  <div class=\"related-provider\">\n                    <span class=\"provider-tag\">服务商：{{ item.providerName }}</span>\n                  </div>\n                </div>\n              </div>\n            </el-card>\n          </div>\n        </div>\n      </div>\n\n      <!-- 预约服务对话框 -->\n      <el-dialog \n        title=\"预约服务\" \n        :visible.sync=\"showBook\" \n        width=\"600px\"\n        custom-class=\"book-dialog\"\n      >\n        <el-form ref=\"bookForm\" :model=\"bookForm\" :rules=\"bookRules\" label-width=\"120px\">\n          <el-form-item label=\"需求说明\" prop=\"description\">\n            <el-input \n              v-model=\"bookForm.description\" \n              type=\"textarea\" \n              rows=\"4\" \n              placeholder=\"请详细描述您的需求\"\n            />\n          </el-form-item>\n          <el-form-item label=\"期望时间\" prop=\"expectTime\">\n            <el-date-picker \n              v-model=\"bookForm.expectTime\" \n              type=\"datetime\" \n              placeholder=\"选择期望服务时间\"\n              style=\"width: 100%\"\n            />\n          </el-form-item>\n          <el-form-item label=\"联系方式\" prop=\"contactInfo\">\n            <el-input \n              v-model=\"bookForm.contactInfo\" \n              placeholder=\"请留下您的联系方式\"\n            />\n          </el-form-item>\n          <el-form-item label=\"服务方式\">\n            <el-radio-group v-model=\"bookForm.serviceMethod\">\n              <el-radio label=\"online\">线上服务</el-radio>\n              <el-radio label=\"offline\">线下服务</el-radio>\n              <el-radio label=\"both\">线上+线下</el-radio>\n            </el-radio-group>\n          </el-form-item>\n        </el-form>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button @click=\"showBook = false\">取消</el-button>\n          <el-button type=\"primary\" @click=\"submitBook\">提交预约</el-button>\n        </span>\n      </el-dialog>\n\n      <!-- 联系服务商对话框 -->\n      <el-dialog \n        title=\"联系服务商\" \n        :visible.sync=\"showContact\" \n        width=\"500px\"\n        custom-class=\"contact-dialog\"\n      >\n        <div class=\"contact-info\">\n          <div class=\"contact-item\">\n            <i class=\"el-icon-phone\"></i>\n            <span class=\"contact-label\">电话：</span>\n            <span class=\"contact-value\">{{ resource.providerPhone || '*******1234' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-message\"></i>\n            <span class=\"contact-label\">邮箱：</span>\n            <span class=\"contact-value\">{{ resource.providerEmail || 'provider@example.com' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-chat-dot-round\"></i>\n            <span class=\"contact-label\">微信：</span>\n            <span class=\"contact-value\">{{ resource.providerWechat || 'service_wx' }}</span>\n          </div>\n          <div class=\"contact-item\">\n            <i class=\"el-icon-map-location\"></i>\n            <span class=\"contact-label\">地址：</span>\n            <span class=\"contact-value\">{{ resource.providerAddress || '北京市朝阳区' }}</span>\n          </div>\n        </div>\n        <div class=\"contact-note\">\n          <i class=\"el-icon-warning-outline\"></i>\n          <p>请在工作时间联系服务商，保持专业礼貌的沟通方式</p>\n        </div>\n        <div class=\"contact-hours\">\n          <i class=\"el-icon-time\"></i>\n          <p>工作时间：周一至周五 9:00-18:00</p>\n        </div>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button type=\"primary\" @click=\"showContact = false\">我知道了</el-button>\n        </span>\n      </el-dialog>\n\n      <!-- 服务商资料对话框 -->\n      <el-dialog \n        title=\"服务商资料\" \n        :visible.sync=\"showProviderDialog\" \n        width=\"700px\"\n        custom-class=\"provider-dialog\"\n      >\n        <div class=\"provider-profile\">\n          <div class=\"provider-header\">\n            <div class=\"provider-avatar large\">\n              {{ (resource.providerName || '服').charAt(0) }}\n            </div>\n            <div class=\"provider-info-detail\">\n              <h3>{{ resource.providerName }}</h3>\n              <p class=\"provider-level\">{{ resource.providerLevel || '认证服务商' }}</p>\n              <div class=\"provider-stats-detail\">\n                <span class=\"stat-item\">{{ resource.serviceCount || 0 }}服务</span>\n                <span class=\"stat-item\">{{ resource.completionRate || 100 }}%完成率</span>\n                <span class=\"stat-item\">{{ resource.providerRating || 4.8 }}分</span>\n                <span class=\"stat-item\">{{ resource.yearsExperience || 3 }}年经验</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"provider-description\">\n            <h4>关于服务商</h4>\n            <p>{{ resource.providerDescription || '专业的服务提供商，致力于为企业提供高质量的服务解决方案。' }}</p>\n          </div>\n          <div class=\"provider-services\">\n            <h4>热门服务</h4>\n            <div class=\"service-list\">\n              <div class=\"service-item\" v-for=\"(service, index) in providerServices\" :key=\"index\">\n                <h5>{{ service.title }}</h5>\n                <p class=\"service-price\">¥{{ service.price }}</p>\n              </div>\n            </div>\n          </div>\n        </div>\n        <span slot=\"footer\" class=\"dialog-footer\">\n          <el-button type=\"primary\" @click=\"showProviderDialog = false\">关闭</el-button>\n        </span>\n      </el-dialog>\n    </template>\n  </div>\n</template>\n\n<script>\nimport { getDetail, toggleFavorite } from '@/api/resource'\nimport { create } from '@/api/order'\nimport { mapGetters } from 'vuex'\nexport default {\n  name: 'ServiceDetail',\n  data() {\n    return { loading: false, resource: null, showBook: false, bookForm: { description: '', expectTime: '' } }\n  },\n  computed: { ...mapGetters('user', ['isEntrepreneur']) },\n  created() { this.load() },\n  methods: {\n    async load() {\n      this.loading = true\n      try {\n        const id = this.$route.params.id\n        this.resource = await getDetail(id)\n      } finally { this.loading = false }\n    },\n    async toggleFavorite() {\n      await toggleFavorite(this.resource.id)\n      this.$message.success('已收藏')\n    },\n    async submitBook() {\n      try {\n        await create({ resourceId: this.resource.id, providerId: this.resource.providerId, amount: this.resource.price, description: this.bookForm.description, expectTime: this.bookForm.expectTime })\n        this.$message.success('预约已提交')\n        this.showBook = false\n      } catch (e) {\n        this.$message.error(e.response?.data?.message || '提交失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.content { margin-top: 16px; line-height: 1.6; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4dA,SAAAA,SAAA,EAAAC,cAAA,IAAAA,eAAA;AACA,SAAAC,MAAA;AACA,SAAAC,UAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MAAAC,OAAA;MAAAC,QAAA;MAAAC,QAAA;MAAAC,QAAA;QAAAC,WAAA;QAAAC,UAAA;MAAA;IAAA;EACA;EACAC,QAAA,EAAAC,aAAA,KAAAV,UAAA;EACAW,OAAA,WAAAA,QAAA;IAAA,KAAAC,IAAA;EAAA;EACAC,OAAA;IACAD,IAAA,WAAAA,KAAA;MAAA,IAAAE,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,EAAA;QAAA,OAAAH,YAAA,GAAAI,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cACAT,KAAA,CAAAX,OAAA;cAAAkB,QAAA,CAAAC,CAAA;cAEAH,EAAA,GAAAL,KAAA,CAAAU,MAAA,CAAAC,MAAA,CAAAN,EAAA;cAAAE,QAAA,CAAAE,CAAA;cAAA,OACA1B,SAAA,CAAAsB,EAAA;YAAA;cAAAL,KAAA,CAAAV,QAAA,GAAAiB,QAAA,CAAAK,CAAA;YAAA;cAAAL,QAAA,CAAAC,CAAA;cACAR,KAAA,CAAAX,OAAA;cAAA,OAAAkB,QAAA,CAAAM,CAAA;YAAA;cAAA,OAAAN,QAAA,CAAAO,CAAA;UAAA;QAAA,GAAAV,OAAA;MAAA;IACA;IACApB,cAAA,WAAAA,eAAA;MAAA,IAAA+B,MAAA;MAAA,OAAAd,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAa,SAAA;QAAA,OAAAd,YAAA,GAAAI,CAAA,WAAAW,SAAA;UAAA,kBAAAA,SAAA,CAAAR,CAAA;YAAA;cAAAQ,SAAA,CAAAR,CAAA;cAAA,OACAzB,eAAA,CAAA+B,MAAA,CAAAzB,QAAA,CAAAe,EAAA;YAAA;cACAU,MAAA,CAAAG,QAAA,CAAAC,OAAA;YAAA;cAAA,OAAAF,SAAA,CAAAH,CAAA;UAAA;QAAA,GAAAE,QAAA;MAAA;IACA;IACAI,UAAA,WAAAA,WAAA;MAAA,IAAAC,MAAA;MAAA,OAAApB,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAmB,SAAA;QAAA,IAAAC,WAAA,EAAAC,EAAA;QAAA,OAAAtB,YAAA,GAAAI,CAAA,WAAAmB,SAAA;UAAA,kBAAAA,SAAA,CAAAjB,CAAA,GAAAiB,SAAA,CAAAhB,CAAA;YAAA;cAAAgB,SAAA,CAAAjB,CAAA;cAAAiB,SAAA,CAAAhB,CAAA;cAAA,OAEAxB,MAAA;gBAAAyC,UAAA,EAAAL