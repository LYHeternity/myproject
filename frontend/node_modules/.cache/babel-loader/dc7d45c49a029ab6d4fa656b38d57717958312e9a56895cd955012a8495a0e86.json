nction (response) {\n        _this3.isFavorited = response;\n      })[\"catch\"](function (error) {\n        console.error('Failed to toggle favorite:', error);\n      });\n    },\n    getArticleImage: function getArticleImage(category) {\n      // 根据文章分类返回对应的图片\n      var images = {\n        '创业资讯': require('@/assets/images/startup-team.jpg'),\n        '投资融资': require('@/assets/images/investment.jpg'),\n        '科技创新': require('@/assets/images/tech-innovation.jpg'),\n        '政策法规': require('@/assets/images/tech-innovation.jpg'),\n        '创业故事': require('@/assets/images/startup-team.jpg')\n      };\n      return images[category] || require('@/assets/images/startup-team.jpg');\n    }\n  }\n};","map":{"version":3,"names":["getArticleById","toggleFavorite","isFavorited","name","data","article","loading","mounted","loadArticle","methods","_this","id","$route","params","console","log","then","response","content","checkFavoriteStatus","error","message","_this2","goBack","$router","push","_this3","getArticleImage","category","images","require"],"sources":["src/views/article/Detail.vue"],"sourcesContent":["<template>\r\n  <div class=\"article-detail\">\r\n    <div class=\"container\">\r\n      <el-button @click=\"goBack\" type=\"text\" class=\"back-button\">\r\n        <i class=\"el-icon-arrow-left\"></i> 返回列表\r\n      </el-button>\r\n      \r\n      <div v-if=\"article\" class=\"article-content\">\r\n        <div class=\"article-header\">\r\n          <h1 class=\"article-title\">{{ article.title }}</h1>\r\n          <div class=\"article-meta\">\r\n            <span class=\"source\">{{ article.source }}</span>\r\n            <span class=\"date\">{{ article.publicationDate }}</span>\r\n            <span class=\"category\">{{ article.category }}</span>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"article-image\">\r\n          <img :src=\"article.imageUrl || getArticleImage(article.category)\" :alt=\"article.title\">\r\n        </div>\r\n        \r\n        <div class=\"article-body\">\r\n          <div v-if=\"article.content\" v-html=\"article.content\"></div>\r\n          <div v-else class=\"no-content\">暂无内容</div>\r\n        </div>\r\n        \r\n        <div class=\"article-footer\">\r\n          <div class=\"footer-left\">\r\n            <span class=\"relevance\">相关度: {{ article.relevanceScore.toFixed(2) }}</span>\r\n          </div>\r\n          <div class=\"footer-right\">\r\n            <el-button type=\"primary\" @click=\"toggleFavorite\">\r\n              <i class=\"el-icon-star\"></i> {{ isFavorited ? '取消收藏' : '收藏' }}\r\n            </el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n      <div v-else class=\"loading\">\r\n        <div class=\"article-content\">\r\n          <div class=\"article-header\">\r\n            <el-skeleton :rows=\"1\" animated style=\"width: 80%; height: 32px; margin-bottom: 20px;\" />\r\n            <div class=\"article-meta\">\r\n              <el-skeleton :rows=\"1\" animated style=\"width: 100px; display: inline-block; margin-right: 15px;\" />\r\n              <el-skeleton :rows=\"1\" animated style=\"width: 120px; display: inline-block; margin-right: 15px;\" />\r\n              <el-skeleton :rows=\"1\" animated style=\"width: 80px; display: inline-block;\" />\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"article-image\">\r\n            <el-skeleton :rows=\"1\" animated style=\"height: 300px;\" />\r\n          </div>\r\n          \r\n          <div style=\"margin-top: 30px;\">\r\n            <el-skeleton :rows=\"8\" animated />\r\n          </div>\r\n          \r\n          <div class=\"article-footer\">\r\n            <div class=\"footer-left\">\r\n              <el-skeleton :rows=\"1\" animated style=\"width: 100px;\" />\r\n            </div>\r\n            <div class=\"footer-right\">\r\n              <el-skeleton :rows=\"1\" animated style=\"width: 100px; height: 36px;\" />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getArticleById, toggleFavorite, isFavorited } from '@/api/article'\r\n\r\nexport default {\r\n  name: 'ArticleDetail',\r\n  data() {\r\n    return {\r\n      article: null,\r\n      isFavorited: false,\r\n      loading: true\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadArticle()\r\n  },\r\n  methods: {\r\n    loadArticle() {\r\n      this.loading = true\r\n      const id = this.$route.params.id\r\n      console.log('Loading article with id:', id)\r\n      getArticleById(id).then(response => {\r\n        console.log('Article response:', response)\r\n        this.article = response\r\n        console.log('Article content:', response.content)\r\n        this.checkFavoriteStatus()\r\n      }).catch(error => {\r\n        console.error('Failed to load article:', error)\r\n        console.error('Error details:', error.message, error.response)\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    checkFavoriteStatus() {\r\n      const id = this.$route.params.id\r\n      isFavorited(id).then(response => {\r\n        this.isFavorited = response\r\n      }).catch(error => {\r\n        console.error('Failed to check favorite status:', error)\r\n      })\r\n    },\r\n    goBack() {\r\n      this.$router.push('/articles')\r\n    },\r\n    toggleFavorite() {\r\n      const id = this.$route.params.id\r\n      toggleFavorite(id).then(response => {\r\n        this.isFavorited = response\r\n      }).catch(error => {\r\n        console.error('Failed to toggle favorite:', error)\r\n      })\r\n    },\r\n    getArticleImage(category) {\r\n      // 根据文章分类返回对应的图片\r\n      const images = {\r\n        '创业资讯': require('@/assets/images/startup-team.jpg'),\r\n        '投资融资': require('@/assets/images/investment.jpg'),\r\n        '科技创新': require('@/assets/images/tech-innovation.jpg'),\r\n        '政策法规': require('@/assets/images/tech-innovation.jpg'),\r\n        '创业故事': require('@/assets/images/startup-team.jpg')\r\n      }\r\n      return images[category] || require('@/assets/images/startup-team.jpg')\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.article-detail {\r\n  min-height: 100vh;\r\n  background-color: #f5f7fa;\r\n  padding: 40px 0;\r\n}\r\n\r\n.container {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  padding: 0 20px;\r\n}\r\n\r\n.back-button {\r\n  margin-bottom: 30px;\r\n  font-size: 16px;\r\n  color: #666;\r\n  transition: color 0.3s ease;\r\n}\r\n\r\n.back-button:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.article-content {\r\n  background: #fff;\r\n  padding: 40px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.article-header {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.article-title {\r\n  font-size: 32px;\r\n  font-weight: 700;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.article-meta {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 20px;\r\n  margin-bottom: 30px;\r\n  padding-bottom: 20px;\r\n  border-bottom: 1px solid #f0f0f0;\r\n  font-size: 14px;\r\n  color: #999;\r\n}\r\n\r\n.article-meta .category {\r\n  background-color: #e6f7ff;\r\n  color: #1890ff;\r\n  padding: 4px 12px;\r\n  border-radius: 16px;\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n  align-self: center;\r\n}\r\n\r\n.article-image {\r\n  width: 100%;\r\n  height: 300px;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  margin-bottom: 30px;\r\n  background-color: #f0f0f0;\r\n}\r\n\r\n.article-image img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.article-body {\r\n  font-size: 16px;\r\n  line-height: 1.8;\r\n  color: #333;\r\n  margin-bottom: 40px;\r\n}\r\n\r\n.article-footer {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding-top: 20px;\r\n  border-top: 1px solid #f0f0f0;\r\n  font-size: 14px;\r\n  color: #999;\r\n}\r\n\r\n.footer-left {\r\n  flex: 1;\r\n}\r\n\r\n.footer-right {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.loading {\r\n  background: #fff;\r\n  padding: 40px;\r\n  border-radius: 12px;\r\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n/* 响应式设计 */\r\n@media (max-width: 768px) {\r\n  .article-detail {\r\n    padding: 20px 0;\r\n  }\r\n  \r\n  .article-content {\r\n    padding: 20px;\r\n  }\r\n  \r\n  .article-title {\r\n    font-size: 24px;\r\n  }\r\n  \r\n  .article-image {\r\n    height: 200px;\r\n  }\r\n  \r\n  .article-meta {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 10px;\r\n  }\r\n  \r\n  .article-footer {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n    gap: 15px;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAwEA,SAAAA,cAAA,EAAAC,cAAA,IAAAA,eAAA,EAAAC,WAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAH,WAAA;MACAI,OAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,WAAA;EACA;EACAC,OAAA;IACAD,WAAA,WAAAA,YAAA;MAAA,IAAAE,KAAA;MACA,KAAAJ,OAAA;MACA,IAAAK,EAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,EAAA;MACAG,OAAA,CAAAC,GAAA,6BAAAJ,EAAA;MACAX,cAAA,CAAAW,EAAA,EAAAK,IAAA,WAAAC,QAAA;QACAH,OAAA,CAAAC,GAAA,sBAAAE,QAAA;QACAP,KAAA,CAAAL,OAAA,GAAAY,QAAA;QACAH,OAAA,CAAAC,GAAA,qBAAAE,QAAA,CAAAC,OAAA;QACAR,KAAA,CAAAS,mBAAA;MACA,sBAAAC,KAAA;QACAN,OAAA,CAAAM,KAAA,4BAAAA,KAAA;QACAN,OAAA,CAAAM,KAAA,mBAAAA,KAAA,CAAAC,OAAA,EAAAD,KAAA,CAAAH,QAAA;MACA;QACAP,KAAA,CAAAJ,OAAA;MACA;IACA;IACAa,mBAAA,WAAAA,oBAAA;MAAA,IAAAG,MAAA;MACA,IAAAX,EAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,EAAA;MACAT,WAAA,CAAAS,EAAA,EAAAK,IAAA,WAAAC,QAAA;QACAK,MAAA,CAAApB,WAAA,GAAAe,QAAA;MACA,sBAAAG,KAAA;QACAN,OAAA,CAAAM,KAAA,qCAAAA,KAAA;MACA;IACA;IACAG,MAAA,WAAAA,OAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAxB,cAAA,WAAAA,eAAA;MAAA,IAAAyB,MAAA;MACA,IAAAf,EAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,EAAA;MACAV,eAAA,CAAAU,EAAA,EAAAK,IAAA,WAAAC,QAAA;QACAS,MAAA,CAAAxB,WAAA,GAAAe,QAAA;MACA,sBAAAG,KAAA;QACAN,OAAA,CAAAM,KAAA,+BAAAA,KAAA;MACA;IACA;IACAO,eA