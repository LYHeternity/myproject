late>\n  <div class=\"home-page\">\n    <!-- 首屏：商务科技风格 -->\n    <section class=\"hero\">\n      <div class=\"hero-bg\"></div>\n      <div class=\"hero-content\">\n        <h1 class=\"hero-title\">创业者综合服务平台</h1>\n        <p class=\"hero-desc\">一站式对接项目、投资与服务资源，助力创业全周期</p>\n        <div class=\"hero-actions\" v-if=\"!isLoggedIn\">\n          <router-link to=\"/register\" class=\"btn-primary\">立即注册</router-link>\n          <router-link to=\"/login\" class=\"btn-outline\">登录</router-link>\n        </div>\n        <div class=\"hero-actions\" v-else>\n          <router-link :to=\"roleEntry\" class=\"btn-primary\">进入工作台</router-link>\n          <router-link to=\"/projects\" class=\"btn-outline\">浏览项目</router-link>\n        </div>\n      </div>\n    </section>\n\n    <!-- 数据概览 -->\n    <section class=\"section overview-section\">\n      <h2 class=\"section-title\">平台数据概览</h2>\n      <el-row :gutter=\"24\" class=\"overview-row\">\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"overview-card\" @click=\"$router.push('/projects')\">\n            <div class=\"overview-icon project\"><i class=\"el-icon-document\"></i></div>\n            <div class=\"overview-num\">{{ overview.projectCount }}</div>\n            <div class=\"overview-label\">在营项目</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"overview-card\" @click=\"$router.push('/services')\">\n            <div class=\"overview-icon service\"><i class=\"el-icon-goods\"></i></div>\n            <div class=\"overview-num\">{{ overview.resourceCount }}</div>\n            <div class=\"overview-label\">服务资源</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"overview-card\">\n            <div class=\"overview-icon user\"><i class=\"el-icon-user-solid\"></i></div>\n            <div class=\"overview-num\">{{ overview.userCount }}</div>\n            <div class=\"overview-label\">注册用户</div>\n          </div>\n        </el-col>\n        <el-col :xs=\"12\" :sm=\"12\" :md=\"6\">\n          <div class=\"overview-card\">\n            <div class=\"overview-icon order\"><i class=\"el-icon-s-order\"></i></div>\n            <div class=\"overview-num\">{{ overview.orderCount }}</div>\n            <div class=\"overview-label\">服务订单</div>\n          </div>\n        </el-col>\n      </el-row>\n    </section>\n\n    <!-- 核心功能入口 -->\n    <section class=\"section\">\n      <h2 class=\"section-title\">核心功能</h2>\n      <el-row :gutter=\"24\" class=\"feature-row\">\n        <el-col :xs=\"24\" :sm=\"12\" :md=\"6\">\n          <div class=\"feature-card\" @click=\"$router.push('/projects')\">\n            <div class=\"feature-icon\"><i class=\"el-icon-document\"></i></div>\n            <h3>项目大厅</h3>\n            <p>浏览、发布与对接创业项目，获取融资与资源</p>\n          </div>\n        </el-col>\n        <el-col :xs=\"24\" :sm=\"12\" :md=\"6\">\n          <div class=\"feature-card\" @click=\"$router.push('/services')\">\n            <div class=\"feature-icon\"><i class=\"el-icon-goods\"></i></div>\n            <h3>服务市场</h3>\n            <p>技术、法律、市场等专业服务预约与对接</p>\n          </div>\n        </el-col>\n        <el-col :xs=\"24\" :sm=\"12\" :md=\"6\">\n          <div class=\"feature-card\" @click=\"$router.push('/my-investments')\">\n            <div class=\"feature-icon\"><i class=\"el-icon-coin\"></i></div>\n            <h3>投资对接</h3>\n            <p>提交意向、在线沟通与投资记录管理</p>\n          </div>\n        </el-col>\n        <el-col :xs=\"24\" :sm=\"12\" :md=\"6\">\n          <div class=\"feature-card\" @click=\"$router.push('/messages')\">\n            <div class=\"feature-icon\"><i class=\"el-icon-message\"></i></div>\n            <h3>消息中心</h3>\n            <p>系统通知、业务消息与在线沟通</p>\n          </div>\n        </el-col>\n      </el-row>\n    </section>\n\n    <!-- 系统简介 -->\n    <section class=\"section intro-section\">\n      <h2 class=\"section-title\">关于平台</h2>\n      <div class=\"intro-card\">\n        <p>创业者综合服务平台面向<strong>创业者、投资人、服务商</strong>三类角色，提供项目展示、融资对接、服务预约、消息通知等一站式能力。平台采用前后端分离架构，支持多角色权限与内容审核，无第三方支付与短信依赖，可在本地完成全流程闭环。</p>\n        <p>支持项目与服务的发布与审核、投资意向提交与沟通、服务订单与评价、管理员数据统计与系统配置等核心能力。</p>\n      </div>\n    </section>\n  </div>\n</template>\n\n<script>\nimport { mapState, mapGetters } from 'vuex'\nimport request from '@/utils/request'\nexport default {\n  name: 'Home',\n  data() {\n    return {\n      overview: {\n        userCount: 0,\n        projectCount: 0,\n        resourceCount: 0,\n        orderCount: 0\n      }\n    }\n  },\n  computed: {\n    ...mapGetters('user', ['isLoggedIn']),\n    ...mapState('user', ['role']),\n    roleEntry() {\n      if (this.role === 'admin') return '/admin'\n      if (this.role === 'entrepreneur') return '/entrepreneur'\n      if (this.role === 'investor') return '/investor'\n      if (this.role === 'provider') return '/provider'\n      return '/home'\n    }\n  },\n  created() {\n    this.loadOverview()\n  },\n  methods: {\n    async loadOverview() {\n      try {\n        const res = await request({ url: '/stats/overview', method: 'get' })\n        if (res && typeof res === 'object') {\n          this.overview.userCount = res.userCount ?? 0\n          this.overview.projectCount = res.projectCount ?? 0\n          this.overview.resourceCount = res.resourceCount ?? 0\n          this.overview.orderCount = res.orderCount ?? 0\n        }\n      } catch (_) {\n        this.overview = { userCount: 128, projectCount: 56, resourceCount: 34, orderCount: 89 }\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.home-page { max-width: 1200px; margin: 0 auto; padding-bottom: 48px; }\n.hero {\n  position: relative;\n  border-radius: 16px;\n  overflow: hidden;\n  margin-bottom: 32px;\n  min-height: 280px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.hero-bg {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 40%, #334155 100%);\n  opacity: .97;\n}\n.hero-content { position: relative; z-index: 1; text-align: center; padding: 48px 24px; }\n.hero-title {\n  font-size: 32px;\n  font-weight: 700;\n  color: #fff;\n  margin-bottom: 16px;\n  letter-spacing: 1px;\n}\n.hero-desc {\n  font-size: 16px;\n  color: rgba(255,255,255,.8);\n  margin-bottom: 32px;\n  max-width: 520px;\n  margin-left: auto;\n  margin-right: auto;\n}\n.hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }\n.btn-primary {\n  display: inline-block;\n  padding: 12px 28px;\n  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);\n  color: #fff;\n  border-radius: 10px;\n  font-weight: 600;\n  text-decoration: none;\n  transition: transform .2s, box-shadow .2s;\n  box-shadow: 0 4px 14px rgba(59,130,246,.4);\n}\n.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59,130,246,.5); color: #fff; }\n.btn-outline {\n  display: inline-block;\n  padding: 12px 28px;\n  border: 2px solid rgba(255,255,255,.5);\n  color: #fff;\n  border-radius: 10px;\n  font-weight: 600;\n  text-decoration: none;\n  transition: all .2s;\n}\n.btn-outline:hover { background: rgba(255,255,255,.1); border-color: #fff; color: #fff; }\n\n.section { margin-bottom: 40px; }\n.section-title {\n  font-size: 20px;\n  font-weight: 600;\n  color: #0f172a;\n  margin-bottom: 24px;\n  padding-bottom: 10px;\n  border-bottom: 2px solid #e2e8f0;\n}\n.overview-row { margin-bottom: 0; }\n.overview-card {\n  background: #fff;\n  border-radius: 12px;\n  padding: 24px;\n  text-align: center;\n  box-shadow: 0 4px 20px rgba(0,0,0,.06);\n  border: 1px solid #e2e8f0;\n  cursor: pointer;\n  transition: transform .25s ease, box-shadow .25s ease;\n  margin-bottom: 20px;\n}\n.overview-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 12px 32px rgba(0,0,0,.1);\n}\n.overview-icon {\n  width: 56px;\n  height: 56px;\n  border-radius: 14px;\n  margin: 0 auto 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 26px;\n  color: #fff;\n}\n.overview-icon.project { background: linear-gradient(135deg, #3b82f6, #2563eb); }\n.overview-icon.service { background: linear-gradient(135deg, #10b981, #059669); }\n.overview-icon.user { background: linear-gradient(135deg, #8b5cf6, #7c3aed); }\n.overview-icon.order { background: linear-gradient(135deg, #f59e0b, #d97706); }\n.overview-num { font-size: 28px; font-weight: 700; color: #0f172a; margin-bottom: 4px; }\n.overview-label { font-size: 13px; color: #64748b; }\n\n.feature-row { margin-bottom: 0; }\n.feature-card {\n  background: #fff;\n  border-radius: 12px;\n  padding: 28px;\n  border: 1px solid #e2e8f0;\n  box-shadow: 0 4px 20px rgba(0,0,0,.06);\n  cursor: pointer;\n  transition: transform .25s ease, box-shadow .25s ease, border-color .25s;\n  margin-bottom: 20px;\n  height: 100%;\n}\n.feature-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 12px 32px rgba(0,0,0,.1);\n  border-color: rgba(59,130,246,.2);\n}\n.feature-icon {\n  width: 52px;\n  height: 52px;\n  border-radius: 12px;\n  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);\n  color: #2563eb;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 24px;\n  margin-bottom: 16px;\n}\n.feature-card h3 { font-size: 17px; font-weight: 600; color: #0f172a; margin-bottom: 8px; }\n.feature-card p { font-size: 13px; color: #64748b; line-height: 1.5; }\n\n.intro-section .intro-card {\n  background: #fff;\n  border-radius: 12px;\n  padding: 28px;\n  border: 1px solid #e2e8f0;\n  box-shadow: 0 4px 20px rgba(0,0,0,.06);\n}\n.intro-card p { color: #475569; line-height: 1.8; margin-bottom: 12px; }\n.intro-card p:last-child { margin-bottom: 0; }\n.intro-card strong { color: #0f172a; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqGA,SAAAA,QAAA,EAAAC,UAAA;AACA,OAAAC,OAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,QAAA;QACAC,SAAA;QACAC,YAAA;QACAC,aAAA;