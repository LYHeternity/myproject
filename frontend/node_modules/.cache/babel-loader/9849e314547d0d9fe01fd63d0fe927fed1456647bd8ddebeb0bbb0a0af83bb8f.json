{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.object.to-string.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { postAPI } from '@/api/community';\nexport default {\n  name: 'CommunityManage',\n  data: function data() {\n    return {\n      posts: [],\n      loading: false,\n      currentPage: 1,\n      pageSize: 10,\n      total: 0,\n      searchKeyword: '',\n      searchCategory: '',\n      searchType: ''\n    };\n  },\n  mounted: function mounted() {\n    this.loadPosts();\n  },\n  methods: {\n    loadPosts: function loadPosts() {\n      var _this = this;\n      this.loading = true;\n      postAPI.getPostList({\n        page: this.currentPage,\n        size: this.pageSize,\n        category: this.searchCategory,\n        type: this.searchType,\n        keyword: this.searchKeyword\n      }).then(function (res) {\n        if (res.data && res.data.records) {\n          _this.posts = res.data.records;\n          _this.total = res.data.total || 0;\n        } else {\n          _this.posts = [];\n          _this.total = 0;\n        }\n      })[\"catch\"](function (err) {\n        console.error('加载帖子失败:', err);\n        _this.$message.error('加载帖子失败');\n      })[\"finally\"](function () {\n        _this.loading = false;\n      });\n    },\n    handleSizeChange: function handleSizeChange(size) {\n      this.pageSize = size;\n      this.loadPosts();\n    },\n    handleCurrentChange: function handleCurrentChange(current) {\n      this.currentPage = current;\n      this.loadPosts();\n    },\n    refreshList: function refreshList() {\n      this.loadPosts();\n    },\n    editPost: function editPost(id) {\n      this.$router.push(\"/community/edit/\".concat(id));\n    },\n    deletePost: function deletePost(id) {\n      var _this2 = this;\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(function () {\n        postAPI.deletePost(id).then(function (res) {\n          if (res.code === 200) {\n            _this2.$message.success('删除成功');\n            _this2.loadPosts();\n          } else {\n            _this2.$message.error(res.message || '删除失败');\n          }\n        })[\"catch\"](function (err) {\n          console.error('删除帖子失败:', err);\n          _this2.$message.error('删除失败，请稍后重试');\n        });\n      })[\"catch\"](function () {\n        // 取消删除\n      });\n    },\n    toggleStatus: function toggleStatus(post) {\n      var _this3 = this;\n      var newStatus = post.status === 1 ? 0 : 1;\n      // 这里需要调用更新帖子状态的API\n      // 暂时使用模拟实现\n      postAPI.updatePost(post.id, {\n        status: newStatus\n      }).then(function (res) {\n        if (res.code === 200) {\n          post.status = newStatus;\n          _this3.$message.success('状态更新成功');\n        } else {\n          _this3.$message.error(res.message || '状态更新失败');\n        }\n      })[\"catch\"](function (err) {\n        console.error('更新状态失败:', err);\n        _this3.$message.error('状态更新失败，请稍后重试');\n      });\n    }\n  }\n};","map":{"version":3,"names":["postAPI","name","data","posts","loading","currentPage","pageSize","total","searchKeyword","searchCategory","searchType","mounted","loadPosts","methods","_this","getPostList","page","size","category","type","keyword","then","res","records","err","console","error","$message","handleSizeChange","handleCurrentChange","current","refreshList","editPost","id","$router","push","concat","deletePost","_this2","$confirm","confirmButtonText","cancelButtonText","code","success","message","toggleStatus","post","_this3","newStatus","status","updatePost"],"sources":["src/views/admin/CommunityManage.vue"],"sourcesContent":["<template>\r\n  <div class=\"admin-page\">\r\n    <div class=\"page-header-section\">\r\n      <div class=\"page-header-content\">\r\n        <h1 class=\"page-title\">社区管理</h1>\r\n        <p class=\"page-subtitle\">管理社区帖子，包括编辑、删除和状态管理</p>\r\n      </div>\r\n      <div class=\"page-header-actions\">\r\n        <el-button type=\"primary\" icon=\"el-icon-refresh\" @click=\"loadPosts\" class=\"primary-action-button\">\r\n          刷新数据\r\n        </el-button>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"project-management-section\">\r\n      <div class=\"section-header\">\r\n        <h2 class=\"section-title\">帖子列表</h2>\r\n        <div class=\"section-actions\">\r\n          <el-button type=\"primary\" icon=\"el-icon-download\" @click=\"doExport\" class=\"action-button\">\r\n            导出帖子\r\n          </el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 搜索筛选区域 -->\r\n      <div class=\"search-filter-section\">\r\n        <el-form inline class=\"search-form\">\r\n          <el-form-item label=\"关键词\">\r\n            <el-input v-model=\"searchKeyword\" placeholder=\"标题/内容\" clearable class=\"search-input\" />\r\n          </el-form-item>\r\n          <el-form-item label=\"分类\">\r\n            <el-select v-model=\"searchCategory\" clearable placeholder=\"全部\" class=\"filter-select\">\r\n              <el-option label=\"全部\" value=\"\"></el-option>\r\n              <el-option label=\"创业经验\" value=\"创业经验\" />\r\n              <el-option label=\"融资技巧\" value=\"融资技巧\" />\r\n              <el-option label=\"技术分享\" value=\"技术分享\" />\r\n              <el-option label=\"行业动态\" value=\"行业动态\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item label=\"类型\">\r\n            <el-select v-model=\"searchType\" clearable placeholder=\"全部\" class=\"filter-select\">\r\n              <el-option label=\"全部\" value=\"\"></el-option>\r\n              <el-option label=\"文章\" value=\"article\" />\r\n              <el-option label=\"问题\" value=\"question\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item label=\"状态\">\r\n            <el-select v-model=\"searchStatus\" clearable placeholder=\"全部\" class=\"filter-select\">\r\n              <el-option label=\"全部\" value=\"\"></el-option>\r\n              <el-option label=\"正常\" value=\"1\" />\r\n              <el-option label=\"禁用\" value=\"0\" />\r\n            </el-select>\r\n          </el-form-item>\r\n          <el-form-item>\r\n            <el-button type=\"primary\" @click=\"loadPosts\" class=\"search-button\">\r\n              <i class=\"el-icon-search\"></i> 查询\r\n            </el-button>\r\n            <el-button @click=\"resetFilters\" class=\"reset-button\">\r\n              <i class=\"el-icon-refresh\"></i> 重置\r\n            </el-button>\r\n          </el-form-item>\r\n        </el-form>\r\n      </div>\r\n\r\n      <!-- 帖子表格 -->\r\n      <div class=\"table-container\">\r\n        <el-table\r\n          v-loading=\"loading\"\r\n          :data=\"posts\"\r\n          style=\"width: 100%\"\r\n          class=\"project-table\"\r\n          stripe\r\n          :cell-style=\"{ backgroundColor: '#1e293b', color: '#f8fafc', borderBottom: '1px solid rgba(255, 255, 255, 0.08)' }\"\r\n          :header-cell-style=\"{ backgroundColor: '#334155', color: '#94a3b8', borderBottom: '1px solid rgba(255, 255, 255, 0.08)' }\"\r\n        >\r\n          <el-table-column prop=\"id\" label=\"ID\" width=\"80\" />\r\n          <el-table-column prop=\"title\" label=\"标题\" min-width=\"200\">\r\n            <template slot-scope=\"scope\">\r\n              <div class=\"project-title\">\r\n                <a :href=\"`/community/post/${scope.row.id}`\" target=\"_blank\" class=\"title-link\">{{ scope.row.title }}</a>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"type\" label=\"类型\" width=\"100\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag :class=\"getTypeTagClass(scope.row.type)\" effect=\"light\">\r\n                {{ scope.row.type === 'article' ? '文章' : '问题' }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"category\" label=\"分类\" width=\"120\" />\r\n          <el-table-column prop=\"userId\" label=\"作者ID\" width=\"80\" />\r\n          <el-table-column prop=\"viewCount\" label=\"浏览\" width=\"80\" />\r\n          <el-table-column prop=\"likeCount\" label=\"点赞\" width=\"80\" />\r\n          <el-table-column prop=\"commentCount\" label=\"评论\" width=\"80\" />\r\n          <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\r\n            <template slot-scope=\"scope\">\r\n              <el-tag :class=\"getStatusTagClass(scope.row.status)\" effect=\"light\">\r\n                {{ scope.row.status === 1 ? '正常' : '禁用' }}\r\n              </el-tag>\r\n            </template>\r\n          </el-table-column>\r\n          <el-table-column prop=\"createdAt\" label=\"创建时间\" width=\"180\" />\r\n          <el-table-column label=\"操作\" min-width=\"300\" align=\"right\">\r\n            <template slot-scope=\"scope\">\r\n              <div class=\"project-actions\">\r\n                <el-button type=\"primary\" size=\"small\" @click=\"editPost(scope.row.id)\" class=\"action-button primary\">\r\n                  <i class=\"el-icon-view\"></i> 查看\r\n                </el-button>\r\n                <el-button type=\"info\" size=\"small\" @click=\"editPost(scope.row.id)\" class=\"action-button\">\r\n                  <i class=\"el-icon-edit\"></i> 编辑\r\n                </el-button>\r\n                <el-button \r\n                  :type=\"scope.row.status === 1 ? 'danger' : 'success'\" \r\n                  size=\"small\" \r\n                  @click=\"toggleStatus(scope.row)\"\r\n                  class=\"action-button\"\r\n                >\r\n                  <i :class=\"scope.row.status === 1 ? 'el-icon-close' : 'el-icon-check'\">\r\n                  </i> {{ scope.row.status === 1 ? '禁用' : '启用' }}\r\n                </el-button>\r\n                <el-button type=\"danger\" size=\"small\" @click=\"deletePost(scope.row.id)\" class=\"action-button\">\r\n                  <i class=\"el-icon-delete\"></i> 删除\r\n                </el-button>\r\n              </div>\r\n            </template>\r\n          </el-table-column>\r\n        </el-table>\r\n\r\n        <!-- 空数据状态 -->\r\n        <div v-if=\"!loading && !posts.length\" class=\"empty-state\">\r\n          <div class=\"empty-icon-container\">\r\n            <i class=\"el-icon-document\"></i>\r\n          </div>\r\n          <h3 class=\"empty-title\">暂无帖子数据</h3>\r\n          <p class=\"empty-description\">当前筛选条件下没有找到帖子信息</p>\r\n          <el-button type=\"primary\" @click=\"resetFilters\" class=\"empty-action-button\">\r\n            重置筛选条件\r\n          </el-button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 分页控件 -->\r\n      <div class=\"pagination-section\" v-if=\"total > 0\">\r\n        <div class=\"pagination-info\">\r\n          共 {{ total }} 条记录，当前第 {{ currentPage }} 页\r\n        </div>\r\n        <el-pagination\r\n          @size-change=\"handleSizeChange\"\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"currentPage\"\r\n          :page-sizes=\"[10, 20, 50, 100]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          :total=\"total\"\r\n          class=\"pagination-controls\"\r\n        />\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { postAPI } from '@/api/community'\r\n\r\nexport default {\r\n  name: 'CommunityManage',\r\n  data() {\r\n    return {\r\n      posts: [],\r\n      loading: false,\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      total: 0,\r\n      searchKeyword: '',\r\n      searchCategory: '',\r\n      searchType: ''\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadPosts()\r\n  },\r\n  methods: {\r\n    loadPosts() {\r\n      this.loading = true\r\n      postAPI.getPostList({\r\n        page: this.currentPage,\r\n        size: this.pageSize,\r\n        category: this.searchCategory,\r\n        type: this.searchType,\r\n        keyword: this.searchKeyword\r\n      }).then(res => {\r\n        if (res.data && res.data.records) {\r\n          this.posts = res.data.records\r\n          this.total = res.data.total || 0\r\n        } else {\r\n          this.posts = []\r\n          this.total = 0\r\n        }\r\n      }).catch(err => {\r\n        console.error('加载帖子失败:', err)\r\n        this.$message.error('加载帖子失败')\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    handleSizeChange(size) {\r\n      this.pageSize = size\r\n      this.loadPosts()\r\n    },\r\n    handleCurrentChange(current) {\r\n      this.currentPage = current\r\n      this.loadPosts()\r\n    },\r\n    refreshList() {\r\n      this.loadPosts()\r\n    },\r\n    editPost(id) {\r\n      this.$router.push(`/community/edit/${id}`)\r\n    },\r\n    deletePost(id) {\r\n      this.$confirm('确定要删除这篇帖子吗？', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        postAPI.deletePost(id).then(res => {\r\n          if (res.code === 200) {\r\n            this.$message.success('删除成功')\r\n            this.loadPosts()\r\n          } else {\r\n            this.$message.error(res.message || '删除失败')\r\n          }\r\n        }).catch(err => {\r\n          console.error('删除帖子失败:', err)\r\n          this.$message.error('删除失败，请稍后重试')\r\n        })\r\n      }).catch(() => {\r\n        // 取消删除\r\n      })\r\n    },\r\n    toggleStatus(post) {\r\n      const newStatus = post.status === 1 ? 0 : 1\r\n      // 这里需要调用更新帖子状态的API\r\n      // 暂时使用模拟实现\r\n      postAPI.updatePost(post.id, { status: newStatus }).then(res => {\r\n        if (res.code === 200) {\r\n          post.status = newStatus\r\n          this.$message.success('状态更新成功')\r\n        } else {\r\n          this.$message.error(res.message || '状态更新失败')\r\n        }\r\n      }).catch(err => {\r\n        console.error('更新状态失败:', err)\r\n        this.$message.error('状态更新失败，请稍后重试')\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.community-manage {\r\n  padding: var(--space-4);\r\n  min-height: calc(100vh - 100px);\r\n  background: var(--bg-primary);\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.page-container {\r\n  background: var(--bg-secondary);\r\n  border-radius: var(--radius-xl);\r\n  padding: var(--space-5);\r\n  box-shadow: var(--shadow-md);\r\n  border: 1px solid var(--border-light);\r\n  position: relative;\r\n  z-index: 2;\r\n}\r\n\r\n.page-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  margin-bottom: var(--space-5);\r\n  padding-bottom: var(--space-3);\r\n  border-bottom: 1px solid var(--border-light);\r\n}\r\n\r\n.page-title {\r\n  font-size: var(--font-xl);\r\n  font-weight: var(--font-bold);\r\n  color: var(--text-primary);\r\n  margin: 0;\r\n}\r\n\r\n.filter-bar {\r\n  display: flex;\r\n  gap: var(--space-3);\r\n  margin-bottom: var(--space-5);\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.search-input {\r\n  flex: 1;\r\n  max-width: 400px;\r\n  min-width: 200px;\r\n}\r\n\r\n.filter-select {\r\n  width: 160px;\r\n  min-width: 120px;\r\n}\r\n\r\n.post-list {\r\n  margin-bottom: var(--space-5);\r\n  position: relative;\r\n  z-index: 3;\r\n}\r\n\r\n.pagination {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  margin-top: var(--space-4);\r\n}\r\n\r\n.post-title-link {\r\n  color: #93c5fd;\r\n  text-decoration: none;\r\n  transition: color var(--transition-fast);\r\n}\r\n\r\n.post-title-link:hover {\r\n  color: var(--primary-color);\r\n  text-decoration: underline;\r\n}\r\n\r\n/* 操作按钮容器 */\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n}\r\n\r\n/* 表格样式 - 使用更具体的选择器覆盖全局样式 */\r\n.community-manage.dark-theme :deep(.el-table) {\r\n  background-color: var(--bg-secondary) !important;\r\n  border-color: var(--border-light) !important;\r\n  position: relative;\r\n  z-index: 4;\r\n  border-radius: var(--radius-md) !important;\r\n  overflow: hidden !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table th) {\r\n  background-color: var(--bg-primary) !important;\r\n  color: var(--text-muted) !important;\r\n  border-color: var(--border-light) !important;\r\n  font-weight: var(--font-medium) !important;\r\n  font-size: var(--font-sm) !important;\r\n  padding: 12px 12px !important;\r\n  letter-spacing: normal !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table tr) {\r\n  background-color: var(--bg-secondary) !important;\r\n  position: relative;\r\n  z-index: 5;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table tr:hover) {\r\n  background-color: rgba(59, 130, 246, 0.1) !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table td) {\r\n  color: var(--text-secondary) !important;\r\n  border-color: var(--border-light) !important;\r\n  font-size: var(--font-sm) !important;\r\n  padding: 8px 12px !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table__empty-text) {\r\n  color: var(--text-disabled) !important;\r\n}\r\n\r\n/* 确保表格单元格内容正确显示 */\r\n.community-manage.dark-theme :deep(.el-table__cell) {\r\n  background-color: transparent !important;\r\n  color: var(--text-secondary) !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table__row) {\r\n  background-color: var(--bg-secondary) !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table__row:hover) {\r\n  background-color: rgba(59, 130, 246, 0.1) !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table--striped .el-table__row--striped) {\r\n  background-color: rgba(255, 255, 255, 0.02) !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-table--striped .el-table__row--striped:hover) {\r\n  background-color: rgba(59, 130, 246, 0.1) !important;\r\n}\r\n\r\n/* 输入框样式 - 使用更具体的选择器覆盖全局样式 */\r\n.community-manage.dark-theme :deep(.el-input) {\r\n  position: relative;\r\n  z-index: 6;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-input__inner) {\r\n  background-color: var(--bg-primary) !important;\r\n  border-color: var(--border-medium) !important;\r\n  color: var(--text-primary) !important;\r\n  border-radius: var(--radius-md) !important;\r\n  font-size: var(--font-sm) !important;\r\n  height: 32px !important;\r\n  padding: 0 12px !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-input__inner:focus) {\r\n  border-color: var(--primary-color) !important;\r\n  box-shadow: 0 0 0 2px var(--primary-glow) !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-input__append) {\r\n  background-color: var(--bg-primary) !important;\r\n  border-color: var(--border-medium) !important;\r\n  border-left: 0 !important;\r\n  border-radius: 0 var(--radius-md) var(--radius-md) 0 !important;\r\n}\r\n\r\n/* 选择框样式 - 使用更具体的选择器覆盖全局样式 */\r\n.community-manage.dark-theme :deep(.el-select) {\r\n  position: relative;\r\n  z-index: 7;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-select .el-input__inner) {\r\n  background-color: var(--bg-primary) !important;\r\n  border-color: var(--border-medium) !important;\r\n  color: var(--text-primary) !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-select__input) {\r\n  color: var(--text-primary) !important;\r\n}\r\n\r\n.community-manage.dark-theme :deep(.el-select__caret) {\r\n  color: var(--text-muted) !impor