   title: '市场测试',\n        description: '进行小规模市场测试，收集用户反馈',\n        date: '2024-05-10'\n      }, {\n        title: '融资准备',\n        description: '完成商业计划书和融资材料准备',\n        date: '2024-07-01'\n      }],\n      teamMembers: [],\n      relatedProjects: []\n    };\n  },\n  computed: _objectSpread({}, mapGetters('user', ['isInvestor'])),\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    load: function load() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var id, response, _response, _t, _t2, _t3;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              id = _this.$route.params.id;\n              _context.n = 2;\n              return getDetail(id);\n            case 2:\n              _this.project = _context.v;\n              _context.p = 3;\n              _context.n = 4;\n              return isFavorited(id);\n            case 4:\n              _this.favorited = _context.v;\n              _context.n = 6;\n              break;\n            case 5:\n              _context.p = 5;\n              _t = _context.v;\n            case 6:\n              _context.p = 6;\n              _context.n = 7;\n              return _this.$http.get(\"/project/\".concat(id, \"/related\"));\n            case 7:\n              response = _context.v;\n              _this.relatedProjects = response.data.data;\n              _context.n = 9;\n              break;\n            case 8:\n              _context.p = 8;\n              _t2 = _context.v;\n            case 9:\n              _context.p = 9;\n              _context.n = 10;\n              return _this.$http.get(\"/project/\".concat(id, \"/team\"));\n            case 10:\n              _response = _context.v;\n              _this.teamMembers = _response.data.data;\n              _context.n = 1