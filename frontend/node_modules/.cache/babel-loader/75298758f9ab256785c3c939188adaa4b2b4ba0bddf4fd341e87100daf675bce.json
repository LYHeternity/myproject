\n                _this4.showOrder = false;\n                _context4.n = 4;\n                break;\n              case 3:\n                _context4.p = 3;\n                _t5 = _context4.v;\n                _this4.$message.error(((_e$response2 = _t5.response) === null || _e$response2 === void 0 || (_e$response2 = _e$response2.data) === null || _e$response2 === void 0 ? void 0 : _e$response2.message) || '提交失败');\n              case 4:\n                return _context4.a(2);\n            }\n          }, _callee4, null, [[1, 3]]);\n        }));\n        return function (_x2) {\n          return _ref2.apply(this, arguments);\n        };\n      }());\n    },\n    getStatusText: function getStatusText(status) {\n      var statusMap = {\n        'draft': '草稿',\n        'pending': '审核中',\n        'published': '已发布',\n        'rejected': '已拒绝',\n        'closed': '已关闭'\n      };\n      return statusMap[status] || '未知状态';\n    },\n    formatDate: function formatDate(dateString) {\n      if (!dateString) return '未知时间';\n      var date = new Date(dateString);\n      return date.toLocaleDateString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit'\n      });\n    },\n    goToProject: function goToProject(id) {\n      this.$router.push(\"/project/\".concat(id));\n    },\n    getImageUrl: function getImageUrl(imageName) {\n      if (!imageName) return '';\n      // 检查是否是完整URL\n      if (imageName.startsWith('http://') || imageName.startsWith('https://')) {\n        return imageName;\n      }\n      // 检查是否是已知的占位图片\n      var placeholderImages = ['1.png', '2.png', '3.png'];\n      if (!placeholderImages.includes(imageName)) {\n        // 如果不是已知的占位图片，返回默认占位图片\n        return \"/images/1.png\";\n      }\n      // 否则返回本地图片路径\n      return \"/images/\".concat(imageName);\n    }\n  }\n};","map":{"version":3,"names":["getDetail","toggleFavorite","isFavorited","submit","create","mapGetters","ChatDialog","name","components","data","loading","projec