{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'AdminBackup',\n  data: function data() {\n    return {\n      backupList: []\n    };\n  }\n};","map":{"version":3,"names":["name","data","backupList"],"sources":["src/views/admin/Backup.vue"],"sourcesContent":["<template>\n  <div class=\"page-card\">\n    <h3>数据备份与恢复</h3>\n    <p class=\"section-desc\">对平台数据进行备份或从备份恢复，建议定期备份。</p>\n    <el-row :gutter=\"24\">\n      <el-col :span=\"12\">\n        <div class=\"backup-card\">\n          <i class=\"el-icon-download backup-icon\"></i>\n          <h4>备份数据</h4>\n          <p>将当前数据库导出为备份文件，可下载到本地保存。</p>\n          <el-button type=\"primary\" icon=\"el-icon-download\">立即备份</el-button>\n        </div>\n      </el-col>\n      <el-col :span=\"12\">\n        <div class=\"backup-card\">\n          <i class=\"el-icon-upload2 backup-icon\"></i>\n          <h4>恢复数据</h4>\n          <p>从已保存的备份文件中恢复数据，请谨慎操作。</p>\n          <el-button type=\"warning\" icon=\"el-icon-upload2\">选择文件恢复</el-button>\n        </div>\n      </el-col>\n    </el-row>\n    <div class=\"page-card\" style=\"margin-top:24px\">\n      <h3>备份记录</h3>\n      <el-table :data=\"backupList\" border stripe>\n        <el-table-column prop=\"name\" label=\"备份名称\" width=\"200\" />\n        <el-table-column prop=\"time\" label=\"备份时间\" width=\"180\" />\n        <el-table-column prop=\"size\" label=\"大小\" width=\"100\" />\n        <el-table-column label=\"操作\">\n          <template slot-scope=\"scope\">\n            <el-button type=\"text\" size=\"small\">下载</el-button>\n            <el-button type=\"text\" size=\"small\">恢复</el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n      <div class=\"data-empty\" v-if=\"!backupList.length\">\n        <div class=\"empty-icon\"><i class=\"el-icon-folder-opened\"></i></div>\n        暂无备份记录\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'AdminBackup',\n  data() {\n    return {\n      backupList: []\n    }\n  }\n}\n</script>\n\n<style scoped>\n.section-desc { color: #64748b; font-size: 14px; margin-bottom: 24px; }\n.backup-card {\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 12px;\n  padding: 28px;\n  text-align: center;\n}\n.backup-icon { font-size: 48px; color: #3b82f6; margin-bottom: 16px; }\n.backup-card h4 { font-size: 16px; margin-bottom: 8px; color: #0f172a; }\n.backup-card p { font-size: 13px; color: #64748b; margin-bottom: 20px; line-height: 1.5; }\n</style>\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4CA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}