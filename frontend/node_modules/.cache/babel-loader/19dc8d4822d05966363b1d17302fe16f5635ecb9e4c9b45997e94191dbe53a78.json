{"ast":null,"code":"import \"core-js/modules/es.array.find.js\";\nimport \"core-js/modules/es.array.for-each.js\";\nimport \"core-js/modules/es.array.is-array.js\";\nimport \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.array.slice.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.object.to-string.js\";\nimport \"core-js/modules/web.dom-collections.for-each.js\";\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { getArticles, searchArticles, toggleFavorite, isFavorited } from '@/api/article';\nexport default {\n  name: 'ArticleList',\n  data: function data() {\n    return {\n      articles: [],\n      total: 0,\n      currentPage: 1,\n      pageSize: 10,\n      selectedCategory: '',\n      searchKeyword: '',\n      isSearching: false,\n      loading: false,\n      sortBy: 'latest'\n    };\n  },\n  computed: {\n    featuredArticle: function featuredArticle() {\n      // 返回第一篇文章作为特色文章\n      return this.articles.length > 0 ? this.articles[0] : null;\n    },\n    displayArticles: function displayArticles() {\n      // 显示除了特色文章之外的文章\n      return this.articles.length > 0 ? this.articles.slice(1) : [];\n    }\n  },\n  mounted: function mounted() {\n    this.isSearching = false;\n    this.loadArticles();\n\n    // 监听新文章通知\n    window.addEventListener('newArticles', this.handleNewArticles);\n  },\n  beforeDestroy: function beforeDestroy() {\n    // 移除事件监听器\n    window.removeEventListener('newArticles', this.handleNewArticles);\n  },\n  methods: {\n    loadArticles: function loadArticles() {\n      var _this = this;\n      this.loading = true;\n      var params = {\n        category: this.selectedCategory || undefined,\n        page: this.currentPage,\n        size: this.pageSize,\n        sortBy: this.sortBy\n      };\n      getArticles(params).then(function (response) {\n        // 处理后端返回的响应\n        if (response && response.records) {\n          // 响应是PageResult对象（被响应拦截器提取过）\n          _this.articles = response.records;\n          _this.total = response.total || response.records.length;\n        } else if (Array.isArray(response)) {\n          // 响应是直接的数组（兼容旧版本）\n          _this.articles = response;\n          _this.total = response.length;\n        } else if (response && response.data && response.data.records) {\n          // 响应是包含data字段的Result对象\n          _this.articles = response.data.records;\n          _this.total = response.data.total || response.data.records.length;\n        } else {\n          _this.articles = [];\n          _this.total = 0;\n        }\n\n        // 检查每篇文章的收藏状态\n        _this.checkFavorites();\n      })[\"catch\"](function (error) {\n        console.error('Failed to load articles:', error);\n        _this.$message.error('加载文章失败，请稍后重试');\n      })[\"finally\"](function () {\n        _this.loading = false;\n      });\n    },\n    checkFavorites: function checkFavorites() {\n      // 检查每篇文章的收藏状态\n      this.articles.forEach(function (article) {\n        isFavorited(article.id).then(function (response) {\n          article.isFavorited = response;\n        })[\"catch\"](function () {\n          article.isFavorited = false;\n        });\n      });\n    },\n    handleSearch: function handleSearch() {\n      var _this2 = this;\n      if (this.searchKeyword) {\n        this.loading = true;\n        this.isSearching = true;\n        var params = {\n          page: this.currentPage,\n          size: this.pageSize,\n          sortBy: this.sortBy\n        };\n        searchArticles(this.searchKeyword, params).then(function (response) {\n          if (response && response.records) {\n            // 响应是PageResult对象（被响应拦截器提取过）\n            _this2.articles = response.records;\n            _this2.total = response.total;\n          } else if (Array.isArray(response)) {\n            // 响应是直接的数组（兼容旧版本）\n            _this2.articles = response;\n            _this2.total = response.length;\n          } else if (response && response.data && response.data.records) {\n            // 响应是包含data字段的Result对象\n            _this2.articles = response.data.records;\n            _this2.total = response.data.total;\n          } else {\n            _this2.articles = [];\n            _this2.total = 0;\n          }\n\n          // 检查每篇文章的收藏状态\n          _this2.checkFavorites();\n        })[\"catch\"](function (error) {\n          console.error('Failed to search articles:', error);\n          _this2.$message.error('搜索失败，请稍后重试');\n        })[\"finally\"](function () {\n          _this2.loading = false;\n        });\n      } else {\n        this.isSearching = false;\n        this.loadArticles();\n      }\n    },\n    handleCategoryChange: function handleCategoryChange() {\n      this.currentPage = 1;\n      this.isSearching = false;\n      this.loadArticles();\n    },\n    selectCategory: function selectCategory(category) {\n      this.selectedCategory = category;\n      this.currentPage = 1;\n      this.isSearching = false;\n      this.loadArticles();\n    },\n    handleSizeChange: function handleSizeChange(size) {\n      this.pageSize = size;\n      this.loadArticles();\n    },\n    handleCurrentChange: function handleCurrentChange(current) {\n      this.currentPage = current;\n      this.loadArticles();\n    },\n    navigateToDetail: function navigateToDetail(id) {\n      this.$router.push(\"/article/detail/\".concat(id));\n    },\n    handleNewArticles: function handleNewArticles(event) {\n      var articleCount = event.detail;\n      this.$message({\n        message: \"\\u6709 \".concat(articleCount, \" \\u7BC7\\u65B0\\u7684\\u521B\\u4E1A\\u8D44\\u8BAF\"),\n        type: 'success',\n        duration: 3000\n      });\n      // 刷新文章列表\n      this.loadArticles();\n    },\n    handleFavorite: function handleFavorite(id) {\n      var _this3 = this;\n      // 检查用户是否已登录\n      if (!this.$store.getters['user/isLoggedIn']) {\n        this.$message({\n          message: '请先登录后再收藏',\n          type: 'warning',\n          duration: 2000\n        });\n        this.$router.push('/login');\n        return;\n      }\n      toggleFavorite(id).then(function (response) {\n        // 更新文章的收藏状态\n        var article = _this3.articles.find(function (a) {\n          return a.id === id;\n        });\n        if (article) {\n          article.isFavorited = response;\n        }\n        _this3.$message({\n          message: response ? '收藏成功' : '取消收藏成功',\n          type: 'success',\n          duration: 2000\n        });\n      })[\"catch\"](function (error) {\n        console.error('Failed to toggle favorite:', error);\n        _this3.$message.error('操作失败，请稍后重试');\n      });\n    },\n    handleShare: function handleShare(id) {\n      var _this4 = this;\n      // 实现分享功能\n      if (navigator.share) {\n        navigator.share({\n          title: '创业资讯',\n          text: '查看这篇创业资讯',\n          url: window.location.origin + '/article/detail/' + id\n        })[\"catch\"](function (error) {\n          console.error('Error sharing:', error);\n        });\n      } else {\n        // 复制链接到剪贴板\n        var url = window.location.origin + '/article/detail/' + id;\n        navigator.clipboard.writeText(url).then(function () {\n          _this4.$message({\n            message: '链接已复制到剪贴板',\n            type: 'success',\n            duration: 2000\n          });\n        })[\"catch\"](function () {\n          _this4.$message.error('复制链接失败，请手动复制');\n        });\n      }\n    },\n    getArticleImage: function getArticleImage(category) {\n      // 根据文章分类返回对应的图片\n      var images = {\n        '创业资讯': require('@/assets/images/startup-team.jpg'),\n        '投资融资': require('@/assets/images/investment.jpg'),\n        '科技创新': require('@/assets/images/tech-innovation.jpg')\n      };\n      return images[category] || require('@/assets/images/startup-team.jpg');\n    }\n  }\n};","map":{"version":3,"names":["getArticles","searchArticles","toggleFavorite","isFavorited","name","data","articles","total","currentPage","pageSize","selectedCategory","searchKeyword","isSearching","loading","sortBy","computed","featuredArticle","length","displayArticles","slice","mounted","loadArticles","window","addEventListener","handleNewArticles","beforeDestroy","removeEventListener","methods","_this","params","category","undefined","page","size","then","response","records","Array","isArray","checkFavorites","error","console","$message","forEach","article","id","handleSearch","_this2","handleCategoryChange","selectCategory","handleSizeChange","handleCurrentChange","current","navigateToDetail","$router","push","concat","event","articleCount","detail","message","type","duration","handleFavorite","_this3","$store","getters","find","a","handleShare","_this4","navigator","share","title","text","url","location","origin","clipboard","writeText","getArticleImage","images","require"],"sources":["src/views/article/List.vue"],"sourcesContent":["<template>\r\n  <div class=\"article-list\">\r\n    <div class=\"container\">\r\n      <!-- 搜索栏 -->\r\n      <div class=\"search-section\">\r\n        <el-input\r\n          v-model=\"searchKeyword\"\r\n          placeholder=\"搜索创业资讯...\"\r\n          prefix-icon=\"el-icon-search\"\r\n          class=\"search-input\"\r\n          @keyup.enter=\"handleSearch\"\r\n        >\r\n          <template #append>\r\n            <el-button type=\"primary\" @click=\"handleSearch\">搜索</el-button>\r\n          </template>\r\n        </el-input>\r\n      </div>\r\n      \r\n      <!-- 头条新闻 -->\r\n      <div v-if=\"!loading && featuredArticle\" class=\"featured-article\">\r\n        <div class=\"featured-image\">\r\n          <img :src=\"featuredArticle.imageUrl || getArticleImage(featuredArticle.category)\" :alt=\"featuredArticle.title\">\r\n          <div class=\"featured-overlay\">\r\n            <span class=\"featured-category\">{{ featuredArticle.category }}</span>\r\n            <h2 class=\"featured-title\">{{ featuredArticle.title }}</h2>\r\n            <div class=\"featured-meta\">\r\n              <span class=\"featured-source\">{{ featuredArticle.source }}</span>\r\n              <span class=\"featured-date\">{{ featuredArticle.publicationDate }}</span>\r\n            </div>\r\n            <p class=\"featured-summary\">{{ featuredArticle.contentSummary }}</p>\r\n            <el-button type=\"primary\" @click=\"navigateToDetail(featuredArticle.id)\" class=\"featured-button\">阅读全文</el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 分类标签 -->\r\n      <div class=\"category-section\">\r\n        <div class=\"category-header\">\r\n          <h3 class=\"section-title\">资讯分类</h3>\r\n        </div>\r\n        <div class=\"category-tabs\">\r\n          <el-tabs v-model=\"selectedCategory\" @tab-click=\"handleCategoryChange\" type=\"card\">\r\n            <el-tab-pane label=\"全部\" name=\"\"></el-tab-pane>\r\n            <el-tab-pane label=\"创业资讯\" name=\"创业资讯\"></el-tab-pane>\r\n            <el-tab-pane label=\"投资融资\" name=\"投资融资\"></el-tab-pane>\r\n            <el-tab-pane label=\"科技创新\" name=\"科技创新\"></el-tab-pane>\r\n          </el-tabs>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 最新新闻 -->\r\n      <div class=\"latest-news\">\r\n        <div class=\"section-header\">\r\n          <h3 class=\"section-title\">最新资讯</h3>\r\n          <el-select v-model=\"sortBy\" @change=\"loadArticles\" class=\"sort-select\">\r\n            <el-option label=\"最新发布\" value=\"latest\"></el-option>\r\n            <el-option label=\"相关度\" value=\"relevance\"></el-option>\r\n          </el-select>\r\n        </div>\r\n        <div class=\"article-grid\">\r\n          <el-card\r\n            v-for=\"article in displayArticles\"\r\n            :key=\"article.id\"\r\n            class=\"article-card\"\r\n            @click=\"navigateToDetail(article.id)\"\r\n            v-if=\"!loading\"\r\n          >\r\n            <div class=\"article-image\">\r\n              <img :src=\"article.imageUrl || getArticleImage(article.category)\" :alt=\"article.title\">\r\n              <div class=\"article-badge\" v-if=\"article.relevanceScore > 0.8\">\r\n                热门\r\n              </div>\r\n            </div>\r\n            <div class=\"article-content\">\r\n              <span class=\"category-tag\">{{ article.category }}</span>\r\n              <h4 class=\"article-title\">{{ article.title }}</h4>\r\n              <div class=\"article-meta\">\r\n                <span class=\"source\">{{ article.source }}</span>\r\n                <span class=\"date\">{{ article.publicationDate }}</span>\r\n                <span class=\"relevance\" v-if=\"article.relevanceScore > 0\">\r\n                  相关度: {{ Math.round(article.relevanceScore * 100) }}%\r\n                </span>\r\n              </div>\r\n              <p class=\"article-summary\">{{ article.contentSummary }}</p>\r\n              <div class=\"article-actions\">\r\n                <el-button type=\"text\" @click.stop=\"handleFavorite(article.id)\" :icon=\"article.isFavorited ? 'el-icon-star-on' : 'el-icon-star-off'\">\r\n                  {{ article.isFavorited ? '已收藏' : '收藏' }}\r\n                </el-button>\r\n                <el-button type=\"text\" @click.stop=\"handleShare(article.id)\" icon=\"el-icon-share\">\r\n                  分享\r\n                </el-button>\r\n              </div>\r\n            </div>\r\n          </el-card>\r\n          \r\n          <!-- 骨架屏 -->\r\n          <div v-else class=\"skeleton-grid\">\r\n            <el-card class=\"article-card skeleton-card\" v-for=\"i in 6\" :key=\"i\">\r\n              <div class=\"skeleton-image\">\r\n                <el-skeleton :rows=\"1\" animated style=\"height: 180px;\" />\r\n              </div>\r\n              <div class=\"skeleton-content\">\r\n                <el-skeleton :rows=\"1\" animated style=\"width: 80px;\" />\r\n                <el-skeleton :rows=\"2\" animated />\r\n                <el-skeleton :rows=\"1\" animated style=\"width: 200px;\" />\r\n                <el-skeleton :rows=\"2\" animated />\r\n                <el-skeleton :rows=\"1\" animated style=\"width: 150px;\" />\r\n              </div>\r\n            </el-card>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"pagination\">\r\n        <el-pagination\r\n          @size-change=\"handleSizeChange\"\r\n          @current-change=\"handleCurrentChange\"\r\n          :current-page=\"currentPage\"\r\n          :page-sizes=\"[10, 20, 50]\"\r\n          :page-size=\"pageSize\"\r\n          layout=\"total, sizes, prev, pager, next, jumper\"\r\n          :total=\"total\"\r\n        ></el-pagination>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { getArticles, searchArticles, toggleFavorite, isFavorited } from '@/api/article'\r\n\r\nexport default {\r\n  name: 'ArticleList',\r\n  data() {\r\n    return {\r\n      articles: [],\r\n      total: 0,\r\n      currentPage: 1,\r\n      pageSize: 10,\r\n      selectedCategory: '',\r\n      searchKeyword: '',\r\n      isSearching: false,\r\n      loading: false,\r\n      sortBy: 'latest'\r\n    }\r\n  },\r\n  computed: {\r\n    featuredArticle() {\r\n      // 返回第一篇文章作为特色文章\r\n      return this.articles.length > 0 ? this.articles[0] : null\r\n    },\r\n    displayArticles() {\r\n      // 显示除了特色文章之外的文章\r\n      return this.articles.length > 0 ? this.articles.slice(1) : []\r\n    }\r\n  },\r\n  mounted() {\r\n    this.isSearching = false\r\n    this.loadArticles()\r\n    \r\n    // 监听新文章通知\r\n    window.addEventListener('newArticles', this.handleNewArticles)\r\n  },\r\n  beforeDestroy() {\r\n    // 移除事件监听器\r\n    window.removeEventListener('newArticles', this.handleNewArticles)\r\n  },\r\n  methods: {\r\n    loadArticles() {\r\n      this.loading = true\r\n      const params = {\r\n        category: this.selectedCategory || undefined,\r\n        page: this.currentPage,\r\n        size: this.pageSize,\r\n        sortBy: this.sortBy\r\n      }\r\n      \r\n      getArticles(params).then(response => {\r\n        // 处理后端返回的响应\r\n        if (response && response.records) {\r\n          // 响应是PageResult对象（被响应拦截器提取过）\r\n          this.articles = response.records\r\n          this.total = response.total || response.records.length\r\n        } else if (Array.isArray(response)) {\r\n          // 响应是直接的数组（兼容旧版本）\r\n          this.articles = response\r\n          this.total = response.length\r\n        } else if (response && response.data && response.data.records) {\r\n          // 响应是包含data字段的Result对象\r\n          this.articles = response.data.records\r\n          this.total = response.data.total || response.data.records.length\r\n        } else {\r\n          this.articles = []\r\n          this.total = 0\r\n        }\r\n        \r\n        // 检查每篇文章的收藏状态\r\n        this.checkFavorites()\r\n      }).catch(error => {\r\n        console.error('Failed to load articles:', error)\r\n        this.$message.error('加载文章失败，请稍后重试')\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    checkFavorites() {\r\n      // 检查每篇文章的收藏状态\r\n      this.articles.forEach(article => {\r\n        isFavorited(article.id).then(response => {\r\n          article.isFavorited = response\r\n        }).catch(() => {\r\n          article.isFavorited = false\r\n        })\r\n      })\r\n    },\r\n    handleSearch() {\r\n      if (this.searchKeyword) {\r\n        this.loading = true\r\n        this.isSearching = true\r\n        const params = {\r\n          page: this.currentPage,\r\n          size: this.pageSize,\r\n          sortBy: this.sortBy\r\n        }\r\n        searchArticles(this.searchKeyword, params).then(response => {\r\n          if (response && response.records) {\r\n            // 响应是PageResult对象（被响应拦截器提取过）\r\n            this.articles = response.records\r\n            this.total = response.total\r\n          } else if (Array.isArray(response)) {\r\n            // 响应是直接的数组（兼容旧版本）\r\n            this.articles = response\r\n            this.total = response.length\r\n          } else if (response && response.data && response.data.records) {\r\n            // 响应是包含data字段的Result对象\r\n            this.articles = response.data.records\r\n            this.total = response.data.total\r\n          } else {\r\n            this.articles = []\r\n            this.total = 0\r\n          }\r\n          \r\n          // 检查每篇文章的收藏状态\r\n          this.checkFavorites()\r\n        }).catch(error => {\r\n          console.error('Failed to search articles:', error)\r\n          this.$message.error('搜索失败，请稍后重试')\r\n        }).finally(() => {\r\n          this.loading = false\r\n        })\r\n      } else {\r\n        this.isSearching = false\r\n        this.loadArticles()\r\n      }\r\n    },\r\n    handleCategoryChange() {\r\n      this.currentPage = 1\r\n      this.isSearching = false\r\n      this.loadArticles()\r\n    },\r\n    selectCategory(category) {\r\n      this.selectedCategory = category\r\n      this.currentPage = 1\r\n      this.isSearching = false\r\n      this.loadArticles()\r\n    },\r\n    handleSizeChange(size) {\r\n      this.pageSize = size\r\n      this.loadArticles()\r\n    },\r\n    handleCurrentChange(current) {\r\n      this.currentPage = current\r\n      this.loadArticles()\r\n    },\r\n    navigateToDetail(id) {\r\n      this.$router.push(`/article/detail/${id}`)\r\n    },\r\n    handleNewArticles(event) {\r\n      const articleCount = event.detail\r\n      this.$message({\r\n        message: `有 ${articleCount} 篇新的创业资讯`,\r\n        type: 'success',\r\n        duration: 3000\r\n      })\r\n      // 刷新文章列表\r\n      this.loadArticles()\r\n    },\r\n    handleFavorite(id) {\r\n      // 检查用户是否已登录\r\n      if (!this.$store.getters['user/isLoggedIn']) {\r\n        this.$message({\r\n          message: '请先登录后再收藏',\r\n          type: 'warning',\r\n          duration: 2000\r\n        })\r\n        this.$router.push('/login')\r\n        return\r\n      }\r\n      \r\n      toggleFavorite(id).then(response => {\r\n        // 更新文章的收藏状态\r\n        const article = this.articles.find(a => a.id === id)\r\n        if (article) {\r\n          article.isFavorited = response\r\n        }\r\n        this.$message({\r\n          message: response ? '收藏成功' : '取消收藏成功',\r\n          type: 'success',\r\n          duration: 2000\r\n        })\r\n      }).catch(error => {\r\n        console.error('Failed to toggle favorite:', error)\r\n        this.$message.error('操作失败，请稍后重试')\r\n      })\r\n    },\r\n    handleShare(id) {\r\n      // 实现分享功能\r\n      if (navigator.share) {\r\n        navigator.share({\r\n          title: '创业资讯',\r\n          text: '查看这篇创业资讯',\r\n          url: window.location.origin + '/article/detail/' + id\r\n        }).catch(error => {\r\n          console.error('Error sharing:', error)\r\n        })\r\n      } else {\r\n        // 复制链接到剪贴板\r\n        const url = window.location.origin + '/article/detail/' + id\r\n        navigator.clipboard.writeText(url).then(() => {\r\n          this.$message({\r\n            message: '链接已复制到剪贴板',\r\n            type: 'success',\r\n            duration: 2000\r\n          })\r\n        }).catch(() => {\r\n          this.$message.error('复制链接失败，请手动复制')\r\n        })\r\n      }\r\n    },\r\n    getArticleImage(category) {\r\n      // 根据文章分类返回对应的图片\r\n      const images = {\r\n        '创业资讯': require('@/assets/images/startup-team.jpg'),\r\n        '投资融资': require('@/assets/images/in