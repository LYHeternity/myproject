//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { adminUser, exportUsers } from '@/api/admin';\nexport default {\n  name: 'AdminUserList',\n  data: function data() {\n    return {\n      loading: false,\n      list: [],\n      query: {\n        role: '',\n        keyword: '',\n        status: null\n      },\n      page: {\n        current: 1,\n        size: 10,\n        total: 0\n      }\n    };\n  },\n  created: function created() {\n    this.load();\n  },\n  methods: {\n    load: function load() {\n      var _this = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee() {\n        var res;\n        return _regenerator().w(function (_context) {\n          while (1) switch (_context.p = _context.n) {\n            case 0:\n              _this.loading = true;\n              _context.p = 1;\n              _context.n = 2;\n              return adminUser.list({\n                current: _this.page.current,\n                size: _this.page.size,\n                role: _this.query.role,\n                keyword: _this.query.keyword,\n                status: _this.query.status\n              });\n            case 2:\n              res = _context.v;\n              _this.list = res.records || [];\n              _this.page.total = res.total || 0;\n            case 3:\n              _context.p = 3;\n              _this.loading = false;\n              return _context.f(3);\n            case 4:\n              return _context.a(2);\n          }\n        }, _callee, null, [[1,, 3, 4]]);\n      }))();\n    },\n    setStatus: function setStatus(id, status) {\n      var _this2 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee2() {\n        var _t;\n        return _regenerator().w(function (_context2) {\n          while (1) switch (_context2.p = _context2.n) {\n            case 0:\n              _context2.p = 0;\n              _context2.n = 1;\n              return adminUser.setStatus(id, status);\n            case 1:\n              _this2.$message.success('已更新');\n              _this2.load();\n              _context2.n = 3;\n              break;\n            case 2:\n              _context2.p = 2;\n              _t = _context2.v;\n              _this2.$message.error(_t.message || '操作失败');\n            case 3:\n              return _context2.a(2);\n          }\n        }, _callee2, null, [[0, 2]]);\n      }))();\n    },\n    resetPwd: function resetPwd(id) {\n      var _this3 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee3() {\n        var _t2;\n        return _regenerator().w(function (_context3) {\n          while (1) switch (_context3.p = _context3.n) {\n            case 0:\n              _context3.p = 0;\n              _context3.n = 1;\n              return _this3.$confirm('确定将该用户密码重置为 Admin@1234？', '提示', {\n                type: 'warning'\n              });\n            case 1:\n              _context3.n = 2;\n              return adminUser.resetPassword(id, 'Admin@1234');\n            case 2:\n              _this3.$message.success('已重置');\n              _context3.n = 4;\n              break;\n            case 3:\n              _context3.p = 3;\n              _t2 = _context3.v;\n              if (_t2 !== 'cancel') _this3.$message.error(_t2.message || '操作失败');\n            case 4:\n              return _context3.a(2);\n          }\n        }, _callee3, null, [[0, 3]]);\n      }))();\n    },\n    doExport: function doExport() {\n      var _this4 = this;\n      return _asyncToGenerator(/*#__PURE__*/_regenerator().m(function _callee4() {\n        var blob, url, a, _t3;\n        return _regenerator().w(function (_context4) {\n          while (1) switch (_context4.p = _context4.n) {\n            case 0:\n              _context4.p = 0;\n              _context4.n = 1;\n              return exportUsers();\n            case 1:\n              blob = _context4.v;\n              url = window.URL.createObjectURL(blob);\n              a = document.createElement('a');\n              a.href = url;\n              a.download = '用户列表.xlsx';\n              a.click();\n              window.URL.revokeObjectURL(url);\n              _this4.$message.success('导出成功');\n              _context4.n = 3;\n              break;\n            case 2:\n              _context4.p = 2;\n              _t3 = _context4.v;\n              _this4.$message.error('导出失败');\n            case 3:\n              return _context4.a(2);\n          }\n        }, _callee4, null, [[0, 2]]);\n      }))();\n    }\n  }\n};","map":{"version":3,"names":["adminUser","exportUsers","name","data","loading","list","query","role","keyword","status","page","current","size","total","created","load","methods","_this","_asyncToGenerator","_regenerator","m","_callee","res","w","_context","p","n","v","records","f","a","setStatus","id","_this2","_callee2","_t","_context2","$message","success","error","message","resetPwd","_this3","_callee3","_t2","_context3","$confirm","type","resetPassword","doExport","_this4","_callee4","blob","url","_t3","_context4","window","URL","createObjectURL","document","createElement","href","download","click","revokeObjectURL"],"sources":["src/views/admin/UserList.vue"],"sourcesContent":["<template>\n  <div class=\"admin-page\">\n    <div class=\"page-header-section\">\n      <div class=\"page-header-content\">\n        <h1 class=\"page-title\">用户管理</h1>\n        <p class=\"page-subtitle\">管理平台用户账号、角色权限及相关设置</p>\n      </div>\n      <div class=\"page-header-actions\">\n        <el-button type=\"primary\" @click=\"openAddUserDialog\" class=\"primary-action-button\">\n          <i class=\"el-icon-plus\"></i> 新增用户\n        </el-button>\n      </div>\n    </div>\n\n    <div class=\"user-management-dashboard\">\n      <!-- 用户概览卡片 -->\n      <div class=\"user-stats-grid\">\n        <div class=\"stat-card\">\n          <div class=\"stat-header\">\n            <h3 class=\"stat-title\">总用户数</h3>\n            <span class=\"stat-icon total\"><i class=\"el-icon-user\"></i></span>\n          </div>\n          <div class=\"stat-body\">\n            <div class=\"stat-value\">{{ totalUsers }}</div>\n            <div class=\"stat-change positive\">+12% <span>较上月</span></div>\n          </div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-header\">\n            <h3 class=\"stat-title\">活跃用户</h3>\n            <span class=\"stat-icon active\"><i class=\"el-icon-video-camera\"></i></span>\n          </div>\n          <div class=\"stat-body\">\n            <div class=\"stat-value\">{{ activeUsers }}</div>\n            <div class=\"stat-change positive\">+8% <span>较上月</span></div>\n          </div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-header\">\n            <h3 class=\"stat-title\">待审核</h3>\n            <span class=\"stat-icon pending\"><i class=\"el-icon-time\"></i></span>\n          </div>\n          <div class=\"stat-body\">\n            <div class=\"stat-value\">{{ pendingUsers }}</div>\n            <div class=\"stat-change warning\">+3 <span>今日</span></div>\n          </div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-header\">\n            <h3 class=\"stat-title\">禁用用户</h3>\n            <span class=\"stat-icon disabled\"><i class=\"el-icon-close\"></i></span>\n          </div>\n          <div class=\"stat-body\">\n            <div class=\"stat-value\">{{ disabledUsers }}</div>\n            <div class=\"stat-change negative\">-2 <span>本月</span></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 用户列表管理 -->\n      <div class=\"user-list-section\">\n        <div class=\"section-header\">\n          <h2 class=\"section-title\">用户列表</h2>\n          <div class=\"section-actions\">\n            <el-button type=\"primary\" icon=\"el-icon-download\" @click=\"doExport\" class=\"action-button\">\n              导出 Excel\n            </el-button>\n            <el-dropdown trigger=\"click\" class=\"batch-actions\">\n              <el-button icon=\"el-icon-s-operation\" class=\"action-button\">\n                批量操作 <i class=\"el-icon-arrow-down el-icon--right\"></i>\n              </el-button>\n              <el-dropdown-menu slot=\"dropdown\">\n                <el-dropdown-item @click=\"batchEnable\">批量启用</el-dropdown-item>\n                <el-dropdown-item @click=\"batchDisable\">批量禁用</el-dropdown-item>\n                <el-dropdown-item @click=\"batchResetPassword\">批量重置密码</el-dropdown-item>\n                <el-dropdown-item divided @click=\"batchDelete\">批量删除</el-dropdown-item>\n              </el-dropdown-menu>\n            </el-dropdown>\n          </div>\n        </div>\n\n        <!-- 搜索筛选区域 -->\n        <div class=\"search-filter-section\">\n          <el-form inline class=\"search-form\">\n            <el-form-item label=\"关键词\">\n              <el-input v-model=\"query.keyword\" placeholder=\"用户名/手机/邮箱\" clearable class=\"search-input\" />\n            </el-form-item>\n            <el-form-item label=\"角色\">\n              <el-select v-model=\"query.role\" clearable placeholder=\"全部\" class=\"filter-select\">\n                <el-option label=\"创业者\" value=\"entrepreneur\" />\n                <el-option label=\"投资人\" value=\"investor\" />\n                <el-option label=\"服务商\" value=\"provider\" />\n                <el-option label=\"管理员\" value=\"admin\" />\n              </el-select>\n            </el-form-item>\n            <el-form-item label=\"状态\">\n              <el-select v-model=\"query.status\" clearable placeholder=\"全部\" class=\"filter-select\">\n                <el-option label=\"启用\" :value=\"1\" />\n                <el-option label=\"禁用\" :value=\"0\" />\n              </el-select>\n            </el-form-item>\n            <el-form-item label=\"注册时间\">\n              <el-date-picker\n                v-model=\"dateRange\"\n                type=\"daterange\"\n                range-separator=\"至\"\n                start-placeholder=\"开始日期\"\n                end-placeholder=\"结束日期\"\n                value-format=\"yyyy-MM-dd\"\n                class=\"date-picker\"\n              />\n            </el-form-item>\n            <el-form-item>\n              <el-button type=\"primary\" @click=\"load\" class=\"search-button\">\n                <i class=\"el-icon-search\"></i> 查询\n              </el-button>\n              <el-button @click=\"resetFilters\" class=\"reset-button\">\n                <i class=\"el-icon-refresh\"></i> 重置\n              </el-button>\n            </el-form-item>\n          </el-form>\n        </div>\n\n        <!-- 批量选择栏 -->\n        <div v-if=\"selectedRows.length > 0\" class=\"batch-selection-bar\">\n          <div class=\"selection-info\">\n            <i class=\"el-icon-check-box\"></i>\n            <span>已选择 {{ selectedRows.length }} 个用户</span>\n          </div>\n          <div class=\"selection-actions\">\n            <el-button size=\"small\" @click=\"batchEnable\">批量启用</el-button>\n            <el-button size=\"small\" @click=\"batchDisable\">批量禁用</el-button>\n            <el-button size=\"small\" @click=\"batchResetPassword\">批量重置密码</el-button>\n            <el-button size=\"small\" type=\"danger\" @click=\"batchDelete\">批量删除</el-button>\n            <el-button size=\"small\" @click=\"clearSelection\">取消选择</el-button>\n          </div>\n        </div>\n\n        <!-- 用户表格 -->\n        <div class=\"user-table-container\">\n          <el-table\n            v-loading=\"loading\"\n            :data=\"list\"\n            style=\"width: 100%\"\n            class=\"user-table\"\n            @selection-change=\"handleSelectionChange\"\n            stripe\n          >\n            <el-table-column type=\"selection\" width=\"50\" />\n            <el-table-column prop=\"id\" label=\"ID\" width=\"80\" />\n            <el-table-column label=\"用户信息\" min-width=\"200\">\n              <template slot-scope=\"scope\">\n                <div class=\"user-info-cell\">\n                  <div class=\"user-avatar\">\n                    {{ (scope.row.realName || scope.row.username || 'A').charAt(0) }}\n                  </div>\n                  <div class=\"user-details\">\n                    <h4 class=\"user-name\">{{ scope.row.realName || scope.row.username }}</h4>\n                    <p class=\"user-username\">{{ scope.row.username }}</p>\n                    <p class=\"user-contact\">{{ scope.row.phone }} | {{ scope.row.email }}</p>\n                  </div>\n                </div>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"role\" label=\"角色\" width=\"120\">\n              <template slot-scope=\"scope\">\n                <el-tag :class=\"getRoleTagClass(scope.row.role)\" effect=\"light\">\n                  {{ getRoleLabel(scope.row.role) }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"status\" label=\"状态\" width=\"100\">\n              <template slot-scope=\"scope\">\n                <el-tag :class=\"getStatusTagClass(scope.row.status)\" effect=\"light\">\n                  {{ scope.row.status === 1 ? '启用' : '禁用' }}\n                </el-tag>\n              </template>\n            </el-table-column>\n            <el-table-column prop=\"createdAt\" label=\"注册时间\" width=\"180\" />\n            <el-table-column prop=\"lastLoginAt\" label=\"最后登录\" width=\"180\" />\n            <el-table-column label=\"操作\" width=\"240\" fixed=\"right\">\n              <template slot-scope=\"scope\">\n                <div class=\"user-actions\">\n                  <el-button type=\"primary\" size=\"small\" @click=\"openEditUserDialog(scope.row)\" class=\"action-button primary\">\n                    <i class=\"el-icon-edit\"></i> 编辑\n                  </el-button>\n                  <el-button \n                    :type=\"scope.row.status === 1 ? 'warning' : 'success'\" \n                    size=\"small\" \n                    @click=\"setStatus(scope.row.id, scope.row.status === 1 ? 0 : 1)\"\n                    class=\"action-button\"\n                  >\n                    <i :class=\"scope.row.status === 1 ? 'el-icon-close' : 'el-icon-check'\">\n                    </i> {{ scope.row.status === 1 ? '禁用' : '启用' }}\n                  </el-button>\n                  <el-button type=\"danger\" size=\"small\" @click=\"resetPwd(scope.row.id)\" class=\"action-button\">\n                    <i class=\"el-icon-key\"></i> 重置密码\n                  </el-button>\n                </div>\n              </template>\n            </el-table-column>\n          </el-table>\n\n          <!-- 空数据状态 -->\n          <div v-if=\"!loading && !list.length\" class=\"empty-state\">\n            <div class=\"empty-icon-container\">\n              <i class=\"el-icon-user\"></i>\n            </div>\n            <h3 class=\"empty-title\">暂无用户数据</h3>\n            <p class=\"empty-description\">当前筛选条件下没有找到用户信息</p>\n            <el-button type=\"primary\" @click=\"resetFilters\" class=\"empty-action-button\">\n              重置筛选条件\n            </el-button>\n          </div>\n        </div>\n\n        <!-- 分页控件 -->\n        <div v-if=\"page.total > 0\" class=\"pagination-section\">\n          <div class=\"pagination-info\">\n            共 {{ page.total }} 条记录，当前第 {{ page.current }} 页\n          </div>\n          <el-pagination\n            v-model:current-page=\"page.current\"\n            v-model:page-size=\"page.size\"\n            :page-sizes=\"[10, 20, 50, 100]\"\n            layout=\"total, sizes, prev, pager, next, jumper\"\n            :total=\"page.total\"\n            @size-change=\"handleSizeChange\"\n            @current-change=\"handleCurrentChange\"\n            class=\"pagination-controls\"\n          />\n        </div>\n      </div>\n    </div>\n\n    <!-- 新增用户弹窗 -->\n    <el-dialog \n      title=\"新增用户\" \n      :visible.sync=\"showAddUserDialog\" \n      width=\"600px\"\n      class=\"custom-dialog\"\n    >\n      <el-form :model=\"newUserForm\" :rules=\"userFormRules\" ref=\"newUserFormRef\" label-width=\"100px\">\n        <el-form-item label=\"用户名\" prop=\"username\">\n          <el-input v-model=\"newUserForm.username\" placeholder=\"请输入用户名\" />\n        </el-form-item>\n        <el-form-item label=\"姓名\" prop=\"realName\">\n          <el-input v-model=\"newUserForm.realName\" placeholder=\"请输入真实姓名\" />\n        </el-form-item>\n        <el-form-item label=\"手机号码\" prop=\"phone\">\n          <el-input v-model=\"newUserForm.phone\" placeholder=\"请输入手机号码\" />\n        </el-form-item>\n        <el-form-item label=\"电子邮箱\" prop=\"email\">\n          <el-input v-model=\"newUserForm.email\" placeholder=\"请输入电子邮箱\" />\n        </el-form-item>\n        <el-form-item label=\"角色\" prop=\"role\">\n          <el-select v-model=\"newUserForm.role\" placeholder=\"请选择角色\">\n            <el-option label=\"创业者\" value=\"entrepreneur\" />\n            <el-option label=\"投资人\" value=\"investor\" />\n            <el-option label=\"服务商\" value=\"provider\" />\n            <el-option label=\"管理员\" value=\"admin\" />\n          </el-select>\n        </el-form-item>\n        <el-form-item label=\"初始密码\" prop=\"password\">\n          <el-input v-model=\"newUserForm.password\" type=\"password\" placeholder=\"请输入初始密码\" />\n        </el-form-item>\n      </el-form>\n      <template #footer>\n        <span class=\"dialog-footer\">\n          <el-button @click=\"showAddUserDialog = false\">取消</el-button>\n          <el-button type=\"primary\" @click=\"addUser\">确定</el-button>\n        </span>\n      </template>\n    </el-dialog>\n\n    <!-- 编辑用户弹窗 -->\n    <el-dialog \n      title=\"编辑用户\" \n      :visible.sync=\"showEditUserDialog\" \n      width=\"600px\"\n      class=\"custom-dialog\"\n    >\n      <el-form :model=\"editUserForm\" :rules=\"userFormRules\" ref=\"editUserFormRef\" label-width=\"100px\">\n        <el-form-item label=\"用户名\" prop=\"username\">\n          <el-input v-model=\"editUserForm.username\" placeholder=\"请输入用户名\" disabled />\n        </el-form-item>\n        <el-form-item label=\"姓名\" prop=\"realName\">\n          <el-input v-model=\"editUserForm.realName\" placeholder=\"请输入真实姓名\" />\n        </el-form-item>\n        <el-form-item label=\"手机号码\" prop=\"phone\">\n          <el-input v-model=\"editUserForm.phone\" placeholder=\"请输入手机号码\" />\n        </el-form-item>\n        <el-form-item label=\"电子邮箱\" prop=\"email\">\n          <el-input v-model=\"editUserForm.email\" placeholder=\"请输入电子邮箱\" />\n        </el-form-item>\n        <el-form-item label=\"角色\" prop=\"role\">\n          <el-select v-model=\"editUserForm.role\" placeholder=\"请选择角色\">\n            <el-option label=\"创业者\" value=\"entrepreneur\" />\n            <el-option label=\"投资人\" value=\"investor\" />\n            <el-option label=\"服务商\" value=\"provider\" />\n            <el-option label=\"管理员\" value=\"admin\" />\n          </el-select>\n        </el-form-item>\n      </el-form>\n      <template #footer>\n        <span class=\"dialog-footer\">\n          <el-button @click=\"showEditUserDialog = false\">取消</el-button>\n          <el-button type=\"primary\" @click=\"updateUser\">确定</el-button>\n        </span>\n      </template>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport { adminUser, exportUsers } from '@/api/admin'\nexport default {\n  name: 'AdminUserList',\n  data() {\n    return { loading: false, list: [], query: { role: '', keyword: '', status: null }, page: { current: 1, size: 10, total: 0 } }\n  },\n  created() { this.load() },\n  methods: {\n    async load() {\n      this.loading = true\n      try {\n        const res = await adminUser.list({ current: this.page.current, size: this.page.size, role: this.query.role, keyword: this.query.keyword, status: this.query.status })\n        this.list = res.records || []\n        this.page.total = res.total || 0\n      } finally { this.loading = false }\n    },\n    async setStatus(id, status) {\n      try {\n        