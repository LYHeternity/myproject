{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { adminConfig } from '@/api/admin';\nexport default {\n  name: 'AdminConfig',\n  data: function data() {\n    return {\n      loading: false,\n      list: []\n    };\n  },\n  created: function created() {\n    var _this = this;\n    this.loading = true;\n    adminConfig.list().then(function (res) {\n      _this.list = res || [];\n      _this.loading = false;\n    })[\"catch\"](function () {\n      _this.loading = false;\n    });\n  }\n};","map":{"version":3,"names":["adminConfig","name","data","loading","list","created","_this","then","res"],"sources":["src/views/admin/Config.vue"],"sourcesContent":["<template>\r\n  <div class=\"page-card\">\r\n    <h3>系统配置</h3>\r\n    <el-table v-loading=\"loading\" :data=\"list\" border stripe>\r\n      <el-table-column prop=\"configKey\" label=\"配置项\" width=\"220\" />\r\n      <el-table-column prop=\"configValue\" label=\"值\" />\r\n      <el-table-column prop=\"description\" label=\"说明\" width=\"200\" />\r\n    </el-table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { adminConfig } from '@/api/admin'\r\nexport default {\r\n  name: 'AdminConfig',\r\n  data() { return { loading: false, list: [] } },\r\n  created() {\r\n    this.loading = true\r\n    adminConfig.list().then(res => { this.list = res || []; this.loading = false }).catch(() => { this.loading = false })\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;;;;;;;;;;;AAYA,SAAAA,WAAA;AACA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IAAA;MAAAC,OAAA;MAAAC,IAAA;IAAA;EAAA;EACAC,OAAA,WAAAA,QAAA;IAAA,IAAAC,KAAA;IACA,KAAAH,OAAA;IACAH,WAAA,CAAAI,IAAA,GAAAG,IAAA,WAAAC,GAAA;MAAAF,KAAA,CAAAF,IAAA,GAAAI,GAAA;MAAAF,KAAA,CAAAH,OAAA;IAAA;MAAAG,KAAA,CAAAH,OAAA;IAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}