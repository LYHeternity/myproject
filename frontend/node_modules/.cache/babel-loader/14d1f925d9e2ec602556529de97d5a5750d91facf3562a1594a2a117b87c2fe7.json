         symbolSize: 8,\n          lineStyle: {\n            width: 2,\n            color: '#007dff'\n          },\n          itemStyle: {\n            color: '#007dff'\n          },\n          areaStyle: {\n            color: {\n              type: 'linear',\n              x: 0,\n              y: 0,\n              x2: 0,\n              y2: 1,\n              colorStops: [{\n                offset: 0,\n                color: 'rgba(0,125,255,0.25)'\n              }, {\n                offset: 1,\n                color: 'rgba(0,125,255,0.02)'\n              }]\n            }\n          }\n        }],\n        animation: true,\n        animationDuration: 1200,\n        animationEasing: 'cubicOut'\n      });\n    },\n    handleCaseClick: function handleCaseClick(item) {\n      this.$router.push('/projects');\n    },\n    startNumberAnimation: function startNumberAnimation() {\n      var _this4 = this;\n      var duration = 1200;\n      var keys = ['userCount', 'projectCount', 'resourceCount', 'orderCount'];\n      var start = Date.now();\n      var _tick = function tick() {\n        var elapsed = Date.now() - start;\n        var t = Math.min(elapsed / duration, 1);\n        var easeOut = 1 - Math.pow(1 - t, 2);\n        keys.forEach(function (k) {\n          _this4.animatedOverview[k] = Math.round(_this4.overview[k] * easeOut);\n        });\n        if (t < 1) requestAnimationFrame(_tick);else keys.forEach(function (k) {\n          _this4.animatedOverview[k] = _this4.overview[k];\n        });\n      };\n      requestAnimationFrame(_tick);\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapGetters","request","echarts","BANNER_IMG","CASE_IMAGES","CASE_TITLES","CASE_DESCS","TAGS","buildCaseList","slice","map","title","i","id","desc","length","image","tag","name","data","overview","userCount","projectCount","resourceCount","orderCount","animatedOverview","caseList","trendChart","heroBgStyle","backgroundImage","concat","computed","_objectSpread","roleEntry","role","c